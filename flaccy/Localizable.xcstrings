    "%@ has been on repeat — %@ plays and counting. See your recap.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ läuft in Dauerschleife – %2$@ Wiedergaben und es werden mehr. Sieh dir deinen Rückblick an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ has been on repeat — %2$@ plays and counting. See your recap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no para de sonar: %2$@ reproducciones y subiendo. Mira tu resumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tourne en boucle — %2$@ écoutes et ça continue. Voir votre récap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ è sempre in loop: %2$@ ascolti e non è finita. Guarda il tuo riepilogo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@がヘビロテ中 — %2$@回再生、まだ止まりません。リキャップを見る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
