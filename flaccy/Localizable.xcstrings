    "Scrobbles every play, keeps an offline queue, and powers the Recap, Wantlist, and loved tracks.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrobbelt jede Wiedergabe, hält eine Offline-Warteschlange bereit und liefert die Basis für Rückblick, Wunschliste und Favoriten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrobblea cada reproducción, mantiene una cola sin conexión y alimenta el resumen, la lista de deseos y las favoritas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrobble chaque écoute, garde une file hors ligne et alimente le récap, la liste d'envies et les morceaux aimés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrobbla ogni riproduzione, mantiene una coda offline e alimenta il riepilogo, la lista dei desideri e i preferiti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての再生をスクロブルし、オフラインではキューに保持して、リキャップ・ウォントリスト・お気に入りの土台になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 재생을 스크로블하고 오프라인 대기열을 유지하며, 리캡과 위시리스트, 좋아요한 트랙의 바탕이 됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrobbla cada reprodução, mantém uma fila offline e alimenta a retrospectiva, a lista de desejos e as faixas curtidas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录每一次播放，保留离线队列，并为回顾、心愿单和喜欢的曲目提供数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄每一次播放，保留離線佇列，並為回顧、願望清單與喜愛的曲目提供資料。"
          }
        }
      }
    },
