    "Folds deluxe, remaster, and explicit variants into one album": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasst Deluxe-, Remaster- und Explicit-Varianten zu einem Album zusammen"
          }
        },
        "es": {
