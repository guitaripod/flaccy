    "Choose a music folder to index in place, or import files into Flaccy's own library.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Musikordner, der direkt indexiert wird, oder importiere Dateien in Flaccys eigene Mediathek."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una carpeta de música para indexarla donde está, o importa archivos a la biblioteca propia de Flaccy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un dossier de musique à indexer sur place, ou importez des fichiers dans la bibliothèque de Flaccy."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una cartella di musica da indicizzare dov'è, oppure importa i file nella libreria di Flaccy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その場でインデックスする音楽フォルダを選ぶか、ファイルをFlaccy自身のライブラリに読み込みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제자리에서 색인할 음악 폴더를 선택하거나, 파일을 Flaccy 보관함으로 가져오세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma pasta de música para indexar onde ela está, ou importe arquivos para a biblioteca do próprio Flaccy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个音乐文件夹就地建立索引，或把文件导入 Flaccy 自己的资料库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一個音樂資料夾就地建立索引，或把檔案匯入 Flaccy 自己的資料庫。"
          }
        }
      }
