    "Your listens are scrobbled to Last.fm and your loved tracks stay in sync.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Hördurchgänge werden zu Last.fm gescrobbelt und deine Favoriten bleiben synchron."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus escuchas se scrobblean a Last.fm y tus pistas favoritas se mantienen sincronizadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos écoutes sont scrobblées sur Last.fm et vos morceaux aimés restent synchronisés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi ascolti vengono scrobblati su Last.fm e i tuoi preferiti restano sincronizzati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生はLast.fmにスクロブルされ、お気に入りは同期され続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감상 기록은 Last.fm에 스크로블되고 좋아요한 트랙은 계속 동기화됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas audições são scrobbladas no Last.fm e suas faixas curtidas ficam em sincronia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的收听记录会 Scrobble 到 Last.fm，喜欢的曲目也会保持同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的聆聽記錄會 Scrobble 到 Last.fm，喜愛的曲目也會保持同步。"
          }
        }
      }
    },
    "Your listens will no longer be scrobbled. Your library, play history, and loved tracks stay on this device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Hördurchgänge werden nicht mehr gescrobbelt. Mediathek, Wiedergabeverlauf und Favoriten bleiben auf diesem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus escuchas ya no se scrobblearán. Tu biblioteca, tu historial de reproducción y tus favoritas siguen en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos écoutes ne seront plus scrobblées. Votre bibliothèque, votre historique et vos morceaux aimés restent sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi ascolti non verranno più scrobblati. Libreria, cronologia di ascolto e preferiti restano su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後、再生はスクロブルされません。ライブラリ、再生履歴、お気に入りはこのデバイスに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 감상 기록이 스크로블되지 않습니다. 보관함, 재생 기록, 좋아요한 트랙은 이 기기에 남습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas audições não serão mais scrobbladas. Sua biblioteca, o histórico de reproduções e as faixas curtidas continuam neste dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的收听记录将不再被 Scrobble。资料库、播放记录和喜欢的曲目都会留在此设备上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的聆聽記錄將不再被 Scrobble。資料庫、播放記錄與喜愛的曲目都會留在這部裝置上。"
          }
        }
      }
    },
