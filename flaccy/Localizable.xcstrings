    "Sync tracks and play from your wrist, no phone needed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Titel synchronisieren und direkt vom Handgelenk hören – ganz ohne iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza pistas y escucha desde la muñeca, sin iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisez des morceaux et écoutez depuis votre poignet, sans iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizza i brani e ascolta dal polso, senza iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曲を同期すれば、iPhoneなしで手首から再生できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트랙을 동기화하면 iPhone 없이 손목에서 바로 들을 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronize faixas e ouça direto do pulso, sem precisar do iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步曲目，从手腕上直接播放，无需 iPhone。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同步曲目，直接從手腕上播放，不需要 iPhone。"
          }
        }
      }
    },
