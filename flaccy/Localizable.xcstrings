          }
        }
      }
    },
    "Gapless playback is always on — FLAC albums flow track to track with zero silence.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lückenlose Wiedergabe ist immer aktiv – FLAC-Alben laufen ohne Stille von Titel zu Titel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reproducción sin pausas está siempre activa: los álbumes FLAC fluyen de pista a pista sin silencios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lecture sans blanc est toujours active — les albums FLAC s'enchaînent sans une seconde de silence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riproduzione senza pause è sempre attiva: gli album FLAC scorrono da un brano all'altro senza silenzi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ギャップレス再生は常にオン — FLACのアルバムは無音を挟まず曲から曲へ流れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "갭리스 재생은 항상 켜져 있습니다 — FLAC 앨범은 정적 없이 곡에서 곡으로 이어집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A reprodução sem pausas está sempre ativa — álbuns em FLAC fluem de faixa em faixa sem um segundo de silêncio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无缝播放始终开启——FLAC 专辑一曲接一曲，中间没有一秒静音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無縫播放一律開啟——FLAC 專輯一曲接一曲，中間沒有一秒空白。"
          }
        }
      }
    },
    "Gapless plays consecutive album tracks without silence. Autoplay keeps a similar-music station going when the queue ends.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lückenlos spielt aufeinanderfolgende Albumtitel ohne Stille. Autoplay hält am Ende der Warteschlange einen Sender mit ähnlicher Musik am Laufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reproducción sin pausas encadena las pistas de un álbum sin silencios. La reproducción automática mantiene una emisora de música similar cuando la cola termina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lecture sans blanc enchaîne les morceaux d'un album sans silence. La lecture auto lance une radio de musique similaire quand la file se termine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riproduzione senza pause concatena i brani di un album senza silenzi. La riproduzione automatica avvia una stazione di musica simile quando la coda finisce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ギャップレス再生はアルバムの連続した曲を無音なしでつなぎます。自動再生はキューが尽きたときに似た曲のステーションを続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "갭리스 재생은 앨범의 연속된 트랙을 정적 없이 이어 줍니다. 자동 재생은 대기열이 끝나면 비슷한 음악 스테이션을 이어 갑니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A reprodução sem pausas emenda as faixas de um álbum sem silêncio. A reprodução automática mantém uma estação de música parecida quando a fila acaba."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无缝播放让专辑中连续的曲目之间没有静音。自动播放会在队列结束时接上一个相似音乐电台。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無縫播放讓專輯中連續的曲目之間沒有空白。自動播放則會在待播清單結束時，接上一個相似音樂電台。"
          }
        }
      }
    },
