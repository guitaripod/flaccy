    "Nothing here right now.\nYour library already covers it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier ist gerade nichts.\nDeine Mediathek deckt schon alles ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí no hay nada ahora mismo.\nTu biblioteca ya lo cubre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ici pour l'instant.\nVotre bibliothèque couvre déjà tout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui non c'è nulla al momento.\nLa tua libreria copre già tutto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今のところ何もありません。\nライブラリがすでにカバーしています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 여기에 아무것도 없습니다.\n보관함이 이미 다 채우고 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada aqui por enquanto.\nSua biblioteca já cobre isso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在这里没有内容。\n你的资料库已经覆盖了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在這裡沒有內容。\n你的資料庫已經都有了。"
          }
        }
      }
    },
