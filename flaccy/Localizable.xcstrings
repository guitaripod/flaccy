        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デラックス版、リマスター版、Explicit版を1つのアルバムにまとめます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디럭스, 리마스터, 익스플리싯 버전을 하나의 앨범으로 묶습니다"
