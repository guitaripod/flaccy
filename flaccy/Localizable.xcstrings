    "Last.fm sign-in didn't complete. Check your connection and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Last.fm-Anmeldung wurde nicht abgeschlossen. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión en Last.fm no se completó. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion à Last.fm n'a pas abouti. Vérifiez votre connexion et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso a Last.fm non è andato a buon fine. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fmへのサインインが完了しませんでした。接続を確認してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm 로그인이 완료되지 않았습니다. 연결 상태를 확인하고 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O login no Last.fm não foi concluído. Verifique sua conexão e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm 登录未完成。请检查网络连接后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm 登入未完成。請檢查網路連線後再試一次。"
          }
        }
      }
    },
