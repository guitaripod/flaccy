        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで作成するか、曲を右クリックして「プレイリストに追加」を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 만들거나, 곡을 마우스 오른쪽 버튼으로 클릭하고 “재생목록에 추가”를 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie uma aqui, ou clique com o botão direito em qualquer música e escolha “Adicionar à playlist”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这里创建一个，或右键点按任意歌曲并选择“添加到播放列表”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這裡建立一個，或在任一首歌曲上按右鍵並選擇「加入播放列表」。"
          }
        }
      }
    },
