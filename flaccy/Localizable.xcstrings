    "Group Album Editions": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Album-Editionen gruppieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupar ediciones de álbum"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regrouper les éditions d'album"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raggruppa le edizioni degli album"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバムのエディションをまとめる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앨범 에디션 묶기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupar Edições de Álbum"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合并专辑版本"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "合併專輯版本"
          }
        }
      }
    },
    "Group album editions (Deluxe, Remaster…) as one album": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Album-Editionen (Deluxe, Remaster…) als ein Album"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupar ediciones (Deluxe, Remaster…) como un álbum"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regrouper les éditions (Deluxe, Remaster…) en un album"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raggruppa le edizioni (Deluxe, Remaster…) come un unico album"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エディション（Deluxe、Remasterなど）を1つのアルバムにまとめます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에디션(디럭스, 리마스터 등)을 하나의 앨범으로 묶기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupar edições (Deluxe, Remaster…) como um só álbum"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把各版本（豪华版、重制版…）合并为一张专辑"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把各種專輯版本（豪華版、重製版…）合併為一張專輯"
          }
        }
      }
    },
    "Group editions folds Deluxe, Remaster, and Explicit variants into one album and keeps a single best copy of each song.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Editionen gruppieren“ fasst Deluxe-, Remaster- und Explicit-Varianten zu einem Album zusammen und behält von jedem Titel die beste Kopie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupar ediciones funde las variantes Deluxe, Remaster y Explicit en un solo álbum y conserva la mejor copia de cada canción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le regroupement des éditions fond les variantes Deluxe, Remaster et Explicit en un seul album et ne garde que la meilleure copie de chaque morceau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il raggruppamento delle edizioni fonde le varianti Deluxe, Remaster ed Explicit in un solo album e tiene la copia migliore di ogni brano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エディションをまとめると、Deluxe版・Remaster版・Explicit版が1つのアルバムになり、各曲は最良のコピーだけが残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에디션 묶기는 디럭스, 리마스터, 익스플리싯 버전을 하나의 앨범으로 합치고 각 곡의 최상급 사본만 남깁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupar edições funde as versões Deluxe, Remaster e Explicit em um só álbum e mantém a melhor cópia de cada música."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合并版本会把豪华版、重制版和显式版合成一张专辑，每首歌只保留最佳的一份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "合併版本會把豪華版、重製版與 Explicit 版合成一張專輯，每首歌只保留最好的一份。"
          }
        }
      }
    },
    "H2-chip AirPods get lossless wirelessly only with Apple Vision Pro, over a proprietary 5 GHz link — not standard Bluetooth.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods mit H2-Chip bekommen verlustfreies Audio drahtlos nur mit Apple Vision Pro über eine proprietäre 5-GHz-Verbindung – nicht über normales Bluetooth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los AirPods con chip H2 reciben lossless por vía inalámbrica solo con el Apple Vision Pro, mediante un enlace propietario de 5 GHz, no por Bluetooth estándar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les AirPods à puce H2 reçoivent le lossless sans fil uniquement avec l'Apple Vision Pro, via une liaison propriétaire 5 GHz — pas en Bluetooth standard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli AirPods con chip H2 ricevono il lossless senza fili solo con Apple Vision Pro, tramite un collegamento proprietario a 5 GHz, non con il Bluetooth standard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "H2チップ搭載のAirPodsがワイヤレスでロスレスを受け取れるのはApple Vision Proと組み合わせたときだけで、独自の5 GHzリンクを使います。標準のBluetoothではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "H2 칩이 들어간 AirPods가 무선으로 무손실을 받는 경우는 Apple Vision Pro와 함께 쓸 때뿐이며, 표준 블루투스가 아니라 독자 5GHz 연결을 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods com chip H2 só recebem lossless sem fio com o Apple Vision Pro, por um enlace proprietário de 5 GHz — não pelo Bluetooth padrão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搭载 H2 芯片的 AirPods 只有配合 Apple Vision Pro 才能无线获得无损，走的是专有的 5 GHz 连接，而不是标准蓝牙。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搭載 H2 晶片的 AirPods 只有搭配 Apple Vision Pro 才能無線取得無損，走的是專屬的 5 GHz 連線，而不是標準藍牙。"
          }
        }
      }
    },
