            "state": "translated",
            "value": "Agrupa las variantes deluxe, remaster y explicit en un solo álbum"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regroupe les variantes deluxe, remaster et explicit en un seul album"
          }
        },
        "it": {
