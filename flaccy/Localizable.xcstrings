    "Recap notifications are generated on this device from your local play history, with a shareable Year in Music story.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rückblick-Mitteilungen entstehen auf diesem Gerät aus deinem lokalen Wiedergabeverlauf – inklusive teilbarer Musikjahr-Story."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones de resumen se generan en este dispositivo con tu historial local, e incluyen una historia del Año en música para compartir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications de récap sont générées sur cet appareil à partir de votre historique local, avec une story Année en musique à partager."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche del riepilogo vengono generate su questo dispositivo dalla tua cronologia locale, con una storia dell'Anno in musica da condividere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リキャップ通知は端末内の再生履歴からこのデバイスで生成され、共有できる音楽の1年のストーリーも付きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리캡 알림은 이 기기의 재생 기록으로 생성되며, 공유할 수 있는 음악 결산 스토리도 함께 제공됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações da retrospectiva são geradas neste dispositivo a partir do seu histórico local, com um story do Ano em música para compartilhar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回顾通知在本机根据你的播放记录生成，并附带可分享的年度音乐故事。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回顧通知會在這部裝置上、依你本機的播放記錄產生，並附上可分享的年度音樂故事。"
          }
        }
      }
    },
