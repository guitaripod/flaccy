    "Your purchase is awaiting approval. Playback unlocks automatically once it completes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kauf wartet auf Freigabe. Die Wiedergabe wird automatisch freigeschaltet, sobald er abgeschlossen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compra está pendiente de aprobación. La reproducción se desbloqueará automáticamente en cuanto se complete."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre achat est en attente d'approbation. La lecture se débloquera automatiquement une fois terminé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo acquisto è in attesa di approvazione. La riproduzione si sbloccherà da sola quando sarà completato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入の承認待ちです。完了すると再生は自動的にアンロックされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구입이 승인 대기 중입니다. 완료되면 재생이 자동으로 잠금 해제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua compra está aguardando aprovação. A reprodução será liberada automaticamente assim que ela for concluída."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的购买正在等待批准。完成后播放会自动解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的購買正在等待核准。完成後播放會自動解鎖。"
          }
        }
      }
    },
    "Your stats now include your full listening history.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Statistiken enthalten jetzt deinen kompletten Hörverlauf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus estadísticas ya incluyen todo tu historial de escucha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos statistiques incluent désormais tout votre historique d'écoute."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue statistiche ora includono tutta la cronologia di ascolto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "統計にこれまでの再生履歴がすべて反映されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 통계에 전체 감상 기록이 포함됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
