            "value": "你的统计现在包含完整的收听记录了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的統計現在包含完整的聆聽記錄了。"
          }
        }
      }
    },
    "Your story is just getting started.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Geschichte fängt gerade erst an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu historia no ha hecho más que empezar."
