    "A handful of artists own your heart.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Handvoll Interpreten hat dein Herz erobert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un puñado de artistas se ha adueñado de tu corazón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une poignée d'artistes règne sur votre cœur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una manciata di artisti ti ha rubato il cuore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひと握りのアーティストがあなたの心をつかんでいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몇몇 아티스트가 당신의 마음을 사로잡았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um punhado de artistas tomou conta do seu coração."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "少数几位艺人占据了你的心。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "少數幾位演出者佔據了你的心。"
          }
        }
      }
    },
    "A shareable recap built from your local play history.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein teilbarer Rückblick aus deinem lokalen Wiedergabeverlauf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un resumen para compartir, hecho con tu historial de reproducción local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un récap à partager, construit à partir de votre historique local."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un riepilogo da condividere, costruito sulla tua cronologia di ascolto locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末内の再生履歴から作られる、共有できるリキャップ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에 저장된 재생 기록으로 만든, 공유할 수 있는 리캡."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma retrospectiva para compartilhar, feita com o seu histórico local de reproduções."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用本机播放记录生成、可以分享的回顾。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用本機播放記錄產生、可以分享的回顧。"
          }
        }
      }
    },
    "A whole month of listening, wrapped up and ready.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein ganzer Monat Musik – zusammengefasst und bereit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mes entero de música, resumido y listo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mois entier d'écoute, résumé et prêt à partager."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mese intero di ascolti, riassunto e pronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひと月分の音楽を、まるごとまとめました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 달 치 음악을 한눈에 정리했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um mês inteiro de música, resumido e pronto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整整一个月的收听，已经打包好了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "整整一個月的聆聽，已經打包好了。"
          }
        }
      }
    },
    "A yearly Year in Music drop is always scheduled for December 1st while notifications are on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange Mitteilungen aktiv sind, kommt dein Musikjahr immer am 1. Dezember."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras las notificaciones estén activadas, tu Año en música llega siempre el 1 de diciembre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que les notifications sont activées, votre Année en musique arrive toujours le 1er décembre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finché le notifiche sono attive, il tuo Anno in musica arriva sempre il 1° dicembre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知がオンの間、音楽の1年は毎年12月1日に届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 켜져 있는 동안 음악 결산은 매년 12월 1일에 도착합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto as notificações estiverem ativadas, seu Ano em música chega sempre em 1º de dezembro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只要通知保持开启，年度音乐总会在 12 月 1 日送达。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只要通知保持開啟，年度音樂一律會在 12 月 1 日送達。"
          }
        }
      }
    },
