    "The audio file will be moved to the Trash and removed from your library.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Audiodatei wandert in den Papierkorb und wird aus deiner Mediathek entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo de audio se moverá a la papelera y se eliminará de tu biblioteca."
