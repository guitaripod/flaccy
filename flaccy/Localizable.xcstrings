    "Storing AAC 256 instead of FLAC loses nothing audible over AirPods and saves roughly 60% storage.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AAC 256 statt FLAC zu speichern kostet über AirPods nichts Hörbares und spart rund 60 % Speicher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar AAC 256 en lugar de FLAC no pierde nada audible con AirPods y ahorra alrededor de un 60 % de espacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stocker de l'AAC 256 au lieu du FLAC ne coûte rien d'audible via AirPods et économise environ 60 % de stockage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvare AAC 256 invece del FLAC non toglie nulla di udibile con gli AirPods e fa risparmiare circa il 60% di spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FLACの代わりにAAC 256で保存しても、AirPodsで聴こえる違いはなく、容量はおよそ60%節約できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "FLAC 대신 AAC 256으로 저장해도 AirPods에서 들리는 차이는 없고 저장 공간은 약 60% 절약됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar AAC 256 em vez de FLAC não perde nada audível pelos AirPods e economiza cerca de 60% de armazenamento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 AAC 256 代替 FLAC 存储，通过 AirPods 听不出差别，却能省下约 60% 的空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改存 AAC 256 而不是 FLAC，透過 AirPods 聽不出任何差別，卻能省下約 60% 的儲存空間。"
          }
        }
      }
    },
