    "No listening history yet.\nPlay something, or import your\nLast.fm history above.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Hörverlauf.\nSpiele etwas ab oder importiere oben\ndeinen Last.fm-Verlauf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay historial de escucha.\nReproduce algo o importa tu\nhistorial de Last.fm arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun historique d'écoute.\nLancez un morceau, ou importez votre\nhistorique Last.fm ci-dessus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna cronologia di ascolto.\nAscolta qualcosa oppure importa la tua\ncronologia Last.fm qui sopra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生履歴がまだありません。\n何か再生するか、上のボタンで\nLast.fmの履歴をインポートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 감상 기록이 없습니다.\n무언가를 재생하거나 위에서\nLast.fm 기록을 가져오세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum histórico de audição ainda.\nToque alguma coisa, ou importe seu\nhistórico do Last.fm acima."
