{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy scanner den QR-kode, din Flaccy Server viser, så du ikke skal skrive dens adresse og nøgle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy scannt den QR-Code, den dein Flaccy Server ausgibt, damit du dessen Adresse und Schlüssel nicht eintippen musst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy scans the QR code your Flaccy Server prints, so you don't have to type its address and key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy escanea el código QR que imprime tu Flaccy Server, para que no tengas que escribir su dirección ni su clave."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy skannaa Flaccy-palvelimen tulostaman QR-koodin, joten osoitetta ja avainta ei tarvitse kirjoittaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy scanne le code QR affiché par ton Flaccy Server, pour que tu n’aies pas à saisir son adresse ni sa clé."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy skannar QR-kóðann sem Flaccy-netþjónninn birtir, svo þú þurfir ekki að slá inn vistfang og lykil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy inquadra il codice QR stampato dal tuo Flaccy Server, così non devi digitarne l’indirizzo e la chiave."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy は Flaccy Server が表示する QR コードをスキャンするので、アドレスとキーを入力する必要はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy가 Flaccy Server가 출력한 QR 코드를 스캔하므로 서버 주소와 키를 직접 입력할 필요가 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy skanner QR-koden som Flaccy Server viser, så du slipper å skrive inn adressen og nøkkelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy skanuje kod QR wydrukowany przez Twój serwer Flaccy, dzięki czemu nie musisz wpisywać jego adresu i klucza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Flaccy escaneia o código QR que o seu Flaccy Server imprime, para você não precisar digitar o endereço e a chave dele."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy skannar QR-koden som din Flaccy Server skriver ut, så att du inte behöver skriva in adressen och nyckeln."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 会扫描 Flaccy Server 打印的 QR 码，因此你无需输入它的地址和密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 會掃描 Flaccy Server 印出的 QR 碼，因此你不必輸入它的位址和金鑰。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy forbinder sig til musikserveren på dit hjemmenetværk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy verbindet sich mit dem Musikserver in deinem Heimnetzwerk."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy connects to the music server on your home network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy se conecta al servidor de música de tu red doméstica."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy yhdistää kotiverkkosi musiikkipalvelimeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy se connecte au serveur de musique de ton réseau domestique."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy tengist tónlistarnetþjóninum á heimanetinu þínu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy si connette al server musicale della tua rete domestica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy はホームネットワーク上のミュージックサーバーに接続します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy가 홈 네트워크의 음악 서버에 연결합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy kobler seg til musikkserveren i hjemmenettverket ditt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy łączy się z serwerem muzyki w Twojej sieci domowej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Flaccy se conecta ao servidor de música da sua rede doméstica."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy ansluter till musikservern i ditt hemnätverk."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 会连接到你家庭网络中的音乐服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 會連線到你家用網路中的音樂伺服器。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy gemmer de sangtekst-videoer og -kort, du laver, i dit fotobibliotek, når du vælger Gem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy speichert die Songtext-Videos und -Karten, die du erstellst, in deiner Fotomediathek, wenn du „Sichern“ wählst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy saves the lyric videos and cards you make to your photo library when you choose Save."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy guarda en tu fototeca los videos y tarjetas con letra que creas cuando eliges Guardar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy tallentaa tekemäsi sanoitusvideot ja -kortit kuvakirjastoosi, kun valitset Tallenna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy enregistre dans votre photothèque les vidéos et cartes de paroles que vous créez lorsque vous choisissez Enregistrer."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy vistar textamyndböndin og textakortin sem þú býrð til í myndasafnið þitt þegar þú velur „Vista“."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy salva nella tua libreria foto i video e le schede con i testi che crei quando scegli Salva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成した歌詞の動画やカードは、「保存」を選ぶと写真ライブラリに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“저장”을 선택하면 만든 가사 동영상과 카드를 사진 보관함에 저장합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy lagrer sangtekstvideoene og -kortene du lager i bildebiblioteket ditt når du velger «Lagre»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy zapisuje utworzone wideo i karty z tekstem w Twojej bibliotece zdjęć, gdy wybierzesz Zapisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Flaccy salva na sua biblioteca de fotos os vídeos e cartões de letra que você criar quando escolher Salvar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy sparar de låttextvideor och kort du skapar i ditt fotobibliotek när du väljer Spara."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当你选择“存储”时，Flaccy 会把你制作的歌词视频和卡片保存到照片图库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當你選擇「儲存」時，Flaccy 會將你製作的歌詞影片和卡片存入照片圖庫。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
