        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リスニングクロック。ピークは%1$lld時台、%2$lld回再生。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감상 시계. 최다 시간대 %1$lld시, %2$lld회 재생."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zegar odsłuchań. Godzina szczytu: %1$lld, %2$#@arg2@."
          },
          "substitutions": {
            "arg2": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "few": {
