    "Your Watch hasn’t answered yet. Open Flaccy on the Watch to wake it up.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uret har ikke svaret endnu. Åbn Flaccy på uret for at vække det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Watch hat noch nicht geantwortet. Öffne Flaccy auf der Watch, um sie aufzuwecken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Watch aún no ha respondido. Abre Flaccy en el Watch para despertarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kellosi ei ole vielä vastannut. Avaa Flaccy kellossa, niin se herää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta Watch n’a pas encore répondu. Ouvre Flaccy sur la Watch pour la réveiller."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Úrið þitt hefur ekki svarað enn. Opnaðu Flaccy á úrinu til að vekja það."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo Watch non ha ancora risposto. Apri Flaccy sul Watch per svegliarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Watchからまだ応答がありません。Watchで Flaccy を開いて起こしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch가 아직 응답하지 않습니다. Watch에서 Flaccy를 열어 깨우세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klokken har ikke svart ennå. Åpne Flaccy på klokken for å vekke den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch jeszcze nie odpowiedział. Otwórz Flaccy na Watchu, aby go obudzić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu Watch ainda não respondeu. Abra o Flaccy no Watch para acordá-lo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din klocka har inte svarat än. Öppna Flaccy på klockan för att väcka den."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch 尚未响应。请在 Watch 上打开 Flaccy 将其唤醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch 尚未回應。請在 Watch 上打開 Flaccy 將其喚醒。"
          }
        }
      }
    },
    "Your Watch hasn’t answered yet. Raise your wrist or open Flaccy on it.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uret har ikke svaret endnu. Løft håndleddet, eller åbn Flaccy på det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Watch hat noch nicht geantwortet. Hebe dein Handgelenk oder öffne Flaccy darauf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Watch aún no ha respondido. Levanta la muñeca o abre Flaccy en él."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kellosi ei ole vielä vastannut. Nosta ranne tai avaa Flaccy siinä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta Watch n’a pas encore répondu. Lève le poignet ou ouvre Flaccy dessus."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Úrið þitt hefur ekki svarað enn. Lyftu úlnliðnum eða opnaðu Flaccy á því."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo Watch non ha ancora risposto. Alza il polso o apri Flaccy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Watchからまだ応答がありません。手首を上げるか、Watchで Flaccy を開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch가 아직 응답하지 않습니다. 손목을 들거나 Watch에서 Flaccy를 여세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klokken har ikke svart ennå. Løft håndleddet eller åpne Flaccy på den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch jeszcze nie odpowiedział. Unieś nadgarstek lub otwórz na nim Flaccy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu Watch ainda não respondeu. Levante o pulso ou abra o Flaccy nele."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din klocka har inte svarat än. Lyft handleden eller öppna Flaccy på den."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch 尚未响应。抬起手腕或在 Watch 上打开 Flaccy。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch 尚未回應。抬起手腕或在 Watch 上打開 Flaccy。"
          }
        }
      }
    },
    "Your Watch isn’t nearby, is asleep, or Flaccy isn’t open on it. Raise your wrist or open Flaccy on the Watch.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uret er ikke i nærheden, sover, eller Flaccy er ikke åbnet på det. Løft håndleddet, eller åbn Flaccy på uret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Watch ist nicht in der Nähe, schläft oder Flaccy ist darauf nicht geöffnet. Hebe dein Handgelenk oder öffne Flaccy auf der Watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Watch no está cerca, está dormido o Flaccy no está abierto en él. Levanta la muñeca o abre Flaccy en el Watch."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kellosi ei ole lähellä, se nukkuu tai Flaccy ei ole auki siinä. Nosta ranne tai avaa Flaccy kellossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta Watch n’est pas à proximité, est en veille, ou Flaccy n’y est pas ouvert. Lève le poignet ou ouvre Flaccy sur la Watch."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Úrið þitt er ekki nálægt, er í svefnham eða Flaccy er ekki opið á því. Lyftu úlnliðnum eða opnaðu Flaccy á úrinu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo Watch non è vicino, è in stop o Flaccy non è aperto. Alza il polso o apri Flaccy sul Watch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Watchが近くにないか、スリープ中か、Flaccyが開いていません。手首を上げるか、Watchで Flaccy を開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch가 가까이 없거나 잠자고 있거나 Flaccy가 열려 있지 않습니다. 손목을 들거나 Watch에서 Flaccy를 여세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klokken er ikke i nærheten, den sover, eller Flaccy er ikke åpen på den. Løft håndleddet eller åpne Flaccy på klokken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch nie jest w pobliżu, śpi albo Flaccy nie jest na nim otwarte. Unieś nadgarstek lub otwórz Flaccy na Watchu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu Watch não está por perto, está em repouso ou o Flaccy não está aberto nele. Levante o pulso ou abra o Flaccy no Watch."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din klocka är inte i närheten, sover eller så är Flaccy inte öppet på den. Lyft handleden eller öppna Flaccy på klockan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch 不在附近、处于休眠状态，或未打开 Flaccy。抬起手腕或在 Watch 上打开 Flaccy。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch 不在附近、處於休眠狀態，或未打開 Flaccy。抬起手腕或在 Watch 上打開 Flaccy。"
          }
        }
      }
    },
