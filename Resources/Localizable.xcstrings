    "No songs yet. Right-click any song and choose Add to Playlist.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Titel. Klicke mit rechts auf einen Titel und wähle „Zur Playlist hinzufügen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay canciones. Haz clic derecho en cualquier canción y elige “Añadir a una playlist”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun morceau pour l’instant. Faites un clic droit sur un morceau et choisissez « Ajouter à une playlist »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun brano per ora. Fai clic destro su un brano e scegli “Aggiungi a playlist”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ曲がありません。曲を右クリックして「プレイリストに追加」を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 곡이 없습니다. 곡을 마우스 오른쪽 버튼으로 클릭하고 “재생목록에 추가”를 선택하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma jeszcze utworów. Kliknij dowolny utwór prawym przyciskiem i wybierz Dodaj do playlisty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma música ainda. Clique com o botão direito em qualquer música e escolha “Adicionar à playlist”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有歌曲。右键点按任意歌曲并选择“添加到播放列表”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有歌曲。在任一首歌曲上按右鍵並選擇「加入播放列表」。"
          }
        }
      }
    },
