    "Your Year in Music": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Musikjahr"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Año en música"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Année en musique"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo Anno in musica"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの音楽の1年"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나의 음악 결산"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój Rok w muzyce"
          }
        },
        "pt-BR": {
          "stringUnit": {
