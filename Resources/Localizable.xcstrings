    },
    "That isn’t a profile Flaccy can read. It understands Equalizer APO and AutoEq text.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist kein Profil, das Flaccy lesen kann. Flaccy versteht Equalizer-APO- und AutoEq-Text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese no es un perfil que Flaccy pueda leer. Entiende texto de Equalizer APO y AutoEq."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n’est pas un profil que Flaccy peut lire. Il comprend le texte Equalizer APO et AutoEq."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è un profilo che Flaccy può leggere. Riconosce i testi di Equalizer APO e AutoEq."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccyで読み込める形式のプロファイルではありません。Flaccyが理解できるのはEqualizer APOとAutoEqのテキストです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy가 읽을 수 있는 프로파일이 아닙니다. Flaccy는 Equalizer APO와 AutoEq 텍스트를 이해합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nie jest profil, który Flaccy potrafi odczytać. Rozumie tekst Equalizer APO i AutoEq."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse não é um perfil que o Flaccy consegue ler. Ele entende texto do Equalizer APO e do AutoEq."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是 Flaccy 能读取的配置文件。它只识别 Equalizer APO 和 AutoEq 格式的文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這不是 Flaccy 能讀取的設定檔。它只看得懂 Equalizer APO 與 AutoEq 格式的文字。"
          }
        }
      }
    },
    "The App Store couldn't verify this purchase. Try again, or choose Restore Purchases.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store konnte diesen Kauf nicht überprüfen. Versuche es erneut oder tippe auf „Käufe wiederherstellen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store no ha podido verificar esta compra. Inténtalo de nuevo o toca «Restaurar compras»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'App Store n'a pas pu vérifier cet achat. Réessayez ou touchez « Restaurer les achats »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'App Store non ha potuto verificare questo acquisto. Riprova oppure scegli «Ripristina acquisti»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeはこの購入を確認できませんでした。もう一度お試しいただくか、購入を復元を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store에서 이 구입을 확인할 수 없습니다. 다시 시도하거나 \"구입 복원\"을 선택하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store nie mógł zweryfikować tego zakupu. Spróbuj ponownie lub wybierz „Przywróć zakupy”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A App Store não conseguiu verificar esta compra. Tente novamente ou toque em “Restaurar compras”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 无法验证此购买。请重试或选择恢复购买。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 無法驗證此購買。請再試一次，或選擇「回復購買項目」。"
          }
        }
      }
    },
