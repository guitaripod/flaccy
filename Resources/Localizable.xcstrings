          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En utgang du kobler til vises her når den har lagret en profil."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podłączone wyjście pojawi się tutaj, gdy zapamięta profil."
