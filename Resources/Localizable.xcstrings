    },
    "Your Apple Watch is ready. Choose an album to send": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Apple Watch ist bereit. Wähle ein Album zum Senden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Apple Watch está listo. Elige un álbum para enviar"
          }
        },
        "fr": {
          "stringUnit": {
