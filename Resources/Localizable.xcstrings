    "Music transfers in the background — you can leave this screen or lock your phone. Each track is re-sent until your Apple Watch confirms it arrived.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Musikken overføres i baggrunden – du kan forlade denne skærm eller låse din telefon. Hver sang sendes igen, indtil dit Apple Watch bekræfter modtagelsen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übertragung läuft im Hintergrund – du kannst diesen Bildschirm verlassen oder dein iPhone sperren. Jeder Titel wird erneut gesendet, bis deine Apple Watch den Empfang bestätigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transferencia va en segundo plano: puedes salir de esta pantalla o bloquear el iPhone. Cada pista se reenvía hasta que tu Apple Watch confirma que llegó."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Musiikki siirtyy taustalla. Voit poistua tältä näytöltä tai lukita puhelimen. Jokainen kappale lähetetään uudelleen, kunnes Apple Watch vahvistaa, että se on saapunut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le transfert se fait en arrière-plan — vous pouvez quitter cet écran ou verrouiller votre iPhone. Chaque morceau est renvoyé jusqu'à ce que votre Apple Watch confirme sa réception."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tónlist flyst í bakgrunni – þú getur yfirgefið þennan skjá eða læst símanum. Hvert lag er sent aftur þar til Apple Watch staðfestir móttöku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il trasferimento avviene in background: puoi uscire da questa schermata o bloccare l'iPhone. Ogni brano viene rinviato finché l'Apple Watch non conferma di averlo ricevuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "転送はバックグラウンドで進みます。この画面を離れても、iPhoneをロックしても大丈夫です。各曲はApple Watchが受信を確認するまで再送されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송은 백그라운드에서 진행됩니다 — 이 화면을 벗어나거나 iPhone을 잠가도 됩니다. 각 트랙은 Apple Watch가 수신을 확인할 때까지 다시 전송됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Musikk overføres i bakgrunnen – du kan forlate denne skjermen eller låse telefonen. Hver sang sendes på nytt inntil Apple Watch bekrefter at den er mottatt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Muzyka przesyła się w tle — możesz opuścić ten ekran lub zablokować telefon. Każdy utwór jest wysyłany ponownie, aż Apple Watch potwierdzi odbiór."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transferência acontece em segundo plano — você pode sair desta tela ou bloquear o iPhone. Cada faixa é reenviada até o Apple Watch confirmar que chegou."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Musiken överförs i bakgrunden. Du kan lämna skärmen eller låsa telefonen. Varje låt skickas igen tills din Apple Watch bekräftar att den har tagits emot."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "传输在后台进行——你可以离开此界面或锁定 iPhone。每首曲目都会重复发送，直到 Apple Watch 确认收到。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳輸會在背景進行——你可以離開這個畫面或鎖定 iPhone。每首曲目都會重送，直到 Apple Watch 確認收到為止。"
          }
        }
      }
    },
