    "Renews yearly. Cancel anytime.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fornyes årligt. Annuller når som helst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlängert sich jährlich. Jederzeit kündbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renueva cada año. Cancela cuando quieras."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uusiutuu vuosittain. Peruuta milloin tahansa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
