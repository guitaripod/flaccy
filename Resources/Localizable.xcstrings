            "value": "Stream fra Flaccy Server, Navidrome eller en anden Subsonic-server."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streame von Flaccy Server, Navidrome oder einem anderen Subsonic-Server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
