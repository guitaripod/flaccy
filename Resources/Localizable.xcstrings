    "lost the connection. Is Flaccy still open on your iPad?": {
      "comment": "Wi-Fi Transfer web page: after a file's name",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "mistede forbindelsen. Er Flaccy stadig åben på din iPad?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung verloren. Ist Flaccy auf deinem iPad noch geöffnet?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "se perdió la conexión. ¿Sigue Flaccy abierta en tu iPad?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "yhteys katkesi. Onko Flaccy yhä auki iPadissasi?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "connexion perdue. Flaccy est-il toujours ouvert sur votre iPad ?"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "sambandið rofnaði. Er Flaccy enn opið á iPad-inum þínum?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "connessione persa. Flaccy è ancora aperto sul tuo iPad?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続が切れました。iPadでFlaccyが開いたままになっていますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결이 끊어졌습니다. iPad에서 Flaccy가 아직 열려 있나요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "mistet forbindelsen. Er Flaccy fortsatt åpen på iPaden din?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "utracono połączenie. Czy Flaccy jest nadal otwarty na iPadzie?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "a conexão caiu. O Flaccy ainda está aberto no seu iPad?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "anslutningen bröts. Är Flaccy fortfarande öppet på din iPad?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接已断开。iPad 上的 Flaccy 还开着吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線已中斷。iPad 上的 Flaccy 還開著嗎？"
          }
        }
      }
    },
