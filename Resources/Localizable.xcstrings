    "Something unexpected went wrong. Try again, and if it keeps happening, check that %@ is running Flaccy Server.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Noget uventet gik galt. Prøv igen, og hvis det fortsætter, så kontrollér, at %@ kører Flaccy Server."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas Unerwartetes ist schiefgelaufen. Erneut versuchen, und falls es weiter passiert, prüfen, ob auf %@ Flaccy Server läuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something unexpected went wrong. Try again, and if it keeps happening, check that %@ is running Flaccy Server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo inesperado salió mal. Vuelve a intentarlo y, si sigue pasando, comprueba que %@ esté ejecutando Flaccy Server."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jotain odottamatonta tapahtui. Yritä uudelleen, ja jos ongelma jatkuu, tarkista, että %@ on käynnissä Flaccy Server."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une erreur inattendue s’est produite. Réessayez et, si cela persiste, vérifiez que %@ exécute Flaccy Server."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Eitthvað óvænt fór úrskeiðis. Reyndu aftur og ef það endurtekur sig, athugaðu hvort %@ sé með Flaccy Server í gangi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si è verificato un errore imprevisto. Riprova e, se continua, verifica che %@ esegua Flaccy Server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予期しないエラーが発生しました。もう一度お試しください。繰り返し発生する場合は、%@ で Flaccy Server が実行されているか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예기치 않은 문제가 발생했어요. 다시 시도해 보시고, 계속되면 %@에서 Flaccy Server가 실행 중인지 확인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noe uventet gikk galt. Prøv igjen, og hvis det fortsetter, sjekk at %@ kjører Flaccy Server."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wystąpił nieoczekiwany błąd. Spróbuj ponownie, a jeśli to się powtarza, sprawdź, czy na: %@ działa Flaccy Server."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo inesperado aconteceu. Tente de novo e, se continuar, confira se %@ está executando o Flaccy Server."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Något oväntat gick fel. Försök igen. Om det fortsätter, kontrollera att %@ kör Flaccy Server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出现了意外错误。请重试；如果问题持续，请检查 %@ 上是否正在运行 Flaccy Server。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發生了未預期的錯誤。請重試；如果問題持續，請檢查 %@ 上是否正在執行 Flaccy Server。"
          }
        }
      }
    },
