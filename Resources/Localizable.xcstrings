          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch jest gotowy. Wybierz album do wysłania"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu Apple Watch está pronto. Escolha um álbum para enviar"
          }
        },
        "zh-Hans": {
