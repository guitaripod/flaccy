        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy는 음악 폴더를 제자리에서 색인하므로, 보관함에서 제거하면 원본 파일이 휴지통으로 이동합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy indekserer musikkmappen din der den ligger, så når du fjerner noe fra biblioteket, flyttes originalfilene til papirkurven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy indeksuje twój folder z muzyką w miejscu, więc usunięcie z biblioteki przenosi oryginalne pliki do Kosza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Flaccy indexa sua pasta de música onde ela está, então remover da biblioteca move os arquivos originais para o Lixo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy indexerar din musikmapp på plats, så när du tar bort något från biblioteket flyttas originalfilerna till Papperskorgen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 会就地为音乐文件夹建立索引，因此从资料库中移除时，原始文件会被移到废纸篓。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 會就地為音樂資料夾建立索引，因此從資料庫移除時，原始檔案會被移到垃圾桶。"
          }
        }
      }
    },
    "Flaccy lists one copy of each song. Tap a copy to play it, or swipe to delete the ones you don't need.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy viser hver sang kun én gang. Tryk på en kopi for at afspille den, eller stryg for at slette dem, du ikke har brug for."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy zeigt jeden Song nur einmal. Tippe auf eine Kopie, um sie abzuspielen, oder wische, um die nicht benötigten zu löschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy lists one copy of each song. Tap a copy to play it, or swipe to delete the ones you don't need."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy muestra una copia de cada canción. Toca una copia para reproducirla o desliza para eliminar las que no necesites."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy näyttää kustakin kappaleesta vain yhden kopion. Napauta kopiota toistaaksesi sen tai pyyhkäise poistaaksesi tarpeettomat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy affiche une seule copie de chaque morceau. Touche une copie pour la lire, ou balaie pour supprimer celles dont tu n'as pas besoin."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy sýnir eitt eintak af hverju lagi. Pikkaðu á eintak til að spila það, eða strjúktu til að eyða þeim sem þú þarft ekki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy mostra una copia di ogni brano. Tocca una copia per riprodurla o scorri per eliminare quelle che non ti servono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccyは各曲を1つだけ表示します。コピーをタップして再生、またはスワイプして不要なものを削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy는 각 곡을 하나씩만 표시합니다. 복사본을 탭하여 재생하거나 스와이프하여 필요 없는 복사본을 삭제하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy viser én kopi av hver sang. Trykk på en kopi for å spille den av, eller sveip for å slette de du ikke trenger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy pokazuje jedną kopię każdego utworu. Stuknij kopię, aby ją odtworzyć, lub przesuń palcem, aby usunąć niepotrzebne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Flaccy lista uma cópia de cada música. Toque em uma cópia para tocá-la ou deslize para apagar as que você não precisa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy visar en kopia av varje låt. Tryck på en kopia för att spela den, eller svep för att radera de du inte behöver."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 每首歌只列出一份。点按某个副本即可播放，或滑动删除不需要的副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 每首歌只列出一份。輕點某個副本即可播放，或滑動刪除不需要的副本。"
          }
        }
      }
    },
    "Flaccy needs Apple Music access to use its artwork.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy har brug for adgang til Apple Music for at bruge dets coverbilleder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy benötigt Zugriff auf Apple Music, um dessen Cover zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy necesita acceso a Apple Music para usar sus carátulas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy tarvitsee Apple Music -käyttöoikeuden, jotta se voi käyttää sen kansikuvia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy a besoin d'accéder à Apple Music pour utiliser ses pochettes."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy þarf aðgang að Apple Music til að nota umslögin þeirra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy ha bisogno di accedere ad Apple Music per usare le sue copertine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccyがそのアートワークを使うには、Apple Musicへのアクセスが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy가 아트워크를 사용하려면 Apple Music 접근 권한이 필요합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy trenger tilgang til Apple Music for å bruke omslagene deres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy potrzebuje dostępu do Apple Music, aby korzystać z jego okładek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Flaccy precisa de acesso ao Apple Music para usar suas capas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy behöver åtkomst till Apple Music för att använda dess omslag."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 需要访问 Apple Music 才能使用其封面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 需要存取 Apple Music 才能使用其封面。"
          }
        }
      }
    },
    "Flaccy plays FLAC, ALAC, MP3, AAC, WAV and AIFF files, and found none in this folder or the folders inside it. Choose the folder your music is in. Music from the Music app is in Music › Music › Media.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy spiller FLAC-, ALAC-, MP3-, AAC-, WAV- og AIFF-filer, men har ikke fundet nogen i denne mappe eller i undermapperne. Vælg den mappe, din musik ligger i. Musik fra Musik-appen ligger under Musik › Musik › Medier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy spielt FLAC-, ALAC-, MP3-, AAC-, WAV- und AIFF-Dateien ab, hat in diesem Ordner und seinen Unterordnern aber keine gefunden. Wähle den Ordner, in dem deine Musik liegt. Musik aus der Music-App liegt unter Music › Music › Media."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy plays FLAC, ALAC, MP3, AAC, WAV and AIFF files, and found none in this folder or the folders inside it. Choose the folder your music is in. Music from the Music app is in Music › Music › Media."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy reproduce archivos FLAC, ALAC, MP3, AAC, WAV y AIFF, pero no encontró ninguno en esta carpeta ni en las carpetas que contiene. Elige la carpeta donde está tu música. La música de la app Music está en Music › Music › Media."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy toistaa FLAC-, ALAC-, MP3-, AAC-, WAV- ja AIFF-tiedostoja, mutta ei löytänyt yhtään tästä kansiosta eikä sen alikansioista. Valitse kansio, jossa musiikkisi on. Musiikki Music-sovelluksesta löytyy kohdasta Music › Music › Media."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy lit les fichiers FLAC, ALAC, MP3, AAC, WAV et AIFF, mais n’en a trouvé aucun dans ce dossier ni dans ses sous-dossiers. Choisissez le dossier où se trouve votre musique. La musique de l’app Music se trouve dans Music › Music › Media."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy spilar FLAC-, ALAC-, MP3-, AAC-, WAV- og AIFF-skrár, en fann engar í þessari möppu eða í möppunum inni í henni. Veldu möppuna sem tónlistin þín er í. Tónlist úr Tónlist-appinu er í Music › Music › Media."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy riproduce file FLAC, ALAC, MP3, AAC, WAV e AIFF, ma in questa cartella e nelle cartelle al suo interno non ne ha trovato nessuno. Scegli la cartella in cui si trova la tua musica. La musica dell’app Music si trova in Music › Music › Media."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy は FLAC、ALAC、MP3、AAC、WAV、AIFF を再生しますが、このフォルダとその中のフォルダには対象ファイルが見つかりませんでした。音楽が入っているフォルダを選んでください。Music アプリの音楽は Music › Music › Media にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy는 FLAC, ALAC, MP3, AAC, WAV, AIFF 파일을 재생하지만 이 폴더와 그 안의 폴더에서는 하나도 찾지 못했습니다. 음악이 들어 있는 폴더를 선택하세요. Music 앱의 음악은 Music › Music › Media에 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy spiller av FLAC-, ALAC-, MP3-, AAC-, WAV- og AIFF-filer, men fant ingen i denne mappen eller i undermappene. Velg mappen musikken din ligger i. Musikk fra Musikk-appen ligger under Musikk › Musikk › Media."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy odtwarza pliki FLAC, ALAC, MP3, AAC, WAV i AIFF, ale nie znalazł żadnego w tym folderze ani w folderach w nim. Wybierz folder, w którym jest twoja muzyka. Muzyka z aplikacji Music znajduje się w Music › Music › Media."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Flaccy toca arquivos FLAC, ALAC, MP3, AAC, WAV e AIFF, mas não encontrou nenhum nesta pasta nem nas pastas dentro dela. Escolha a pasta onde está sua música. A música do app Music está em Music › Music › Media."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy spelar upp FLAC-, ALAC-, MP3-, AAC-, WAV- och AIFF-filer, men hittade inga i den här mappen eller i mapparna inuti den. Välj mappen där din musik finns. Musik från appen Musik finns i Music › Music › Media."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 可以播放 FLAC、ALAC、MP3、AAC、WAV 和 AIFF 文件，但在此文件夹及其子文件夹中没有找到任何此类文件。请选择存放音乐的文件夹。Music App 中的音乐位于 Music › Music › Media。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 可以播放 FLAC、ALAC、MP3、AAC、WAV 和 AIFF 檔案，但在此資料夾及其子資料夾中沒有找到任何此類檔案。請選擇存放音樂的資料夾。Music App 中的音樂位於 Music › Music › Media。"
          }
        }
      }
    },
    "Flaccy plays music files you own: FLAC, ALAC, MP3, AAC, WAV and AIFF. Where is yours?": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy afspiller musikfiler, du ejer: FLAC, ALAC, MP3, AAC, WAV og AIFF. Hvor er dine?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy spielt Musikdateien ab, die dir gehören: FLAC, ALAC, MP3, AAC, WAV und AIFF. Wo sind deine?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy reproduce los archivos de música que tienes: FLAC, ALAC, MP3, AAC, WAV y AIFF. ¿Dónde están los tuyos?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy toistaa omistamiasi musiikkitiedostoja: FLAC, ALAC, MP3, AAC, WAV ja AIFF. Missä sinun musiikkisi on?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy lit les fichiers musicaux que vous possédez : FLAC, ALAC, MP3, AAC, WAV et AIFF. Où sont les vôtres ?"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy spilar tónlistarskrár sem þú átt: FLAC, ALAC, MP3, AAC, WAV og AIFF. Hvar eru þínar?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy riproduce i file musicali che possiedi: FLAC, ALAC, MP3, AAC, WAV e AIFF. Dove sono i tuoi?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccyは、お持ちの音楽ファイル（FLAC、ALAC、MP3、AAC、WAV、AIFF）を再生します。音楽はどこにありますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy는 내가 소유한 음악 파일을 재생합니다: FLAC, ALAC, MP3, AAC, WAV, AIFF. 음악은 어디에 있나요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy spiller av musikkfiler du eier: FLAC, ALAC, MP3, AAC, WAV og AIFF. Hvor er dine?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy odtwarza pliki muzyczne, które posiadasz: FLAC, ALAC, MP3, AAC, WAV i AIFF. Gdzie są twoje?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Flaccy reproduz arquivos de música que você possui: FLAC, ALAC, MP3, AAC, WAV e AIFF. Onde estão os seus?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy spelar musikfiler du äger: FLAC, ALAC, MP3, AAC, WAV och AIFF. Var finns dina?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 播放你拥有的音乐文件：FLAC、ALAC、MP3、AAC、WAV 和 AIFF。你的音乐在哪里？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 播放你擁有的音樂檔案：FLAC、ALAC、MP3、AAC、WAV 和 AIFF。你的音樂在哪裡？"
          }
        }
      }
    },
    "Flaccy sends music to an Apple Watch that is paired with this iPhone.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy sender musik til en Apple Watch, der er parret med denne iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy sendet Musik an eine Apple Watch, die mit diesem iPhone gekoppelt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy envía música a un Apple Watch emparejado con este iPhone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy lähettää musiikkia Apple Watchiin, joka on pariliitetty tähän iPhoneen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy envoie de la musique à un Apple Watch associé à cet iPhone."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy sendir tónlist í Apple Watch sem er parað við þessum iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy invia musica a un Apple Watch associato a questo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccyは、このiPhoneとペアリングされたApple Watchに音楽を送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy는 이 iPhone과 페어링된 Apple Watch로 음악을 보냅니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy sender musikk til en Apple Watch som er koblet sammen med denne iPhone-en."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy wysyła muzykę na Apple Watcha sparowanego z tym iPhonem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Flaccy envia músicas para um Apple Watch pareado com este iPhone."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy skickar musik till en Apple Watch som är parkopplad med den här iPhonen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 会将音乐发送到与此 iPhone 配对的 Apple Watch。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 會將音樂傳送到與此 iPhone 配對的 Apple Watch。"
          }
        }
      }
    },
    "Flaccy sends music to its own app on your Apple Watch. Installing it takes about a minute.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy sender musik til sin egen app på din Apple Watch. Installationen tager ca. et minut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy sendet Musik an seine eigene App auf deiner Apple Watch. Die Installation dauert etwa eine Minute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy envía música a su propia app en tu Apple Watch. Instalarla tarda un minuto más o menos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy lähettää musiikkia omaan sovellukseensa Apple Watchissa. Asentaminen kestää noin minuutin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy envoie la musique à sa propre app sur ton Apple Watch. L’installation prend environ une minute."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy sendir tónlist í sitt eigið forrit á Apple Watch. Uppsetning tekur um eina mínútu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy invia la musica alla sua app sul tuo Apple Watch. L’installazione richiede circa un minuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccyは、Apple Watch上の専用Appに音楽を送信します。インストールには約1分かかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy는 Apple Watch의 자체 App으로 음악을 보냅니다. 설치에는 약 1분이 걸립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy sender musikk til sin egen app på Apple Watch-en din. Installasjonen tar omtrent ett minutt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy wysyła muzykę do własnej aplikacji na Apple Watchu. Instalacja trwa około minuty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Flaccy envia músicas para o próprio app no seu Apple Watch. A instalação leva cerca de um minuto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy skickar musik till sin egen app på din Apple Watch. Det tar cirka en minut att installera den."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 会将音乐发送到 Apple Watch 上的 Flaccy App。安装大约需要一分钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 會將音樂傳送到 Apple Watch 上的 Flaccy App。安裝大約需要一分鐘。"
          }
        }
      }
    },
    "Flaccy still isn’t on your Watch. Installing can take a minute, so try again shortly.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy er stadig ikke på dit ur. Installationen kan tage et minut, så prøv igen om lidt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy ist noch nicht auf deiner Watch. Die Installation kann eine Minute dauern, versuche es gleich noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy todavía no está en tu Watch. Instalarlo puede tardar un minuto, así que inténtalo de nuevo enseguida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy ei ole vielä kellossasi. Asentaminen voi kestää minuutin, joten yritä pian uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy n’est toujours pas sur ta Watch. L’installation peut prendre une minute, réessaie bientôt."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy er enn ekki á úrinu þínu. Uppsetning getur tekið eina mínútu, svo reyndu aftur eftir stutta stund."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy non è ancora sul tuo Watch. L’installazione può richiedere un minuto, riprova tra poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Watchにまだ Flaccy がありません。インストールには1分ほどかかることがあるので、少し待ってから再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch에 아직 Flaccy가 없습니다. 설치에 1분 정도 걸릴 수 있으니 잠시 후 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy er fortsatt ikke på klokken din. Installasjonen kan ta et minutt, så prøv igjen om litt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy nadal nie ma na Watchu. Instalacja może potrwać minutę, więc spróbuj ponownie za chwilę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Flaccy ainda não está no seu Watch. A instalação pode levar um minuto, então tente de novo em instantes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy finns fortfarande inte på klockan. Installationen kan ta en minut, så försök igen strax."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch 上还没有 Flaccy。安装可能需要一分钟，请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch 上還沒有 Flaccy。安裝可能需要一分鐘，請稍後再試。"
          }
        }
      }
    },
    "Flaccy's AI turns scrambled filenames into real titles, artists and albums.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccys AI gør kryptiske filnavne til rigtige titler, kunstnere og album."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccys KI macht aus kryptischen Dateinamen echte Titel, Interpreten und Alben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA de Flaccy convierte nombres de archivo enrevesados en títulos, artistas y álbumes de verdad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccyn tekoäly muuttaa sekavat tiedostonimet oikeiksi nimiksi, artisteiksi ja albumeiksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’IA de Flaccy transforme des noms de fichiers illisibles en vrais titres, artistes et albums."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Gervigreind Flaccy breytir ruglingsleg skráarheiti í alvöru titla, listamenn og plötur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’IA di Flaccy trasforma nomi di file incomprensibili in titoli, artisti e album veri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FlaccyのAIが、ぐちゃぐちゃなファイル名を本物のタイトル・アーティスト・アルバムに変えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy의 AI가 뒤죽박죽인 파일 이름을 진짜 제목, 아티스트, 앨범으로 바꿉니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccys KI gjør om kryptiske filnavn til ekte titler, artister og album."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Flaccy zamienia poplątane nazwy plików w prawdziwe tytuły, wykonawców i albumy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A IA do Flaccy transforma nomes de arquivo embaralhados em títulos, artistas e álbuns de verdade."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccys AI gör om virriga filnamn till riktiga titlar, artister och album."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 的 AI 把杂乱的文件名变成真正的标题、艺人和专辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 的 AI 把雜亂的檔案名稱變成真正的標題、演出者和專輯。"
          }
        }
      }
    },
