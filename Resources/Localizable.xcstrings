          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar de novo capas e datas de lançamento dos álbuns em que o Flaccy desistiu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为 Flaccy 放弃的专辑重新获取封面和发行日期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為 Flaccy 放棄的專輯重新取得封面和發行日期。"
          }
        }
      }
    },
    "Re-ripping the album to FLAC removes the seam for good.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du das Album erneut als FLAC rippst, verschwindet die Nahtstelle für immer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volver a extraer el álbum en FLAC elimina la unión para siempre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réextraire l'album en FLAC supprime définitivement la jonction."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rippare di nuovo l'album in FLAC elimina la giunzione una volta per tutte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバムをFLACで再リッピングすれば、つなぎ目は完全に解消されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앨범을 FLAC로 다시 리핑하면 이음매가 완전히 사라집니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponowne zripowanie albumu do FLAC usuwa szew raz na zawsze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reripar o álbum em FLAC elimina a emenda de vez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把专辑重新抓取为 FLAC，就能彻底消除衔接处的杂音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把專輯重新擷取為 FLAC，就能徹底消除銜接處的雜音。"
          }
        }
      }
    },
