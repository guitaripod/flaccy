    "Seven days of listening, wrapped up and ready.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieben Tage Musik – zusammengefasst und bereit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siete días de música, resumidos y listos."
