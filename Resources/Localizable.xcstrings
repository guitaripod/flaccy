          "stringUnit": {
            "state": "translated",
            "value": "Empareja un Apple Watch con este iPhone para enviarle música."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistä Apple Watch tähän iPhoneen, jotta siihen voi lähettää musiikkia."
          }
        },
        "fr": {
          "stringUnit": {
