            "value": "低频更饱满"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "低頻更飽滿"
          }
        }
      }
    },
    "A good middle: noticeably more music in the same space.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gute Mitte: deutlich mehr Musik auf demselben Speicher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El punto medio: bastante más música en el mismo espacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bon compromis : nettement plus de musique dans le même espace."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un buon compromesso: molta più musica nello stesso spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ちょうどよいバランス。同じ容量でずっと多くの音楽を入れられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "균형 잡힌 선택: 같은 공간에 훨씬 더 많은 음악을 담을 수 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobry kompromis: znacznie więcej muzyki w tym samym miejscu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um bom meio-termo: bem mais música no mesmo espaço."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "理想折中：同样的空间可以装下明显更多的音乐。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "理想折衷：同樣的空間可以裝下明顯更多的音樂。"
          }
        }
      }
    },
    "A handful of artists own your heart.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Handvoll Interpreten hat dein Herz erobert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un puñado de artistas se ha adueñado de tu corazón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une poignée d'artistes règne sur votre cœur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una manciata di artisti ti ha rubato il cuore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひと握りのアーティストがあなたの心をつかんでいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몇몇 아티스트가 당신의 마음을 사로잡았습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Garstka wykonawców zawładnęła twoim sercem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um punhado de artistas tomou conta do seu coração."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "少数几位艺人占据了你的心。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "少數幾位演出者佔據了你的心。"
          }
        }
      }
    },
    "A metadata source refused the request for “%@”. Try again later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Metadatenquelle hat die Anfrage für „%@“ abgelehnt. Versuche es später erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una fuente de metadatos rechazó la solicitud para “%@”. Inténtalo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une source de métadonnées a refusé la demande pour « %@ ». Réessayez plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una fonte dei metadati ha rifiutato la richiesta per “%@”. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メタデータソースが「%@」のリクエストを拒否しました。後でもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
