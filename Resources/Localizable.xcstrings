          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无缝播放"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無縫播放"
          }
        }
      }
    },
    "Gapless is exact on lossless files. MP3 and AAC files can keep tiny encoder gaps.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sømløs afspilning er præcis på tabsfrie filer. MP3- og AAC-filer kan beholde små huller fra encoderen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lückenlos ist bei verlustfreien Dateien exakt. MP3- und AAC-Dateien können winzige Encoder-Lücken behalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reproducción sin pausas es exacta con archivos sin pérdida. Los MP3 y AAC pueden conservar pequeñas pausas del codificador."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Saumaton toisto on tarkka häviöttömissä tiedostoissa. MP3- ja AAC-tiedostoissa voi jäädä pieniä koodauksesta johtuvia aukkoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lecture sans blanc est exacte avec les fichiers sans perte. Les MP3 et AAC peuvent garder de minuscules blancs d'encodage."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Óslitin spilun er nákvæm á taplausum skrám. MP3- og AAC-skrár geta haldið örlitlum bilum frá kóðaranum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riproduzione senza pause è esatta con i file lossless. I file MP3 e AAC possono conservare piccole pause dell'encoder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ギャップレスはロスレスファイルで正確に動作します。MP3やAACにはエンコーダー由来のわずかな無音が残ることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "갭리스는 무손실 파일에서 정확합니다. MP3와 AAC 파일에는 인코더가 남긴 아주 짧은 공백이 있을 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sømløs avspilling er nøyaktig for tapsfrie filer. MP3- og AAC-filer kan beholde små pauser fra kodingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwarzanie bez przerw jest dokładne dla plików bezstratnych. Pliki MP3 i AAC mogą zachować drobne przerwy z kodera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A reprodução sem pausas é exata em arquivos sem perdas. Arquivos MP3 e AAC podem manter pequenas pausas do codificador."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sömlös uppspelning är exakt på förlustfria filer. MP3- och AAC-filer kan behålla små luckor från kodaren."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无损文件可实现精确无缝播放。MP3 和 AAC 文件可能保留编码器留下的细微间隙。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無損檔案可做到精確的無縫播放。MP3 與 AAC 檔案可能保留編碼器留下的細微間隙。"
          }
        }
      }
    },
    "Gapless lossless playback": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sømløs, tabsfri afspilning"
          }
        },
