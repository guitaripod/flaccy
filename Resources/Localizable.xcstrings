          "stringUnit": {
            "state": "translated",
            "value": "無法製作圖片。請檢查可用儲存空間後重試。"
          }
        }
      }
    },
    "Couldn't make the video (%@). Try again, or share an image instead.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
