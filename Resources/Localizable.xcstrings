    "There’s no music on your Watch to remove": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ingen musik på dit Apple Watch, der kan fjernes"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf deiner Watch ist keine Musik zum Entfernen"
          }
        },
        "es": {
          "stringUnit": {
