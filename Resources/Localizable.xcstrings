    "Less sizzle on bright records": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindre hvæsen på lyse indspilninger"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weniger Zischen bei hellen Aufnahmen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos brillo áspero en grabaciones brillantes"
          }
        },
