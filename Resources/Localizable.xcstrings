    "The clipboard doesn’t hold a Flaccy Server link. Copy the flaccy://server link the server printed, then try again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udklipsholderen indeholder ikke et Flaccy Server-link. Kopiér flaccy://server-linket, som serveren viste, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zwischenablage enthält keinen Flaccy Server-Link. Kopiere den flaccy://server-Link, den der Server ausgegeben hat, und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El portapapeles no contiene un enlace de Flaccy Server. Copia el enlace flaccy://server que imprimió el servidor y vuelve a intentarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Leikepöydällä ei ole Flaccy Server -linkkiä. Kopioi palvelimen tulostama flaccy://server-linkki ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le presse-papiers ne contient pas de lien Flaccy Server. Copie le lien flaccy://server affiché par le serveur, puis réessaie."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Klippiborðið inniheldur engan Flaccy Server-hlekk. Afritaðu flaccy://server-hlekkinn sem netþjónninn birti og reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli appunti non contengono un link di Flaccy Server. Copia il link flaccy://server stampato dal server e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードに Flaccy Server のリンクがありません。サーバーが表示した flaccy://server のリンクをコピーして、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드에 Flaccy Server 링크가 없습니다. 서버가 출력한 flaccy://server 링크를 복사한 뒤 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utklippstavlen inneholder ingen Flaccy Server-lenke. Kopier flaccy://server-lenken serveren skrev ut, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schowek nie zawiera linku serwera Flaccy Server. Skopiuj link flaccy://server wydrukowany przez serwer i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A área de transferência não tem um link do Flaccy Server. Copie o link flaccy://server impresso pelo servidor e tente novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Urklippet innehåller ingen Flaccy Server-länk. Kopiera länken flaccy://server som servern skrev ut och försök igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板中没有 Flaccy Server 链接。请复制服务器打印的 flaccy://server 链接，然后重试。"
          }
        },
