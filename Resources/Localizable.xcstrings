    "Optional. Scrobble your plays and bring your Last.fm history into Stats.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgfrit. Scrobble dine afspilninger, og hent din Last.fm-historik ind i Statistik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Scrobble deine Wiedergaben und hol deinen Last.fm-Verlauf in die Statistiken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Haz scrobble de lo que escuchas y trae tu historial de Last.fm a las estadísticas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valinnainen. Scrobblaa toistosi ja tuo Last.fm-historiasi Tilastoihin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Scrobblez vos écoutes et intégrez votre historique Last.fm aux statistiques."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Valfrjálst. Scrobblaðu spilanirnar þínar og færðu Last.fm-hlustunarferilinn þinn inn í Tölfræði."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo. Fai scrobble degli ascolti e porta la cronologia di Last.fm nelle statistiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意です。再生をスクロブルし、Last.fmの履歴を統計に取り込めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항입니다. 재생한 곡을 스크로블하고 Last.fm 기록을 통계로 가져옵니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgfritt. Scrobble avspillingene dine og hent Last.fm-historikken din inn i Statistikk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalne. Scrobbluj odtworzenia i wczytaj historię Last.fm do statystyk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Faça scrobble do que você ouve e traga seu histórico do Last.fm para as estatísticas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Valfritt. Scrobbla dina uppspelningar och ta med din Last.fm-historik till Statistik."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。对你的播放进行 Scrobble，并把 Last.fm 记录带入统计。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選用。對你的播放進行 Scrobble，並把 Last.fm 記錄帶入統計。"
          }
        }
      }
    },
    "Or drop audio files and folders anywhere in this window.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Eller træk lydfiler og mapper ind i vinduet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oder ziehe Audiodateien und Ordner einfach in dieses Fenster."
          }
