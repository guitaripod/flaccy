    "System follows your device's light and dark setting.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„System“ folgt der Hell-/Dunkel-Einstellung deines Geräts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“Sistema” sigue el ajuste claro u oscuro de tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Système » suit le réglage clair/sombre de votre appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Sistema” segue l'impostazione chiaro/scuro del dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム」はデバイスのライト/ダーク設定に従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“시스템”은 기기의 라이트/다크 설정을 따릅니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemowy podąża za ustawieniem jasnego i ciemnego trybu twojego urządzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Sistema” segue o ajuste claro ou escuro do seu dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“跟随系统”会跟随设备的浅色/深色设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「跟隨系統」會依照裝置的淺色／深色設定。"
