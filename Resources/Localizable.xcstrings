            "state": "translated",
            "value": "Kunne ikke sende til Apple Watch. Tryk for at prøve igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Senden an die Apple Watch fehlgeschlagen. Tippe zum erneuten Versuch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo enviar al Apple Watch. Toca para reintentar."
