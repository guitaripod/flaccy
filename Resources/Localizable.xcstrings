    "Flaccy asks Apple Music for covers it can't find anywhere else. Turning this on asks for permission once.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy beder Apple Music om coverbilleder, som det ikke kan finde andre steder. Når du slår dette til, bliver du spurgt om tilladelse én gang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy fragt Apple Music nach Covern, die es sonst nirgends findet. Beim Aktivieren wird einmal um Erlaubnis gebeten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy pide a Apple Music las carátulas que no encuentra en ningún otro sitio. Al activarlo se te pedirá permiso una vez."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy pyytää Apple Musicilta kansikuvia, joita se ei löydä muualta. Kun tämä otetaan käyttöön, lupa kysytään kerran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy demande à Apple Music les pochettes qu’il ne trouve nulle part ailleurs. L’activation demande une autorisation, une seule fois."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy biður Apple Music um umslög sem það finnur hvergi annars staðar. Þegar kveikt er á þessu er beðið um leyfi einu sinni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy chiede ad Apple Music le copertine che non trova altrove. Attivandolo, ti verrà chiesto il permesso una volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のどこにも見つからないアートワークをApple Musicに問い合わせます。オンにすると一度だけ許可を求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 곳에서 찾지 못한 커버를 Apple Music에 요청합니다. 켜면 한 번 권한을 묻습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy spør Apple Music om omslag den ikke finner andre steder. Når du slår på dette, ber Flaccy om tillatelse én gang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy pyta Apple Music o okładki, których nie może znaleźć nigdzie indziej. Włączenie tego poprosi o zgodę jednorazowo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Flaccy pede ao Apple Music as capas que não encontra em nenhum outro lugar. Ao ativar, a permissão é solicitada uma vez."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy frågar Apple Music efter omslag som den inte kan hitta någon annanstans. När du slår på den här funktionen frågar appen om tillstånd en gång."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 会向 Apple Music 索取在别处找不到的封面。开启时会请求一次权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 會向 Apple Music 索取在別處找不到的封面。開啟時會請求一次權限。"
          }
        }
      }
    },
    "Flaccy built an invalid Last.fm request address, so nothing was sent.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy har dannet en ugyldig Last.fm-anmodningsadresse, så intet blev sendt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy hat eine ungültige Last.fm-Anfrageadresse erstellt, daher wurde nichts gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy creó una dirección de solicitud de Last.fm no válida, así que no se envió nada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy muodosti virheellisen Last.fm-pyyntöosoitteen, joten mitään ei lähetetty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy a créé une adresse de requête Last.fm non valide ; rien n’a donc été envoyé."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy bjó til ógilt vistfang fyrir Last.fm-beiðni, þannig að ekkert var sent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy ha creato un indirizzo di richiesta Last.fm non valido, quindi non è stato inviato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccyが無効なLast.fmリクエストのアドレスを作成したため、何も送信されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy가 잘못된 Last.fm 요청 주소를 만들었으므로 아무것도 전송되지 않았습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy laget en ugyldig Last.fm-forespørselsadresse, så ingenting ble sendt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy utworzyło nieprawidłowy adres żądania Last.fm, więc nic nie zostało wysłane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Flaccy criou um endereço de solicitação do Last.fm inválido, então nada foi enviado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy byggde en ogiltig adress för Last.fm-förfrågan, så inget skickades."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 生成的 Last.fm 请求地址无效，因此未发送任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 產生的 Last.fm 請求網址無效，因此未傳送任何內容。"
          }
        }
      }
    },
    "Flaccy can send three notifications: two days before your trial ends, on the last day, and once if a welcome-back price on Lifetime becomes available. Nothing else. You can turn them off any time in Settings.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy kan sende tre notifikationer: to dage før din prøveperiode udløber, på sidste dag og én gang, hvis en Velkommen tilbage-pris på Lifetime bliver tilgængelig. Ikke andet. Du kan slå dem fra når som helst i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy kann drei Mitteilungen senden: zwei Tage vor Ende deiner Testphase, am letzten Tag und einmal, falls ein Willkommens-zurück-Preis für Lifetime verfügbar wird. Sonst nichts. Du kannst sie jederzeit in den Einstellungen deaktivieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy puede enviar tres notificaciones: dos días antes de que termine tu prueba, el último día y una vez si aparece un precio de bienvenida para de por vida. Nada más. Puedes desactivarlas en cualquier momento en Ajustes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy voi lähettää kolme ilmoitusta: kaksi päivää ennen kokeilun päättymistä, viimeisenä päivänä ja kerran, jos Lifetimeen tulee saataville tervetuloa takaisin -hinta. Ei mitään muuta. Voit poistaa ne käytöstä milloin tahansa Asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy peut envoyer trois notifications : deux jours avant la fin de votre essai, le dernier jour, et une fois si un tarif de bienvenue pour l'accès à vie devient disponible. Rien d'autre. Vous pouvez les désactiver à tout moment dans Réglages."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy getur sent þrjár tilkynningar: tveimur dögum áður en prufutíminn lýkur, á síðasta degi og einu sinni ef tilboðið Velkomin aftur fyrir Lifetime verður í boði. Ekkert annað. Þú getur slökkt á þeim hvenær sem er í Stillingum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy può inviare tre notifiche: due giorni prima della fine della prova, l'ultimo giorno e una volta se diventa disponibile un prezzo di bentornato per l'opzione a vita. Nient'altro. Puoi disattivarle in qualsiasi momento in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccyが送信する通知は最大3回です：トライアル終了2日前、最終日、そして買い切りのおかえりなさい価格が利用可能になった際の1回。それ以外はありません。設定でいつでもオフにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy는 최대 세 번의 알림을 보낼 수 있습니다: 체험 종료 2일 전, 마지막 날, 그리고 평생 이용의 웰컴백 가격이 제공될 때 한 번. 그 외에는 없습니다. 설정에서 언제든 끌 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy kan sende tre varsler: to dager før prøveperioden din utløper, på siste dag, og én gang hvis et «Velkommen tilbake»-tilbud på Lifetime blir tilgjengelig. Ingenting annet. Du kan slå dem av når som helst i Innstillinger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy może wysłać trzy powiadomienia: dwa dni przed końcem okresu próbnego, w ostatnim dniu i raz, gdy pojawi się cena powitalna na dostęp dożywotni. Nic więcej. Możesz je wyłączyć w każdej chwili w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Flaccy pode enviar três notificações: dois dias antes do fim do seu teste, no último dia e uma vez se um preço de boas-vindas no vitalício ficar disponível. Nada mais. Você pode desativá-las a qualquer momento em Ajustes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy kan skicka tre notiser: två dagar innan din provperiod går ut, på den sista dagen, och en gång om ett Välkommen tillbaka-pris på Lifetime blir tillgängligt. Inget annat. Du kan stänga av dem när som helst i Inställningar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 最多会发送三次通知：试用结束前两天、最后一天，以及永久版的欢迎回归价可用时各一次。仅此而已。你可以随时在设置中关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 最多會發送三次通知：試用結束前兩天、最後一天，以及永久版的歡迎回歸價可用時各一次。僅此而已。你可以隨時在設定中關閉。"
          }
        }
      }
    },
    "Flaccy can't play %@ files, so these %lld weren't added.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy kan ikke afspille %@-filer, så disse %lld blev ikke tilføjet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy kann Dateien im Format %@ nicht abspielen, daher wurden diese %lld nicht hinzugefügt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy no puede reproducir archivos %@, así que estos %lld no se añadieron."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy ei voi toistaa tiedostoja muodossa %@, joten näitä %lld ei lisätty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy ne peut pas lire les fichiers %@, donc ces %lld n’ont pas été ajoutés."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy getur ekki spilað %@-skrár, svo %lld skrár voru ekki bættar við."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy non può riprodurre i file %@, quindi questi %lld non sono stati aggiunti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccyでは%@ファイルを再生できないため、これら%lld件は追加されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy는 %@ 파일을 재생할 수 없으므로 이 %lld개는 추가되지 않았습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy kan ikke spille av %@-filer, så disse %lld ble ikke lagt til."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy nie potrafi odtwarzać plików %@, więc %lld z nich nie zostało dodanych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Flaccy não consegue reproduzir arquivos %@, então estes %lld não foram adicionados."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy kan inte spela %@-filer, så dessa %lld lades inte till."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 无法播放 %@ 文件，因此这 %lld 个未添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 無法播放 %@ 檔案，因此這 %lld 個未加入。"
          }
        }
      }
    },
    "Flaccy can't play %@ files, so this one wasn't added.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy kan ikke afspille %@-filer, så denne blev ikke tilføjet."
