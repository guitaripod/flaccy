        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法還原「%@」的上一個混音——%@。未做任何變更，請再試一次。"
          }
        }
      }
    },
    "Couldn't save the artwork — the framed picture couldn't be rendered. Choose a different image.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke gemme coverbilledet: det indrammede billede kunne ikke oprettes. Vælg et andet billede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Artwork konnte nicht gespeichert werden – das eingerahmte Bild ließ sich nicht rendern. Wähle ein anderes Bild."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la carátula: la imagen recortada no se pudo generar. Elige otra imagen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kansikuvaa ei voitu tallentaa, koska kehystettyä kuvaa ei voitu luoda. Valitse toinen kuva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer la pochette : l’image recadrée n’a pas pu être générée. Choisissez une autre image."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki tókst að vista umslagið – ekki var hægt að búa til innrammaða myndina. Veldu aðra mynd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare la copertina: non è stato possibile generare l’immagine ritagliata. Scegli un’altra immagine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アートワークを保存できませんでした。切り抜いた画像を描画できませんでした。別の画像を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아트워크를 저장할 수 없습니다. 프레임에 맞춘 이미지를 렌더링할 수 없었습니다. 다른 이미지를 선택하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke lagre omslaget – det innrammede bildet kunne ikke gjengis. Velg et annet bilde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać grafiki — nie można wyrenderować kadrowanego obrazu. Wybierz inny obraz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar a arte: a imagem enquadrada não pôde ser renderizada. Escolha outra imagem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Omslaget kunde inte sparas – den inramade bilden kunde inte renderas. Välj en annan bild."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存封面——无法渲染裁剪后的图片。请选择其他图片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存封面——無法轉譯裁切後的圖片。請選擇其他圖片。"
          }
        }
      }
    },
    "Couldn't save the artwork — the library database couldn't be written. Check free disk space and try again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke gemme coverbilledet: bibliotekets database kunne ikke skrives. Kontrollér den ledige lagerplads, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Artwork konnte nicht gespeichert werden – die Mediathek-Datenbank ließ sich nicht schreiben. Prüfe den freien Speicherplatz und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la carátula: la base de datos de la biblioteca no se pudo escribir. Revisa el espacio libre del disco e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kansikuvaa ei voitu tallentaa, koska kirjastotietokantaan ei voitu kirjoittaa. Tarkista levytila ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer la pochette : la base de données de la bibliothèque n’a pas pu être écrite. Vérifiez l’espace disque disponible et réessayez."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki tókst að vista umslagið – ekki var hægt að skrifa í gagnagrunn safnsins. Athugaðu laust geymslupláss og reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare la copertina: impossibile scrivere il database della libreria. Controlla lo spazio libero su disco e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アートワークを保存できませんでした。ライブラリのデータベースに書き込めませんでした。空き容量を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아트워크를 저장할 수 없습니다. 보관함 데이터베이스에 쓸 수 없었습니다. 디스크 여유 공간을 확인하고 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke lagre omslaget – biblioteksdatabasen kunne ikke skrives til. Kontroller ledig lagringsplass og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać grafiki — nie można zapisać bazy danych biblioteki. Sprawdź wolne miejsce na dysku i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar a arte: o banco de dados da biblioteca não pôde ser gravado. Verifique o espaço livre em disco e tente novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Omslaget kunde inte sparas – biblioteksdatabasen gick inte att skriva till. Kontrollera det lediga lagringsutrymmet och försök igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存封面——资料库数据库无法写入。请检查可用磁盘空间后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
