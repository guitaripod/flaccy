    "Queued. It sends on its own.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sat i kø. Den sendes af sig selv."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Warteschlange. Wird automatisch gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En cola. Se enviará sola."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonossa. Lähetetään automaattisesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En file d’attente. Il s’envoie tout seul."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Í biðröð. Sendist sjálfkrafa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In coda. Verrà inviato da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キューに追加済み。自動で送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기 중. 자동으로 전송됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I køen. Sendes automatisk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W kolejce. Wyśle się sam."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na fila. Será enviada sozinha."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I kö. Skickas automatiskt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已排队，将自动发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已排隊，將自動傳送。"
          }
        }
      }
    },
    "Queued. It sends when your Watch is nearby": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sat i kø. Den sendes, når dit ur er i nærheden"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Warteschlange. Wird gesendet, wenn deine Watch in der Nähe ist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En cola. Se enviará cuando tu Watch esté cerca"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonossa. Lähetetään, kun kellosi on lähellä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En file d’attente. Il s’enverra quand ta Watch sera à proximité"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Í biðröð. Sendist þegar úrið þitt er nálægt"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In coda. Verrà inviato quando il tuo Watch sarà vicino"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キューに追加済み。Watchが近くにあると送信されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기 중. Watch가 가까이 있으면 전송됩니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I køen. Sendes når klokken din er i nærheten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W kolejce. Wyśle się, gdy Watch będzie w pobliżu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
