    },
    "Your computer and this iPad need to be on the same Wi-Fi.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din computer og denne iPad skal være på samme Wi-Fi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Computer und dieses iPad müssen im selben WLAN sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ordenador y este iPad deben estar en la misma Wi-Fi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tietokoneesi ja tämän iPadin on oltava samassa WLAN-verkossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre ordinateur et cet iPad doivent être sur le même Wi-Fi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tölvan þín og þessi iPad þurfa að vera á sama Wi-Fi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il computer e questo iPad devono essere sulla stessa rete Wi-Fi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピュータとこのiPadを同じWi-Fiに接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터와 이 iPad이 같은 Wi-Fi에 연결되어 있어야 합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Datamaskinen og denne iPaden må være på samme Wi-Fi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Komputer i ten iPad muszą być w tej samej sieci Wi-Fi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O computador e este iPad precisam estar na mesma rede Wi-Fi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din dator och den här iPaden måste vara på samma Wi-Fi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑和这台 iPad 需要连接同一个 Wi-Fi。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電腦和這部 iPad 需要連接同一個 Wi-Fi。"
          }
        }
      }
    },
