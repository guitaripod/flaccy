    "%lld songs are now loved here, from your other devices.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sange er nu markeret som synes godt om her, fra dine andre enheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Titel sind hier jetzt favorisiert, aus anderen Geräten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld songs are now loved here, from your other devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora hay %lld canciones favoritas aquí, de otros dispositivos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld kappaletta on nyt tykätty täällä muilta laitteiltasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld morceaux sont désormais aimés ici, depuis d’autres appareils."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld lög eru nú líkuð hér, frá öðrum tækjum þínum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld brani sono ora preferiti qui, dagli altri dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のデバイスから、%lld 曲がここでお気に入りになりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기에서 %lld곡이 여기서도 좋아요 상태가 됐어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sanger er nå likt her, fra dine andre enheter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwory z innych urządzeń w ulubionych: %lld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld músicas agora são curtidas aqui, de outros dispositivos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld låtar är nu gillade här, från dina andra enheter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自你其他设备的 %lld 首歌曲现在也已在这里标为喜欢。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
