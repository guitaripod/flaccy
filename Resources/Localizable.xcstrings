            "state": "translated",
            "value": "重新检查"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新檢查"
          }
        }
      }
    },
    "Check that %@ is on and on the same Wi-Fi as this device, or that Tailscale is on for both. Then try again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollér, at %@ er tændt og på samme Wi-Fi som denne enhed, eller at Tailscale er tændt på begge. Prøv derefter igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe, ob %@ eingeschaltet ist und im selben WLAN wie dieses Gerät ist, oder ob Tailscale auf beiden Geräten aktiv ist. Versuche es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that %@ is on and on the same Wi-Fi as this device, or that Tailscale is on for both. Then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que %@ esté encendido y en el mismo Wi-Fi que este dispositivo, o que Tailscale esté activado en ambos. Luego vuelve a intentarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista, että %@ on päällä ja samassa Wi-Fi-verkossa kuin tämä laite tai että Tailscale on päällä molemmissa. Yritä sitten uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie que %@ est allumé et sur le même Wi-Fi que cet appareil, ou que Tailscale est activé sur les deux. Réessaie ensuite."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Athugaðu hvort %@ sé kveikt og á sama Wi-Fi og þetta tæki, eða hvort Tailscale sé kveikt á báðum. Reyndu síðan aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica che %@ sia acceso e sulla stessa rete Wi-Fi di questo dispositivo, oppure che Tailscale sia attivo su entrambi. Poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の電源が入っていて、この機器と同じ Wi-Fi に接続されているか、両方で Tailscale がオンになっているか確認してください。その後、もう一度試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 켜져 있고 이 기기와 같은 Wi-Fi에 연결되어 있는지, 또는 두 기기 모두 Tailscale이 켜져 있는지 확인하세요. 그런 다음 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontroller at %@ er på og på samme Wi-Fi som denne enheten, eller at Tailscale er slått på for begge. Prøv deretter igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź, czy %@ jest włączony i w tej samej sieci Wi-Fi co to urządzenie, albo czy Tailscale jest włączony na obu. Potem spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique se %@ está ligado e na mesma rede Wi-Fi deste dispositivo, ou se o Tailscale está ativado nos dois. Depois tente de novo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera att %@ är på och ansluten till samma Wi-Fi som den här enheten, eller att Tailscale är aktiverat på båda. Försök sedan igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认 %@ 已开机，并且与此设备在同一 Wi-Fi 下，或两端都已开启 Tailscale。然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請確認 %@ 已開機，並且與此裝置在同一 Wi-Fi 下，或兩端都已開啟 Tailscale。然後重試。"
          }
        }
      }
    },
    "Check the address shown on %@, or scan its code again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollér adressen, der vises på %@, eller scan koden igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe die Adresse, die auf %@ angezeigt wird, oder scanne den Code erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the address shown on %@, or scan its code again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba la dirección que muestra %@, o escanea de nuevo su código."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista laitteessa %@ näkyvä osoite tai skannaa sen koodi uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie l’adresse affichée sur %@, ou scanne de nouveau son code."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Athugaðu vistfangið sem birtist á %@, eða skannaðu kóðann aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla l’indirizzo mostrato su %@ o scansiona di nuovo il suo codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に表示されているアドレスを確認するか、そのコードをもう一度スキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 표시된 주소를 확인하거나 코드를 다시 스캔하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontroller adressen som vises på %@, eller skann koden på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź adres pokazany na %@ albo zeskanuj jego kod ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira o endereço mostrado em %@ ou escaneie o código dele de novo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera adressen som visas på %@, eller skanna koden igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查 %@ 上显示的地址，或重新扫描它的二维码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查 %@ 上顯示的位址，或重新掃描它的 QR Code。"
          }
        }
      }
    },
    "Checking the song's tags, files next to it, and lrclib.net.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollerer sangens tags, filerne ved siden af den og lrclib.net."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tags des Titels, Dateien daneben und lrclib.net werden geprüft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprobando las etiquetas de la canción, los archivos junto a ella y lrclib.net."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkistetaan kappaleen tunnisteet, sen vieressä olevat tiedostot ja lrclib.net."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
