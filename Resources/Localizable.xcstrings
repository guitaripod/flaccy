    "On a Mac, open Flaccy and turn on Settings › Servers › Share this Mac's library. On Linux or a NAS, install Flaccy Server and run flaccy-server setup.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "På en Mac åbner du Flaccy og slår Indstillinger › Servere › Del denne Macs bibliotek til. På Linux eller en NAS installerer du Flaccy Server og kører flaccy-server setup."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne auf einem Mac Flaccy und aktiviere Einstellungen › Server › Mediathek dieses Macs teilen. Installiere unter Linux oder auf einem NAS Flaccy Server und führe flaccy-server setup aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En un Mac, abre Flaccy y activa Ajustes › Servidores › Compartir la biblioteca de este Mac. En Linux o un NAS, instala Flaccy Server y ejecuta flaccy-server setup."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Macissa Flaccy ja ota käyttöön Asetukset › Palvelimet › Jaa tämän Macin kirjasto. Linuxissa tai NAS-laitteessa asenna Flaccy Server ja suorita flaccy-server setup."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur un Mac, ouvrez Flaccy et activez Réglages › Serveurs › Partager la bibliothèque de ce Mac. Sous Linux ou sur un NAS, installez Flaccy Server et lancez flaccy-server setup."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Á Mac-tölvu skaltu opna Flaccy, fara í Stillingar › Netþjónar og kveikja á „Deila safni þessarar Mac-tölvu“. Á Linux eða NAS skaltu setja upp Flaccy Server og keyra flaccy-server setup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su un Mac, apri Flaccy e attiva Impostazioni › Server › Condividi la libreria di questo Mac. Su Linux o un NAS, installa Flaccy Server ed esegui flaccy-server setup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macでは、Flaccyを開いて「設定」›「サーバー」›「このMacのライブラリを共有」をオンにします。LinuxやNASでは、Flaccy Serverをインストールしてflaccy-server setupを実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서는 Flaccy를 열고 설정 › 서버 › 이 Mac의 보관함 공유를 켜세요. Linux나 NAS에서는 Flaccy Server를 설치하고 flaccy-server setup을 실행하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På en Mac åpner du Flaccy og slår på Innstillinger › Servere › Del biblioteket på denne Macen. På Linux eller en NAS installerer du Flaccy Server og kjører flaccy-server setup."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na Macu otwórz Flaccy i włącz Ustawienia › Serwery › Udostępnij bibliotekę tego Maca. Na Linuksie lub NAS zainstaluj Flaccy Server i uruchom flaccy-server setup."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No Mac, abra o Flaccy e ative Ajustes › Servidores › Compartilhar a biblioteca deste Mac. No Linux ou em um NAS, instale o Flaccy Server e rode flaccy-server setup."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "På en Mac öppnar du Flaccy och slår på Inställningar › Servrar › Dela den här datorns bibliotek. På Linux eller en NAS installerar du Flaccy Server och kör flaccy-server setup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上，打开 Flaccy 并开启“设置 › 服务器 › 共享此 Mac 的资料库”。在 Linux 或 NAS 上，安装 Flaccy Server 并运行 flaccy-server setup。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上，打開 Flaccy 並開啟「設定 › 伺服器 › 共享此 Mac 的資料庫」。在 Linux 或 NAS 上，安裝 Flaccy Server 並執行 flaccy-server setup。"
          }
        }
      }
    },
