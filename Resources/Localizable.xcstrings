            "state": "translated",
            "value": "Ret kameraet mod den QR-kode, som din Flaccy-server viser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte die Kamera auf den QR-Code, den dein Flaccy Server ausgegeben hat."
          }
        },
