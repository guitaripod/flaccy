    "If macOS asks whether Flaccy may accept incoming connections, choose Allow.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis macOS spørger, om Flaccy må acceptere indgående forbindelser, skal du vælge Tillad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn macOS fragt, ob Flaccy eingehende Verbindungen annehmen darf, „Erlauben“ wählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If macOS asks whether Flaccy may accept incoming connections, choose Allow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si macOS pregunta si Flaccy puede aceptar conexiones entrantes, elige Permitir."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos macOS kysyy, saako Flaccy hyväksyä saapuvat yhteydet, valitse Salli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si macOS demande si Flaccy peut accepter les connexions entrantes, choisissez Autoriser."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ef macOS spyr hvort Flaccy megi taka við innkomnum tengingum, veldu Leyfa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se macOS chiede se Flaccy può accettare connessioni in entrata, scegli Consenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS から Flaccy が受信接続を受け入れてよいか尋ねられたら、「許可」を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS에서 Flaccy가 들어오는 연결을 허용할지 물으면 “허용”을 선택하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis macOS spør om Flaccy får ta imot innkommende tilkoblinger, velg Tillat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli macOS zapyta, czy Flaccy może przyjmować połączenia przychodzące, wybierz Zezwalaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o macOS perguntar se o Flaccy pode aceitar conexões de entrada, escolha Permitir."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om macOS frågar om Flaccy får ta emot inkommande anslutningar, välj Tillåt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 macOS 询问是否允许 Flaccy 接受传入连接，请选择“允许”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 macOS 詢問是否允許 Flaccy 接受傳入連線，請選擇「允許」。"
          }
        }
      }
    },
    "If you close now, the songs that have finished stay and the rest stop. Keep this screen open until the computer is done.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du lukker nu, bliver de sange, der er færdige, og resten stopper. Lad denne skærm være åben, indtil computeren er færdig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du jetzt schließt, bleiben die fertigen Songs erhalten und der Rest wird angehalten. Lass diesen Bildschirm offen, bis der Computer fertig ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you close now, the songs that have finished stay and the rest stop. Keep this screen open until the computer is done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cierras ahora, las canciones terminadas se quedan y el resto se detiene. Mantén esta pantalla abierta hasta que el ordenador termine."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos suljet nyt, valmiit kappaleet säilyvät ja loput pysähtyvät. Pidä tämä näkymä auki, kunnes tietokone on valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous fermez maintenant, les morceaux terminés restent et les autres s’arrêtent. Gardez cet écran ouvert jusqu’à ce que l’ordinateur ait terminé."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ef þú lokar núna haldast lögin sem eru þegar búin og restin stöðvast. Haltu þessum skjá opnum þar til tölvan er búin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se chiudi ora, i brani già completati restano e il resto si interrompe. Tieni aperta questa schermata finché il computer non ha finito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今閉じると、完了した曲は残り、残りは止まります。コンピュータの処理が終わるまで、この画面を開いたままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 닫으면 완료된 곡은 남고 나머지는 중단됩니다. 컴퓨터 작업이 끝날 때까지 이 화면을 열어 두세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du lukker nå, blir de ferdige sangene, mens resten stopper. Hold denne skjermen åpen til datamaskinen er ferdig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli zamkniesz teraz, zakończone utwory zostaną, a reszta się zatrzyma. Zostaw ten ekran otwarty, dopóki komputer nie skończy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você fechar agora, as músicas já concluídas ficam e as demais param. Mantenha esta tela aberta até o computador terminar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du stänger nu finns de låtar som är klara kvar, och resten avbryts. Håll den här skärmen öppen tills datorn är klar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果现在关闭，已完成的歌曲会保留，其余的将停止。请保持此屏幕打开，直到电脑完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果現在關閉，已完成的歌曲會保留，其餘的將停止。請保持此畫面開啟，直到電腦完成。"
          }
        }
      }
    },
