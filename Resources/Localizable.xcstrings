          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwarza stację podobnej muzyki z twojej biblioteki"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca uma estação de música parecida da sua biblioteca"
          }
