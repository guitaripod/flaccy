    "Keep Flaccy open on your iPad until everything has arrived.": {
      "comment": "Wi-Fi Transfer web page",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold Flaccy åben på din iPad, indtil alt er ankommet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass Flaccy auf deinem iPad geöffnet, bis alles angekommen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén Flaccy abierta en tu iPad hasta que llegue todo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä Flaccy auki iPadillasi, kunnes kaikki on saapunut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez Flaccy ouvert sur votre iPad jusqu'à ce que tout soit arrivé."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafðu Flaccy opið á iPad-inum þínum þar til allt hefur borist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni Flaccy aperto sul tuo iPad finché non è arrivato tutto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて届くまで、iPadでFlaccyを開いたままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두 도착할 때까지 iPad에서 Flaccy를 열어 두세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold Flaccy åpent på iPad-en din til alt er kommet frem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zamykaj Flaccy na iPadzie, dopóki wszystko nie dotrze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o Flaccy aberto no iPad até que tudo chegue."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll Flaccy öppet på din iPad tills allt har kommit fram."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在全部传完之前，请在 iPad 上保持 Flaccy 打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在全部傳完之前，請讓 iPad 上的 Flaccy 保持開啟。"
          }
        }
      }
    },
