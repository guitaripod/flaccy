    "lrclib.net lists this track as an instrumental, so there are no words to follow.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "lrclib.net angiver, at denne sang er instrumental, så der er ingen tekst at følge med i."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "lrclib.net führt diesen Titel als Instrumental, es gibt also keinen Text zum Mitlesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "lrclib.net indica que esta pista es instrumental, así que no hay letra que seguir."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "lrclib.net merkitsee tämän kappaleen instrumentaaliksi, joten sanoja ei ole seurattavana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "lrclib.net indique que ce morceau est instrumental, il n’y a donc pas de paroles à suivre."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "lrclib.net skráir þetta lag sem hljóðfæraleik, þannig að enginn texti er til að fylgja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "lrclib.net indica questo brano come strumentale, quindi non ci sono parole da seguire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "lrclib.netではこの曲はインストゥルメンタルとして登録されているため、追う歌詞はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "lrclib.net은 이 트랙을 연주곡으로 등록해 두었으므로 따라 부를 가사가 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "lrclib.net har denne sangen oppført som instrumental, så det finnes ingen tekst å følge med på."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "lrclib.net oznacza ten utwór jako instrumentalny, więc nie ma słów do śledzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O lrclib.net lista esta faixa como instrumental, então não há letra para acompanhar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "lrclib.net listar den här låten som instrumental, så det finns inga låttexter att läsa med i."
          }
