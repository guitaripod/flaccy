                      "state": "translated",
                      "value": "%arg odtworzenia"
                    }
                  },
                  "many": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg odtworzeń"
                    }
                  },
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg odtworzenie"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg odtworzenia"
                    }
                  }
                }
              }
            }
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Relógio de audição. Horário de pico %1$lld horas, com %2$lld reproduções."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收听时钟。高峰时段 %1$lld 点，共 %2$lld 次播放。"
