        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke tegne tilbakeblikk-kortet – systemet kunne ikke reservere minne til bildet. Prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się narysować karty podsumowania — system nie mógł przydzielić dla niej obrazu. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível desenhar o cartão do resumo: o sistema não conseguiu alocar a imagem. Tente novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att rita återblickskortet. Systemet kunde inte reservera minne till bilden. Försök igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
