          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy no puede reproducir archivos %@, así que este no se añadió."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy ei voi toistaa tiedostoja muodossa %@, joten tätä ei lisätty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy ne peut pas lire les fichiers %@, donc celui-ci n’a pas été ajouté."
          }
        },
        "is": {
