    "Keeps a similar-music station going when the queue ends": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Holder en station med lignende musik i gang, når køen slutter"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält am Ende der Warteschlange einen Sender mit ähnlicher Musik am Laufen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene una emisora de música similar cuando la cola termina"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitää samankaltaisen musiikin radioaseman käynnissä, kun jono päättyy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance une radio de musique similaire quand la file se termine"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Heldur uppi stöð með svipaðri tónlist þegar biðröðin klárast"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia una stazione di musica simile quando la coda finisce"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キューが尽きたときに似た曲のステーションを続けます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기열이 끝나면 비슷한 음악 스테이션을 이어 갑니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Holder en radiostasjon med lignende musikk i gang når køen tar slutt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymuje podobną stację muzyczną, gdy kolejka się skończy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém uma estação de música parecida quando a fila acaba"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håller en station med liknande musik igång när kön tar slut"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "队列结束时接上一个相似音乐电台"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "待播清單結束時接上一個相似音樂電台"
          }
        }
      }
    },
