    "Wait a minute, then try again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vent et minut, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Minute warten, dann erneut versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait a minute, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera un minuto y vuelve a intentarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Odota minuutti ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Patientez une minute, puis réessayez."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Bíddu í eina mínútu og reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendi un minuto, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少し待ってから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠시 기다린 뒤 다시 시도해 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vent ett minutt, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poczekaj chwilę i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguarde um minuto e tente de novo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vänta en minut och försök igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请稍等片刻，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請稍候片刻，然後再試一次。"
          }
        }
      }
    },
