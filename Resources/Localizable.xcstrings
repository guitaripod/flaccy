    "Install Tailscale on this iPad and on your computer, signed in to the same account, and your music plays anywhere.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer Tailscale på denne iPad og på din computer, logget ind med samme konto, så spiller din musik overalt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere Tailscale auf diesem iPad und auf deinem Computer, angemeldet mit demselben Konto, dann spielt deine Musik überall."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install Tailscale on this iPad and on your computer, signed in to the same account, and your music plays anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala Tailscale en este iPad y en tu ordenador, con la misma cuenta iniciada, y tu música sonará en cualquier lugar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asenna Tailscale tähän iPadiin ja tietokoneeseesi, kirjautuneena samaan tiliin, niin musiikkisi toistetaan missä tahansa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez Tailscale sur cet iPad et sur votre ordinateur, connectés au même compte, et votre musique se joue partout."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Settu upp Tailscale á þessum iPad og tölvunni þinni, skráðu þig inn á sama aðgang, og tónlistin þín spilast hvar sem er."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa Tailscale su questo iPad e sul tuo computer, con lo stesso account, e la tua musica suonerà ovunque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPad とコンピュータに Tailscale を入れ、同じアカウントでサインインすれば、どこでも音楽が再生できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPad와 컴퓨터에 Tailscale을 설치하고 같은 계정으로 로그인하면 어디서든 음악을 들을 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer Tailscale på denne iPaden og på datamaskinen din, logget på med samme konto, så spiller musikken din overalt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zainstaluj Tailscale na tym iPadzie i na komputerze, zalogowany na to samo konto, a twoja muzyka będzie grać wszędzie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale o Tailscale neste iPad e no seu computador, conectados à mesma conta, e sua música toca em qualquer lugar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Installera Tailscale på den här iPaden och på datorn, och logga in med samma konto, så spelas din musik var som helst."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这台 iPad 和你的电脑上安装 Tailscale 并登录同一账户，你的音乐就能随处播放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這台 iPad 和你的電腦上安裝 Tailscale 並登入同一帳號，你的音樂就能隨處播放。"
          }
        }
      }
    },
