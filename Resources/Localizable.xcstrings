    "This account can only listen. Ask the owner of %@ to give it access.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne konto kan kun lytte. Bed ejeren af %@ om at give adgang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Konto kann nur hören. Bitte den Besitzer von %@, Zugriff zu gewähren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account can only listen. Ask the owner of %@ to give it access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta solo puede escuchar. Pide al propietario de %@ que le dé acceso."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tällä tilillä voi vain kuunnella. Pyydä kohteen %@ omistajaa antamaan tälle tilille pääsy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte ne peut qu’écouter. Demandez au propriétaire de %@ de lui accorder l’accès."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þessi aðgangur getur aðeins hlustað. Biddu eiganda %@ um að veita aðgang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo account può solo ascoltare. Chiedi al proprietario di %@ di concedergli l’accesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントは再生のみ可能です。%@ の所有者にアクセス権を付与してもらってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정은 듣기만 할 수 있어요. %@의 소유자에게 접근 권한을 요청하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne kontoen kan bare lytte. Be eieren av %@ om å gi den tilgang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To konto może tylko słuchać. Poproś właściciela: %@, aby nadał mu dostęp."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta só pode ouvir. Peça ao dono de %@ para dar acesso a ela."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här kontot kan bara lyssna. Be ägaren till %@ om åtkomst."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户只能收听。请让 %@ 的所有者授予访问权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳號只能收聽。請讓 %@ 的擁有者授予存取權限。"
          }
        }
      }
    },
    "This can take a moment. You can keep browsing.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det kan tage et øjeblik. Du kan fortsætte med at kigge rundt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das kann einen Moment dauern. Du kannst weiter stöbern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto puede tardar un momento. Puedes seguir navegando."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä voi kestää hetken. Voit jatkaa selaamista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela peut prendre un moment. Vous pouvez continuer à naviguer."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þetta getur tekið smástund. Þú getur haldið áfram að vafra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Può volerci un momento. Puoi continuare a navigare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少し時間がかかります。そのまま操作を続けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠시 걸릴 수 있습니다. 계속 둘러보셔도 됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette kan ta en stund. Du kan fortsette å bla."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To może zająć chwilę. Możesz dalej przeglądać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso pode demorar um pouco. Você pode continuar navegando."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det kan ta en stund. Du kan fortsätta att bläddra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这需要一点时间，你可以继续浏览。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這需要一點時間，你可以繼續瀏覽。"
          }
        }
      }
    },
    "This code has expired. Make a new one.": {
      "localizations": {
        "da": {
