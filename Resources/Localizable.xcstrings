    "Reminders are generated on this device from your local play history.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Påmindelser genereres på denne enhed ud fra din lokale afspilningshistorik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen entstehen auf diesem Gerät aus deinem lokalen Wiedergabeverlauf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios se generan en este dispositivo con tu historial de reproducción local."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistutukset luodaan tällä laitteella paikallisen toistohistoriasi perusteella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels sont générés sur cet appareil à partir de votre historique local."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Áminningar verða til á þessu tæki úr staðbundnum spilunarferli þínum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria vengono generati su questo dispositivo dalla tua cronologia di ascolto locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーは端末内の再生履歴からこのデバイスで生成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림은 이 기기의 재생 기록으로 생성됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Påminnelser lages på denne enheten fra den lokale avspillingshistorikken din."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnienia są generowane na tym urządzeniu z twojej lokalnej historii odtwarzania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lembretes são gerados neste dispositivo a partir do seu histórico local de reproduções."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Påminnelser skapas på den här enheten från din lokala uppspelningshistorik."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒在本机根据你的播放记录生成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
