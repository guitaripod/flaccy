    "Built with GRDB (SQLite), lyrics from lrclib.net, universal links by Songlink/Odesli, and scrobbling via the Last.fm API.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebaut mit GRDB (SQLite), Songtexten von lrclib.net, universellen Links von Songlink/Odesli und Scrobbling über die Last.fm-API."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hecha con GRDB (SQLite), letras de lrclib.net, enlaces universales de Songlink/Odesli y scrobbling con la API de Last.fm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conçu avec GRDB (SQLite), paroles de lrclib.net, liens universels par Songlink/Odesli et scrobbling via l'API Last.fm."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Realizzata con GRDB (SQLite), testi da lrclib.net, link universali di Songlink/Odesli e scrobbling tramite l'API di Last.fm."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GRDB（SQLite）、lrclib.netの歌詞、Songlink/Odesliのユニバーサルリンク、Last.fm APIによるスクロブルで作られています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GRDB(SQLite), lrclib.net 가사, Songlink/Odesli 유니버설 링크, Last.fm API 스크로블로 만들었습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbudowane na GRDB (SQLite), tekstach z lrclib.net, uniwersalnych linkach Songlink/Odesli oraz scrobblowaniu przez Last.fm API."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Feito com GRDB (SQLite), letras do lrclib.net, links universais do Songlink/Odesli e scrobbling pela API do Last.fm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 GRDB（SQLite）构建，歌词来自 lrclib.net，通用链接由 Songlink/Odesli 提供，Scrobble 通过 Last.fm API 完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 GRDB（SQLite）打造，歌詞來自 lrclib.net，通用連結由 Songlink/Odesli 提供，Scrobble 透過 Last.fm API 完成。"
          }
        }
      }
    },
