    "Looking up artwork, years and genres for every album.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Henter coverbilleder, årstal og genrer for hvert album."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cover, Jahre und Genres werden für jedes Album gesucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscando carátula, año y género de cada álbum."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haetaan jokaiselle albumille kansikuvat, vuodet ja tyylilajit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche de la pochette, de l’année et du genre de chaque album."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitað er að umslögum, útgáfuárum og tónlistarstefnum fyrir hverja plötu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricerca di copertina, anno e genere per ogni album."
          }
        },
