    "Sharing is off. Turn on Share this Mac's library to add a device.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Deling er slået fra. Slå »Del denne Macs bibliotek« til for at tilføje en enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freigabe ist aus. „Mediathek dieses Macs teilen“ einschalten, um ein Gerät hinzuzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing is off. Turn on Share this Mac's library to add a device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El uso compartido está desactivado. Activa «Compartir la biblioteca de este Mac» para añadir un dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakaminen on pois päältä. Kytke päälle ”Jaa tämän Macin kirjasto”, jotta voit lisätä laitteen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le partage est désactivé. Activez « Partager la bibliothèque de ce Mac » pour ajouter un appareil."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Deiling er slökkt. Kveiktu á „Deila safni þessarar Mac-tölvu“ til að bæta við tæki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La condivisione è disattivata. Attiva «Condividi la libreria di questo Mac» per aggiungere un dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有はオフです。デバイスを追加するには「このMacのライブラリを共有」をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유가 꺼져 있어요. 기기를 추가하려면 “이 Mac의 보관함 공유”를 켜세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Deling er av. Slå på «Del denne Macens bibliotek» for å legge til en enhet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępnianie jest wyłączone. Włącz „Udostępnij bibliotekę tego Maca”, aby dodać urządzenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O compartilhamento está desativado. Ative “Compartilhar a biblioteca deste Mac” para adicionar um dispositivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Delning är avstängd. Slå på ”Dela den här Macens bibliotek” för att lägga till en enhet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享已关闭。要添加设备，请打开“共享此 Mac 的资料库”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "共享已關閉。要新增裝置，請開啟「共享此 Mac 的資料庫」。"
          }
        }
      }
    },
