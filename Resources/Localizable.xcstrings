    "%@ stops syncing with %@. Its playlists and history stay on it, and %@ keeps its copy.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ synkroniserer ikke længere med %@. Dets playlister og historik bliver liggende der, og %@ beholder sin kopi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ synchronisiert nicht mehr mit %@. Playlists und Verlauf bleiben dort, und %@ behält seine Kopie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ stops syncing with %@. Its playlists and history stay on it, and %@ keeps its copy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ deja de sincronizarse con %@. Sus playlists e historial se quedan allí, y %@ conserva su copia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lopettaa synkronoinnin %@:n kanssa. Sen soittolistat ja historia jäävät sinne, ja %@ säilyttää oman kopionsa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ arrête la synchronisation avec %@. Les playlists et l’historique restent en place, et %@ garde sa copie."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hættir að samstilla við %@. Spilunarlistar og ferill haldast þar, og %@ heldur sínu afriti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ smette di sincronizzarsi con %@. Le sue playlist e la cronologia restano lì, e %@ conserva la sua copia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は %@ との同期を停止します。プレイリストと履歴はそのまま残り、%@ は自分のコピーを保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) %@와의 동기화를 중단해요. 재생목록과 기록은 그대로 남고, %@은(는) 자신의 사본을 유지해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ slutter å synkronisere med %2$@. Spillelistene og historikken blir værende der, og %3$@ beholder sin kopi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ przestaje synchronizować się z %@. Jego playlisty i historia zostają tam, a %@ zachowuje swoją kopię."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ deixa de sincronizar com %@. Suas playlists e seu histórico ficam lá, e %@ mantém a sua cópia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ slutar synkronisera med %@. Dess spellistor och historik finns kvar på den, och %@ behåller sin kopia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 停止与 %@ 同步。播放列表和记录仍保留在本地，%@ 保留其副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 停止與 %@ 同步。播放列表和記錄仍保留在本機，%@ 保留其副本。"
          }
        }
      }
    },
