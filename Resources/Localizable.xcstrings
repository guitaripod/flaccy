    "That isn’t a Flaccy Server code. Scan the code from Add a Device on your Mac, or the one your server printed.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er ikke en Flaccy Server-kode. Scan koden fra »Tilføj en enhed« på din Mac, eller den, din server udskrev."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist kein Code von Flaccy Server. Scanne den Code aus „Gerät hinzufügen“ auf deinem Mac oder den, den dein Server ausgibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That isn’t a Flaccy Server code. Scan the code from Add a Device on your Mac, or the one your server printed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese no es un código de Flaccy Server. Escanea el código de «Añadir un dispositivo» en tu Mac o el que muestre tu servidor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä ei ole Flaccy Serverin koodi. Skannaa koodi Macin kohdasta ”Lisää laite” tai skannaa palvelimesi tulostama koodi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n’est pas un code de Flaccy Server. Scanne le code de « Ajouter un appareil » sur ton Mac, ou celui affiché par ton serveur."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þetta er ekki kóði frá Flaccy Server. Skannaðu kóðann úr „Bæta við tæki“ á Mac-tölvunni þinni, eða kóðann sem netþjónninn þinn prentaði út."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è un codice di Flaccy Server. Scansiona il codice da «Aggiungi un dispositivo» sul Mac o quello mostrato dal server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy Server のコードではありません。Mac の「デバイスを追加」のコードか、サーバーに表示されたコードをスキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy Server 코드가 아닙니다. Mac의 “기기 추가”에 있는 코드나 서버에 표시된 코드를 스캔하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er ikke en kode for Flaccy Server. Skann koden fra «Legg til en enhet» på Mac-en din, eller den serveren din skrev ut."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nie jest kod Flaccy Server. Zeskanuj kod z „Dodaj urządzenie” na Macu albo ten, który wyświetlił serwer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este não é um código do Flaccy Server. Escaneie o código de “Adicionar um dispositivo” no seu Mac ou o que o seu servidor exibiu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är ingen Flaccy Server-kod. Skanna koden från ”Lägg till en enhet” på din Mac, eller den som servern skrev ut."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是 Flaccy Server 的代码。请扫描 Mac 上“添加设备”中的代码，或服务器打印的代码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這不是 Flaccy Server 的代碼。請掃描 Mac 上「新增裝置」中的代碼，或伺服器印出的代碼。"
          }
        }
      }
    },
    "That isn’t a profile Flaccy can read. It understands Equalizer APO and AutoEq text.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er ikke en profil, som Flaccy kan læse. Flaccy forstår Equalizer APO- og AutoEq-tekst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist kein Profil, das Flaccy lesen kann. Flaccy versteht Equalizer-APO- und AutoEq-Text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese no es un perfil que Flaccy pueda leer. Entiende texto de Equalizer APO y AutoEq."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä ei ole profiili, jonka Flaccy osaa lukea. Flaccy ymmärtää Equalizer APO- ja AutoEq-tekstiä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n’est pas un profil que Flaccy peut lire. Il comprend le texte Equalizer APO et AutoEq."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þetta er ekki prófíll sem Flaccy getur lesið. Flaccy skilur Equalizer APO- og AutoEq-texta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è un profilo che Flaccy può leggere. Riconosce i testi di Equalizer APO e AutoEq."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccyで読み込める形式のプロファイルではありません。Flaccyが理解できるのはEqualizer APOとAutoEqのテキストです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy가 읽을 수 있는 프로파일이 아닙니다. Flaccy는 Equalizer APO와 AutoEq 텍스트를 이해합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er ikke en profil Flaccy kan lese. Den forstår Equalizer APO- og AutoEq-tekst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nie jest profil, który Flaccy potrafi odczytać. Rozumie tekst Equalizer APO i AutoEq."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse não é um perfil que o Flaccy consegue ler. Ele entende texto do Equalizer APO e do AutoEq."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här är inte en profil som Flaccy kan läsa. Flaccy förstår text från Equalizer APO och AutoEq."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是 Flaccy 能读取的配置文件。它只识别 Equalizer APO 和 AutoEq 格式的文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這不是 Flaccy 能讀取的設定檔。它只看得懂 Equalizer APO 與 AutoEq 格式的文字。"
          }
        }
      }
    },
    "That playlist is no longer in your library.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Playlisten findes ikke længere i dit bibliotek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Playlist ist nicht mehr in deiner Mediathek."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa lista ya no está en tu biblioteca."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä soittolistaa ei ole enää kirjastossasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette playlist n'est plus dans votre bibliothèque."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þessi spilunarlisti er ekki lengur í safninu þínu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa playlist non è più nella tua libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのプレイリストはもうライブラリにありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 재생목록은 더 이상 보관함에 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spillelisten finnes ikke lenger i biblioteket ditt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tej playlisty nie ma już w Twojej bibliotece."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa playlist não está mais na sua biblioteca."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den spellistan finns inte längre i ditt bibliotek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该播放列表已不在你的资料库中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該播放清單已不在你的資料庫中。"
          }
        }
      }
    },
    "That server address can’t be read. Type it like music.example.com or http://192.168.1.20:4533, then try again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveradressen kan ikke læses. Skriv den som music.example.com eller http://192.168.1.20:4533 og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Serveradresse lässt sich nicht lesen. Gib sie z. B. als music.example.com oder http://192.168.1.20:4533 ein und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede leer esa dirección de servidor. Escríbela como music.example.com o http://192.168.1.20:4533 y vuelve a intentarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä palvelimen osoitetta ei voi lukea. Kirjoita se muodossa music.example.com tai http://192.168.1.20:4533 ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette adresse de serveur est illisible. Saisis-la sous la forme music.example.com ou http://192.168.1.20:4533, puis réessaie."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki er hægt að lesa vistfang netþjónsins. Sláðu það inn eins og music.example.com eða http://192.168.1.20:4533 og reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere questo indirizzo del server. Scrivilo come music.example.com o http://192.168.1.20:4533 e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーアドレスを読み取れません。music.example.com や http://192.168.1.20:4533 のように入力して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버 주소를 읽을 수 없습니다. music.example.com 또는 http://192.168.1.20:4533 형식으로 입력한 뒤 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveradressen kan ikke leses. Skriv den slik: music.example.com eller http://192.168.1.20:4533 , og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odczytać adresu serwera. Wpisz go w postaci music.example.com lub http://192.168.1.20:4533 i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler esse endereço de servidor. Digite-o como music.example.com ou http://192.168.1.20:4533 e tente novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den serveradressen går inte att läsa. Skriv den så här: music.example.com eller http://192.168.1.20:4533 och försök igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法识别此服务器地址。请按 music.example.com 或 http://192.168.1.20:4533 的格式输入，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法辨識此伺服器位址。請依 music.example.com 或 http://192.168.1.20:4533 的格式輸入，然後再試一次。"
          }
        }
      }
    },
    "The App Store couldn't verify this purchase. Try again, or choose Restore Purchases.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store kunne ikke bekræfte dette køb. Prøv igen, eller vælg Gendan køb."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store konnte diesen Kauf nicht überprüfen. Versuche es erneut oder tippe auf „Käufe wiederherstellen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store no ha podido verificar esta compra. Inténtalo de nuevo o toca «Restaurar compras»."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store ei voinut vahvistaa tätä ostoa. Yritä uudelleen tai valitse Palauta ostot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'App Store n'a pas pu vérifier cet achat. Réessayez ou touchez « Restaurer les achats »."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store gat ekki staðfest þessi kaup. Reyndu aftur eða veldu „Endurheimta kaup“."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'App Store non ha potuto verificare questo acquisto. Riprova oppure scegli «Ripristina acquisti»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeはこの購入を確認できませんでした。もう一度お試しいただくか、購入を復元を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store에서 이 구입을 확인할 수 없습니다. 다시 시도하거나 \"구입 복원\"을 선택하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store kunne ikke bekrefte dette kjøpet. Prøv igjen, eller velg Gjenopprett kjøp."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store nie mógł zweryfikować tego zakupu. Spróbuj ponownie lub wybierz „Przywróć zakupy”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A App Store não conseguiu verificar esta compra. Tente novamente ou toque em “Restaurar compras”."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store kunde inte verifiera köpet. Försök igen eller välj Återställ köp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 无法验证此购买。请重试或选择恢复购买。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 無法驗證此購買。請再試一次，或選擇「回復購買項目」。"
          }
        }
      }
    },
