    "Nothing here right now.\nYour library already covers it.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet her lige nu.\nDit bibliotek dækker det allerede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier ist gerade nichts.\nDeine Mediathek deckt schon alles ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí no hay nada ahora mismo.\nTu biblioteca ya lo cubre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Täällä ei ole juuri nyt mitään.\nKirjastosi kattaa jo kaiken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ici pour l'instant.\nVotre bibliothèque couvre déjà tout."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekkert hér í augnablikinu.\nSafnið þitt nær nú þegar yfir þetta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui non c'è nulla al momento.\nLa tua libreria copre già tutto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今のところ何もありません。\nライブラリがすでにカバーしています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 여기에 아무것도 없습니다.\n보관함이 이미 다 채우고 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting her akkurat nå.\nBiblioteket ditt dekker allerede alt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic tu teraz nie ma.\nTwoja biblioteka już to obejmuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada aqui por enquanto.\nSua biblioteca já cobre isso."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget här just nu.\nDitt bibliotek täcker redan det."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在这里没有内容。\n你的资料库已经覆盖了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在這裡沒有內容。\n你的資料庫已經都有了。"
          }
        }
      }
    },
    "Nothing here yet": {
      "localizations": {
