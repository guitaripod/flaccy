          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动控制点或输入数值。曲线会经过每一个控制点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
