    "H2-chip AirPods get lossless wirelessly only with Apple Vision Pro, over a proprietary 5 GHz link — not standard Bluetooth.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods mit H2-Chip bekommen verlustfreies Audio drahtlos nur mit Apple Vision Pro über eine proprietäre 5-GHz-Verbindung – nicht über normales Bluetooth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los AirPods con chip H2 reciben lossless por vía inalámbrica solo con el Apple Vision Pro, mediante un enlace propietario de 5 GHz, no por Bluetooth estándar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les AirPods à puce H2 reçoivent le lossless sans fil uniquement avec l'Apple Vision Pro, via une liaison propriétaire 5 GHz — pas en Bluetooth standard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli AirPods con chip H2 ricevono il lossless senza fili solo con Apple Vision Pro, tramite un collegamento proprietario a 5 GHz, non con il Bluetooth standard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "H2チップ搭載のAirPodsがワイヤレスでロスレスを受け取れるのはApple Vision Proと組み合わせたときだけで、独自の5 GHzリンクを使います。標準のBluetoothではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "H2 칩이 들어간 AirPods가 무선으로 무손실을 받는 경우는 Apple Vision Pro와 함께 쓸 때뿐이며, 표준 블루투스가 아니라 독자 5GHz 연결을 사용합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods z chipem H2 uzyskują dźwięk bezstratny bezprzewodowo tylko z Apple Vision Pro, przez zastrzeżone łącze 5 GHz — nie standardowy Bluetooth."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods com chip H2 só recebem lossless sem fio com o Apple Vision Pro, por um enlace proprietário de 5 GHz — não pelo Bluetooth padrão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搭载 H2 芯片的 AirPods 只有配合 Apple Vision Pro 才能无线获得无损，走的是专有的 5 GHz 连接，而不是标准蓝牙。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搭載 H2 晶片的 AirPods 只有搭配 Apple Vision Pro 才能無線取得無損，走的是專屬的 5 GHz 連線，而不是標準藍牙。"
          }
        }
      }
    },
