    "An output you connect shows up here once it remembers a profile.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et output, du forbinder, vises her, når det har gemt en profil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ausgang, den du verbindest, erscheint hier, sobald er ein Profil gespeichert hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una salida que conectes aparecerá aquí cuando recuerde un perfil."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistämäsi ulostulo näkyy tässä, kun se on muistanut profiilin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une sortie que vous connectez apparaît ici dès qu'elle mémorise un profil."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Úttak sem þú tengir birtist hér þegar það hefur vistað prófíl."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'uscita collegata appare qui quando ricorda un profilo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続した出力は、プロファイルを記憶するとここに表示されます。"
