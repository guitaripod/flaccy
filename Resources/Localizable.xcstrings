          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A imagem escolhida será removida e a playlist voltará a um mosaico de seus álbuns."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选图片将被移除，播放列表将恢复为其专辑的拼贴图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選圖片將被移除，播放列表將恢復為其專輯的拼貼圖。"
          }
        }
      }
    },
