    "Cleaned up %lld duplicates and %lld editions.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld Duplikate und %2$lld Editionen aufgeräumt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Cleaned up %1$lld duplicates and %2$lld editions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se limpiaron %1$lld duplicados y %2$lld ediciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld doublons et %2$lld éditions nettoyés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puliti %1$lld duplicati e %2$lld edizioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重複%1$lld件とエディション%2$lld件を整理しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중복 %1$lld개와 에디션 %2$lld개를 정리했습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporządkowano %1$#@arg1@ i %2$#@arg2@."
          },
          "substitutions": {
            "arg1": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "few": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg duplikaty"
                    }
                  },
                  "many": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg duplikatów"
                    }
                  },
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg duplikat"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg duplikatu"
                    }
                  }
                }
              }
            },
            "arg2": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "few": {
