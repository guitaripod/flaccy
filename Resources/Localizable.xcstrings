            "state": "translated",
            "value": "最も小さいファイル。長い旅でも最も多くの音楽を入れられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 작은 파일. 긴 여행에도 가장 많은 음악을 담을 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De minste filene. Får plass til mest mulig musikk på lange reiser."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najmniejsze pliki. Mieści najwięcej muzyki na długie podróże."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
