    "Connect your iPhone to a Mac, select it in the Finder sidebar, open the Files tab and drag songs or folders onto Flaccy.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde dein iPhone mit einem Mac, wähle es in der Finder-Seitenleiste aus, öffne den Tab „Dateien“ und ziehe Titel oder Ordner auf Flaccy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta tu iPhone a un Mac, selecciónalo en la barra lateral del Finder, abre la pestaña Archivos y arrastra canciones o carpetas a Flaccy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Branchez votre iPhone à un Mac, sélectionnez-le dans la barre latérale du Finder, ouvrez l'onglet Fichiers et faites glisser des morceaux ou des dossiers sur Flaccy."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega l'iPhone a un Mac, selezionalo nella barra laterale del Finder, apri la scheda File e trascina brani o cartelle su Flaccy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneをMacに接続し、Finderのサイドバーで選択して「ファイル」タブを開き、曲やフォルダをFlaccyにドラッグします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone을 Mac에 연결하고 Finder 사이드바에서 선택한 다음 파일 탭을 열어 곡이나 폴더를 Flaccy로 드래그하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podłącz iPhone’a do Maca, wybierz go na pasku bocznym Findera, otwórz kartę Pliki i przeciągnij utwory lub foldery na Flaccy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte o iPhone a um Mac, selecione-o na barra lateral do Finder, abra a aba Arquivos e arraste músicas ou pastas para o Flaccy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用数据线将 iPhone 连接到 Mac，在访达边栏中选择它，打开“文件”标签页，然后将歌曲或文件夹拖到 Flaccy 上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用傳輸線將 iPhone 連接到 Mac，在 Finder 側邊欄中選取它，打開「檔案」標籤頁，然後將歌曲或資料夾拖到 Flaccy 上。"
          }
        }
      }
    },
