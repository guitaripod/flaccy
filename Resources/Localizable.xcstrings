    "Send it over Wi-Fi from the computer's web browser, or stream all of it with Flaccy Server. Both free.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Send den over Wi-Fi fra computerens webbrowser, eller stream det hele med Flaccy Server. Begge dele er gratis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sende sie per WLAN aus dem Webbrowser des Computers oder streame alles mit Flaccy Server. Beides kostenlos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envíala por Wi-Fi desde el navegador del ordenador o escúchala entera en streaming con Flaccy Server. Ambas opciones son gratis."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetä se Wi-Fi-yhteydellä tietokoneen selaimesta tai suoratoista kaikki Flaccy Serverin kautta. Molemmat ovat ilmaisia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez-la par Wi-Fi depuis le navigateur de l'ordinateur, ou diffusez-la en entier avec Flaccy Server. Les deux sont gratuits."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendu hana yfir Wi-Fi úr vafra tölvunnar, eða streymdu allri tónlistinni með Flaccy Server. Hvort tveggja er ókeypis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inviala via Wi-Fi dal browser del computer, oppure ascoltala tutta in streaming con Flaccy Server. Entrambi gratis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピュータのWebブラウザからWi-Fiで転送するか、Flaccy Serverですべてをストリーミング。どちらも無料です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터의 웹 브라우저에서 Wi-Fi로 보내거나, Flaccy Server로 전부 스트리밍하세요. 둘 다 무료입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Send den over Wi-Fi fra datamaskinens nettleser, eller strøm alt med Flaccy Server. Begge er gratis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyślij ją przez Wi-Fi z przeglądarki na komputerze albo strumieniuj całość przez Flaccy Server. Oba sposoby są darmowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie por Wi-Fi pelo navegador do computador ou transmita tudo com o Flaccy Server. Ambos grátis."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skicka över Wi-Fi från datorns webbläsare, eller streama allt med Flaccy Server. Båda är gratis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过电脑的网页浏览器用 Wi-Fi 传过来，或用 Flaccy Server 串流全部音乐。两种方式都免费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過電腦的網頁瀏覽器用 Wi-Fi 傳過來，或用 Flaccy Server 串流全部音樂。兩種方式都免費。"
          }
        }
      }
    },
