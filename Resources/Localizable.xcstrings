    "Nothing queued — play an album to fill Up Next.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet i kø – afspil et album for at fylde Næste op."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts in der Warteschlange – spiele ein Album, um „Als Nächstes“ zu füllen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cola vacía: reproduce un álbum para llenar A continuación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonossa ei ole mitään. Toista albumi, niin Seuraavana täyttyy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "File vide — lancez un album pour remplir À suivre."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Engin lög í biðröð – spilaðu plötu til að fylla „Næst“."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Coda vuota: riproduci un album per riempire Successivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キューは空です — アルバムを再生して次に再生を埋めましょう。"
