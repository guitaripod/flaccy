    "Your Watch hasn’t answered yet. Open Flaccy on the Watch to wake it up.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Watch hat noch nicht geantwortet. Öffne Flaccy auf der Watch, um sie aufzuwecken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Watch aún no ha respondido. Abre Flaccy en el Watch para despertarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta Watch n’a pas encore répondu. Ouvre Flaccy sur la Watch pour la réveiller."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo Watch non ha ancora risposto. Apri Flaccy sul Watch per svegliarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Watchからまだ応答がありません。Watchで Flaccy を開いて起こしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch가 아직 응답하지 않습니다. Watch에서 Flaccy를 열어 깨우세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch jeszcze nie odpowiedział. Otwórz Flaccy na Watchu, aby go obudzić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu Watch ainda não respondeu. Abra o Flaccy no Watch para acordá-lo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch 尚未响应。请在 Watch 上打开 Flaccy 将其唤醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch 尚未回應。請在 Watch 上打開 Flaccy 將其喚醒。"
          }
        }
      }
    },
    "Your Watch hasn’t answered yet. Raise your wrist or open Flaccy on it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Watch hat noch nicht geantwortet. Hebe dein Handgelenk oder öffne Flaccy darauf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Watch aún no ha respondido. Levanta la muñeca o abre Flaccy en él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta Watch n’a pas encore répondu. Lève le poignet ou ouvre Flaccy dessus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo Watch non ha ancora risposto. Alza il polso o apri Flaccy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Watchからまだ応答がありません。手首を上げるか、Watchで Flaccy を開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch가 아직 응답하지 않습니다. 손목을 들거나 Watch에서 Flaccy를 여세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch jeszcze nie odpowiedział. Unieś nadgarstek lub otwórz na nim Flaccy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu Watch ainda não respondeu. Levante o pulso ou abra o Flaccy nele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch 尚未响应。抬起手腕或在 Watch 上打开 Flaccy。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch 尚未回應。抬起手腕或在 Watch 上打開 Flaccy。"
          }
        }
      }
    },
    "Your Watch isn’t nearby, is asleep, or Flaccy isn’t open on it. Raise your wrist or open Flaccy on the Watch.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Watch ist nicht in der Nähe, schläft oder Flaccy ist darauf nicht geöffnet. Hebe dein Handgelenk oder öffne Flaccy auf der Watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Watch no está cerca, está dormido o Flaccy no está abierto en él. Levanta la muñeca o abre Flaccy en el Watch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta Watch n’est pas à proximité, est en veille, ou Flaccy n’y est pas ouvert. Lève le poignet ou ouvre Flaccy sur la Watch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo Watch non è vicino, è in stop o Flaccy non è aperto. Alza il polso o apri Flaccy sul Watch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Watchが近くにないか、スリープ中か、Flaccyが開いていません。手首を上げるか、Watchで Flaccy を開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch가 가까이 없거나 잠자고 있거나 Flaccy가 열려 있지 않습니다. 손목을 들거나 Watch에서 Flaccy를 여세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch nie jest w pobliżu, śpi albo Flaccy nie jest na nim otwarte. Unieś nadgarstek lub otwórz Flaccy na Watchu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu Watch não está por perto, está em repouso ou o Flaccy não está aberto nele. Levante o pulso ou abra o Flaccy no Watch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch 不在附近、处于休眠状态，或未打开 Flaccy。抬起手腕或在 Watch 上打开 Flaccy。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch 不在附近、處於休眠狀態，或未打開 Flaccy。抬起手腕或在 Watch 上打開 Flaccy。"
          }
        }
      }
    },
