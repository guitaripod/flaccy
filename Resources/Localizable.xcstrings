    "Couldn't create “%@” — the library database couldn't be written. Check free disk space and try again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "»%@« kunne ikke oprettes – biblioteksdatabasen kunne ikke skrives. Kontrollér ledig lagerplads, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ konnte nicht erstellt werden – die Mediathek-Datenbank ließ sich nicht schreiben. Prüfe den freien Speicherplatz und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo crear “%@”: la base de datos de la biblioteca no se pudo escribir. Revisa el espacio libre del disco e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei voitu luoda ”%@”: kirjaston tietokantaan ei voitu kirjoittaa. Tarkista vapaa levytila ja yritä uudelleen."
