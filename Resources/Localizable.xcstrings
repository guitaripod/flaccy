            "state": "translated",
            "value": "Die aktuellen Versionen bleiben 30 Tage lang unter „Frühere Versionen“ erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las versiones actuales se conservan en Versiones anteriores durante 30 días."
