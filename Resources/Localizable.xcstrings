    "Listening clock. Peak hour %lld hundred hours, with %lld plays.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hör-Uhr. Spitzenstunde %1$lld Uhr mit %2$lld Wiedergaben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Listening clock. Peak hour %1$lld hundred hours, with %2$lld plays."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reloj de escucha. Hora punta: %1$lld horas, con %2$lld reproducciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Horloge d'écoute. Heure de pointe %1$lld heures, avec %2$lld écoutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Orologio degli ascolti. Ora di punta: %1$lld, con %2$lld ascolti."
          }
