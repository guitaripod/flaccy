    "Jump Back In": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsæt, hvor du slap"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wieder einsteigen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retomar"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jatka siitä, mihin jäit"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprendre"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Halda áfram"
          }
        },
        "it": {
