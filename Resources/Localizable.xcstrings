    "The audio file from \"%@\" will be removed from this device.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lydfilen fra »%@« fjernes fra denne enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Audiodatei von \"%@\" wird von diesem Gerät entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The audio file from \"%@\" will be removed from this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo de audio de \"%@\" se eliminará de este dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Audiotiedosto kohteesta ”%@” poistetaan tältä laitteelta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier audio de \"%@\" sera supprimé de cet appareil."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hljóðskráin úr „%@“ verður fjarlægð af þessu tæki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file audio di \"%@\" verrà rimosso da questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" の音声ファイルはこのデバイスから削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\"의 오디오 파일이 이 기기에서 삭제됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lydfilen fra «%@» blir fjernet fra denne enheten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik audio z \"%@\" zostanie usunięty z tego urządzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo de áudio de \"%@\" será removido deste dispositivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljudfilen från ”%@” tas bort från den här enheten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自 \"%@\" 的音频文件将从此设备中移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來自 \"%@\" 的音訊檔案將從此裝置中移除。"
          }
        }
      }
    },
    "The audio file will be moved to the Trash and removed from your library.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lydfilen flyttes til Papirkurv og fjernes fra dit bibliotek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Audiodatei wandert in den Papierkorb und wird aus deiner Mediathek entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo de audio se moverá a la papelera y se eliminará de tu biblioteca."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Audiotiedosto siirretään roskakoriin ja poistetaan kirjastostasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier audio sera placé dans la corbeille et retiré de votre bibliothèque."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hljóðskráin verður færð í ruslakörfuna og fjarlægð úr safninu þínu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file audio verrà spostato nel Cestino e rimosso dalla libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーディオファイルはゴミ箱に移動し、ライブラリから削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오 파일은 휴지통으로 이동하고 보관함에서 제거됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lydfilen flyttes til Papirkurven og fjernes fra biblioteket ditt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik audio zostanie przeniesiony do Kosza i usunięty z twojej biblioteki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo de áudio será movido para o Lixo e removido da sua biblioteca."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljudfilen flyttas till Papperskorgen och tas bort från ditt bibliotek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频文件将被移到废纸篓，并从资料库中移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊檔案會被移到垃圾桶，並從資料庫中移除。"
          }
        }
      }
    },
