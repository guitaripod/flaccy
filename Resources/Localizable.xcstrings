    "%lld songs stopped after repeated attempts. Retry to send them again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Titel wurden nach mehreren Versuchen gestoppt. Erneut versuchen, um sie noch einmal zu senden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detuvieron %lld canciones tras varios intentos. Reintenta para volver a enviarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld morceaux arrêtés après plusieurs tentatives. Réessayez pour les renvoyer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld brani interrotti dopo ripetuti tentativi. Riprova per inviarli di nuovo."
