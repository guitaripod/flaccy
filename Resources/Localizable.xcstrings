        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobieranie zostało przerwane. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O download foi interrompido. Tente novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hämtningen avbröts. Försök igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载已中断。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載已中斷。請再試一次。"
          }
        }
      }
    },
    "The equalizer only shapes what Flaccy plays. Other apps and system sounds are untouched.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Equalizeren former kun det, Flaccy afspiller. Andre apps og systemlyde påvirkes ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Equalizer formt nur, was Flaccy abspielt. Andere Apps und Systemklänge bleiben unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ecualizador solo modifica lo que reproduce Flaccy. Otras apps y los sonidos del sistema no se ven afectados."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Equalizer muokkaa vain Flaccyn toistamaa ääntä. Muut sovellukset ja järjestelmän äänet eivät muutu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'égaliseur ne modifie que ce que lit Flaccy. Les autres applications et les sons système ne sont pas touchés."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tónjafnarinn hefur aðeins áhrif á það sem Flaccy spilar. Önnur forrit og kerfishljóð haldast óbreytt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'equalizzatore modifica solo ciò che riproduce Flaccy. Le altre app e i suoni di sistema restano invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イコライザはFlaccyの再生音だけを調整します。他のアプリやシステムの音には影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이퀄라이저는 Flaccy 재생음에만 적용됩니다. 다른 앱과 시스템 소리는 그대로입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Equalizeren påvirker bare det Flaccy spiller av. Andre apper og systemlyder blir ikke endret."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Korektor dźwięku zmienia tylko to, co odtwarza Flaccy. Inne aplikacje i dźwięki systemowe pozostają bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O equalizador altera apenas o que o Flaccy toca. Outros apps e sons do sistema não são afetados."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Equalizern påverkar bara det Flaccy spelar upp. Andra appar och systemljud påverkas inte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "均衡器只调整 Flaccy 播放的声音，其他 App 和系统声音不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等化器只調整 Flaccy 播放的聲音，其他 App 與系統音效不受影響。"
          }
        }
      }
    },
    "The lyrics server answered HTTP %lld instead of lyrics. Trying again is harmless, but this one may need an update to Flaccy.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sangtekst-serveren svarede med HTTP %lld i stedet for sangtekster. Et nyt forsøg skader ikke, men denne fejl kræver måske en opdatering af Flaccy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Songtext-Server hat mit HTTP %lld statt mit Songtext geantwortet. Ein erneuter Versuch schadet nicht, dieser Fehler könnte aber ein Update für Flaccy erfordern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de letras respondió HTTP %lld en lugar de la letra. Volver a intentarlo no hace daño, pero este caso puede requerir una actualización de Flaccy."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanoituspalvelin vastasi HTTP-koodilla %lld sanoitusten sijaan. Uudelleen yrittäminen ei haittaa, mutta tämä virhe saattaa vaatia Flaccyn päivityksen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur de paroles a répondu HTTP %lld au lieu des paroles. Réessayer ne pose aucun problème, mais ce cas peut nécessiter une mise à jour de Flaccy."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Textanetþjónninn svaraði með HTTP %lld í stað texta. Það er í lagi að reyna aftur, en þessi villa gæti krafist uppfærslu á Flaccy."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server dei testi ha risposto HTTP %lld invece del testo. Riprovare non causa problemi, ma questo caso potrebbe richiedere un aggiornamento di Flaccy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "歌詞サーバがHTTP %lldを返し、歌詞は返されませんでした。再試行しても問題ありませんが、Flaccyのアップデートが必要な場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가사 서버가 가사 대신 HTTP %lld를 응답했습니다. 다시 시도해도 괜찮지만, Flaccy 업데이트가 필요할 수도 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjenesten for sangtekster svarte med HTTP %lld i stedet for sangtekster. Det er ufarlig å prøve igjen, men denne feilen kan kreve en oppdatering av Flaccy."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer tekstów odpowiedział kodem HTTP %lld zamiast tekstem. Ponowna próba nie zaszkodzi, ale ten przypadek może wymagać aktualizacji Flaccy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor de letras respondeu HTTP %lld em vez da letra. Tentar de novo não faz mal, mas este caso pode exigir uma atualização do Flaccy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låttextservern svarade med HTTP %lld i stället för låttexter. Det är ofarligt att försöka igen, men felet kan kräva en uppdatering av Flaccy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "歌词服务器返回了 HTTP %lld 而不是歌词。再试一次没有坏处，但此问题可能需要更新 Flaccy 才能解决。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歌詞伺服器回傳了 HTTP %lld 而非歌詞。再試一次不會有影響，但此問題可能需要更新 Flaccy 才能解決。"
          }
        }
      }
    },
    "The lyrics server answered with an error (HTTP %lld). These usually clear up within a few minutes.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sangtekst-serveren svarede med en fejl (HTTP %lld). Den slags går som regel over i løbet af få minutter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Songtext-Server hat mit einem Fehler geantwortet (HTTP %lld). Das legt sich meist innerhalb weniger Minuten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de letras respondió con un error (HTTP %lld). Normalmente se resuelve en unos minutos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanoituspalvelin vastasi virheellä (HTTP %lld). Tällaiset virheet menevät yleensä ohi muutamassa minuutissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur de paroles a répondu par une erreur (HTTP %lld). Cela se résout généralement en quelques minutes."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Textanetþjónninn svaraði með villu (HTTP %lld). Þetta lagast venjulega innan nokkurra mínútna."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server dei testi ha risposto con un errore (HTTP %lld). Di solito si risolve in pochi minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "歌詞サーバがエラー（HTTP %lld）を返しました。通常は数分以内に解消します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가사 서버가 오류(HTTP %lld)로 응답했습니다. 보통 몇 분 안에 해결됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjenesten for sangtekster svarte med en feil (HTTP %lld). Dette går vanligvis over i løpet av få minutter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer tekstów odpowiedział błędem (HTTP %lld). Zwykle problem znika w ciągu kilku minut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor de letras respondeu com um erro (HTTP %lld). Isso costuma se resolver em alguns minutos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låttextservern svarade med ett fel (HTTP %lld). De brukar gå över inom några minuter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "歌词服务器返回了错误（HTTP %lld）。这类问题通常几分钟内会恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歌詞伺服器回傳了錯誤（HTTP %lld）。這類問題通常幾分鐘內就會恢復。"
          }
        }
      }
    },
    "The lyrics server asked Flaccy to slow down and still hadn't room after a retry. Give it a minute and try again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sangtekst-serveren bad Flaccy om at sætte farten ned, og efter et nyt forsøg var der stadig ingen plads. Vent et minut, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Songtext-Server hat Flaccy gebeten, langsamer zu werden, und nach einem erneuten Versuch war immer noch kein Platz frei. Warte eine Minute und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de letras pidió a Flaccy que bajara el ritmo y, tras reintentar, seguía sin capacidad. Espera un minuto e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanoituspalvelin pyysi Flaccya hidastamaan, eikä palvelimella ollut vapaata kapasiteettia uudenkaan yrityksen jälkeen. Odota hetki ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur de paroles a demandé à Flaccy de ralentir, et après un nouvel essai il n’avait toujours pas de capacité. Attendez une minute et réessayez."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Textanetþjónninn bað Flaccy um að hægja á sér og enn var ekkert svigrúm eftir endurtilraun. Bíddu í eina mínútu og reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server dei testi ha chiesto a Flaccy di rallentare e, dopo un nuovo tentativo, non aveva ancora capacità. Attendi un minuto e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "歌詞サーバがFlaccyに速度を落とすよう求め、再試行後もまだ余裕がありませんでした。1分ほど待ってから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가사 서버가 Flaccy에 속도를 줄이라고 요청했고, 재시도 후에도 여유가 없었습니다. 1분 기다렸다가 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjenesten for sangtekster ba Flaccy om å senke farten, og etter et nytt forsøk var den fortsatt overbelastet. Vent et minutt, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer tekstów poprosił Flaccy o zwolnienie, a po ponownej próbie nadal nie miał wolnych zasobów. Odczekaj minutę i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor de letras pediu ao Flaccy que desacelerasse e, depois de uma nova tentativa, ainda não tinha capacidade. Aguarde um minuto e tente novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låttextservern bad Flaccy att sakta ner, och den var fortfarande överbelastad efter ett nytt försök. Vänta en minut och försök igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "歌词服务器要求 Flaccy 放慢速度，重试后仍然没有余量。请等待一分钟后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歌詞伺服器要求 Flaccy 放慢速度，重試後仍然沒有餘裕。請等待一分鐘後再試一次。"
          }
        }
      }
    },
    "The menu bar player shows the current track with transport and love controls.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afspilleren i menulinjen viser den aktuelle sang med afspilningsknapper og knapper til Synes godt om."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Menüleisten-Player zeigt den aktuellen Titel samt Steuerung und Favoriten-Herz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reproductor de la barra de menús muestra la pista actual con los controles y el corazón."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valikkopalkin soitin näyttää nykyisen kappaleen, toistonohjaimet ja Tykkää-painikkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lecteur de la barre des menus affiche le morceau en cours avec les commandes de lecture et le cœur."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Spilarinn í valmyndastikunni sýnir núverandi lag ásamt spilunarstýringum og Líka við."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il player nella barra dei menu mostra il brano in corso con i comandi di riproduzione e il cuore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバープレイヤーには再生中の曲と再生操作、お気に入りボタンが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대 플레이어는 현재 트랙과 재생 조작, 좋아요 버튼을 보여 줍니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Menylinjespilleren viser gjeldende sang med avspillingsknapper og Lik."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwarzacz na pasku menu pokazuje bieżący utwór z kontrolkami odtwarzania i ulubionych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O player da barra de menus mostra a faixa atual com os controles de reprodução e o coração."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyradsspelaren visar den aktuella låten med uppspelningskontroller och gilla-knappar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单栏播放器会显示当前曲目，并提供播放控制和喜欢按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選單列播放器會顯示目前的曲目，並提供播放控制和喜愛按鈕。"
          }
        }
      }
    },
    "The metadata sources are busy. Try “%@” again in a few minutes.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadatakilderne er travle. Prøv »%@« igen om et par minutter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Metadatenquellen sind ausgelastet. Versuche „%@“ in ein paar Minuten erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fuentes de metadatos están ocupadas. Vuelve a intentar “%@” dentro de unos minutos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Metatietolähteet ovat ruuhkautuneet. Yritä ”%@” uudelleen muutaman minuutin kuluttua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sources de métadonnées sont occupées. Réessayez « %@ » dans quelques minutes."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Lýsigagnaveiturnar eru uppteknar. Reyndu „%@“ aftur eftir nokkrar mínútur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fonti dei metadati sono occupate. Riprova “%@” tra qualche minuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メタデータソースが混み合っています。数分後に「%@」をもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메타데이터 소스가 바쁩니다. 몇 분 후에 “%@”을(를) 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadatakildene er travle. Prøv «%@» igjen om noen minutter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Źródła metadanych są zajęte. Spróbuj ponownie „%@” za kilka minut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fontes de metadados estão ocupadas. Tente “%@” novamente em alguns minutos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadatakällorna är upptagna. Försök igen med ”%@” om några minuter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "元数据来源繁忙。请几分钟后再次尝试“%@”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中繼資料來源忙碌中。請幾分鐘後再次嘗試「%@」。"
          }
        }
      }
    },
    "The metadata sources have nothing new for “%@”.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadatakilderne har intet nyt til »%@«."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Metadatenquellen haben für „%@“ nichts Neues."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fuentes de metadatos no tienen nada nuevo para “%@”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Metatietolähteissä ei ole uutta kohteelle ”%@”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sources de métadonnées n’ont rien de nouveau pour « %@ »."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Lýsigagnaveiturnar hafa ekkert nýtt fyrir „%@“."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fonti dei metadati non hanno nulla di nuovo per “%@”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メタデータソースに「%@」の新しい情報はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메타데이터 소스에 “%@”에 대한 새 정보가 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadatakildene har ingenting nytt for «%@»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Źródła metadanych nie mają nic nowego dla „%@”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fontes de metadados não têm nada novo para “%@”."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadatakällorna har inget nytt för ”%@”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "元数据来源中没有“%@”的新信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中繼資料來源中沒有「%@」的新資訊。"
          }
        }
      }
    },
    "The music there is in %lld zip archives. Double-click each in the Finder to unzip it, then add the folders they make.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Musikken dér ligger i %lld zip-arkiver. Dobbeltklik på hvert i Finder for at pakke det ud, og tilføj derefter de mapper, de danner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Musik dort liegt in %lld ZIP-Archiven. Doppelklicke jedes im Finder, um es zu entpacken, und füge dann die entstandenen Ordner hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La música está en %lld archivos ZIP. Haz doble clic en cada uno en el Finder para descomprimirlo y luego añade las carpetas que se crean."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Musiikki on siellä %lld ZIP-arkistossa. Kaksoisnapsauta jokaista Finderissa purkaaksesi sen, ja lisää sitten syntyneet kansiot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La musique se trouve dans %lld archives ZIP. Double-cliquez sur chacune dans le Finder pour la décompresser, puis ajoutez les dossiers créés."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tónlistin þar er í %lld ZIP-skjalasöfnum. Tvísmelltu á hvert í Finder til að pakka því út og bættu síðan við möppunum sem verða til."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La musica è in %lld archivi ZIP. Fai doppio clic su ciascuno nel Finder per decomprimerlo, poi aggiungi le cartelle che crea."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音楽は%lld個のZIPアーカイブの中にあります。Finderで各ZIPをダブルクリックして展開し、できたフォルダを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악은 ZIP 아카이브 %lld개 안에 있습니다. Finder에서 각각 더블클릭해 압축을 푼 뒤, 만들어진 폴더를 추가하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Musikken der ligger i %lld zip-arkiver. Dobbeltklikk på hvert i Finder for å pakke det ut, og legg deretter til mappene som blir laget."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Muzyka jest w %lld archiwach ZIP. Kliknij dwukrotnie każde w Finderze, aby je rozpakować, a następnie dodaj powstałe foldery."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A música está em %lld arquivos ZIP. Clique duas vezes em cada um no Finder para descompactá-lo e depois adicione as pastas criadas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Musiken där finns i %lld zip-arkiv. Dubbelklicka på var och en i Finder för att packa upp den och lägg sedan till mapparna som skapas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音乐位于 %lld 个 ZIP 压缩包中。请在 Finder 中双击每个压缩包进行解压，然后添加解压出的文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音樂位於 %lld 個 ZIP 壓縮檔中。請在 Finder 中逐一雙擊壓縮檔進行解壓縮，然後加入解壓出的資料夾。"
          }
        }
      }
    },
