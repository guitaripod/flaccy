    "When this output connects, Flaccy switches to its profile by itself and says so with a short banner.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når dette output forbindes, skifter Flaccy automatisk til sin profil og viser det i et kort banner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald dieser Ausgang verbunden wird, wechselt Flaccy von selbst zu seinem Profil und zeigt das kurz per Banner an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando esta salida se conecte, Flaccy cambia a su perfil automáticamente y lo indica con un breve aviso."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun tämä ulostulo yhdistyy, Flaccy vaihtaa profiiliinsa itse ja kertoo siitä lyhyellä bannerilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dès que cette sortie se connecte, Flaccy passe automatiquement à son profil et l'annonce brièvement."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þegar þetta úttak tengist skiptir Flaccy sjálfkrafa yfir í prófílinn sitt og lætur vita af því með stuttum borða."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando questa uscita si connette, Flaccy passa da solo al suo profilo e lo segnala con un breve banner."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この出力が接続されると、Flaccyは自動でそのプロファイルに切り替え、短いバナーでお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 출력이 연결되면 Flaccy가 자동으로 해당 프로파일로 전환하고 짧은 배너로 알려줍니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når denne utgangen kobles til, bytter Flaccy selv til profilen sin og gir beskjed om det med et kort banner."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy to wyjście się połączy, Flaccy sam przełączy się na jego profil i pokaże krótki baner."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando esta saída conectar, o Flaccy troca para o perfil dela sozinho e avisa com um banner curto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När den här utgången ansluts byter Flaccy till sin profil av sig själv och visar det med en kort banderoll."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此输出连接时，Flaccy 会自动切换到其配置文件，并通过简短横幅提示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此輸出連接時，Flaccy 會自動切換到其設定檔，並以簡短橫幅提示。"
          }
        }
      }
    },
