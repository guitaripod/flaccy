        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함에 비슷한 아티스트가 아직 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen lignende artister i biblioteket ditt ennå."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak podobnych wykonawców w twojej bibliotece."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há artistas parecidos na sua biblioteca."
          }
        },
        "sv": {
