    "Add songs and folders from Files, iCloud Drive or a USB drive.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj sange og mapper fra Filer, iCloud Drev eller et USB-drev."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Songs und Ordner aus Dateien, iCloud Drive oder von einem USB-Laufwerk hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade canciones y carpetas desde Archivos, iCloud Drive o una unidad USB."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää kappaleita ja kansioita Tiedostot-sovelluksesta, iCloud Drivesta tai USB-asemalta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des morceaux et des dossiers depuis Fichiers, iCloud Drive ou une clé USB."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Bættu lögum og möppum við úr Skrám, iCloud Drive eða USB-drifi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi brani e cartelle da File, iCloud Drive o un'unità USB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ファイル」、iCloud Drive、USBドライブから曲やフォルダを追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 앱, iCloud Drive 또는 USB 드라이브에서 노래와 폴더를 추가하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til sanger og mapper fra Filer, iCloud Drive eller en USB-stasjon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj utwory i foldery z Plików, iCloud Drive lub dysku USB."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione músicas e pastas do Arquivos, do iCloud Drive ou de um pendrive."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till låtar och mappar från Filer, iCloud Drive eller en USB-enhet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“文件”、iCloud 云盘或 USB 驱动器添加歌曲和文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從「檔案」、iCloud 雲碟或 USB 磁碟加入歌曲與檔案夾。"
          }
        }
      }
    },
    "Add songs from the Files app, a NAS or your computer, or start with a free sample album.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj sange fra appen Filer, en NAS eller din computer, eller start med et gratis eksempelalbum."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Songs aus der Dateien-App, von einem NAS oder deinem Computer hinzu – oder starte mit einem kostenlosen Beispielalbum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade canciones desde la app Archivos, un NAS o tu ordenador, o empieza con un álbum de muestra gratuito."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää kappaleita Tiedostot-sovelluksesta, NAS-laitteelta tai tietokoneeltasi, tai aloita ilmaisella esimerkkialbumilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des morceaux depuis l'app Fichiers, un NAS ou votre ordinateur, ou commencez avec un album d'exemple gratuit."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Bættu lögum við úr Skrám-forritinu, NAS-tæki eða tölvunni þinni, eða byrjaðu með ókeypis sýnishornsplötu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi brani dall'app File, da un NAS o dal computer, oppure inizia con un album di esempio gratuito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルAppやNAS、コンピュータから曲を追加するか、無料のサンプルアルバムから始めましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 앱, NAS 또는 컴퓨터에서 노래를 추가하거나 무료 샘플 앨범으로 시작하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til sanger fra Filer-appen, en NAS eller datamaskinen din, eller start med et gratis eksempelalbum."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj utwory z aplikacji Pliki, z serwera NAS lub komputera albo zacznij od darmowego albumu przykładowego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione músicas do app Arquivos, de um NAS ou do seu computador, ou comece com um álbum de amostra gratuito."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till låtar från appen Filer, en NAS eller din dator, eller börja med ett gratis exempelalbum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“文件”App、NAS 或电脑添加歌曲，或先试听免费的示例专辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從「檔案」App、NAS 或電腦加入歌曲，或先從免費的範例專輯開始。"
          }
        }
      }
    },
    "Add songs or whole folders from iCloud Drive, a USB drive, or a network share you've connected in the Files app.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj sange eller hele mapper fra iCloud Drev, et USB-drev eller en netværksdeling, du har forbundet i appen Filer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Titel oder ganze Ordner aus iCloud Drive, einem USB-Laufwerk oder einer Netzwerkfreigabe hinzu, die du in der App „Dateien“ verbunden hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade canciones o carpetas completas desde iCloud Drive, una unidad USB o un recurso compartido de red que has conectado en la app “Archivos”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää kappaleita tai kokonaisia kansioita iCloud Drivesta, USB-asemalta tai Tiedostot-sovelluksessa yhdistämältäsi verkkojaosta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des morceaux ou des dossiers entiers depuis iCloud Drive, un disque USB ou un partage réseau que vous avez connecté dans l'app « Fichiers »."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Bættu lögum eða heilum möppum við úr iCloud Drive, USB-drifi eða netdeilingu sem þú hefur tengt í Skrám."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi brani o intere cartelle da iCloud Drive, un'unità USB o una condivisione di rete che hai collegato nell'app “File”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive、USBドライブ、またはファイルAppで接続したネットワーク共有から、曲やフォルダごと追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive, USB 드라이브 또는 파일 앱에서 연결한 네트워크 공유 폴더에서 곡이나 폴더 전체를 추가하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til sanger eller hele mapper fra iCloud Drive, en USB-stasjon eller en nettverksdeling du har koblet til i Filer-appen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodawaj utwory lub całe foldery z iCloud Drive, dysku USB albo udziału sieciowego połączonego w aplikacji Pliki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione músicas ou pastas inteiras do iCloud Drive, de uma unidade USB ou de um compartilhamento de rede conectado no app “Arquivos”."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till låtar eller hela mappar från iCloud Drive, en USB-enhet eller en nätverksresurs du har anslutit i appen Filer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以从 iCloud Drive、U 盘，或你在“文件”App 中连接的网络共享，添加歌曲或整个文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以從 iCloud Drive、USB 隨身碟，或你在「檔案」App 中連接的網路共享，新增歌曲或整個資料夾。"
          }
        }
      }
    },
