        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기열이 비었습니다 — 앨범을 재생해 다음 재생을 채우세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting i køen – spill et album for å fylle «Neste»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak elementów w kolejce — odtwórz album, aby wypełnić Następne."
