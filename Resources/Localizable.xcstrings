    "Minutes, top artists, obsessions — your whole year, ready to share.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Minuten, Top-Interpreten, Obsessionen – dein ganzes Jahr, bereit zum Teilen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutos, artistas top, obsesiones: todo tu año, listo para compartir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutes, top artistes, obsessions — toute votre année, prête à partager."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Minuti, top artisti, ossessioni: tutto il tuo anno, pronto da condividere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "聴いた分数、トップアーティスト、ハマった曲 — 1年まるごと、すぐ共有できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감상 시간, 톱 아티스트, 빠져든 음악 — 한 해 전체를 바로 공유하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Minuty, top wykonawcy, obsesje — cały twój rok, gotowy do udostępnienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutos, top artistas, obsessões — seu ano inteiro, pronto para compartilhar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收听分钟、年度艺人、单曲循环——你的一整年，随时可以分享。"
          }
        },
        "zh-Hant": {
