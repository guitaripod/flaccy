    "Pick an album to start listening": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg et album, og begynd at lytte"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Album und leg los"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un álbum para empezar a escuchar"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse albumi ja aloita kuuntelu"
          }
        },
        "fr": {
