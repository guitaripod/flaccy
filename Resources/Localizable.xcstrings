        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można przywrócić poprzedniego miksu „%@” — %@. Nic nie zostało zmienione; spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível restaurar a mixagem anterior de “%@”: %@. Nada foi alterado; tente novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte återställa den tidigare mixen av ”%@” – %@. Inget ändrades; försök igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法恢复“%@”的上一个混音——%@。未做任何更改，请重试。"
