    "Great sound over Bluetooth for nearly everyone. The default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Großartiger Klang über Bluetooth für fast alle. Die Standardeinstellung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gran sonido por Bluetooth para casi todos. La opción predeterminada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un excellent son en Bluetooth pour presque tout le monde. Le réglage par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottimo suono via Bluetooth per quasi tutti. L'impostazione predefinita."
          }
