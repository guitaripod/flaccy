    " · you own %lld of its tracks": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " · du besitzt %lld Titel davon"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " · tienes %lld de sus pistas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " · vous possédez %lld de ses morceaux"
          }
        },
        "it": {
