            "value": "Denne kode er udløbet. Opret en ny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Code ist abgelaufen. Einen neuen erstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code has expired. Make a new one."
          }
        },
        "es": {
