    "Scanning your files for audio": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Dateien werden nach Audio durchsucht"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscando audio en tus archivos"
          }
        },
        "fr": {
