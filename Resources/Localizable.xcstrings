    "Songs and whole folders go straight to your iPad.": {
      "comment": "Wi-Fi Transfer web page: line under the title",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sange og hele mapper går direkte til din iPad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Songs und ganze Ordner landen direkt auf deinem iPad."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las canciones y carpetas enteras van directas a tu iPad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kappaleet ja kokonaiset kansiot siirtyvät suoraan iPadiisi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les morceaux et dossiers entiers arrivent directement sur votre iPad."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Lög og heilar möppur fara beint á iPad-tækið þitt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Brani e intere cartelle arrivano direttamente sul tuo iPad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曲もフォルダごとも、そのままiPadへ届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노래와 폴더 전체가 바로 iPad으로 전송됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanger og hele mapper havner direkte på iPaden din."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwory i całe foldery trafiają prosto na iPada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Músicas e pastas inteiras vão direto para o seu iPad."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låtar och hela mappar hamnar direkt på din iPad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "歌曲和整个文件夹都会直接传到你的 iPad。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歌曲和整個資料夾都會直接傳到你的 iPad。"
          }
        }
      }
    },
