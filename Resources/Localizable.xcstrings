            "state": "translated",
            "value": "Kunne ikke vise enhederne på %@. Træk ned for at prøve igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geräte auf %@ konnten nicht aufgelistet werden. Zum erneuten Versuch nach unten ziehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't list the devices on %@. Pull down to try again."
          }
        },
        "es": {
