    "M4P songs are iTunes Store purchases that only Apple's Music app can play.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "M4P-sange er køb fra iTunes Store, som kun Apples Musik-app kan afspille."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "M4P-Songs sind iTunes-Store-Käufe, die nur die Music-App von Apple abspielen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "M4P songs are iTunes Store purchases that only Apple's Music app can play."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las canciones M4P son compras de la iTunes Store que solo puede reproducir la app Music de Apple."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "M4P-kappaleet ovat iTunes Storesta ostettuja, ja vain Applen Music-sovellus voi toistaa niitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les morceaux M4P sont des achats de l’iTunes Store que seule l’app Music d’Apple peut lire."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "M4P-lög eru kaup í iTunes Store sem aðeins Tónlist-appið frá Apple getur spilað."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I brani M4P sono acquisti dall’iTunes Store che solo l’app Music di Apple può riprodurre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "M4P の曲は iTunes Store で購入したもので、Apple の Music アプリでしか再生できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "M4P 곡은 iTunes Store에서 구매한 곡으로, Apple의 Music 앱에서만 재생할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "M4P-sanger er kjøp fra iTunes Store som bare Apples Musikk-app kan spille av."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwory M4P to zakupy z iTunes Store, które odtworzy tylko aplikacja Music firmy Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As músicas M4P são compras da iTunes Store que só o app Music da Apple consegue tocar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "M4P-låtar är köp från iTunes Store som bara Apples app Musik kan spela upp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "M4P 歌曲是在 iTunes Store 购买的，只有 Apple 的 Music App 能播放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "M4P 歌曲是在 iTunes Store 購買的，只有 Apple 的 Music App 能播放。"
          }
        }
      }
    },
