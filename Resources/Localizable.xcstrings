    "Last.fm sign-in didn't complete. Check your connection and try again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm-login blev ikke fuldført. Tjek din forbindelse, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Last.fm-Anmeldung wurde nicht abgeschlossen. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión en Last.fm no se completó. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm-kirjautuminen ei onnistunut. Tarkista yhteytesi ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion à Last.fm n'a pas abouti. Vérifiez votre connexion et réessayez."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Innskráningu á Last.fm lauk ekki. Athugaðu tenginguna og reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso a Last.fm non è andato a buon fine. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fmへのサインインが完了しませんでした。接続を確認してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm 로그인이 완료되지 않았습니다. 연결 상태를 확인하고 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Innloggingen på Last.fm ble ikke fullført. Sjekk tilkoblingen og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie do Last.fm nie zostało ukończone. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O login no Last.fm não foi concluído. Verifique sua conexão e tente de novo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggningen med Last.fm slutfördes inte. Kontrollera anslutningen och försök igen."
          }
        },
        "zh-Hans": {
