    "The name shows in the library’s source filter and in messages. Its songs stay where they are.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Navnet vises i bibliotekets kildefilter og i meddelelser. Sangene bliver, hvor de er."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name erscheint im Quellfilter der Mediathek und in Meldungen. Seine Songs bleiben, wo sie sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre aparece en el filtro de fuente de la biblioteca y en los mensajes. Sus canciones se quedan donde están."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimi näkyy kirjaston lähdesuodattimessa ja viesteissä. Sen kappaleet pysyvät paikoillaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom apparaît dans le filtre de source de la bibliothèque et dans les messages. Ses morceaux restent à leur place."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafnið birtist í uppsprettusíu safnsins og í skilaboðum. Lögin þess haldast þar sem þau eru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome compare nel filtro di origine della libreria e nei messaggi. I suoi brani restano dove sono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この名前はライブラリのソースフィルタとメッセージに表示されます。曲の保存先は変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이름은 보관함의 출처 필터와 메시지에 표시됩니다. 곡은 그대로 유지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Navnet vises i kildefilteret i biblioteket og i meldinger. Sangene blir liggende der de er."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwa pojawia się w filtrze źródeł biblioteki i w komunikatach. Jej utwory pozostają tam, gdzie są."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome aparece no filtro de fonte da biblioteca e nas mensagens. As músicas dele continuam onde estão."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Namnet visas i bibliotekets källfilter och i meddelanden. Dess låtar ligger kvar där de är."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此名称会显示在资料库的来源筛选器和消息中。其中的歌曲保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此名稱會顯示在資料庫的來源篩選器和訊息中。其中的歌曲保持不變。"
          }
        }
      }
    },
    "The new Flaccy works on your iPhone, Mac and Apple Watch with one purchase. Your library, playlists and Pro come with you.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den nye Flaccy virker på din iPhone, Mac og Apple Watch med ét køb. Dit bibliotek, dine playlister og Pro følger med."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das neue Flaccy läuft mit einem Kauf auf iPhone, Mac und Apple Watch. Deine Mediathek, deine Playlists und Pro kommen mit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nuevo Flaccy funciona en tu iPhone, Mac y Apple Watch con una sola compra. Tu biblioteca, tus listas y Pro se vienen contigo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uusi Flaccy toimii iPhonella, Macilla ja Apple Watchilla yhdellä ostolla. Kirjastosi, soittolistasi ja Pro tulevat mukaasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nouveau Flaccy fonctionne sur ton iPhone, ton Mac et ton Apple Watch avec un seul achat. Ta bibliothèque, tes playlists et Pro te suivent."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Nýja Flaccy virkar á iPhone, Mac og Apple Watch með einum kaupum. Safnið þitt, spilunarlistar og Pro fylgja þér."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nuovo Flaccy funziona su iPhone, Mac e Apple Watch con un solo acquisto. La tua libreria, le playlist e Pro vengono con te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい Flaccy は、1 回の購入で iPhone、Mac、Apple Watch で使えます。ライブラリ、プレイリスト、Pro もそのまま引き継がれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로운 Flaccy는 한 번의 구입으로 iPhone, Mac, Apple Watch에서 모두 사용할 수 있습니다. 보관함, 플레이리스트, Pro도 그대로 옮겨집니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den nye Flaccy fungerer på iPhone, Mac og Apple Watch med ett kjøp. Biblioteket, spillelistene og Pro følger med deg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowy Flaccy działa na iPhonie, Macu i Apple Watchu po jednym zakupie. Twoja biblioteka, playlisty i Pro przechodzą razem z Tobą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O novo Flaccy funciona no iPhone, no Mac e no Apple Watch com uma única compra. Sua biblioteca, suas playlists e o Pro vão com você."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den nya Flaccy fungerar på din iPhone, Mac och Apple Watch med ett enda köp. Ditt bibliotek, dina spellistor och Pro följer med."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新版 Flaccy 只需一次购买，即可在 iPhone、Mac 和 Apple Watch 上使用。你的资料库、播放列表和 Pro 都会一并带走。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新版 Flaccy 只需一次購買，即可在 iPhone、Mac 和 Apple Watch 上使用。你的資料庫、播放列表和 Pro 都會一併帶走。"
          }
        }
      }
    },
    "The player for the music you own.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afspilleren til den musik, du ejer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Player für die Musik, die dir gehört."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reproductor para la música que es tuya."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Soitin omistamallesi musiikille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lecteur de la musique qui vous appartient."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Spilarinn fyrir tónlistina sem þú átt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il lettore per la musica che possiedi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたが持っている音楽のためのプレーヤー。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 가진 음악을 위한 플레이어."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spilleren for musikken du eier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwarzacz muzyki, która należy do ciebie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O player para a música que é sua."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spelaren för musiken du äger."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为你拥有的音乐而生的播放器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為你擁有的音樂而生的播放器。"
          }
        }
      }
    },
    "The playlist is removed; your music files are not touched.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Playlisten fjernes; dine musikfiler berøres ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Playlist wird entfernt; deine Musikdateien bleiben unangetastet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La playlist se elimina; tus archivos de música no se tocan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Soittolista poistetaan, musiikkitiedostojasi ei kosketa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La playlist est supprimée ; vos fichiers musicaux ne sont pas touchés."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Spilunarlistinn er fjarlægður; tónlistarskrárnar þínar eru ósnertar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La playlist viene rimossa; i tuoi file musicali non vengono toccati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレイリストは削除されますが、音楽ファイルはそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생목록만 제거되며 음악 파일은 그대로 유지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spillelisten fjernes. Musikkfilene dine berøres ikke."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Playlista jest usuwana; twoje pliki muzyczne pozostają nietknięte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A playlist é removida; seus arquivos de música não são tocados."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spellistan tas bort. Dina musikfiler berörs inte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅移除播放列表；你的音乐文件不会被改动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會移除播放列表；你的音樂檔案不受影響。"
          }
        }
      }
    },
