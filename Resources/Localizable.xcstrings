        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per riposizionare, scorri per ingrandire, usa le frecce per regolare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグで位置を変更、スクロールで拡大縮小、矢印キーで微調整"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하여 위치 조정, 스크롤하여 확대/축소, 화살표 키로 미세 조정"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra for å flytte, rull for å zoome, bruk piltastene for å justere"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij, aby zmienić położenie, przewiń, aby powiększyć, strzałkami przesuń o krok"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para reposicionar, role para ampliar, use as setas para ajustar"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra för att flytta, rulla för att zooma, använd piltangenterna för att justera"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以调整位置，滚动以缩放，使用方向键微调"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移以調整位置，捲動以縮放，使用方向鍵微調"
          }
        }
      }
    },
    "Drop music here": {
      "comment": "Wi-Fi Transfer web page: drop zone",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læg musik her"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Musik hier ablegen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suelta la música aquí"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pudota musiikki tähän"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déposez la musique ici"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Slepptu tónlist hér"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina qui la musica"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに音楽をドロップ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 음악을 놓으세요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slipp musikk her"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upuść muzykę tutaj"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solte a música aqui"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Släpp musik här"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把音乐拖到这里"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把音樂拖到這裡"
          }
        }
      }
    },
    "Drop your music folders onto the page. Keep Flaccy open until they arrive.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk dine musikmapper hen på siden. Lad Flaccy være åben, indtil de er ankommet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh deine Musikordner auf die Seite. Lass Flaccy geöffnet, bis alles angekommen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra tus carpetas de música a la página. Mantén Flaccy abierta hasta que lleguen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pudota musiikkikansiot sivulle. Pidä Flaccy auki, kunnes ne ovat perillä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déposez vos dossiers de musique sur la page. Gardez Flaccy ouvert jusqu'à leur arrivée."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Dragðu tónlistarmöppurnar þínar á síðuna. Hafðu Flaccy opið þar til þær hafa borist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina le cartelle di musica sulla pagina. Tieni Flaccy aperto finché non arrivano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音楽フォルダをページにドロップします。届くまでFlaccyを開いたままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악 폴더를 페이지에 끌어다 놓으세요. 도착할 때까지 Flaccy를 열어 두세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra musikkmappene dine inn på siden. La Flaccy være åpen til alt er kommet frem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij foldery z muzyką na stronę. Nie zamykaj Flaccy, dopóki nie dotrą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste suas pastas de música para a página. Mantenha o Flaccy aberto até que cheguem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra dina musikmappar till sidan. Håll Flaccy öppet tills allt har kommit fram."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把音乐文件夹拖到网页上。在传输完成前请保持 Flaccy 打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把音樂資料夾拖到網頁上。傳送完成前請讓 Flaccy 保持開啟。"
          }
        }
      }
    },
