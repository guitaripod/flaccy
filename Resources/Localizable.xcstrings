    "%lld songs stopped after repeated attempts. Retry to send them again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sange stoppede efter gentagne forsøg. Prøv igen for at sende dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Titel wurden nach mehreren Versuchen gestoppt. Erneut versuchen, um sie noch einmal zu senden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detuvieron %lld canciones tras varios intentos. Reintenta para volver a enviarlas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld kappaletta pysäytettiin toistuvien yritysten jälkeen. Yritä lähettää ne uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld morceaux arrêtés après plusieurs tentatives. Réessayez pour les renvoyer."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld lög stöðvuðust eftir endurteknar tilraunir. Reyndu aftur til að senda þau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld brani interrotti dopo ripetuti tentativi. Riprova per inviarli di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld曲は繰り返し失敗したため停止しました。再試行して再送できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld곡이 여러 번 시도 후 중단되었습니다. 다시 시도해서 보내세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sanger stoppet etter gjentatte forsøk. Prøv igjen for å sende dem på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld utworów zatrzymano po kilku próbach. Ponów, aby wysłać je ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld músicas pararam após tentativas repetidas. Tente novamente para reenviá-las."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld låtar stoppades efter flera försök. Försök igen för att skicka dem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 首歌曲在多次尝试后停止。重试即可再次发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 首歌曲在多次嘗試後停止。重試即可再次傳送。"
          }
        }
      }
    },
