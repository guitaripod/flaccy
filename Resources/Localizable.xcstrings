    "Own your music.\nForever.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Eje din musik.\nFor altid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Besitze deine Musik.\nFür immer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu música es tuya.\nPara siempre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Omista musiikkisi.\nIkuisesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Possédez votre musique.\nPour toujours."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Eigðu tónlistina þína.\nTil eilífðar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua musica è tua.\nPer sempre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音楽は自分のもの。\nずっと。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악은 당신의 것.\n영원히."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Eie musikken din.\nFor alltid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Posiadaj swoją muzykę.\nNa zawsze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua música é sua.\nPara sempre."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Äg din musik.\nFör alltid."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音乐属于你。\n永远。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音樂屬於你。\n永遠。"
          }
        }
      }
    },
