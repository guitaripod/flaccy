    "Streamed songs stay here for replay. Downloads don’t count toward the limit.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Streamede sange bliver her, så du kan afspille dem igen. Overførsler tæller ikke med i grænsen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestreamte Songs bleiben hier zum erneuten Abspielen. Downloads zählen nicht zum Limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las canciones en streaming se guardan aquí para volver a sonar. Las descargas no cuentan para el límite."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suoratoistetut kappaleet säilyvät täällä uudelleentoistoa varten. Lataukset eivät lasketa rajaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les morceaux écoutés en streaming restent ici pour être rejoués. Les téléchargements ne comptent pas dans la limite."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Streymd lög haldast hér til að spila aftur. Niðurhal telst ekki með í takmörkinu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I brani in streaming restano qui per riascoltarli. I download non contano nel limite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストリーミングした曲は再生用にここに保存されます。ダウンロードした曲は上限に含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스트리밍한 곡은 다시 재생할 수 있도록 여기에 보관됩니다. 다운로드한 곡은 한도에 포함되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Strømmede sanger blir her for ny avspilling. Nedlastinger teller ikke mot grensen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwory ze strumienia zostają tu do ponownego odtwarzania. Pobrane nie wliczają się do limitu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As músicas transmitidas ficam aqui para tocar de novo. Os downloads não contam para o limite."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Strömmade låtar finns kvar här för att kunna spelas upp igen. Hämtningar räknas inte mot gränsen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "流式播放过的歌曲会保存在这里以便重播。下载的歌曲不计入上限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "串流播放過的歌曲會保存在這裡以便重播。下載的歌曲不計入上限。"
          }
        }
      }
    },
    "Subscribes for a year, renewing automatically until cancelled": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegner et årligt abonnement, der fornyes automatisk, indtil det opsiges"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließt ein Jahresabo ab, das sich bis zur Kündigung automatisch verlängert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suscribe por un año, renovándose automáticamente hasta que canceles"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuositilaus uusiutuu automaattisesti, kunnes se peruutetaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnement d’un an, renouvelé automatiquement jusqu’à annulation"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerist áskrifandi í eitt ár og endurnýjast sjálfkrafa þar til henni er sagt upp"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbonamento di un anno, rinnovato automaticamente fino alla disdetta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1年間のサブスクリプションに登録します。解約するまで自動更新されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1년 구독을 시작합니다. 해지할 때까지 자동 갱신됩니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnerer i ett år og fornyes automatisk til du sier opp"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Subskrybuje na rok, odnawia się automatycznie do momentu anulowania"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assina por um ano, renovando automaticamente até cancelar"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenumererar på ett år och förnyas automatiskt tills du avbryter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅一年，取消前自动续订"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訂閱一年，取消前自動續訂"
          }
        }
      }
    },
