    "Plays a station from your most-played tracks": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afspiller en radio med dine mest afspillede sange"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet einen Sender aus deinen meistgespielten Titeln"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia una emisora con tus pistas más reproducidas"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toistaa radiokanavan eniten toistetuista kappaleistasi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance une radio à partir de vos morceaux les plus écoutés"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Spilar útvarpsstöð úr mest spiluðu lögunum þínum"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia una stazione dai tuoi brani più ascoltati"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく聴く曲からステーションを再生します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 많이 들은 트랙으로 스테이션을 재생합니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiller en stasjon basert på de mest spilte sangene dine"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwarza stację z twoich najczęściej odtwarzanych utworów"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca uma estação com as suas faixas mais tocadas"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spelar en radiostation med dina mest spelade låtar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用你播放最多的曲目播放电台"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用你播放最多的曲目播放電台"
          }
        }
      }
    },
    "Plays a station of similar music from your library": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afspiller en radio med lignende musik fra dit bibliotek"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet einen Sender mit ähnlicher Musik aus deiner Mediathek"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia una emisora de música similar de tu biblioteca"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
