          }
        }
      }
    },
    "Couldn't make the image. Check free space and try again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke lave billedet. Kontrollér ledig lagerplads, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bild konnte nicht erstellt werden. Prüfe den freien Speicher und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo crear la imagen. Revisa el espacio libre y vuelve a intentarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvaa ei voitu luoda. Tarkista vapaa tila ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de créer l’image. Vérifiez l’espace disponible et réessayez."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki tókst að búa til myndina. Athugaðu laust pláss og reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile creare l’immagine. Controlla lo spazio libero e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像を作成できませんでした。空き容量を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지를 만들 수 없습니다. 저장 공간을 확인하고 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke lage bildet. Sjekk ledig lagringsplass og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się utworzyć obrazu. Sprawdź wolne miejsce i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível criar a imagem. Verifique o espaço livre e tente novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att skapa bilden. Kontrollera ledigt utrymme och försök igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法生成图片。请检查可用存储空间后重试。"
          }
        },
