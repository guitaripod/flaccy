    "%lld %@ files weren't added: Flaccy can't play them.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld %@-filer blev ikke tilføjet: Flaccy kan ikke afspille dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Dateien im Format %@ wurden nicht hinzugefügt: Flaccy kann sie nicht abspielen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld archivos %@ no se añadieron: Flaccy no puede reproducirlos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld %@-tiedostoa ei lisätty: Flaccy ei osaa toistaa niitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fichiers %@ n’ont pas été ajoutés : Flaccy ne peut pas les lire."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld skrár af gerðinni %@ voru ekki bættar við: Flaccy getur ekki spilað þær."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld file %@ non sono stati aggiunti: Flaccy non può riprodurli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld件の%@ファイルは追加されませんでした。Flaccyでは再生できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개의 %@ 파일을 추가하지 못했습니다. Flaccy에서 재생할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld filer i formatet %@ ble ikke lagt til: Flaccy kan ikke spille dem av."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld plików %@ nie zostało dodanych: Flaccy nie potrafi ich odtworzyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld arquivos %@ não foram adicionados: o Flaccy não consegue reproduzi-los."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld %@-filer lades inte till: Flaccy kan inte spela upp dem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个 %@ 文件未添加：Flaccy 无法播放。"
          }
        },
