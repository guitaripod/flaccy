    "Removes cached songs and keeps your downloads": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjerner sange i cachen og beholder dine overførsler"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt zwischengespeicherte Songs und behält deine Downloads"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita las canciones en caché y conserva tus descargas"
          }
        },
