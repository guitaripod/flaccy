    "Pair an Apple Watch with this iPhone to send it music.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Par en Apple Watch med denne iPhone for at sende den musik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppele eine Apple Watch mit diesem iPhone, um ihr Musik zu senden."
          }
        },
