            "state": "translated",
            "value": " · possiedi %lld dei suoi brani"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " · うち%lld曲を所有しています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " · 그중 %lld곡 보유"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": " · masz %lld z jego utworów"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " · você tem %lld faixas dele"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " · 你已拥有其中 %lld 首"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": " · 你已擁有其中 %lld 首"
          }
        }
      }
    },
    "$9.99 · once, forever (store unavailable)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "$9.99 · einmalig, für immer (Store nicht verfügbar)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "$9.99 · una vez, para siempre (tienda no disponible)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "$9.99 · une fois, pour toujours (store indisponible)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "$9.99 · una volta, per sempre (store non disponibile)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "$9.99 · 一度きり、ずっと（ストアを利用できません）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "$9.99 · 한 번 결제, 평생 이용 (스토어 사용 불가)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "9,99 zł · raz, na zawsze (sklep niedostępny)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "$9.99 · uma vez, para sempre (loja indisponível)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "$9.99 · 一次买断，永久使用（商店不可用）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "$9.99 · 一次買斷，永久使用（商店無法使用）"
          }
        }
      }
    },
