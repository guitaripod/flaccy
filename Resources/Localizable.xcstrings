            "value": "Ingen lignende kunstnere i dit bibliotek endnu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine ähnlichen Interpreten in deiner Mediathek."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay artistas similares en tu biblioteca."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjastossasi ei ole vielä samankaltaisia artisteja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun artiste similaire dans votre bibliothèque pour l'instant."
