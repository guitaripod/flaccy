    "Control playback from the menu bar; new files appear in your library instantly.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Styr afspilningen fra menulinjen; nye filer vises straks i dit bibliotek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuere die Wiedergabe über die Menüleiste; neue Dateien erscheinen sofort in deiner Mediathek."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla la reproducción desde la barra de menús; los archivos nuevos aparecen al instante en tu biblioteca."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohjaa toistoa valikkopalkista. Uudet tiedostot ilmestyvät kirjastoosi heti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôlez la lecture depuis la barre des menus ; les nouveaux fichiers apparaissent instantanément dans votre bibliothèque."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Stýrðu spilun úr valmyndarstikunni; nýjar skrár birtast strax í safninu þínu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla la riproduzione dalla barra dei menu; i nuovi file compaiono subito nella tua libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーから再生を操作。新しいファイルはすぐにライブラリに現れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대에서 재생을 조작하세요. 새 파일은 보관함에 바로 나타납니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Styr avspillingen fra menylinjen. Nye filer vises i biblioteket ditt med en gang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Steruj odtwarzaniem z paska menu; nowe pliki pojawiają się w bibliotece od razu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Controle a reprodução pela barra de menus; arquivos novos aparecem na hora na sua biblioteca."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Styr uppspelningen från menyraden; nya filer visas direkt i ditt bibliotek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在菜单栏控制播放；新文件会立即出现在资料库中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從選單列控制播放；新增的檔案會立刻出現在資料庫中。"
          }
        }
      }
    },
