    "Choose a folder of music on this Mac, import files, or start with a free sample album.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en mappe med musik på denne Mac, importér filer, eller start med et gratis eksempelalbum."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Musikordner auf diesem Mac, importiere Dateien oder starte mit einem kostenlosen Beispielalbum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una carpeta de música en este Mac, importa archivos o empieza con un álbum de muestra gratuito."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse musiikkikansio tältä Macilta, tuo tiedostoja tai aloita ilmaisella esimerkkialbumilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un dossier de musique sur ce Mac, importez des fichiers ou commencez avec un album d'exemple gratuit."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Veldu tónlistarmöppu á þessum Mac, fluttu inn skrár eða byrjaðu með ókeypis sýnishornsplötu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una cartella di musica su questo Mac, importa file oppure inizia con un album di esempio gratuito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMac上の音楽フォルダを選ぶか、ファイルを読み込むか、無料のサンプルアルバムから始めましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 음악 폴더를 선택하거나 파일을 가져오거나 무료 샘플 앨범으로 시작하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg en musikkmappe på denne Macen, importer filer, eller start med et gratis eksempelalbum."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz folder z muzyką na tym Macu, zaimportuj pliki albo zacznij od darmowego albumu przykładowego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma pasta de música neste Mac, importe arquivos ou comece com um álbum de amostra gratuito."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en musikmapp på den här Mac:en, importera filer eller börja med ett gratis exempelalbum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择这台 Mac 上的音乐文件夹、导入文件，或先试听免费的示例专辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇這台 Mac 上的音樂檔案夾、匯入檔案，或先從免費的範例專輯開始。"
          }
        }
      }
    },
    "Choose a music folder to index in place, or import files into Flaccy's own library.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en musikmappe, der skal indekseres direkte, eller importér filer til Flaccys eget bibliotek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Musikordner, der direkt indexiert wird, oder importiere Dateien in Flaccys eigene Mediathek."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una carpeta de música para indexarla donde está, o importa archivos a la biblioteca propia de Flaccy."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse musiikkikansio, joka indeksoidaan paikallaan, tai tuo tiedostoja Flaccyn omaan kirjastoon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un dossier de musique à indexer sur place, ou importez des fichiers dans la bibliothèque de Flaccy."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Veldu tónlistarmöppu til að skrá hana á sínum stað, eða fluttu skrár inn í eigið safn Flaccy."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una cartella di musica da indicizzare dov'è, oppure importa i file nella libreria di Flaccy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その場でインデックスする音楽フォルダを選ぶか、ファイルをFlaccy自身のライブラリに読み込みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제자리에서 색인할 음악 폴더를 선택하거나, 파일을 Flaccy 보관함으로 가져오세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg en musikkmappe som skal indekseres på stedet, eller importer filer til Flaccys eget bibliotek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz folder z muzyką do zaindeksowania w miejscu albo zaimportuj pliki do własnej biblioteki Flaccy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma pasta de música para indexar onde ela está, ou importe arquivos para a biblioteca do próprio Flaccy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en musikmapp att indexera på plats, eller importera filer till Flaccys egna bibliotek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个音乐文件夹就地建立索引，或把文件导入 Flaccy 自己的资料库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一個音樂資料夾就地建立索引，或把檔案匯入 Flaccy 自己的資料庫。"
          }
        }
      }
    },
