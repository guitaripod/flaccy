    "“%@” needs %@, but your Apple Watch has %@ free. Remove some music first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ braucht %2$@, aber deine Apple Watch hat nur %3$@ frei. Entferne zuerst etwas Musik."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "“%1$@” needs %2$@, but your Apple Watch has %3$@ free. Remove some music first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” necesita %2$@, pero tu Apple Watch solo tiene %3$@ libres. Quita algo de música antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » nécessite %2$@, mais votre Apple Watch ne dispose que de %3$@ libres. Retirez d'abord de la musique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” richiede %2$@, ma il tuo Apple Watch ha solo %3$@ liberi. Rimuovi prima un po' di musica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」には%2$@が必要ですが、Apple Watchの空きは%3$@です。先に音楽を減らしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”에는 %2$@이(가) 필요하지만 Apple Watch의 여유 공간은 %3$@입니다. 먼저 음악을 정리하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” wymaga %2$@, ale twój Apple Watch ma %3$@ wolnego miejsca. Najpierw usuń trochę muzyki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” precisa de %2$@, mas seu Apple Watch tem %3$@ livres. Remova alguma música antes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”需要 %2$@，但你的 Apple Watch 仅剩 %3$@ 可用。请先移除一些音乐。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」需要 %2$@，但你的 Apple Watch 只剩 %3$@ 可用。請先移除一些音樂。"
          }
        }
      }
    },
