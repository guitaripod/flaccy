        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pizzica per ingrandire e trascina per riposizionare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピンチで拡大、ドラッグで位置を調整"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "핀치하여 확대하고 끌어서 위치 조정"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klyp for å zoome og dra for å flytte"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozsuń palce, aby powiększyć, i przeciągnij, aby zmienić położenie"
