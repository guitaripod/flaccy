    "Allow Apple Music access for Flaccy to find links for “%@”.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad adgang til Apple Music for Flaccy, så den kan finde links til »%@«."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Flaccy den Zugriff auf Apple Music, um Links für „%@“ zu finden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que Flaccy acceda a Apple Music para encontrar enlaces de “%@”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli Flaccylle pääsy Apple Music -palveluun, jotta se löytää linkit kohteelle ”%@”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Flaccy à accéder à Apple Music pour trouver les liens de « %@ »."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Leyfðu Flaccy aðgang að Apple Music til að finna tengla fyrir „%@“."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti a Flaccy l'accesso ad Apple Music per trovare i link per “%@”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」のリンクを探すため、FlaccyがApple Musicにアクセスすることを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”의 링크를 찾으려면 Flaccy의 Apple Music 접근을 허용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi Flaccy tilgang til Apple Music for å finne lenker til «%@»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól Flaccy na dostęp do Apple Music, aby znaleźć linki do „%@”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que o Flaccy acesse o Apple Music para encontrar links de “%@”."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt Flaccy åtkomst till Apple Music för att hitta länkar till ”%@”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 Flaccy 访问 Apple Music，以查找“%@”的链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 Flaccy 存取 Apple Music，以尋找「%@」的連結。"
          }
        }
      }
    },
