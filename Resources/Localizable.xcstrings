    "The playlist is removed; your music files are not touched.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Playlist wird entfernt; deine Musikdateien bleiben unangetastet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La playlist se elimina; tus archivos de música no se tocan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La playlist est supprimée ; vos fichiers musicaux ne sont pas touchés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La playlist viene rimossa; i tuoi file musicali non vengono toccati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレイリストは削除されますが、音楽ファイルはそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생목록만 제거되며 음악 파일은 그대로 유지됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Playlista jest usuwana; twoje pliki muzyczne pozostają nietknięte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A playlist é removida; seus arquivos de música não são tocados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅移除播放列表；你的音乐文件不会被改动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會移除播放列表；你的音樂檔案不受影響。"
          }
        }
      }
    },
