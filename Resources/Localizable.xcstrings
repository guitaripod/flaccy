    "Connect this iPad to Wi-Fi to send music to it.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbind denne iPad til Wi-Fi for at sende musik til den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde dieses iPad mit einem WLAN, um Musik darauf zu senden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta este iPad a una Wi-Fi para enviarle música."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistä tämä iPad Wi-Fi-verkkoon, niin voit lähettää sille musiikkia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez cet iPad au Wi-Fi pour lui envoyer de la musique."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tengdu þennan iPad við Wi-Fi til að senda tónlist á hann."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega questo iPad a una rete Wi-Fi per inviargli musica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音楽を転送するには、このiPadをWi-Fiに接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악을 보내려면 이 iPad을 Wi-Fi에 연결하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koble denne iPad-en til Wi-Fi for å sende musikk til den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz ten iPad z Wi-Fi, aby wysłać na niego muzykę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte este iPad a uma rede Wi-Fi para enviar música a ele."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslut den här iPad:en till Wi-Fi för att skicka musik till den."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将这台 iPad 连接到 Wi-Fi 以接收音乐。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請將這部 iPad 連上 Wi-Fi 以接收音樂。"
          }
        }
      }
    },
