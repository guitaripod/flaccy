    "This iPad is out of space. Free some up, then send the rest again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne iPad har ikke mere lagerplads. Frigør noget, og send resten igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses iPad hat keinen Speicherplatz mehr. Gib etwas frei und sende den Rest erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPad no tiene espacio. Libera algo y vuelve a enviar el resto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän iPadin tallennustila loppui. Vapauta tilaa ja lähetä loput uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPad n'a plus d'espace. Libérez-en un peu, puis renvoyez le reste."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Það er ekkert pláss eftir á þessum iPad. Losaðu um pláss og sendu afganginn aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo iPad ha esaurito lo spazio. Liberane un po' e invia di nuovo il resto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPadの空き容量が足りません。容量を空けてから、残りをもう一度送ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPad의 저장 공간이 부족합니다. 공간을 확보한 다음 나머지를 다시 보내세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne iPaden har ikke mer plass. Frigjør litt, og send resten på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tym iPadzie zabrakło miejsca. Zwolnij trochę i wyślij resztę ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPad está sem espaço. Libere um pouco e envie o restante de novo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här iPaden har ont om utrymme. Frigör lite och skicka resten igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 iPad 空间不足。请释放一些空间后重新发送剩余内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部 iPad 空間不足。請釋放一些空間後重新傳送其餘內容。"
          }
        }
      }
    },
    "This iPad stops syncing with %@. Your playlists and history stay here, and %@ keeps its copy.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne iPad holder op med at synkronisere med %@. Playlister og historik bliver her, og %@ beholder sin kopi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses iPad synchronisiert nicht mehr mit %@. Playlists und Verlauf bleiben hier, und %@ behält seine Kopie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPad stops syncing with %@. Your playlists and history stay here, and %@ keeps its copy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPad deja de sincronizarse con %@. Tus playlists y tu historial se quedan aquí, y %@ conserva su copia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä iPad lopettaa synkronoinnin kohteen %@ kanssa. Soittolistasi ja historiasi pysyvät täällä, ja %@ säilyttää oman kopionsa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPad arrête la synchronisation avec %@. Vos playlists et votre historique restent ici, et %@ garde sa copie."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þessi iPad hættir að samstilla við %@. Spilunarlistarnir og ferillinn haldast hér, og %@ heldur sínu afriti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo iPad smette di sincronizzarsi con %@. Le tue playlist e la cronologia restano qui, e %@ conserva la sua copia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPadは %@ との同期を停止します。プレイリストと履歴はここに残り、%@ は自分のコピーを保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPad은 %@와의 동기화를 중단해요. 재생목록과 기록은 여기에 남고, %@은(는) 자신의 사본을 유지해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne iPaden slutter å synkronisere med %@. Spillelistene og lyttehistorikken blir her, og %@ beholder sin kopi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten iPad przestaje synchronizować się z: %@. Twoje playlisty i historia zostają tutaj, a %@ zachowuje swoją kopię."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPad deixa de sincronizar com %@. Suas playlists e seu histórico ficam aqui, e %@ mantém a sua cópia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här iPaden slutar synkronisera med %@. Dina spellistor, gillningar och historik finns kvar här, och %@ behåller sin kopia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 iPad 将停止与 %@ 同步。你的播放列表和记录保留在这里，%@ 保留其副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 iPad 將停止與 %@ 同步。你的播放列表和記錄保留在這裡，%@ 保留其副本。"
          }
        }
      }
    },
