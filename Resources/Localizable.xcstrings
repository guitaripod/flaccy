    "Rather stream your whole library without copying it?": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du hellere streame hele dit bibliotek uden at kopiere det?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lieber die ganze Mediathek streamen, ohne sie zu kopieren?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Prefieres escuchar toda tu biblioteca en streaming sin copiarla?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haluatko mieluummin suoratoistaa koko kirjastosi kopioimatta sitä?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous préférez diffuser toute votre bibliothèque sans la copier ?"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Viltu frekar streyma öllu safninu án þess að afrita það?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferisci ascoltare in streaming tutta la libreria senza copiarla?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーせずにライブラリ全体をストリーミングしたいですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사하지 않고 보관함 전체를 스트리밍하고 싶나요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du heller strømme hele biblioteket ditt uten å kopiere det?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wolisz strumieniować całą bibliotekę bez kopiowania?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefere transmitir toda a biblioteca sem copiá-la?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vill du hellre strömma hela biblioteket utan att kopiera det?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
