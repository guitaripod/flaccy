    "Peak guard is catching overs. Lower the preamp or return to Auto.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Peak-Schutz greift ein. Vorverstärkung senken oder zu Auto zurückkehren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La protección de picos está actuando. Baja el preamplificador o vuelve a Automático."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La protection de crête intervient. Baissez le préampli ou revenez sur Auto."
          }
        },
        "it": {
