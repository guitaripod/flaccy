    "Deep, steady devotion to your favorites.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyb, stabil hengivenhed til dine favoritter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiefe, beständige Treue zu deinen Favoriten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Devoción profunda y constante por tus favoritos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syvää ja tasaista omistautumista suosikeillesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une dévotion profonde et constante à vos favoris."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Djúp, stöðug tryggð við eftirlætin þín."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Devozione profonda e costante ai tuoi preferiti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りへの深く揺るぎない愛。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋아하는 음악을 향한 깊고 꾸준한 애정."
