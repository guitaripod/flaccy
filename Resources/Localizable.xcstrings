        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyp, stabil hengivenhet til favorittene dine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Głębokie, stałe oddanie ulubionym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Devoção profunda e constante aos seus favoritos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Djup, stadig hängivenhet till dina favoriter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对心头好深沉而持久的偏爱。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
