{
  "sourceLanguage": "en",
  "strings": {
    "\n\nDuplicate files are moved to the Trash, so nothing is permanently deleted.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nDublerede filer flyttes til Papirkurven, så intet slettes permanent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nDoppelte Dateien landen im Papierkorb – nichts wird endgültig gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nLos archivos duplicados van a la papelera, así que no se elimina nada de forma permanente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nKaksoiskappaleet siirretään roskakoriin, joten mitään ei poisteta pysyvästi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nLes fichiers en double sont placés dans la corbeille : rien n'est supprimé définitivement."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nTvíteknar skrár eru færðar í ruslið, svo ekkert er eytt varanlega."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nI file duplicati finiscono nel Cestino, quindi non viene eliminato nulla in modo definitivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n重複ファイルはゴミ箱に移動されるため、完全に削除されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n중복 파일은 휴지통으로 이동하므로 영구적으로 삭제되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nDuplikatfiler flyttes til Papirkurv, så ingenting slettes permanent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nDuplikaty trafiają do Kosza, więc nic nie jest trwale usuwane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nOs arquivos duplicados vão para o Lixo, então nada é apagado em definitivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nDubblettfiler flyttas till papperskorgen, så inget raderas permanent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n重复文件会移到废纸篓，不会被永久删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n重複的檔案會移到垃圾桶，不會永久刪除。"
          }
        }
      }
    },
