        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke gi «%@» nytt navn – biblioteksdatabasen kunne ikke skrives til. Kontroller ledig lagringsplass og prøv igjen."
          }
        },
        "pl": {
