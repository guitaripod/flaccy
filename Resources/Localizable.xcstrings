    "Lists a song once when it sits on several albums, such as a single and the album it came from. Your files stay untouched.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt einen Song nur einmal, wenn er auf mehreren Alben steht, zum Beispiel auf einer Single und dem Album, von dem sie stammt. Deine Dateien bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lists a song once when it sits on several albums, such as a single and the album it came from. Your files stay untouched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra una canción una sola vez cuando aparece en varios álbumes, como un single y el álbum del que procede. Tus archivos no se modifican."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche un morceau une seule fois lorsqu'il figure sur plusieurs albums, comme un single et l'album d'origine. Tes fichiers restent intacts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra un brano una sola volta quando è presente in più album, ad esempio un singolo e l'album da cui proviene. I tuoi file restano intatti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シングルと元のアルバムのように複数のアルバムに入っている曲は1回だけ表示します。ファイルは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "싱글과 원본 앨범처럼 여러 앨범에 들어 있는 곡을 한 번만 표시합니다. 파일은 그대로 유지됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyświetla utwór raz, gdy znajduje się na kilku albumach, na przykład na singlu i albumie, z którego pochodzi. Twoje pliki pozostają nienaruszone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista uma música uma vez quando ela aparece em vários álbuns, como um single e o álbum de onde saiu. Seus arquivos não são alterados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当一首歌出现在多张专辑中（例如单曲及其所属专辑）时只列出一次。你的文件保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當一首歌出現在多張專輯中（例如單曲及其所屬專輯）時只列出一次。你的檔案保持不變。"
          }
        }
      }
    },
