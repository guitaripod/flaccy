    "Create one here, or right-click any song and choose Add to Playlist.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opret en her, eller højreklik på en sang, og vælg »Føj til playliste«."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle hier eine – oder klicke mit rechts auf einen Titel und wähle „Zur Playlist hinzufügen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una aquí, o haz clic derecho en cualquier canción y elige “Añadir a una playlist”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luo uusi tässä tai napsauta mitä tahansa kappaletta oikealla painikkeella ja valitse Lisää soittolistaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez-en une ici, ou faites un clic droit sur un morceau et choisissez « Ajouter à une playlist »."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Búðu til einn hér, eða hægrismelltu á lag og veldu „Bæta við spilunarlista“."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Creane una qui, oppure fai clic destro su un brano e scegli “Aggiungi a playlist”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで作成するか、曲を右クリックして「プレイリストに追加」を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 만들거나, 곡을 마우스 오른쪽 버튼으로 클릭하고 “재생목록에 추가”를 선택하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opprett en her, eller høyreklikk på en sang og velg «Legg til i spilleliste»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwórz nową tutaj albo kliknij utwór prawym przyciskiem i wybierz Dodaj do playlisty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
