    "1 %@ file wasn't added: Flaccy can't play it.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "1 %@-fil blev ikke tilføjet: Flaccy kan ikke afspille den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Datei im Format %@ wurde nicht hinzugefügt: Flaccy kann sie nicht abspielen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se añadió 1 archivo %@: Flaccy no puede reproducirlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "1 tiedosto muodossa %@ ei lisätty: Flaccy ei osaa toistaa sitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 fichier %@ n’a pas été ajouté : Flaccy ne peut pas le lire."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "1 %@ skrá var ekki bætt við: Flaccy getur ekki spilað hana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1 file %@ non è stato aggiunto: Flaccy non può riprodurlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ファイル1件は追加されませんでした。Flaccyでは再生できません。"
