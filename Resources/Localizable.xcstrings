    "If one album gaps and the rest don't, check its format before blaming the player.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein Album Lücken hat und die anderen nicht, prüfe zuerst sein Format, bevor du dem Player die Schuld gibst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un álbum tiene pausas y los demás no, comprueba su formato antes de culpar al reproductor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un album présente des blancs et pas les autres, vérifiez son format avant d'accuser le lecteur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se un album ha delle pause e gli altri no, controlla il suo formato prima di dare la colpa al player."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あるアルバムだけ曲間が途切れるなら、プレーヤーを疑う前にそのフォーマットを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 앨범에서만 끊김이 생기고 나머지는 괜찮다면, 플레이어를 탓하기 전에 해당 앨범의 형식부터 확인하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli jeden album ma przerwy, a pozostałe nie, sprawdź jego format, zanim obwinisz odtwarzacz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se um álbum tem pausas e os outros não, confira o formato dele antes de culpar o player."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果只有某张专辑出现间隙，其他专辑都正常，请先检查它的格式，再怪播放器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果只有某張專輯出現間隙，其他專輯都正常，請先檢查它的格式，再怪播放器。"
          }
        }
      }
    },
