        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone에 Apple Watch를 페어링하면 음악을 보낼 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Par en Apple Watch med denne iPhonen for å sende musikk til den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparuj Apple Watcha z tym iPhonem, aby przesyłać na niego muzykę."
