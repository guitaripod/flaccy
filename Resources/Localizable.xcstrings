    "Cleared %@ of cached songs. Downloads were not touched.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ryddede %@ af de cachelagrede sange. Overførsler blev ikke berørt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ der zwischengespeicherten Songs wurden gelöscht. Downloads blieben unberührt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han vaciado %@ de canciones en caché. Las descargas no se han tocado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kappaleiden välimuistista tyhjennettiin %@. Lataukset säilyivät ennallaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de morceaux en cache ont été vidés. Les téléchargements n’ont pas été touchés."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hreinsað var %@ af lögum í skyndiminni. Niðurhal var ekki snert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Svuotati %@ di brani in cache. I download non sono stati toccati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュ済みの曲 %@ を消去しました。ダウンロードは変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캐시된 곡 %@ 분량을 지웠습니다. 다운로드한 곡은 건드리지 않았습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tømte %@ med cachelagrede sanger. Nedlastinger ble ikke berørt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyczyszczono %@ utworów z pamięci podręcznej. Pobrane utwory nie zostały naruszone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Foram liberados %@ de músicas em cache. Os downloads não foram alterados."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rensade %@ av de cachade låtarna. Hämtningar lämnades orörda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已清除 %@ 的缓存歌曲。下载内容未受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已清除 %@ 的快取歌曲。下載內容未受影響。"
          }
        }
      }
    },
