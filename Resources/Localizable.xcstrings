    "Folds Deluxe, Remaster and Explicit editions into one album.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Samler Deluxe-, Remaster- og Explicit-udgaverne i ét album."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasst Deluxe-, Remaster- und Explicit-Editionen zu einem Album zusammen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funde las ediciones Deluxe, Remaster y Explicit en un solo álbum."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistää Deluxe-, Remaster- ja Explicit-painokset yhdeksi albumiksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fond les éditions Deluxe, Remaster et Explicit en un seul album."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sameinar Deluxe-, Remaster- og Explicit-útgáfur í eina plötu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonde le edizioni Deluxe, Remaster ed Explicit in un solo album."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Deluxe版・Remaster版・Explicit版を1つのアルバムにまとめます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디럭스, 리마스터, 익스플리싯 에디션을 하나의 앨범으로 합칩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slår sammen Deluxe-, Remaster- og Explicit-utgavene til ett album."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łączy edycje Deluxe, Remaster i Explicit w jeden album."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Junta as edições Deluxe, Remaster e Explicit em um só álbum."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slår ihop Deluxe-, Remaster- och Explicit-utgåvor till ett album."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把豪华版、重制版和显式版合成一张专辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把豪華版、重製版與 Explicit 版合成一張專輯。"
          }
        }
      }
    },
