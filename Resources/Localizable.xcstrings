    "Waiting for approval. Ask the owner of %@ to approve this device.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter på godkendelse. Bed ejeren af %@ om at godkende denne enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten auf Freigabe. Den Besitzer von %@ bitten, dieses Gerät freizugeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for approval. Ask the owner of %@ to approve this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando aprobación. Pide al propietario de %@ que apruebe este dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Odotetaan hyväksyntää. Pyydä %@:n omistajaa hyväksymään tämä laite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente d’approbation. Demandez au propriétaire de %@ d’approuver cet appareil."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Beðið eftir samþykki. Biddu eiganda %@ um að samþykkja þetta tæki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa di approvazione. Chiedi al proprietario di %@ di approvare questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認を待っています。%@ の所有者にこのデバイスの承認を依頼してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인 대기 중이에요. %@의 소유자에게 이 기기를 승인해 달라고 요청하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter på godkjenning. Be eieren av %@ om å godkjenne denne enheten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oczekiwanie na zatwierdzenie. Poproś właściciela: %@, aby zatwierdził to urządzenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando aprovação. Peça ao dono de %@ para aprovar este dispositivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Väntar på godkännande. Be ägaren av %@ att godkänna den här enheten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待批准。请让 %@ 的所有者批准此设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待核准。請讓 %@ 的擁有者核准此裝置。"
          }
        }
      }
    },
