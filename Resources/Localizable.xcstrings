    "FLAC albums flow track to track with zero silence.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FLAC-Alben laufen ohne eine Sekunde Stille von Titel zu Titel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los álbumes FLAC fluyen de pista a pista sin un segundo de silencio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les albums FLAC s'enchaînent sans une seconde de silence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli album FLAC scorrono da un brano all'altro senza un attimo di silenzio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FLACのアルバムは無音を挟まず曲から曲へ流れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "FLAC 앨범은 정적 없이 곡에서 곡으로 이어집니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Albumy FLAC płyną z utworu na utwór bez cienia ciszy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Álbuns em FLAC fluem de faixa em faixa sem um segundo de silêncio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "FLAC 专辑一曲接一曲，中间没有一秒静音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "FLAC 專輯一曲接一曲，中間沒有一秒空白。"
          }
        }
      }
    },
    "FLAC, ALAC, WAV and AIFF albums are gapless with no caveat.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alben in FLAC, ALAC, WAV und AIFF laufen lückenlos – ohne Einschränkung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los álbumes FLAC, ALAC, WAV y AIFF se reproducen sin pausas, sin ninguna salvedad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les albums FLAC, ALAC, WAV et AIFF s'enchaînent sans blanc, sans aucune réserve."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli album FLAC, ALAC, WAV e AIFF sono senza pause, senza alcuna riserva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FLAC、ALAC、WAV、AIFFのアルバムは、例外なくギャップレスで再生されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "FLAC, ALAC, WAV, AIFF 앨범은 예외 없이 갭리스로 재생됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Albumy FLAC, ALAC, WAV i AIFF odtwarzane są bez przerw i bez żadnych zastrzeżeń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Álbuns em FLAC, ALAC, WAV e AIFF tocam sem pausas, sem ressalvas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "FLAC、ALAC、WAV 和 AIFF 专辑可无缝播放，没有任何例外。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "FLAC、ALAC、WAV 和 AIFF 專輯可無縫播放，沒有任何例外。"
          }
        }
      }
    },
