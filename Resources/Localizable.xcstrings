            "value": "Création de la vidéo arrêtée."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hætt við gerð myndbandsins."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Creazione del video interrotta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画の作成を停止しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동영상 만들기를 중단했습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Videolaging avbrutt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymano tworzenie wideo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A criação do vídeo foi interrompida."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Videoskapandet avbröts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已停止生成视频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已停止製作影片。"
          }
        }
      }
    },
    "Stopped with %lld songs left. Add the same songs again to finish.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppet med %lld sange tilbage. Tilføj de samme sange igen for at afslutte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgebrochen, %lld Titel fehlen noch. Füge dieselben Titel erneut hinzu, um den Vorgang abzuschließen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detenido con %lld canciones pendientes. Vuelve a añadir las mismas canciones para terminar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pysäytettiin, %lld kappaletta jäljellä. Lisää samat kappaleet uudelleen, jotta lisäys valmistuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêté, il reste %lld morceaux. Ajoutez les mêmes morceaux à nouveau pour terminer."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hætt þegar %lld lög voru eftir. Bættu sömu lögin við aftur til að ljúka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrotto con %lld brani rimanenti. Aggiungi di nuovo gli stessi brani per completare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld曲が残った状態で停止しました。同じ曲をもう一度追加すると完了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld곡을 남기고 중단되었습니다. 같은 곡을 다시 추가하면 완료됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avbrutt, %lld sanger gjenstår. Legg til de samme sangene igjen for å fullføre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymano, pozostało %lld utworów. Dodaj ponownie te same utwory, aby dokończyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompido com %lld músicas restantes. Adicione as mesmas músicas novamente para concluir."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avbröts med %lld låtar kvar. Lägg till samma låtar igen för att slutföra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已停止，还剩 %lld 首歌曲未添加。再次添加相同的歌曲即可完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已停止，還剩 %lld 首歌曲未加入。再次加入相同的歌曲即可完成。"
          }
        }
      }
    },
