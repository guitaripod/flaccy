    "Every listen counted, with an offline queue that never drops a play.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver lytning tæller med, og en offline-kø mister aldrig en afspilning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Hördurchgang zählt – mit einer Offline-Warteschlange, die keine Wiedergabe verliert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada escucha cuenta, con una cola sin conexión que nunca pierde una reproducción."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen kuuntelu lasketaan, ja offline-jono ei koskaan menetä toistoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque écoute comptée, avec une file hors ligne qui ne perd jamais une lecture."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver hlustun er skráð, með biðröð án nettengingar sem missir aldrei spilun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni ascolto conta, con una coda offline che non perde mai una riproduzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回の再生も逃さず、オフラインでもキューに貯めて必ず送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 감상을 빠짐없이 기록하고, 오프라인 대기열이 재생을 놓치지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver lytt telles, med en offline-kø som aldri mister en avspilling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde odsłuchanie policzone, z kolejką offline, która nigdy nie zgubi odtworzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada audição contabilizada, com uma fila offline que nunca perde uma reprodução."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje lyssning räknas, med en offlinekö som aldrig tappar en uppspelning."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一次收听都算数，离线队列绝不漏掉任何一次播放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每一次聆聽都算數，離線佇列絕不漏掉任何一次播放。"
          }
        }
      }
    },
    "Everything is indexed on this device — this only takes a moment the first time.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt indekseres på denne enhed – det tager kun et øjeblik første gang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wird auf diesem Gerät indiziert – beim ersten Mal dauert es kurz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se indexa en este dispositivo: solo tarda un momento la primera vez."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki indeksoidaan tällä laitteella. Tämä kestää ensimmäisellä kerralla vain hetken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est indexé sur cet appareil — cela ne prend qu’un instant la première fois."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt er skráð á þessu tæki, það tekur aðeins smá stund í fyrsta skiptið."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto viene indicizzato su questo dispositivo: la prima volta richiede solo un momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてこの端末内でインデックスされます。初回だけ少し時間がかかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 색인은 이 기기에서 만들어집니다. 처음 한 번만 잠시 걸려요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt indekseres på denne enheten, og det tar bare et øyeblikk første gang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko jest indeksowane na tym urządzeniu — pierwszy raz zajmuje to chwilę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo é indexado neste dispositivo — só demora um instante na primeira vez."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt indexeras på den här enheten, vilket bara tar en stund första gången."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有内容都在本机建立索引——只有第一次会花一点时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有內容都在本機建立索引——只有第一次會花一點時間。"
          }
        }
      }
    },
