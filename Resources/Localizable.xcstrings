        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low resolution — this will look soft on large displays"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja resolución: se verá borroso en pantallas grandes"
          }
