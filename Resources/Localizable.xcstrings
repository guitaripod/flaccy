        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メタデータソースに接続できませんでした。オンラインになると、年とジャンルを読み込みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메타데이터 소스에 연결할 수 없습니다. 온라인 상태가 되면 연도와 장르를 불러옵니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke nå metadatakildene. År og sjanger lastes inn når du er på nett."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się połączyć ze źródłami metadanych. Rok i gatunek wczytają się po połączeniu z internetem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar as fontes de metadados. Ano e gênero serão carregados quando você estiver online."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadatakällorna kunde inte nås. År och genre läses in när du är online."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接元数据来源。联网后将加载年份和流派。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線至中繼資料來源。連上網路後會載入年份與風格。"
          }
        }
      }
    },
    "Couldn't reach the sample music server — check your connection": {
