        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ olivat molemmilla laitteilla, ja nyt kustakin on vain yksi kopio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ étaient sur les deux appareils, il n’en reste plus qu’un de chaque."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ voru á báðum tækjunum og eru nú eitt eintak á hvoru tæki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ erano su entrambi i dispositivi ed ora ne resta uno per ciascuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は両方のデバイスにあり、今はそれぞれ1つずつになりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 두 기기에 모두 있었고, 이제 기기마다 하나씩 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fantes på begge enhetene og finnes nå én gang på hver."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ były na obu urządzeniach, a teraz jest po jednym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ estavam nos dois dispositivos e agora há um de cada."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fanns på båda enheterna och finns nu en av varje."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 原本同时存在于两台设备上，现在每台设备各有一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 原本同時存在於兩台裝置上，現在每台裝置各有一個。"
          }
        }
      }
    },
