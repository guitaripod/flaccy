    "Not enough space — this import needs %@, only %@ is free.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke nok plads – importen kræver %1$@, og der er kun %2$@ ledigt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu wenig Speicherplatz – dieser Import braucht %@, nur %@ sind frei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espacio insuficiente: esta importación necesita %@, solo %@ están libres."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilaa ei ole tarpeeksi: tämä tuonti tarvitsee %@, mutta vapaata tilaa on vain %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Espace insuffisant — cet import nécessite %@, mais seulement %@ sont libres."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki nóg pláss – þessi innflutningur þarf %@, en aðeins %@ er laust."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spazio insufficiente: questa importazione richiede %@, ma solo %@ sono liberi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空き容量が足りません — このインポートには%@が必要ですが、空きは%@しかありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 공간 부족 — 가져오기에 %@이(가) 필요하지만 %@만 남아 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke nok plass – denne importen trenger %@, bare %@ er ledig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za mało miejsca — ten import wymaga %1$@, dostępne jest tylko %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Espaço insuficiente — esta importação precisa de %@, mas só há %@ livres."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inte tillräckligt med utrymme. Importen kräver %@, men bara %@ är ledigt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空间不足——此次导入需要 %@，但只剩 %@ 可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "空間不足——此次匯入需要 %@，但只剩 %@ 可用。"
          }
        }
      }
    },
