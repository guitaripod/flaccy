          "stringUnit": {
            "state": "translated",
            "value": "此裝置沒有可用於掃描的相機。請改為手動輸入伺服器資訊。"
          }
        }
      }
    },
    "This device was removed from %@. Add the server again to keep syncing.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne enhed er fjernet fra %@. Tilføj serveren igen for at fortsætte med at synkronisere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät wurde von %@ entfernt. Den Server erneut hinzufügen, um die Synchronisierung fortzusetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device was removed from %@. Add the server again to keep syncing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo se quitó de %@. Vuelve a añadir el servidor para seguir sincronizando."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä laite poistettiin kohteesta %@. Lisää palvelin uudelleen, jotta synkronointi jatkuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil a été retiré de %@. Ajoutez à nouveau le serveur pour continuer la synchronisation."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þessu tæki var fjarlægt úr %@. Bættu netþjóninum við aftur til að halda samstillingu áfram."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo è stato rimosso da %@. Aggiungi di nuovo il server per continuare a sincronizzare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスは %@ から削除されました。同期を続けるには、サーバーをもう一度追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기가 %@에서 제거됐어요. 동기화를 계속하려면 서버를 다시 추가하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne enheten ble fjernet fra %@. Legg til serveren på nytt for å fortsette å synkronisere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To urządzenie zostało usunięte z: %@. Dodaj serwer ponownie, aby kontynuować synchronizację."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo foi removido de %@. Adicione o servidor de novo para continuar sincronizando."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här enheten togs bort från %@. Lägg till servern igen för att fortsätta synkronisera."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备已从 %@ 中移除。请重新添加服务器以继续同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置已從 %@ 中移除。請重新新增伺服器以繼續同步。"
          }
        }
      }
    },
