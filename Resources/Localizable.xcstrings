    "It answered, but not as Flaccy Server. If it is Navidrome or another Subsonic server, add it as a regular server.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveren svarede, men ikke som Flaccy Server. Hvis det er Navidrome eller en anden Subsonic-server, så tilføj den som en almindelig server."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es hat geantwortet, aber nicht als Flaccy Server. Ist es Navidrome oder ein anderer Subsonic-Server, als normalen Server hinzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It answered, but not as Flaccy Server. If it is Navidrome or another Subsonic server, add it as a regular server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respondió, pero no como Flaccy Server. Si es Navidrome u otro servidor Subsonic, añádelo como servidor normal."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vastasi, mutta ei Flaccy Serverinä. Jos kyse on Navidromesta tai muusta Subsonic-palvelimesta, lisää se tavallisena palvelimena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il a répondu, mais pas en tant que Flaccy Server. S’il s’agit de Navidrome ou d’un autre serveur Subsonic, ajoutez-le comme serveur classique."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Það svaraði, en ekki sem Flaccy Server. Ef þetta er Navidrome eða annar Subsonic-netþjónn, bættu honum við sem venjulegum netþjóni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha risposto, ma non come Flaccy Server. Se è Navidrome o un altro server Subsonic, aggiungilo come server normale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応答はありましたが、Flaccy Server ではありません。Navidrome などの Subsonic サーバーであれば、通常のサーバーとして追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응답은 했지만 Flaccy Server는 아니에요. Navidrome이나 다른 Subsonic 서버라면 일반 서버로 추가하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Adressen svarte, men ikke som Flaccy Server. Hvis det er Navidrome eller en annen Subsonic-server, legg den til som en vanlig server."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiedział, ale nie jako Flaccy Server. Jeśli to Navidrome lub inny serwer Subsonic, dodaj go jako zwykły serwer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Respondeu, mas não como Flaccy Server. Se for Navidrome ou outro servidor Subsonic, adicione-o como servidor comum."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den svarade, men inte som Flaccy Server. Om det är Navidrome eller en annan Subsonic-server, lägg till den som en vanlig server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它有响应，但不是 Flaccy Server。如果它是 Navidrome 或其他 Subsonic 服务器，请将其添加为普通服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它有回應，但不是 Flaccy Server。如果它是 Navidrome 或其他 Subsonic 伺服器，請將其新增為一般伺服器。"
          }
        }
      }
    },
    "It doesn't match the key from when this device was added, so nothing was sent. If %@ was reinstalled or moved, remove it and add it again with a new code.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den stemmer ikke med den nøgle, der blev gemt, da denne enhed blev tilføjet, så intet blev sendt. Hvis %@ er blevet geninstalleret eller flyttet, skal du fjerne den og tilføje den igen med en ny kode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er stimmt nicht mit dem Schlüssel überein, der beim Hinzufügen dieses Geräts gespeichert wurde, daher wurde nichts gesendet. Wenn %@ neu installiert oder verschoben wurde, entferne es und füge es mit einem neuen Code erneut hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It doesn't match the key from when this device was added, so nothing was sent. If %@ was reinstalled or moved, remove it and add it again with a new code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No coincide con la clave de cuando se añadió este dispositivo, así que no se envió nada. Si %@ se reinstaló o se movió, elimínalo y añádelo de nuevo con un código nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avain ei täsmää siihen, joka tallennettiin laitetta lisättäessä, joten mitään ei lähetetty. Jos %@ asennettiin uudelleen tai siirrettiin, poista se ja lisää uudelleen uudella koodilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle ne correspond pas à la clé de l’ajout de cet appareil, donc rien n’a été envoyé. Si %@ a été réinstallé ou déplacé, supprime-le et ajoute-le de nouveau avec un nouveau code."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Lykillinn stemmir ekki við þann sem var vistaður þegar tækið var bætt við, svo ekkert var sent. Ef %@ var sett upp aftur eða flutt, fjarlægðu netþjóninn og bættu honum aftur við með nýjum kóða."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non corrisponde alla chiave di quando questo dispositivo è stato aggiunto, quindi non è stato inviato nulla. Se %@ è stato reinstallato o spostato, rimuovilo e aggiungilo di nuovo con un nuovo codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この機器を追加したときの鍵と一致しないため、何も送信されていません。%@ を再インストールまたは移動した場合は、削除してから新しいコードで追加し直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기를 추가했을 때의 키와 일치하지 않아 아무것도 전송되지 않았습니다. %@을(를) 다시 설치하거나 옮겼다면 삭제한 뒤 새 코드로 다시 추가하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den samsvarer ikke med nøkkelen fra da denne enheten ble lagt til, så ingenting ble sendt. Hvis %@ ble installert på nytt eller flyttet, fjern den og legg den til igjen med en ny kode."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zgadza się z kluczem z chwili dodania tego urządzenia, więc nic nie zostało wysłane. Jeśli %@ został ponownie zainstalowany lub przeniesiony, usuń go i dodaj ponownie z nowym kodem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não corresponde à chave de quando este dispositivo foi adicionado, então nada foi enviado. Se %@ foi reinstalado ou movido, remova-o e adicione-o de novo com um código novo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den stämmer inte med nyckeln som sparades när den här enheten lades till, så inget skickades. Om %@ har installerats om eller flyttats, ta bort den och lägg till den igen med en ny kod."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与添加此设备时的密钥不匹配，因此未发送任何内容。如果 %@ 被重新安装或移动，请将其移除，然后用新代码重新添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與新增此裝置時的金鑰不符，因此未傳送任何內容。如果 %@ 被重新安裝或移動，請將其移除，然後用新代碼重新新增。"
          }
        }
      }
    },
    "It stops syncing with %@ and needs a new code to be added again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkroniseringen med %@ stopper, og der skal en ny kode til for at tilføje serveren igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Synchronisierung mit %@ endet. Zum erneuten Hinzufügen ist ein neuer Code nötig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It stops syncing with %@ and needs a new code to be added again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja de sincronizarse con %@ y necesita un código nuevo para volver a añadirse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkronointi %@:n kanssa päättyy. Laitteen lisääminen uudelleen vaatii uuden koodin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation avec %@ s’arrête, et un nouveau code est nécessaire pour l’ajouter à nouveau."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Samstilling við %@ hættir og þarf nýjan kóða til að bæta við aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Smette di sincronizzarsi con %@ e per aggiungerlo di nuovo serve un nuovo codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ との同期が停止し、再び追加するには新しいコードが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@와의 동기화가 중단되며, 다시 추가하려면 새 코드가 필요해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkroniseringen med %@ stopper, og den må legges til på nytt med en ny kode."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przestaje synchronizować się z: %@ i aby go dodać ponownie, potrzebny jest nowy kod."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa de sincronizar com %@ e precisa de um código novo para ser adicionado de novo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkroniseringen med %@ upphör, och en ny kod krävs för att lägga till den igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它将停止与 %@ 同步，需要新的代码才能重新添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它將停止與 %@ 同步，需要新的代碼才能重新新增。"
          }
        }
      }
    },
