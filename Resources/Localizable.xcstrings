          "stringUnit": {
            "state": "translated",
            "value": "FLAC-Alben laufen ohne eine Sekunde Stille von Titel zu Titel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los álbumes FLAC fluyen de pista a pista sin un segundo de silencio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "FLAC-albumit soivat kappaleesta toiseen ilman hiljaisuutta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les albums FLAC s'enchaînent sans une seconde de silence."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "FLAC-plötur renna áfram milli laga án nokkurrar þagnar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli album FLAC scorrono da un brano all'altro senza un attimo di silenzio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FLACのアルバムは無音を挟まず曲から曲へ流れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "FLAC 앨범은 정적 없이 곡에서 곡으로 이어집니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "FLAC-album flyter fra sang til sang uten stillhet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Albumy FLAC płyną z utworu na utwór bez cienia ciszy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Álbuns em FLAC fluem de faixa em faixa sem um segundo de silêncio."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "FLAC-album flyter från låt till låt utan någon tystnad alls."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "FLAC 专辑一曲接一曲，中间没有一秒静音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "FLAC 專輯一曲接一曲，中間沒有一秒空白。"
          }
        }
      }
    },
    "FLAC, ALAC, WAV, AIFF, MP3 and AAC, plus .lrc lyrics. Anything else is skipped.": {
      "comment": "Wi-Fi Transfer web page: what can be sent",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "FLAC, ALAC, WAV, AIFF, MP3 og AAC samt .lrc-sangtekster. Alt andet springes over."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FLAC, ALAC, WAV, AIFF, MP3 und AAC sowie .lrc-Songtexte. Alles andere wird übersprungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FLAC, ALAC, WAV, AIFF, MP3 y AAC, además de letras .lrc. Lo demás se omite."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "FLAC, ALAC, WAV, AIFF, MP3 ja AAC sekä .lrc-sanoitukset. Muut tiedostot ohitetaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FLAC, ALAC, WAV, AIFF, MP3 et AAC, ainsi que les paroles .lrc. Le reste est ignoré."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "FLAC, ALAC, WAV, AIFF, MP3 og AAC, auk .lrc-textaskráa. Öllu öðru er sleppt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "FLAC, ALAC, WAV, AIFF, MP3 e AAC, più i testi .lrc. Tutto il resto viene saltato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FLAC、ALAC、WAV、AIFF、MP3、AAC、および.lrc歌詞に対応。それ以外はスキップされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "FLAC, ALAC, WAV, AIFF, MP3, AAC 및 .lrc 가사. 그 밖의 파일은 건너뜁니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "FLAC, ALAC, WAV, AIFF, MP3 og AAC, samt .lrc-sangtekster. Alt annet hoppes over."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "FLAC, ALAC, WAV, AIFF, MP3 i AAC oraz teksty .lrc. Wszystko inne jest pomijane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "FLAC, ALAC, WAV, AIFF, MP3 e AAC, além de letras .lrc. O resto é ignorado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "FLAC, ALAC, WAV, AIFF, MP3 och AAC, samt .lrc-låttexter. Allt annat hoppas över."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持 FLAC、ALAC、WAV、AIFF、MP3 和 AAC，以及 .lrc 歌词。其他文件会被跳过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支援 FLAC、ALAC、WAV、AIFF、MP3 和 AAC，以及 .lrc 歌詞。其他檔案會略過。"
          }
        }
      }
    },
