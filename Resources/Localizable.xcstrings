    "Two reminders before your trial ends, and one if an offer opens.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "To påmindelser, før din prøveperiode slutter, og en, hvis der åbner sig et tilbud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Erinnerungen vor Ende deiner Testphase und eine, wenn ein Angebot startet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos recordatorios antes de que termine tu prueba y uno si hay una oferta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaksi muistutusta ennen kokeilun päättymistä ja yksi, jos tarjous tulee saataville."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux rappels avant la fin de votre essai, et un si une offre se présente."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvær áminningar áður en prufutíminn lýkur, og ein þegar tilboð verður í boði."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due promemoria prima della fine della prova e uno se arriva un'offerta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トライアル終了前に2回、オファーが始まったときに1回お知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체험 종료 전에 두 번, 할인이 시작되면 한 번 알려 드립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "To påminnelser før prøveperioden din utløper, og én hvis et tilbud dukker opp."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwa przypomnienia przed końcem okresu próbnego i jedno, gdy pojawi się oferta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dois lembretes antes do fim do seu teste e um se surgir uma oferta."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Två påminnelser innan din provperiod går ut, och en om ett erbjudande blir tillgängligt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试用结束前提醒两次，有优惠时再提醒一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "試用結束前提醒兩次，有優惠時再提醒一次。"
          }
        }
      }
    },
