    "Drag a node · pinch to change Q · double-tap empty space to add a band": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Knoten ziehen · zum Ändern von Q kneifen · auf leere Fläche doppeltippen, um ein Band hinzuzufügen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra un nodo · pellizca para cambiar Q · toca dos veces un espacio vacío para añadir una banda"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser un nœud · pincez pour changer Q · double-tapez un espace vide pour ajouter une bande"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina un nodo · pizzica per cambiare Q · tocca due volte uno spazio vuoto per aggiungere una banda"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノードをドラッグ · ピンチでQを変更 · 空いている場所をダブルタップでバンドを追加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노드 드래그 · 핀치로 Q 변경 · 빈 공간 더블 탭하여 밴드 추가"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij węzeł · uszczypnij, aby zmienić Q · dwukrotnie dotknij pustego miejsca, aby dodać pasmo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste um nó · beliscar para mudar Q · toque duas vezes em espaço vazio para adicionar uma banda"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动节点 · 捏合以更改 Q 值 · 双击空白处以添加频段"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移節點 · 捏合以變更 Q 值 · 雙擊空白處以新增頻段"
          }
        }
      }
    },
    "Drag a node · scroll over it to change Q · double-click empty space to add a band": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Knoten ziehen · darüber scrollen, um Q zu ändern · auf leeren Bereich doppelklicken, um ein Band hinzuzufügen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra un nodo · desplázate sobre él para cambiar Q · haz doble clic en un espacio vacío para añadir una banda"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser un nœud · faites défiler dessus pour changer Q · double-cliquez sur un espace vide pour ajouter une bande"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina un nodo · scorri sopra di esso per cambiare Q · fai doppio clic su uno spazio vuoto per aggiungere una banda"
