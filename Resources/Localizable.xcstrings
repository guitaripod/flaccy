            "state": "translated",
            "value": "ライブラリから似た曲のステーションを再生します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함에서 비슷한 음악 스테이션을 재생합니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
