          }
        }
      }
    },
    "Flaccy Server plays the music on your Mac or PC on this iPad over your Wi-Fi, with playlists, loves and history in step. It's free, and your music never leaves your own network.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy Server afspiller musikken fra din Mac eller pc på denne iPad over dit Wi-Fi, med playlister, synes godt om-markeringer og historik synkroniseret. Den er gratis, og din musik forlader aldrig dit eget netværk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy Server spielt die Musik deines Macs oder PCs auf diesem iPad über dein WLAN ab, mit Playlists, Loves und Verlauf synchron. Er ist kostenlos, und deine Musik verlässt nie dein eigenes Netzwerk."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy Server plays the music on your Mac or PC on this iPad over your Wi-Fi, with playlists, loves and history in step. It's free, and your music never leaves your own network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy Server reproduce en este iPad la música de tu Mac o PC por Wi-Fi, con las listas, los me gusta y el historial al día. Es gratis, y tu música nunca sale de tu propia red."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy Server toistaa Mac- tai PC-tietokoneesi musiikkia tällä iPadilla Wi-Fi-verkon kautta, ja soittolistat, tykkäykset ja historia pysyvät ajan tasalla. Se on ilmainen, eikä musiikkisi koskaan poistu omasta verkostasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy Server joue sur cet iPad la musique de votre Mac ou PC via le Wi-Fi, avec playlists, favoris et historique synchronisés. C’est gratuit, et votre musique ne quitte jamais votre propre réseau."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy Server spilar tónlistina í Mac- eða PC-tölvunni þinni á þessum iPad yfir Wi-Fi, með spilunarlistum, líkuðum lögum og hlustunarferli í samstillingu. Hann er ókeypis og tónlistin þín yfirgefur aldrei þitt eigið net."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy Server riproduce su questo iPad la musica del tuo Mac o PC tramite Wi-Fi, con playlist, Mi piace e cronologia sempre aggiornati. È gratuito e la tua musica non lascia mai la tua rete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy Server は、Mac や PC の音楽を Wi-Fi 経由でこの iPad で再生します。プレイリスト、お気に入り、再生履歴も同期されます。無料で、音楽が自分のネットワークの外へ出ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy Server는 Mac이나 PC의 음악을 Wi-Fi를 통해 이 iPad에서 재생합니다. 재생목록, 좋아요, 재생 기록도 함께 맞춰집니다. 무료이며, 음악은 내 네트워크 밖으로 나가지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy Server spiller av musikken på Mac-en eller PC-en din på denne iPaden over Wi-Fi, med spillelister, likte sanger og lyttehistorikk i takt. Den er gratis, og musikken din forlater aldri ditt eget nettverk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy Server odtwarza na tym iPadzie muzykę z twojego Maca lub PC przez Wi-Fi, z playlistami, polubieniami i historią na bieżąco. To bezpłatne, a twoja muzyka nigdy nie opuszcza twojej sieci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Flaccy Server toca no seu iPad a música do Mac ou PC por Wi-Fi, com playlists, curtidas e histórico sincronizados. É grátis, e sua música nunca sai da sua própria rede."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy Server spelar upp musiken från din Mac eller dator på den här iPaden via ditt Wi-Fi, med spellistor, gillningar och historik i synk. Den är gratis, och din musik lämnar aldrig ditt eget nätverk."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy Server 通过 Wi-Fi 在这台 iPad 上播放你的 Mac 或 PC 中的音乐，播放列表、喜欢和历史记录保持同步。免费，你的音乐绝不会离开你自己的网络。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy Server 透過 Wi-Fi 在這台 iPad 上播放你的 Mac 或 PC 中的音樂，播放列表、喜愛和紀錄保持同步。免費，你的音樂絕不會離開你自己的網路。"
          }
        }
      }
    },
