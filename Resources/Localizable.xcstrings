            "value": "從你的資料庫播放相似音樂電台"
          }
        }
      }
    },
    "Plays deep cuts from albums you already love": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afspiller skjulte perler fra album, du allerede elsker"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielt verborgene Perlen aus Alben, die du liebst"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce joyas ocultas de álbumes que ya te encantan"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toistaa piilotettuja helmiä albumeilta, joista jo pidät."
          }
        },
        "fr": {
