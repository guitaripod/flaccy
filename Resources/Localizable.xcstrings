    "Couldn't delete “%@” — the library database couldn't be written. Check free disk space and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ konnte nicht gelöscht werden – die Mediathek-Datenbank ließ sich nicht schreiben. Prüfe den freien Speicherplatz und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo eliminar “%@”: la base de datos de la biblioteca no se pudo escribir. Revisa el espacio libre del disco e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de supprimer « %@ » : la base de données de la bibliothèque n’a pas pu être écrite. Vérifiez l’espace disque disponible et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile eliminare “%@”: impossibile scrivere il database della libreria. Controlla lo spazio libero su disco e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を削除できませんでした。ライブラリのデータベースに書き込めませんでした。空き容量を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”을(를) 삭제할 수 없습니다. 보관함 데이터베이스에 쓸 수 없었습니다. 디스크 여유 공간을 확인하고 다시 시도하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się usunąć „%@” — nie można zapisać bazy danych biblioteki. Sprawdź wolne miejsce na dysku i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível excluir “%@”: o banco de dados da biblioteca não pôde ser gravado. Verifique o espaço livre em disco e tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法删除“%@”——资料库数据库无法写入。请检查可用磁盘空间后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法刪除「%@」——資料庫無法寫入。請檢查可用磁碟空間後再試一次。"
          }
        }
      }
    },
