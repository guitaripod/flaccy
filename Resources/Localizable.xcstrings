            "state": "translated",
            "value": "Synkroniser sange, og afspil dem fra håndleddet, uden iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Titel synchronisieren und direkt vom Handgelenk hören – ganz ohne iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza pistas y escucha desde la muñeca, sin iPhone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkronoi kappaleet ja toista ne ranteelta ilman puhelinta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisez des morceaux et écoutez depuis votre poignet, sans iPhone."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Samstilltu lög og spilaðu af úlnliðnum, án þess að þurfa símann."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizza i brani e ascolta dal polso, senza iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曲を同期すれば、iPhoneなしで手首から再生できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트랙을 동기화하면 iPhone 없이 손목에서 바로 들을 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkroniser sanger og spill av fra håndleddet, uten telefon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizuj utwory i odtwarzaj z nadgarstka, bez telefonu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronize faixas e ouça direto do pulso, sem precisar do iPhone."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkronisera låtar och spela upp dem från handleden, utan att behöva en iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步曲目，从手腕上直接播放，无需 iPhone。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同步曲目，直接從手腕上播放，不需要 iPhone。"
          }
        }
      }
    },
