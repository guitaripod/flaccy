    "Low resolution — this will look soft on large displays": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lav opløsning – dette vil se blødt ud på store skærme"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niedrige Auflösung – auf großen Displays wirkt das unscharf"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low resolution — this will look soft on large displays"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja resolución: se verá borroso en pantallas grandes"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Matala resoluutio – tämä näyttää pehmeältä suurilla näytöillä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Basse résolution : l'image paraîtra floue sur les grands écrans"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Lág upplausn – þetta verður óskýrt á stórum skjám"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bassa risoluzione: apparirà sfocata sui display grandi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低解像度です。大きなディスプレイでは粗く見えます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해상도가 낮습니다. 큰 디스플레이에서는 흐리게 보일 수 있습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lav oppløsning – dette blir uskarpt på store skjermer"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niska rozdzielczość — na dużych ekranach będzie nieostra"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixa resolução — ficará borrada em telas grandes"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låg upplösning – det här blir suddigt på stora skärmar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分辨率较低，在大屏幕上会显得模糊"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解析度較低，在大螢幕上會顯得模糊"
          }
        }
      }
    },
