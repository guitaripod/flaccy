    "%@ doesn’t accept password sign-in from apps. Use an API key instead: create one in the server’s settings and enter it here.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tillader ikke at logge ind med adgangskode fra apps. Brug i stedet en API-nøgle: Opret en i serverens indstillinger, og indtast den her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ erlaubt die Anmeldung per Passwort aus Apps nicht. Verwende stattdessen einen API-Schlüssel: Erstelle einen in den Servereinstellungen und gib ihn hier ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no admite el inicio de sesión con contraseña desde apps. Usa una clave de API: crea una en los ajustes del servidor e introdúcela aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ei hyväksy salasanakirjautumista sovelluksista. Käytä sen sijaan API-avainta: luo sellainen palvelimen asetuksista ja syötä se tähän."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’accepte pas la connexion par mot de passe depuis des apps. Utilise plutôt une clé d’API : crée-en une dans les réglages du serveur et saisis-la ici."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tekur ekki við innskráningu með lykilorði úr forritum. Notaðu API-lykil í staðinn: búðu til einn í stillingum netþjónsins og settu hann inn hér."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non accetta l’accesso con password dalle app. Usa invece una chiave API: creane una nelle impostazioni del server e inseriscila qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はアプリからのパスワードによるサインインを受け付けません。代わりに API キーを使ってください。サーバーの設定でキーを作成し、ここに入力します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 앱의 비밀번호 로그인을 허용하지 않습니다. 대신 API 키를 사용하세요. 서버 설정에서 키를 만들어 여기에 입력하면 됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ godtar ikke pålogging med passord fra apper. Bruk en API-nøkkel i stedet: opprett en i serverens innstillinger og skriv den inn her."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie przyjmuje logowania hasłem z aplikacji. Użyj zamiast tego klucza API: utwórz go w ustawieniach serwera i wpisz tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não aceita login com senha em apps. Use uma chave de API: crie uma nas configurações do servidor e informe aqui."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tillåter inte inloggning med lösenord från appar. Använd en API-nyckel i stället: skapa en i serverns inställningar och ange den här."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不接受应用使用密码登录。请改用 API 密钥：在服务器设置中创建一个，然后在此输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不接受 App 以密碼登入。請改用 API 金鑰：在伺服器設定中建立一組，然後在此輸入。"
          }
        }
      }
    },
