    "Songs you streamed are fetched from the server again the next time you play them. Songs you downloaded are not touched.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Streamede sange hentes igen fra serveren, næste gang du afspiller dem. Hentede sange påvirkes ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestreamte Songs werden beim nächsten Abspielen erneut vom Server geladen. Heruntergeladene Songs bleiben unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las canciones que has reproducido en streaming se volverán a descargar del servidor la próxima vez que las reproduzcas. Las canciones descargadas no se tocan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suoratoistetut kappaleet haetaan palvelimelta uudelleen, kun seuraavan kerran toistat ne. Ladattuja kappaleita ei kosketa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les morceaux écoutés en streaming seront à nouveau récupérés sur le serveur la prochaine fois que tu les écouteras. Les morceaux téléchargés ne sont pas touchés."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Lög sem þú hefur streymt eru sótt aftur af netþjóninum næst þegar þú spilar þau. Lög sem þú hefur sótt eru ekki snert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I brani ascoltati in streaming verranno scaricati di nuovo dal server la prossima volta che li riprodurrai. I brani scaricati non vengono modificati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストリーミングで再生した曲は、次に再生するときサーバーから再取得されます。ダウンロードした曲は変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스트리밍으로 재생한 곡은 다음에 재생할 때 서버에서 다시 가져옵니다. 다운로드한 곡은 그대로 유지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanger du har strømmet, hentes på nytt fra serveren neste gang du spiller dem av. Nedlastede sanger berøres ikke."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwory odtwarzane ze strumienia zostaną ponownie pobrane z serwera przy następnym odtworzeniu. Pobrane utwory nie są naruszane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As músicas que você transmitiu serão buscadas no servidor de novo na próxima vez que tocar. As músicas baixadas não são alteradas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låtar du streamade hämtas från servern igen nästa gång du spelar dem. Låtar du hämtade berörs inte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你流式播放过的歌曲会在下次播放时从服务器重新获取。你下载的歌曲不会受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你串流播放過的歌曲會在下次播放時從伺服器重新取得。你下載的歌曲不會受影響。"
          }
        }
      }
    },
