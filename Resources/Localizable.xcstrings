    "Written by AI from the lyrics. It can be wrong.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrevet af AI ud fra sangteksten. Den kan tage fejl."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von KI anhand des Songtexts geschrieben. Das kann falsch sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escrito por IA a partir de la letra. Puede equivocarse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekoäly kirjoitti tämän sanoitusten perusteella. Se voi olla väärin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrit par l’IA à partir des paroles. Peut contenir des erreurs."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrifað af gervigreind út frá textanum. Það getur verið rangt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scritto dall’IA a partire dal testo. Può essere sbagliato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "歌詞をもとにAIが書いた解説です。誤りを含むことがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가사를 바탕으로 AI가 작성했습니다. 틀릴 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrevet av KI ut fra sangteksten. Det kan være feil."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napisane przez AI na podstawie tekstu. Może zawierać błędy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escrito por IA a partir da letra. Pode estar errado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriven av AI utifrån låttexten. Den kan vara fel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由 AI 根据歌词撰写，可能有误。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
