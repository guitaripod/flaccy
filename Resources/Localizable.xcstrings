    "Sync stays off until the date and time on %@ are right.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkroniseringen forbliver slået fra, indtil datoen og klokkeslættet på %@ er rigtige."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Synchronisierung bleibt aus, bis Datum und Uhrzeit auf %@ stimmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync stays off until the date and time on %@ are right."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización sigue desactivada hasta que la fecha y la hora de %@ sean correctas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkronointi pysyy pois päältä, kunnes %@:n päivämäärä ja kellonaika ovat oikein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation reste désactivée tant que la date et l’heure de %@ ne sont pas justes."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Samstilling helst slökkt þangað til dagsetning og tími á %@ eru rétt stillt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione resta disattivata finché data e ora su %@ non sono corrette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の日付と時刻が正しくなるまで、同期はオフのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 날짜와 시간이 맞을 때까지 동기화는 꺼진 상태로 유지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkroniseringen er av til dato og klokkeslett på %@ stemmer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizacja pozostaje wyłączona, dopóki data i godzina na %@ nie będą prawidłowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização fica desativada até que a data e a hora em %@ estejam corretas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkroniseringen är avstängd tills datum och tid på %@ stämmer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %@ 上的日期和时间正确之前，同步将保持关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %@ 上的日期和時間正確之前，同步將保持關閉。"
          }
        }
      }
    },
