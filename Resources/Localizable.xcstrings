    "Everything, renews each year. Cancel anytime.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt inklusive, fornyes hvert år. Opsig når som helst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles inklusive, verlängert sich jährlich. Jederzeit kündbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo incluido, se renueva cada año. Cancela cuando quieras."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki mukana, uusiutuu vuosittain. Voit peruuttaa milloin tahansa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout inclus, renouvelé chaque année. Annulable à tout moment."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt innifalið, endurnýjast árlega. Hægt er að hætta hvenær sem er."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto incluso, si rinnova ogni anno. Disdici quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての機能。毎年自動更新、いつでも解約できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기능 포함, 매년 갱신. 언제든 해지할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt inkludert, fornyes hvert år. Avbryt når som helst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko, odnawia się co roku. Anuluj w każdej chwili."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo incluído, renova todo ano. Cancele quando quiser."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt ingår, förnyas varje år. Avbryt när som helst."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
