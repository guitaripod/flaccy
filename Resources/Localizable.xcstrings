    "Lists a song once when it is on several albums.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser en sang én gang, når den står på flere album."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt einen Song nur einmal, wenn er auf mehreren Alben steht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra una canción una sola vez cuando aparece en varios álbumes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää kappaleen vain kerran, kun se on useilla albumeilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche un morceau une seule fois lorsqu'il figure sur plusieurs albums."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sýnir lag aðeins einu sinni þegar það er á mörgum plötum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra un brano una sola volta quando è presente in più album."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数のアルバムに入っている曲は1回だけ表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 앨범에 들어 있는 곡을 한 번만 표시합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser en sang bare én gang når den er på flere album."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyświetla utwór raz, gdy znajduje się na kilku albumach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista uma música uma vez quando ela aparece em vários álbuns."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar en låt en gång när den finns på flera album."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一首歌出现在多张专辑中时只列出一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
