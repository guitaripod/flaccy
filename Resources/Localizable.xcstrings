    "%@ is out of disk space. Free some up and Flaccy retries by itself.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er løbet tør for lagerplads. Frigør lidt, så prøver Flaccy automatisk igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat keinen freien Speicherplatz mehr. Sobald Platz frei wird, versucht Flaccy es automatisch erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is out of disk space. Free some up and Flaccy retries by itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha agotado el espacio en disco de %@. Al liberar espacio, Flaccy lo reintentará solo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:n levytila on täynnä. Vapauta tilaa, niin Flaccy yrittää uudelleen automaattisesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus de place sur %@. Une fois de la place libérée, Flaccy réessaie automatiquement."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Geymslupláss á %@ er á þrotum. Losaðu um pláss og Flaccy reynir aftur af sjálfu sér."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non ha più spazio su disco. Quando se ne libera, Flaccy riprova da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の空き容量が不足しています。空き容量を増やすと、Flaccyが自動で再試行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 저장 공간이 부족해요. 공간을 확보하면 Flaccy가 자동으로 다시 시도해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har gått tom for lagringsplass. Frigjør litt, så prøver Flaccy igjen av seg selv."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na %@ skończyło się miejsce na dysku. Gdy zwolni się miejsce, Flaccy spróbuje ponownie sam."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está sem espaço em disco. Ao liberar espaço, o Flaccy tenta de novo sozinho."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har slut på lagringsutrymme. Frigör lite utrymme så försöker Flaccy igen automatiskt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 磁盘空间不足。腾出一些空间后，Flaccy 会自动重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 磁碟空間不足。騰出一些空間後，Flaccy 會自動重試。"
          }
        }
      }
    },
