        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous écoutez le mieux une fois la nuit tombée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai il meglio quando cala il buio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日が暮れてからが本領発揮です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해가 진 뒤에 가장 잘 듣습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najlepiej słucha ci się po zmroku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ouve melhor depois que escurece."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "夜幕降临后，你才真正开始听歌。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "天黑之後，你才真正開始聽歌。"
          }
        }
      }
    },
