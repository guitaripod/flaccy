    "Your listens will no longer be scrobbled. Your library, play history, and loved tracks stay on this device.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine afspilninger scrobbles ikke længere. Dit bibliotek, din lyttehistorik og de sange, du synes godt om, bliver på denne enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Hördurchgänge werden nicht mehr gescrobbelt. Mediathek, Wiedergabeverlauf und Favoriten bleiben auf diesem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus escuchas ya no se scrobblearán. Tu biblioteca, tu historial de reproducción y tus favoritas siguen en este dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuuntelujasi ei enää scrobblata. Mediatekasi, toistohistoriasi ja tykätyt kappaleet pysyvät tällä laitteella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos écoutes ne seront plus scrobblées. Votre bibliothèque, votre historique et vos morceaux aimés restent sur cet appareil."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlustanir þínar verða ekki lengur scrobblaðar. Safnið þitt, spilunarferill og líkuð lög haldast á þessu tæki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi ascolti non verranno più scrobblati. Libreria, cronologia di ascolto e preferiti restano su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後、再生はスクロブルされません。ライブラリ、再生履歴、お気に入りはこのデバイスに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 감상 기록이 스크로블되지 않습니다. 보관함, 재생 기록, 좋아요한 트랙은 이 기기에 남습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyttingene dine scrobbles ikke lenger. Biblioteket, lyttehistorikken og likte sanger blir på denne enheten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje odsłuchy nie będą już scrobblowane. Twoja biblioteka, historia odtwarzania i ulubione utwory zostają na tym urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas audições não serão mais scrobbladas. Sua biblioteca, o histórico de reproduções e as faixas curtidas continuam neste dispositivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina lyssningar scrobblas inte längre. Ditt bibliotek, din uppspelningshistorik och dina gillade låtar stannar på den här enheten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的收听记录将不再被 Scrobble。资料库、播放记录和喜欢的曲目都会留在此设备上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的聆聽記錄將不再被 Scrobble。資料庫、播放記錄與喜愛的曲目都會留在這部裝置上。"
          }
        }
      }
    },
