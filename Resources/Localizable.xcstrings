            "value": "Dirige l’appareil photo vers le code QR affiché par ton Flaccy Server."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Beindu myndavélinni að QR-kóðanum sem Flaccy-netþjónninn þinn sýnir."
          }
        },
        "it": {
          "stringUnit": {
