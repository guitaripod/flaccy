    "Point Flaccy at your music folder and it indexes everything in place — FLAC, ALAC, MP3 and more, nothing copied or moved.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Peg Flaccy på din musikmappe, og den indekserer alt, hvor det ligger – FLAC, ALAC, MP3 og mere, uden at noget kopieres eller flyttes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte Flaccy auf deinen Musikordner und alles wird an Ort und Stelle indexiert – FLAC, ALAC, MP3 und mehr, nichts wird kopiert oder verschoben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta Flaccy a tu carpeta de música y lo indexa todo donde está: FLAC, ALAC, MP3 y más, sin copiar ni mover nada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoita Flaccy musiikkikansioosi, niin se indeksoi kaiken paikallaan – FLAC, ALAC, MP3 ja muut, eikä mitään kopioida tai siirretä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointez Flaccy vers votre dossier de musique et tout est indexé sur place — FLAC, ALAC, MP3 et plus, rien n'est copié ni déplacé."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Beindu Flaccy að tónlistarmöppunni þinni og það skráir allt á sínum stað – FLAC, ALAC, MP3 og fleira, án þess að neitt sé afritað eða fært."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Punta Flaccy alla tua cartella di musica e indicizza tutto dov'è: FLAC, ALAC, MP3 e altro, senza copiare né spostare nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccyに音楽フォルダを指定すれば、その場ですべてをインデックスします — FLAC、ALAC、MP3など、コピーも移動もしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy에 음악 폴더를 지정하면 모든 것을 제자리에서 색인합니다 — FLAC, ALAC, MP3 등, 복사하거나 옮기지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pek Flaccy mot musikkmappen din, så indekseres alt der det ligger – FLAC, ALAC, MP3 og mer, uten at noe kopieres eller flyttes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wskaż Flaccy swój folder z muzyką, a on zaindeksuje wszystko w miejscu — FLAC, ALAC, MP3 i więcej, nic nie jest kopiowane ani przenoszone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aponte o Flaccy para a sua pasta de música e ele indexa tudo onde está — FLAC, ALAC, MP3 e mais, sem copiar nem mover nada."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Peka Flaccy mot din musikmapp så indexeras allt på plats: FLAC, ALAC, MP3 och mer, utan att något kopieras eller flyttas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把 Flaccy 指向你的音乐文件夹，它会就地索引一切——FLAC、ALAC、MP3 等等，不拷贝也不移动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把 Flaccy 指向你的音樂資料夾，它就會就地索引一切——FLAC、ALAC、MP3 等等，不拷貝也不移動。"
          }
        }
      }
    },
