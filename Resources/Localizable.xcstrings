    "Re-analyze cleans up titles, artists and albums from file names with AI.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysér igen rydder op i titler, kunstnere og album ud fra filnavnene med AI."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut analysieren bereinigt Titel, Interpreten und Alben anhand der Dateinamen mit KI."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reanalizar depura títulos, artistas y álbumes a partir de los nombres de archivo con IA."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uudelleenanalyysi siivoaa nimet, artistit ja albumit tiedostonimistä Flaccy AI:n avulla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réanalyse nettoie titres, artistes et albums à partir des noms de fichiers grâce à l'IA."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Greina aftur hreinsar til titla, listamenn og plötur út frá skráarnöfnum með gervigreind."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La rianalisi ripulisce titoli, artisti e album a partire dai nomi dei file con l'IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再解析では、ファイル名をもとにAIでタイトル・アーティスト・アルバムを整えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 분석하면 파일 이름을 바탕으로 AI가 제목, 아티스트, 앨범을 정리합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyser på nytt rydder opp i titler, artister og album fra filnavnene med KI."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponowna analiza porządkuje tytuły, wykonawców i albumy na podstawie nazw plików za pomocą AI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A reanálise limpa títulos, artistas e álbuns a partir dos nomes dos arquivos com IA."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att analysera om rensar upp titlar, artister och album från filnamnen med AI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新分析会用 AI 根据文件名整理标题、艺人和专辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
