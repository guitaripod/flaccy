    "Pair an Apple Watch to sync music.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppele eine Apple Watch, um Musik zu synchronisieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empareja un Apple Watch para sincronizar música."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumelez une Apple Watch pour synchroniser de la musique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbina un Apple Watch per sincronizzare la musica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音楽を同期するにはApple Watchをペアリングしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악을 동기화하려면 Apple Watch를 페어링하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparuj Apple Watch, aby synchronizować muzykę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Emparelhe um Apple Watch para sincronizar música."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请配对一块 Apple Watch 以同步音乐。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請配對 Apple Watch 以同步音樂。"
          }
        }
      }
    },
    "Pair an Apple Watch with this iPhone to send it music.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppele eine Apple Watch mit diesem iPhone, um ihr Musik zu senden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empareja un Apple Watch con este iPhone para enviarle música."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Associe un Apple Watch à cet iPhone pour lui envoyer de la musique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbina un Apple Watch a questo iPhone per inviargli musica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneにApple Watchをペアリングすると、音楽を送信できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone에 Apple Watch를 페어링하면 음악을 보낼 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparuj Apple Watcha z tym iPhonem, aby przesyłać na niego muzykę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pareie um Apple Watch com este iPhone para enviar músicas a ele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 Apple Watch 与此 iPhone 配对，即可向其发送音乐。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 Apple Watch 與此 iPhone 配對，即可向其傳送音樂。"
          }
        }
      }
    },
    "Paste": {
      "localizations": {
        "de": {
