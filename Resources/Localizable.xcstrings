    "Files are sent untouched. The biggest by far, and no better over Bluetooth.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filer sendes uændrede. De er klart de største, og over Bluetooth er de ikke bedre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien werden unverändert gesendet. Mit Abstand die größten, über Bluetooth aber nicht besser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos se envían sin cambios. Con diferencia los más grandes, y por Bluetooth no suenan mejor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedostot lähetetään muuttumattomina. Ne ovat ylivoimaisesti suurimpia, eikä Bluetooth tee niistä parempia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers sont envoyés tels quels. De loin les plus volumineux, et pas meilleurs en Bluetooth."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrárnar eru sendar óbreyttar. Langstærstar, en ekki betri yfir Bluetooth."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file vengono inviati invariati. Di gran lunga i più pesanti, e via Bluetooth non suonano meglio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルはそのまま送信されます。圧倒的に容量が大きく、Bluetoothではより良い音にもなりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 변경 없이 보냅니다. 단연 가장 크며, 블루투스에서는 더 좋은 소리가 나지도 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filer sendes uendret. Desidert størst, og ikke bedre over Bluetooth."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki są wysyłane bez zmian. Zdecydowanie największe, a przez Bluetooth nie brzmią lepiej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos são enviados sem alterações. De longe os maiores, e não soam melhor por Bluetooth."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filerna skickas orörda. Med råge störst, och inte bättre över Bluetooth."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件原样发送。体积远超其他选项，而且通过蓝牙也不会更好听。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案原樣傳送。體積遠大於其他選項，而且透過藍牙也不會更好聽。"
          }
        }
      }
    },
