            "state": "translated",
            "value": "Der mangler stadig coverbillede til %@ album."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei %@ Alben fehlt noch das Cover."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A %@ álbumes todavía les falta la carátula."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kansikuva puuttuu vielä %@ albumilta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il manque encore la pochette de %@ albums."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Umslag vantar enn á %@ plötum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A %@ album manca ancora la copertina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 枚のアルバムにまだアートワークがありません。"
