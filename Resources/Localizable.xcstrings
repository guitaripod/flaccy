    "Import failed — couldn't copy into the library folder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Import fehlgeschlagen – Kopieren in den Mediathekordner nicht möglich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló la importación: no se pudo copiar en la carpeta de la biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l'import — impossible de copier dans le dossier de bibliothèque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importazione non riuscita: impossibile copiare nella cartella della libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インポートに失敗しました — ライブラリフォルダにコピーできませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져오기 실패 — 보관함 폴더로 복사하지 못했습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Import nie powiódł się — nie udało się skopiować do folderu biblioteki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha na importação — não foi possível copiar para a pasta da biblioteca."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入失败——无法拷贝到资料库文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入失敗——無法拷貝到資料庫資料夾。"
          }
        }
      }
    },
