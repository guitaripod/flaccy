    "Import failed — couldn't copy into the library folder.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Import mislykkedes. Kunne ikke kopiere til bibliotekets mappe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Import fehlgeschlagen – Kopieren in den Mediathekordner nicht möglich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló la importación: no se pudo copiar en la carpeta de la biblioteca."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuonti epäonnistui – tiedostoja ei voitu kopioida kirjastokansioon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l'import — impossible de copier dans le dossier de bibliothèque."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Innflutningur mistókst: ekki tókst að afrita í safnmöppuna."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importazione non riuscita: impossibile copiare nella cartella della libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インポートに失敗しました — ライブラリフォルダにコピーできませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져오기 실패 — 보관함 폴더로 복사하지 못했습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Import mislyktes – kunne ikke kopiere til mappen for biblioteket."
