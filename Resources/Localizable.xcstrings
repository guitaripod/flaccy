          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este plano não está disponível em seu país ou região."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här alternativet är inte tillgängligt i ditt land eller din region."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此方案在你的国家或地区不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此方案在你的國家或地區無法使用。"
          }
        }
      }
    },
    "This re-analyzes every track's metadata with AI and rewrites titles, artists, and album grouping in the database. It may take a few minutes for large libraries.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette analyserer hver sangs metadata igen med AI og omskriver titler, kunstnere og albumgruppering i databasen. Det kan tage et par minutter for store biblioteker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dabei werden die Metadaten jedes Titels per KI neu analysiert und Titel, Interpreten und Albumzuordnung in der Datenbank überschrieben. Bei großen Mediatheken kann das einige Minuten dauern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto reanaliza los metadatos de cada pista con IA y reescribe títulos, artistas y agrupación de álbumes en la base de datos. Puede tardar unos minutos en bibliotecas grandes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä analysoi jokaisen kappaleen metatiedot uudelleen tekoälyllä ja kirjoittaa tietokantaan uusiksi kappaleiden nimet, artistit ja albumiryhmittelyn. Suurilla kirjastoilla se voi kestää muutaman minuutin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette opération réanalyse les métadonnées de chaque morceau avec l'IA et réécrit les titres, les artistes et le regroupement des albums dans la base. Cela peut prendre quelques minutes sur de grandes bibliothèques."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þetta greinir lýsigögn hvers lags aftur með gervigreind og endurskrifar titla, listamenn og plötuflokkun í gagnagrunninum. Það getur tekið nokkrar mínútur í stærri söfnum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa operazione rianalizza i metadati di ogni brano con l'IA e riscrive titoli, artisti e raggruppamento degli album nel database. Su librerie grandi può richiedere qualche minuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての曲のメタデータをAIで再解析し、タイトル・アーティスト・アルバムのまとまりをデータベース上で書き換えます。ライブラリが大きいと数分かかることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 트랙의 메타데이터를 AI로 다시 분석하고 제목, 아티스트, 앨범 묶음을 데이터베이스에서 새로 씁니다. 보관함이 크면 몇 분 걸릴 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette analyserer metadataene til hver sang på nytt med KI og skriver om titler, artister og albumgruppering i databasen. Det kan ta noen minutter for store biblioteker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To analizuje ponownie metadane każdego utworu przez AI i przepisuje tytuły, wykonawców oraz grupowanie albumów w bazie danych. Dla dużych bibliotek może to zająć kilka minut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso reanalisa os metadados de cada faixa com IA e reescreve títulos, artistas e o agrupamento de álbuns no banco de dados. Pode levar alguns minutos em bibliotecas grandes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här analyserar om metadata för varje låt med AI och skriver om titlar, artister och albumgruppering i databasen. Det kan ta några minuter för stora bibliotek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作会用 AI 重新分析每首曲目的元数据，并在数据库中改写标题、艺人和专辑归类。资料库较大时可能需要几分钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會用 AI 重新分析每首曲目的中繼資料，並在資料庫中改寫標題、演出者與專輯歸類。資料庫較大時可能需要幾分鐘。"
          }
        }
      }
    },
    "This removes %@ from your library and any playlists, and deletes the copies cached or downloaded on this device. The server itself is not changed.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner %@ fra dit bibliotek og alle playlister og sletter de cachede eller hentede kopier på denne enhed. Selve serveren ændres ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird %@ aus deiner Mediathek und allen Playlists entfernt, und die auf diesem Gerät zwischengespeicherten oder heruntergeladenen Kopien werden gelöscht. Der Server selbst wird nicht verändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto quita %@ de tu biblioteca y de todas las listas de reproducción, y borra las copias en caché o descargadas en este dispositivo. El servidor en sí no cambia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa kohteen %@ kirjastostasi ja kaikista soittolistoista sekä tältä laitteelta välimuistiin tallennetut tai ladatut kopiot. Palvelinta itseään ei muuteta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela retire %@ de ta bibliothèque et de toutes les playlists, et supprime les copies en cache ou téléchargées sur cet appareil. Le serveur lui-même n’est pas modifié."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þetta fjarlægir %@ úr safninu þínu og öllum spilunarlistum, og eyðir afritunum sem eru í skyndiminni eða hafa verið sótt á þetta tæki. Netþjónninn sjálfur breytist ekki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo rimuove %@ dalla tua libreria e da tutte le playlist, ed elimina le copie in cache o scaricate su questo dispositivo. Il server non viene modificato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ をライブラリとすべてのプレイリストから削除し、このデバイスにキャッシュまたはダウンロードされたコピーを消去します。サーバー自体は変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이렇게 하면 보관함과 모든 재생목록에서 %@ 항목을 삭제하고, 이 기기에 캐시되거나 다운로드된 사본도 지웁니다. 서버 자체는 변경되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner %@ fra biblioteket og alle spillelister, og sletter kopiene som er lagret i cache eller lastet ned på denne enheten. Selve serveren endres ikke."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To usunie %@ z Twojej biblioteki i wszystkich playlist oraz skasuje kopie zapisane w pamięci podręcznej lub pobrane na tym urządzeniu. Sam serwer nie zostanie zmieniony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove %@ da sua biblioteca e de todas as playlists, e apaga as cópias em cache ou baixadas neste dispositivo. O próprio servidor não é alterado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här tar bort %@ från ditt bibliotek och alla spellistor, och raderar de cachade och hämtade kopiorna på den här enheten. Servern själv påverkas inte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作会将 %@ 从你的资料库和所有播放列表中移除，并删除此设备上缓存或下载的副本。服务器本身不会改变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作會將 %@ 從你的資料庫和所有播放清單中移除，並刪除此裝置上快取或下載的副本。伺服器本身不會變更。"
          }
        }
      }
    },
    "This removes the preset. Anything that used it goes back to Flat.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner forhåndsindstillingen. Alt, der brugte den, går tilbage til Flad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird die Voreinstellung entfernt. Alles, was sie verwendet hat, wird auf Flach zurückgesetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminará el preajuste. Todo lo que lo usaba volverá a Plano."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa esiasetuksen. Kaikki, mikä käytti sitä, palautuu tilaan Tasainen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce préréglage sera supprimé. Tout ce qui l’utilisait revient à Plat."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þetta fjarlægir forstillinguna. Allt sem notaði hana fer aftur í Flatt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il preset verrà rimosso. Tutto ciò che lo usava tornerà a Piatto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプリセットは削除されます。使用していたものはフラットに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프리셋이 삭제됩니다. 이 프리셋을 사용하던 항목은 플랫으로 돌아갑니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner forhåndsinnstillingen. Alt som brukte den, går tilbake til Flat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To usunie preset. Wszystko, co go używało, wróci do ustawienia „Płaska”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove a predefinição. Tudo que a usava volta para Plano."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här tar bort förinställningen. Allt som använde den återgår till Platt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会移除该预设。使用它的内容将恢复为平坦。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會移除該預設。使用它的項目將恢復為平坦。"
          }
        }
      }
    },
    "This song has lyrics but no timing, so they can't follow the music. Timing comes from lrclib when a contributor adds it, or from a .lrc or .elrc file saved next to the song.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne sang har en sangtekst, men ingen tidspunkter, så den kan ikke følge musikken. Tidspunkterne kommer fra lrclib, når en bidragyder tilføjer dem, eller fra en .lrc- eller .elrc-fil gemt ved siden af sangen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Song hat einen Songtext, aber kein Timing – er kann der Musik daher nicht folgen. Das Timing kommt von lrclib, wenn jemand es beisteuert, oder aus einer .lrc- oder .elrc-Datei neben dem Song."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta canción tiene letra, pero sin sincronización, así que no puede seguir la música. La sincronización viene de lrclib cuando alguien la aporta, o de un archivo .lrc o .elrc guardado junto a la canción."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tässä kappaleessa on sanoitukset, mutta ei ajoitusta, joten ne eivät voi seurata musiikkia. Ajoituksen tarjoaa lrclib, kun joku osallistuja lisää sen, tai kappaleen viereen tallennettu .lrc- tai .elrc-tiedosto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce titre a des paroles mais aucune synchronisation : elles ne peuvent donc pas suivre la musique. La synchronisation vient de lrclib quand un contributeur l'ajoute, ou d'un fichier .lrc ou .elrc placé à côté du morceau."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þetta lag er með texta en án tímasetningar, svo textinn getur ekki fylgt tónlistinni. Tímasetning kemur frá lrclib þegar einhver bætir henni við, eða úr .lrc- eða .elrc-skrá sem er vistuð við hliðina á laginu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo brano ha un testo ma nessuna sincronizzazione, quindi non può seguire la musica. La sincronizzazione arriva da lrclib quando un contributore la aggiunge, oppure da un file .lrc o .elrc salvato accanto al brano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この曲には歌詞はありますがタイミング情報がないため、音楽に合わせて動かせません。タイミングはlrclibに投稿された場合や、曲と同じ場所に置いた.lrcまたは.elrcファイルから取得されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 곡에는 가사는 있지만 싱크 정보가 없어 음악을 따라갈 수 없습니다. 싱크는 기여자가 lrclib에 추가했거나, 곡 옆에 저장된 .lrc 또는 .elrc 파일에서 가져옵니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne sangen har sangtekst, men ingen tidsstyring, så de kan ikke følge musikken. Tidsstyringen kommer fra lrclib når noen bidrar med den, eller fra en .lrc- eller .elrc-fil lagret ved siden av sangen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten utwór ma tekst, ale bez synchronizacji, więc nie może podążać za muzyką. Synchronizacja pochodzi z lrclib, gdy ktoś ją doda, albo z pliku .lrc lub .elrc zapisanego obok utworu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta música tem letra, mas sem sincronização, então ela não consegue acompanhar o som. A sincronização vem do lrclib quando alguém a adiciona, ou de um arquivo .lrc ou .elrc salvo ao lado da música."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här låten har låttext men ingen tidsstyrning, så den kan inte följa musiken. Tidsstyrningen kommer från lrclib när någon bidragsgivare lägger till den, eller från en .lrc- eller .elrc-fil sparad bredvid låten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这首歌有歌词但没有计时，因此无法跟随音乐。计时来自 lrclib 上贡献者的添加，或来自保存在歌曲旁边的 .lrc 或 .elrc 文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這首歌有歌詞但沒有計時，因此無法跟隨音樂。計時來自 lrclib 上貢獻者的新增，或來自存放在歌曲旁邊的 .lrc 或 .elrc 檔案。"
          }
        }
      }
    },
    "This song is no longer in your library. Refresh the library to update the list.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne sang er ikke længere i dit bibliotek. Genindlæs biblioteket for at opdatere listen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Song ist nicht mehr in deiner Mediathek. Aktualisiere die Mediathek, um die Liste zu erneuern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta canción ya no está en tu biblioteca. Actualiza la biblioteca para renovar la lista."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä kappale ei ole enää kirjastossasi. Päivitä kirjasto, jotta luettelo on ajan tasalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce morceau n’est plus dans ta bibliothèque. Actualise la bibliothèque pour mettre la liste à jour."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þetta lag er ekki lengur í safninu þínu. Endurnýjaðu safnið til að uppfæra listann."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo brano non è più nella tua libreria. Aggiorna la libreria per rinnovare l’elenco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この曲はライブラリにもうありません。ライブラリを更新してリストを最新にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 곡은 더 이상 보관함에 없습니다. 보관함을 새로 고쳐 목록을 업데이트하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne sangen er ikke lenger i biblioteket ditt. Oppdater biblioteket for å oppdatere listen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tego utworu nie ma już w Twojej bibliotece. Odśwież bibliotekę, aby zaktualizować listę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta música não está mais na sua biblioteca. Atualize a biblioteca para renovar a lista."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här låten finns inte längre i ditt bibliotek. Uppdatera biblioteket så att listan blir aktuell."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此歌曲已不在你的资料库中。请刷新资料库以更新列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此歌曲已不在你的資料庫中。請重新整理資料庫以更新列表。"
          }
        }
      }
    },
    "This song's lyrics are timed one line at a time, so Flaccy lights the line being sung but can't fill it word by word. Word timing is still rare: it comes from lrclib when a contributor adds it, or from an enhanced .elrc file saved next to the song.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sangteksten til denne sang har tidspunkter linje for linje. Flaccy fremhæver derfor linjen, der synges, men kan ikke udfylde den ord for ord. Tidspunkter for hvert ord er stadig sjældne: de kommer fra lrclib, når en bidragyder tilføjer dem, eller fra en forbedret .elrc-fil gemt ved siden af sangen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Songtext dieses Songs ist zeilenweise getaktet. Flaccy hebt daher die gerade gesungene Zeile hervor, kann sie aber nicht Wort für Wort füllen. Wortgenaues Timing ist noch selten: Es stammt von lrclib, wenn jemand es beisteuert, oder aus einer erweiterten .elrc-Datei neben dem Song."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La letra de esta canción está sincronizada línea a línea, así que Flaccy ilumina la línea que suena, pero no puede rellenarla palabra por palabra. La sincronización por palabras sigue siendo rara: viene de lrclib cuando alguien la aporta, o de un archivo .elrc mejorado guardado junto a la canción."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän kappaleen sanoitukset on ajoitettu yksi rivi kerrallaan, joten Flaccy korostaa laulettavana olevan rivin, mutta sanoja ei voi korostaa yksitellen. Sanakohtainen ajoitus on yhä harvinaista: sen tarjoaa lrclib, kun joku osallistuja lisää sen, tai kappaleen viereen tallennettu parannettu .elrc-tiedosto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paroles de ce titre sont synchronisées ligne par ligne : Flaccy éclaire la ligne chantée, mais ne peut pas la remplir mot par mot. La synchronisation par mot reste rare : elle vient de lrclib quand un contributeur l'ajoute, ou d'un fichier .elrc enrichi placé à côté du morceau."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Textinn í þessu lagi er tímasettur línu fyrir línu, svo Flaccy lýsir upp línuna sem er sungin en getur ekki fyllt hana orð fyrir orð. Orðatímasetning er ennþá sjaldgæf: hún kemur frá lrclib þegar einhver bætir henni við, eða úr aukinni .elrc-skrá sem er vistuð við hliðina á laginu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo di questo brano è sincronizzato riga per riga, quindi Flaccy illumina la riga cantata ma non può riempirla parola per parola. La sincronizzazione per parola è ancora rara: arriva da lrclib quando un contributore la aggiunge, oppure da un file .elrc avanzato salvato accanto al brano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この曲の歌詞は1行ずつタイミングが付いているため、Flaccyは歌われている行をハイライトしますが、単語ごとに塗りつぶすことはできません。単語単位のタイミングはまだ少なく、lrclibに投稿された場合や、曲と同じ場所に置いた拡張版の.elrcファイルから取得されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 곡의 가사는 한 줄씩 싱크되어 있어 Flaccy가 부르는 줄은 강조하지만 단어 단위로 채울 수는 없습니다. 단어 단위 싱크는 아직 드뭅니다. 기여자가 lrclib에 추가했거나, 곡 옆에 저장된 확장 .elrc 파일에서 가져옵니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sangteksten til denne sangen er tidsstyrt linje for linje, så Flaccy markerer linjen som synges, men kan ikke fylle den ord for ord. Tidsstyring på ordnivå er fortsatt sjelden: Den kommer fra lrclib når noen bidrar med den, eller fra en utvidet .elrc-fil lagret ved siden av sangen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst tego utworu jest zsynchronizowany linia po linii, więc Flaccy podświetla śpiewaną linię, ale nie może jej wypełniać słowo po słowie. Synchronizacja słów jest wciąż rzadka: pochodzi z lrclib, gdy ktoś ją doda, albo z rozszerzonego pliku .elrc zapisanego obok utworu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A letra desta música está sincronizada linha a linha, então o Flaccy ilumina a linha cantada, mas não consegue preenchê-la palavra por palavra. A sincronização por palavra ainda é rara: vem do lrclib quando alguém a adiciona, ou de um arquivo .elrc avançado salvo ao lado da música."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låttexten är tidsstyrd rad för rad, så Flaccy markerar raden som sjungs men kan inte fylla den ord för ord. Ordtidsstyrning är fortfarande sällsynt: den kommer från lrclib när någon bidragsgivare lägger till den, eller från en förbättrad .elrc-fil sparad bredvid låten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这首歌的歌词按行计时，因此 Flaccy 会点亮正在演唱的那一行，但无法逐字填充。逐字计时仍然很少见：它来自 lrclib 上贡献者的添加，或来自保存在歌曲旁边的增强版 .elrc 文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這首歌的歌詞依行計時，因此 Flaccy 會點亮正在演唱的那一行，但無法逐字填滿。逐字計時仍然很少見：它來自 lrclib 上貢獻者的新增，或來自存放在歌曲旁邊的增強版 .elrc 檔案。"
          }
        }
      }
    },
    "This version of Flaccy needs Flaccy Server 1.0 or newer. Update Flaccy on the Mac that shares, or the flaccy-server package on the computer that runs it.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne version af Flaccy kræver Flaccy Server 1.0 eller nyere. Opdater Flaccy på den Mac, der deler, eller pakken flaccy-server på computeren, der kører den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Flaccy-Version braucht Flaccy Server 1.0 oder neuer. Aktualisiere Flaccy auf dem Mac, der teilt, oder das Paket flaccy-server auf dem Computer, der ihn ausführt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version of Flaccy needs Flaccy Server 1.0 or newer. Update Flaccy on the Mac that shares, or the flaccy-server package on the computer that runs it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión de Flaccy necesita Flaccy Server 1.0 o posterior. Actualiza Flaccy en el Mac que comparte, o el paquete flaccy-server en el ordenador que lo ejecuta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä Flaccy-versio vaatii Flaccy Server 1.0:n tai uudemman. Päivitä Flaccy sillä Macilla, joka jakaa, tai päivitä flaccy-server-paketti tietokoneella, joka sitä ajaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version de Flaccy nécessite Flaccy Server 1.0 ou plus récent. Mettez à jour Flaccy sur le Mac qui partage, ou le paquet flaccy-server sur l’ordinateur qui l’exécute."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þessi útgáfa af Flaccy þarf Flaccy Server 1.0 eða nýrri. Uppfærðu Flaccy á Mac-tölvunni sem deilir, eða flaccy-server pakkann á tölvunni sem keyrir hann."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa versione di Flaccy richiede Flaccy Server 1.0 o successiva. Aggiorna Flaccy sul Mac che condivide o il pacchetto flaccy-server sul computer che lo esegue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Flaccy のバージョンには Flaccy Server 1.0 以降が必要です。共有している Mac の Flaccy、または実行しているコンピュータの flaccy-server パッケージを更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 버전의 Flaccy는 Flaccy Server 1.0 이상이 필요합니다. 공유하는 Mac의 Flaccy, 또는 서버를 실행하는 컴퓨터의 flaccy-server 패키지를 업데이트하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne versjonen av Flaccy krever Flaccy Server 1.0 eller nyere. Oppdater Flaccy på Mac-en som deler, eller pakken flaccy-server på datamaskinen som kjører den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta wersja Flaccy wymaga Flaccy Server 1.0 lub nowszego. Zaktualizuj Flaccy na udostępniającym Macu albo pakiet flaccy-server na komputerze, na którym działa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão do Flaccy precisa do Flaccy Server 1.0 ou mais recente. Atualize o Flaccy no Mac que compartilha, ou o pacote flaccy-server no computador que o executa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här versionen av Flaccy kräver Flaccy Server 1.0 eller nyare. Uppdatera Flaccy på Mac:en som delar, eller paketet flaccy-server på datorn som kör det."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本的 Flaccy 需要 Flaccy Server 1.0 或更高版本。请更新共享的 Mac 上的 Flaccy，或运行它的电脑上的 flaccy-server 软件包。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本的 Flaccy 需要 Flaccy Server 1.0 或更新版本。請更新分享的 Mac 上的 Flaccy，或執行它的電腦上的 flaccy-server 套件。"
          }
        }
      }
    },
