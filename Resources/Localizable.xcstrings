    "Manual preamp. Return to Auto and Flaccy sets it from the curve.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Manuel forforstærkning. Gå tilbage til Auto, så sætter Flaccy den ud fra kurven."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manuelle Vorverstärkung. Zu Auto zurückkehren, dann setzt Flaccy sie anhand der Kurve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preamplificador manual. Vuelve a Automático y Flaccy lo ajustará según la curva."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Manuaalinen esivahvistus. Palaa Automaattiin, niin Flaccy asettaa sen käyrän perusteella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préampli manuel. Revenez sur Auto et Flaccy le règle selon la courbe."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Handvirkt forstig. Farðu aftur í Sjálfvirkt, þá stillir Flaccy það út frá ferlinum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preamplificatore manuale. Torna ad Automatico e Flaccy lo imposta in base alla curva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリアンプは手動です。自動に戻すと、Flaccyがカーブに合わせて設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프리앰프가 수동입니다. 자동으로 되돌리면 Flaccy가 곡선에 맞춰 설정합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Manuell forforsterker. Gå tilbake til Auto, så setter Flaccy den ut fra kurven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przedwzmacniacz ustawiony ręcznie. Wróć do trybu auto, a Flaccy ustawi go na podstawie krzywej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pré-amplificador manual. Volte para Automático e o Flaccy o ajusta pela curva."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Manuell förförstärkning. Återgå till Auto så ställer Flaccy in den utifrån kurvan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前级增益为手动设置。切回自动后，Flaccy 会根据曲线进行设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前級增益為手動設定。切回自動後，Flaccy 會依曲線進行設定。"
          }
        }
      }
    },
