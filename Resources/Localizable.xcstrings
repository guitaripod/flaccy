    "Music folder unavailable — reconnect the drive or choose a new folder.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Musikmappen er ikke tilgængelig – tilslut drevet igen, eller vælg en ny mappe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Musikordner nicht verfügbar – schließe das Laufwerk wieder an oder wähle einen neuen Ordner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carpeta de música no disponible: vuelve a conectar la unidad o elige otra carpeta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Musiikkikansio ei ole käytettävissä. Yhdistä asema uudelleen tai valitse uusi kansio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dossier de musique indisponible — rebranchez le disque ou choisissez un nouveau dossier."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tónlistarmappa ekki tiltæk – tengdu drifið aftur eða veldu nýja möppu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartella musica non disponibile: ricollega l'unità o scegli un'altra cartella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音楽フォルダを利用できません — ドライブを接続し直すか、別のフォルダを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악 폴더를 사용할 수 없습니다 — 드라이브를 다시 연결하거나 새 폴더를 선택하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Musikkmappen er ikke tilgjengelig – koble til stasjonen igjen, eller velg en ny mappe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder z muzyką niedostępny — podłącz dysk ponownie albo wybierz nowy folder."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasta de música indisponível — reconecte a unidade ou escolha uma nova pasta."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Musikmappen är inte tillgänglig. Anslut enheten igen eller välj en ny mapp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音乐文件夹不可用——请重新连接磁盘或选择新文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音樂資料夾無法使用——請重新連接磁碟機或選擇新的資料夾。"
          }
        }
      }
    },
