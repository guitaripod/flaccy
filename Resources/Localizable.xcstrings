    "%@ was on both devices and is now one.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fandtes på begge enheder og findes nu kun én gang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ war auf beiden Geräten und ist jetzt nur noch einmal vorhanden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ was on both devices and is now one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ estaba en ambos dispositivos y ahora es uno solo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ oli molemmilla laitteilla, ja nyt siitä on vain yksi kopio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ était sur les deux appareils et n’en fait plus qu’un."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ var á báðum tækjunum og er nú aðeins eitt eintak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ era su entrambi i dispositivi ed è ora uno solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は両方のデバイスにあり、今は1つになりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 두 기기에 모두 있었고, 이제 하나로 합쳐졌어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fantes på begge enhetene og finnes nå bare én gang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ był na obu urządzeniach, a teraz jest tylko raz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ estava nos dois dispositivos e agora é um só."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fanns på båda enheterna och finns nu bara en gång."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 原本同时存在于两台设备上，现在已合并为一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 原本同時存在於兩台裝置上，現在已合併為一個。"
          }
        }
      }
    },
    "%@ were on both devices and are now one each.": {
