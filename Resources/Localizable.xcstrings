    "Choose your music folder once more. macOS asks every app for permission separately.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg din musikmappe igen. macOS spørger hver app om tilladelse hver for sig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle deinen Musikordner noch einmal aus. macOS fragt für jede App einzeln nach der Erlaubnis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige tu carpeta de música una vez más. macOS pide permiso a cada app por separado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse musiikkikansio uudelleen. macOS pyytää luvan erikseen jokaiselle sovellukselle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis ton dossier de musique une dernière fois. macOS demande l’autorisation séparément pour chaque app."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Veldu tónlistarmöppuna þína aftur. macOS biður hvert forrit um heimild fyrir sig."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli ancora una volta la cartella della musica. macOS chiede il permesso a ogni app separatamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音楽フォルダをもう一度選択してください。macOS では、アクセスの許可がアプリごとに別々に求められます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악 폴더를 한 번만 더 선택해 주세요. macOS는 앱마다 따로 권한을 요청합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg musikkmappen din en gang til. macOS spør hver app om tillatelse hver for seg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz folder z muzyką jeszcze raz. macOS prosi o zgodę osobno dla każdej aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha sua pasta de música mais uma vez. O macOS pede permissão a cada app separadamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj din musikmapp en gång till. macOS frågar varje app om behörighet separat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请再选择一次你的音乐文件夹。macOS 会为每个 App 单独请求权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
