        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting å sende: ingen av disse filene er musikk som Flaccy spiller av."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma czego wysłać: żaden z tych plików nie jest muzyką odtwarzaną przez Flaccy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada para enviar: nenhum desses arquivos é música que o Flaccy reproduz."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
