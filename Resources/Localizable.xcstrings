    "Paste or drop the flaccy://server link your server printed, or type its address and code.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indsæt eller træk det flaccy://server-link, som din server har udskrevet, hertil, eller skriv dens adresse og kode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den flaccy://server-Link, den der Server ausgegeben hat, einfügen oder hierher ziehen, oder Adresse und Code eingeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste or drop the flaccy://server link your server printed, or type its address and code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega o arrastra el enlace flaccy://server que imprimió tu servidor, o escribe su dirección y su código."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liitä tai pudota palvelimen tulostama flaccy://server-linkki tai kirjoita sen osoite ja koodi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez ou glissez le lien flaccy://server affiché par votre serveur, ou saisissez son adresse et son code."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Límdu eða dragðu flaccy://server-hlekkinn sem netþjónninn þinn sýndi, eða sláðu inn vistfang hans og kóða."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla o trascina il link flaccy://server stampato dal server, oppure inserisci il suo indirizzo e il codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーが表示した flaccy://server リンクを貼り付けるかドロップするか、アドレスとコードを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 출력한 flaccy://server 링크를 붙여넣거나 끌어다 놓거나, 주소와 코드를 입력하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lim inn eller slipp flaccy://server-lenken serveren din skrev ut, eller skriv inn adressen og koden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklej lub upuść link flaccy://server wydrukowany przez serwer albo wpisz jego adres i kod."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole ou solte o link flaccy://server que seu servidor exibiu, ou digite o endereço e o código dele."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klistra in eller släpp flaccy://server-länken som servern skrev ut, eller skriv in dess adress och kod."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴或拖入服务器输出的 flaccy://server 链接，或输入其地址和代码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上或拖放伺服器列印的 flaccy://server 連結，或輸入其位址和代碼。"
          }
        }
      }
    },
