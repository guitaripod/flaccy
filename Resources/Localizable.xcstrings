    "In your library. Double tap to play from here through the rest of popular tracks.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I dit bibliotek. Dobbelttryk for at spille herfra og gennem resten af de populære numre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In deiner Mediathek. Doppeltippen, um ab hier durch die beliebten Titel zu spielen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En tu biblioteca. Toca dos veces para reproducir desde aquí el resto de las pistas populares."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjastossasi. Kaksoisnapauta, niin toisto jatkuu tästä suosittuihin kappaleisiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans votre bibliothèque. Toucher deux fois pour lire à partir d'ici toute la suite des morceaux populaires."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Í safninu þínu. Tvísmelltu til að spila héðan í gegnum restina af vinsælum lögum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella tua libreria. Tocca due volte per riprodurre da qui in poi il resto dei brani più popolari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリにあります。ダブルタップすると、ここから人気曲を続けて再生します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함에 있습니다. 두 번 탭하면 여기부터 인기 트랙을 이어서 재생합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I biblioteket ditt. Dobbelttrykk for å spille herfra gjennom resten av de populære sangene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W twojej bibliotece. Stuknij dwukrotnie, aby odtwarzać stąd przez resztę popularnych utworów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na sua biblioteca. Toque duas vezes para reproduzir daqui em diante o resto das faixas populares."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I ditt bibliotek. Dubbeltryck för att spela härifrån och vidare genom de populära låtarna."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的资料库中。轻点两下即可从这里开始，接着播放其余热门曲目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的資料庫中。點兩下即可從這裡開始，接著播放其餘熱門曲目。"
          }
        }
      }
    },
