    "Install Flaccy from Available Apps if it isn’t on your Watch yet": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Installér Flaccy fra Tilgængelige apps, hvis den ikke allerede er på dit ur"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere Flaccy aus „Verfügbare Apps“, falls es noch nicht auf deiner Watch ist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala Flaccy desde «Apps disponibles» si aún no está en tu Watch"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asenna Flaccy ”Saatavilla olevat sovellukset” -kohdasta, jos se ei ole vielä Apple Watchissa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installe Flaccy depuis « Apps disponibles » s’il n’est pas encore sur ta Watch"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Settu upp Flaccy úr Tiltækum forritum ef það er ekki komið á úrið þitt enn"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa Flaccy da «App disponibili» se non è ancora sul tuo Watch"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだWatchにない場合は、「利用可能なApp」からFlaccyをインストール"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch에 아직 없다면 「사용 가능한 App」에서 Flaccy 설치"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer Flaccy fra Tilgjengelige apper hvis den ikke er på klokken din ennå"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli Flaccy nie ma jeszcze na Watchu, zainstaluj je z sekcji „Dostępne aplikacje”"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale o Flaccy em «Apps disponíveis» se ele ainda não estiver no seu Watch"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Installera Flaccy från Tillgängliga appar om den inte finns på din klocka än"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 Watch 上还没有 Flaccy，请从“可用 App”中安装"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 Watch 上還沒有 Flaccy，請從「可用的 App」中安裝"
          }
        }
      }
    },
