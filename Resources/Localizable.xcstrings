    "Interrupted — picks up where it stopped": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afbrudt – fortsætter, hvor den stoppede"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterbrochen – geht dort weiter, wo es aufgehört hat"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrumpida: continúa donde se quedó"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keskeytetty – jatkuu siitä, mihin pysähtyi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompu – reprend là où il s'est arrêté"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Truflað, heldur áfram þar sem hætt var"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrotto: riprende da dove si era fermato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中断されました — 続きから再開します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중단됨 — 멈춘 곳부터 이어받습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avbrutt – fortsetter der den stoppet"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przerwano — wznowi od miejsca zatrzymania"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompido — continua de onde parou"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avbruten – fortsätter där den slutade"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已中断——将从中断处继续"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已中斷——將從中斷處繼續"
          }
        }
      }
    },
