      }
    },
    "Couldn't open Share Lyrics because this song has no lines to share. Play a song with lyrics and try again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ikke åbne »Del sangtekster«, fordi denne sang ikke har linjer at dele. Afspil en sang med sangtekster, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Songtext teilen“ konnte nicht geöffnet werden, weil dieser Song keine Zeilen zum Teilen hat. Spiele einen Song mit Songtext ab und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir Compartir letra porque esta canción no tiene líneas para compartir. Reproduce una canción con letra e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanoitusten jakamista ei voitu avata, koska tässä kappaleessa ei ole rivejä jaettavaksi. Toista kappale, jossa on sanoitus, ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir « Partager les paroles » car ce morceau n’a aucune ligne à partager. Lancez un morceau avec des paroles et réessayez."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki tókst að opna „Deila textum“ því þetta lag hefur engar línur til að deila. Spilaðu lag með texta og reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire Condividi testo perché questo brano non ha righe da condividere. Riproduci un brano con il testo e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この曲には共有できる歌詞がないため、「歌詞を共有」を開けませんでした。歌詞のある曲を再生して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 곡에는 공유할 가사가 없어서 가사 공유를 열 수 없습니다. 가사가 있는 곡을 재생한 후 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke åpne «Del sangtekster» fordi denne sangen ikke har linjer å dele. Spill av en sang med sangtekst og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można otworzyć udostępniania tekstu, ponieważ ten utwór nie ma wierszy do udostępnienia. Odtwórz utwór z tekstem i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir Compartilhar letra porque esta música não tem linhas para compartilhar. Toque uma música com letra e tente novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att öppna ”Dela låttexter” eftersom den här låten inte har några rader att dela. Spela en låt med låttext och försök igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此歌曲没有可分享的歌词，无法打开“分享歌词”。请播放带歌词的歌曲后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此歌曲沒有可分享的歌詞，無法開啟「分享歌詞」。請播放有歌詞的歌曲後重試。"
          }
        }
      }
    },
    "Couldn't open the Last.fm sign-in page": {
      "localizations": {
