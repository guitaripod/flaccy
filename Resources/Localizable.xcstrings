        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "O suelta archivos de audio y carpetas en cualquier punto de esta ventana."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit myös pudottaa äänitiedostoja ja kansioita mihin tahansa tähän ikkunaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou déposez des fichiers audio et des dossiers n'importe où dans cette fenêtre."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Eða dragðu hljóðskrár og möppur hvert sem er í þennan glugga."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppure trascina file audio e cartelle in un punto qualsiasi di questa finestra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "または、このウインドウのどこにでもオーディオファイルやフォルダをドロップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "또는 이 윈도우 아무 곳에나 오디오 파일과 폴더를 끌어다 놓으세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Eller slipp lydfiler og mapper hvor som helst i dette vinduet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Albo upuść pliki audio i foldery w dowolnym miejscu tego okna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou solte arquivos de áudio e pastas em qualquer ponto desta janela."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Eller släpp ljudfiler och mappar var som helst i det här fönstret."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "也可以把音频文件和文件夹拖到本窗口的任意位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "也可以把音訊檔案和資料夾拖到這個視窗的任何地方。"
          }
        }
      }
    },
