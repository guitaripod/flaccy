    "Can't reach %@ to list its devices. Same Wi-Fi, or Tailscale on?": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ikke nå %@ for at vise dens enheder. Samme Wi-Fi, eller Tailscale tændt?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist nicht erreichbar, um seine Geräte aufzulisten. Gleiches WLAN oder Tailscale aktiv?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach %@ to list its devices. Same Wi-Fi, or Tailscale on?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede acceder a %@ para listar sus dispositivos. ¿Mismo Wi-Fi o Tailscale activado?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ei ole tavoitettavissa, joten sen laitteita ei voi listata. Onko se samassa Wi-Fi-verkossa tai onko Tailscale päällä?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre %@ pour lister ses appareils. Même Wi-Fi, ou Tailscale activé ?"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki næst samband við %@ til að birta lista yfir tæki þess. Sama Wi-Fi, eða er Tailscale kveikt?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere %@ per elencare i suoi dispositivi. Stessa rete Wi-Fi o Tailscale attivo?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に接続して機器一覧を取得できません。同じ Wi-Fi か、Tailscale はオンですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 목록을 가져오려고 %@에 연결할 수 없습니다. 같은 Wi-Fi인가요, 아니면 Tailscale이 켜져 있나요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Får ikke kontakt med %@ for å liste opp enhetene. Samme Wi-Fi, eller er Tailscale på?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można połączyć się z %@, by pobrać listę urządzeń. Ten sam Wi-Fi albo włączony Tailscale?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar %@ para listar os dispositivos. Mesmo Wi-Fi ou Tailscale ativado?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan inte nå %@ för att lista dess enheter. Samma Wi-Fi, eller är Tailscale på?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接 %@ 以列出其设备。是否在同一 Wi-Fi，或已开启 Tailscale？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線到 %@ 以列出其裝置。是否在同一 Wi-Fi，或已開啟 Tailscale？"
          }
        }
      }
    },
