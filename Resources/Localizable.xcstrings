            "value": "Ingen lyttehistorik endnu.\nAfspil noget for at opbygge dit tilbageblik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Hörverlauf.\nSpiel etwas ab, um deinen Rückblick aufzubauen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay historial de escucha.\nReproduce algo para crear tu resumen."
