        }
      }
    },
    "Songs from Apple Music, Spotify and other streaming services are locked to their app, so no other player can add them. Flaccy plays music files you own.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sange fra Apple Music, Spotify og andre streamingtjenester er låst til deres app, så ingen anden afspiller kan tilføje dem. Flaccy afspiller musikfiler, du ejer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Songs von Apple Music, Spotify und anderen Streamingdiensten sind an ihre App gebunden, daher kann kein anderer Player sie hinzufügen. Flaccy spielt Musikdateien ab, die dir gehören."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las canciones de Apple Music, Spotify y otros servicios de streaming están vinculadas a su app, así que ningún otro reproductor puede añadirlas. Flaccy reproduce archivos de música que tienes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Musicin, Spotifyn ja muiden suoratoistopalveluiden kappaleet on lukittu niiden omaan sovellukseensa, eikä muu soitin voi lisätä niitä. Flaccy toistaa omistamiasi musiikkitiedostoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les morceaux d’Apple Music, de Spotify et des autres services de streaming sont verrouillés dans leur application, donc aucun autre lecteur ne peut les ajouter. Flaccy lit les fichiers musicaux que vous possédez."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Lög frá Apple Music, Spotify og öðrum streymisveitum eru læst í sínu appi, svo enginn annar spilari getur bætt þeim við. Flaccy spilar tónlistarskrár sem þú átt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I brani di Apple Music, Spotify e degli altri servizi di streaming sono bloccati nella loro app, quindi nessun altro lettore può aggiungerli. Flaccy riproduce i file musicali che possiedi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music、Spotifyなどのストリーミングサービスの曲は、そのアプリ内に限定されているため、ほかのプレーヤーでは追加できません。Flaccyは、お持ちの音楽ファイルを再生します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music, Spotify 등 스트리밍 서비스의 곡은 해당 앱 안에서만 재생되므로 다른 플레이어에 추가할 수 없습니다. Flaccy는 내가 소유한 음악 파일을 재생합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanger fra Apple Music, Spotify og andre strømmetjenester er låst til appen sin, så ingen annen spiller kan legge dem til. Flaccy spiller musikkfiler du eier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwory z Apple Music, Spotify i innych serwisów streamingowych są zablokowane w swojej aplikacji, więc żaden inny odtwarzacz nie może ich dodać. Flaccy odtwarza pliki muzyczne, które posiadasz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As músicas do Apple Music, do Spotify e de outros serviços de streaming ficam presas ao próprio app, então nenhum outro player consegue adicioná-las. O Flaccy reproduz arquivos de música que você possui."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låtar från Apple Music, Spotify och andra streamingtjänster är låsta till sin app, så ingen annan spelare kan lägga till dem. Flaccy spelar musikfiler som du äger."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自 Apple Music、Spotify 和其他流媒体服务的歌曲被锁定在其应用内，其他播放器无法添加。Flaccy 播放你拥有的音乐文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來自 Apple Music、Spotify 和其他串流服務的歌曲被鎖定在其應用程式內，其他播放器無法加入。Flaccy 播放你擁有的音樂檔案。"
          }
        }
      }
    },
