          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget i kön. Spela ett album för att fylla på Nästa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "队列是空的——播放一张专辑来填满“接下来播放”。"
