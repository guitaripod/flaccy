    "Connect Last.fm in Settings for suggestions from your history, or add wanted albums manually.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbind Last.fm i Indstillinger for forslag ud fra din historik, eller tilføj ønskede album manuelt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde Last.fm in den Einstellungen für Vorschläge aus deinem Verlauf – oder füge gewünschte Alben manuell hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta Last.fm en Ajustes para recibir sugerencias de tu historial, o añade álbumes manualmente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistä Last.fm asetuksissa, niin saat ehdotuksia historiasi perusteella. Voit myös lisätä toivotut albumit itse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez Last.fm dans Réglages pour des suggestions issues de votre historique, ou ajoutez les albums voulus manuellement."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tengdu Last.fm í Stillingum til að fá tillögur úr ferli þínum, eða bættu við plötum á óskalista handvirkt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega Last.fm in Impostazioni per ricevere suggerimenti dalla tua cronologia, oppure aggiungi gli album a mano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴に基づく提案を受け取るには設定でLast.fmを接続するか、欲しいアルバムを手動で追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록을 바탕으로 추천을 받으려면 설정에서 Last.fm을 연결하거나, 원하는 앨범을 직접 추가하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koble til Last.fm i Innstillinger for forslag basert på historikken din, eller legg til ønskede album manuelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz z Last.fm w Ustawieniach, aby otrzymywać propozycje z historii, albo dodaj poszukiwane albumy ręcznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte o Last.fm nos Ajustes para receber sugestões do seu histórico, ou adicione os álbuns desejados manualmente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslut Last.fm i Inställningar för förslag från din historik, eller lägg till önskade album manuellt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置”中连接 Last.fm，即可根据你的收听记录获得推荐；也可以手动添加想要的专辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「設定」中連接 Last.fm，就能根據你的聆聽記錄取得推薦；也可以手動加入想要的專輯。"
          }
        }
      }
    },
    "Connect Last.fm in Settings to see\nwhich music you love but don't own.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbind Last.fm i Indstillinger for at se\nhvilken musik du holder af, men ikke ejer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde Last.fm in den Einstellungen und sieh,\nwelche Musik du liebst, aber nicht besitzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta Last.fm en Ajustes para ver\nqué música te encanta pero no tienes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistä Last.fm asetuksissa, niin näet\nmusiikin, josta tykkäät mutta jota et omista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez Last.fm dans Réglages pour voir\nla musique que vous aimez sans la posséder."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tengdu Last.fm í Stillingum til að sjá\nhvaða tónlist þú elskar en átt ekki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega Last.fm in Impostazioni per vedere\nquale musica ami ma non possiedi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定でLast.fmを接続すると、\n好きなのに持っていない音楽がわかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 Last.fm을 연결하면\n좋아하지만 갖고 있지 않은 음악을 볼 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koble til Last.fm i Innstillinger for å se\nhvilken musikk du elsker, men ikke eier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz z Last.fm w Ustawieniach, aby zobaczyć,\njaką muzykę kochasz, ale jeszcze jej nie masz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte o Last.fm nos Ajustes para ver\nque música você ama mas não tem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslut Last.fm i Inställningar för att se\nvilken musik du gillar men inte äger."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置”中连接 Last.fm，看看\n哪些你喜欢的音乐还没有拥有。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「設定」中連接 Last.fm，看看\n哪些你喜歡的音樂還沒擁有。"
          }
        }
      }
    },
    "Connect Last.fm in Settings, or play\nsomething to build your Recap.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbind Last.fm i Indstillinger, eller afspil\nnoget for at opbygge dit tilbageblik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde Last.fm in den Einstellungen oder spiele\netwas ab, um deinen Rückblick zu füllen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta Last.fm en Ajustes, o reproduce\nalgo para construir tu resumen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistä Last.fm asetuksissa tai soita\njotain, niin flaccy-katsauksesi alkaa muodostua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez Last.fm dans Réglages, ou lancez\nun morceau pour construire votre récap."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tengdu Last.fm í Stillingum eða spilaðu\neitthvað til að byggja upp yfirlitið þitt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega Last.fm in Impostazioni, oppure ascolta\nqualcosa per costruire il tuo riepilogo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定でLast.fmを接続するか、\n何か再生してリキャップを育てましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 Last.fm을 연결하거나\n무언가를 재생해 리캡을 채워 보세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koble til Last.fm i Innstillinger, eller spill av\nnoe for å bygge tilbakeblikket ditt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz z Last.fm w Ustawieniach albo odtwórz\ncoś, aby zbudować swoje podsumowanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte o Last.fm nos Ajustes, ou toque\nalgo para montar sua retrospectiva."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslut Last.fm i Inställningar eller spela\nnågot för att bygga din återblick."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置”中连接 Last.fm，或者\n播放一些音乐来生成回顾。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「設定」中連接 Last.fm，或者\n播放一些音樂來產生你的回顧。"
          }
        }
      }
    },
