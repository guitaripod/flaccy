          }
        }
      }
    },
    "Your choice is saved and applies when music is sent. Your Apple Watch plays over Bluetooth, which already compresses audio, so lossless files take several times the space for no audible gain.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit valg er gemt og gælder, når musik sendes. Dit Apple Watch afspiller via Bluetooth, som allerede komprimerer lyden, så tabsfrie filer fylder flere gange så meget plads uden hørbar gevinst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Wahl wird gespeichert und gilt, wenn Musik gesendet wird. Deine Apple Watch spielt über Bluetooth ab, das Audio ohnehin komprimiert. Verlustfreie Dateien brauchen daher ein Vielfaches an Speicher, ohne hörbaren Gewinn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu elección se guarda y se aplica al enviar música. Tu Apple Watch reproduce por Bluetooth, que ya comprime el audio, así que los archivos sin pérdida ocupan varias veces más espacio sin ninguna mejora audible."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valintasi tallennetaan ja tulee voimaan, kun musiikkia lähetetään. Apple Watch toistaa Bluetoothin kautta, joka pakkaa äänen jo valmiiksi, joten häviöttömät tiedostot vievät moninkertaisesti tilaa ilman kuultavaa hyötyä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton choix est enregistré et s’applique à l’envoi de la musique. Ton Apple Watch joue via Bluetooth, qui compresse déjà le son : les fichiers sans perte prennent plusieurs fois plus de place, sans gain audible."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Valið þitt er vistað og gildir þegar tónlist er send. Apple Watch-úrið þitt spilar yfir Bluetooth, sem þjappar hljóð nú þegar, þannig að taplausar skrár taka margfalt meira pláss án þess að nokkur munur heyrist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua scelta viene salvata e si applica all’invio della musica. Il tuo Apple Watch riproduce via Bluetooth, che comprime già l’audio, quindi i file lossless occupano diverse volte lo spazio senza un vantaggio udibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択内容は保存され、音楽の送信時に適用されます。Apple WatchはBluetoothで再生し、Bluetoothはすでに音声を圧縮するため、ロスレスファイルは容量が数倍になりますが、聴き取れる違いはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 내용은 저장되며 음악을 보낼 때 적용됩니다. Apple Watch는 Bluetooth로 재생하며 Bluetooth는 이미 오디오를 압축하므로, 무손실 파일은 용량이 몇 배 커지지만 들리는 차이는 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Valget ditt er lagret og gjelder når musikk sendes. Din Apple Watch spiller av over Bluetooth, som allerede komprimerer lyd, så tapsfrie filer tar flere ganger så mye plass uten hørbar gevinst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój wybór jest zapisany i zastosuje się podczas wysyłania muzyki. Apple Watch odtwarza przez Bluetooth, który już kompresuje dźwięk, więc pliki bezstratne zajmują kilka razy więcej miejsca bez słyszalnej różnicy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua escolha é salva e vale quando a música é enviada. O seu Apple Watch toca por Bluetooth, que já comprime o áudio, então arquivos sem perda ocupam várias vezes mais espaço sem ganho audível."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt val sparas och gäller när musik skickas. Din Apple Watch spelar upp via Bluetooth, som redan komprimerar ljudet, så förlustfria filer tar flera gånger mer plats utan hörbar vinst."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的选择会被保存，并在发送音乐时生效。Apple Watch 通过蓝牙播放，而蓝牙本身已压缩音频，因此无损文件会占用数倍空间，却没有可听出的提升。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的選擇會被儲存，並在傳送音樂時生效。Apple Watch 透過藍牙播放，而藍牙本身已壓縮音訊，因此無損檔案會佔用數倍空間，卻沒有可聽出的提升。"
          }
        }
      }
    },
    "Your chosen cover will be removed and the artwork from the music files is used again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit valgte coverbillede fjernes, og coverbilledet fra musikfilerne bruges igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein gewähltes Cover wird entfernt, und das Cover aus den Musikdateien wird wieder verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your chosen cover will be removed and the artwork from the music files is used again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se quitará la portada que elegiste y se volverá a usar la de los archivos de música."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitsemasi kansikuva poistetaan, ja musiikkitiedostojen kansikuva otetaan jälleen käyttöön."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pochette choisie sera retirée et celle des fichiers musicaux sera de nouveau utilisée."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Valda umslagið verður fjarlægt og umslagið úr tónlistarskránum er notað aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La copertina scelta verrà rimossa e tornerà in uso quella dei file musicali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したカバーは削除され、音楽ファイルのアートワークが再び使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 커버가 제거되고 음악 파일의 아트워크가 다시 사용됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det valgte omslaget fjernes, og omslaget fra musikkfilene brukes igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrana okładka zostanie usunięta, a ponownie użyta zostanie okładka z plików muzycznych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A capa escolhida será removida e a arte dos arquivos de música será usada novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt valda omslag tas bort, och omslaget från musikfilerna används igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选封面将被移除，并重新使用音乐文件中的封面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選封面將被移除，並重新使用音樂檔案中的封面。"
          }
        }
      }
    },
    "Your chosen picture will be removed and the playlist goes back to a mosaic of its albums.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit valgte billede fjernes, og playlisten vises igen som et mosaik af sine album."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein gewähltes Bild wird entfernt, und die Playlist zeigt wieder ein Mosaik aus ihren Alben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your chosen picture will be removed and the playlist goes back to a mosaic of its albums."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imagen elegida se eliminará y la playlist volverá a mostrar un mosaico de sus álbumes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitsemasi kuva poistetaan, ja soittolista palaa albumiensa mosaiikkiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'image choisie sera supprimée et la playlist reprendra une mosaïque de ses albums."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Valda myndin verður fjarlægð og spilunarlistinn fer aftur í mósaík úr plötunum sínum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'immagine scelta verrà rimossa e la playlist tornerà a un mosaico dei suoi album."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだ画像は削除され、プレイリストはアルバムのモザイク表示に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 이미지가 삭제되고 재생목록은 다시 앨범 모자이크로 돌아갑니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det valgte bildet fjernes, og spillelisten viser igjen et mosaikk av albumene sine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrany obraz zostanie usunięty, a playlista wróci do mozaiki ze swoich albumów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A imagem escolhida será removida e a playlist voltará a um mosaico de seus álbuns."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din valda bild tas bort, och spellistan visar igen en mosaik av sina album."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选图片将被移除，播放列表将恢复为其专辑的拼贴图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選圖片將被移除，播放列表將恢復為其專輯的拼貼圖。"
          }
        }
      }
    },
