    "Playing music from your server is free. Syncing playlists, loves and history across devices is part of Flaccy Pro.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afspilning af musik fra din server er gratis. Synkronisering af spillelister, synes godt om-markeringer og historik på tværs af enheder er en del af Flaccy Pro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Musik von deinem Server zu hören ist kostenlos. Playlists, Favoriten und Verlauf geräteübergreifend zu synchronisieren gehört zu Flaccy Pro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escuchar música desde tu servidor es gratis. Sincronizar listas, favoritos e historial entre dispositivos forma parte de Flaccy Pro."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelimeltasi toistettava musiikki on ilmaista. Soittolistojen, tykkäysten ja kuunteluhistorian synkronointi laitteiden välillä kuuluu Flaccy Pro -ominaisuuksiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écouter la musique de votre serveur est gratuit. Synchroniser playlists, coups de cœur et historique entre appareils fait partie de Flaccy Pro."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Það er ókeypis að spila tónlist af netþjóninum þínum. Samstilling spilunarlista, líkaðra laga og hlustunarferils milli tækja er hluti af Flaccy Pro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ascoltare la musica dal tuo server è gratis. Sincronizzare playlist, preferiti e cronologia tra dispositivi fa parte di Flaccy Pro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーの音楽の再生は無料です。デバイス間でのプレイリスト、お気に入り、履歴の同期はFlaccy Proの機能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버의 음악 재생은 무료입니다. 기기 간 플레이리스트, 좋아요, 기록 동기화는 Flaccy Pro 기능입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å spille musikk fra serveren din er gratis. Synkronisering av spillelister, likte sanger og historikk på tvers av enheter er en del av Flaccy Pro."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwarzanie muzyki z serwera jest darmowe. Synchronizacja playlist, ulubionych i historii między urządzeniami to część Flaccy Pro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocar música do seu servidor é grátis. Sincronizar playlists, favoritos e histórico entre aparelhos faz parte do Flaccy Pro."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att spela musik från din server är gratis. Synkronisering av spellistor, gillanden och historik mellan enheter ingår i Flaccy Pro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放服务器上的音乐是免费的。在设备间同步播放列表、喜欢和历史属于 Flaccy Pro。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "播放伺服器上的音樂是免費的。在裝置間同步播放列表、喜愛與記錄屬於 Flaccy Pro。"
          }
        }
      }
    },
