    "Great sound over Bluetooth for nearly everyone. The default.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fremragende lyd over Bluetooth til næsten alle. Standarden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Großartiger Klang über Bluetooth für fast alle. Die Standardeinstellung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gran sonido por Bluetooth para casi todos. La opción predeterminada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinomainen ääni Bluetoothilla lähes kaikille. Oletus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un excellent son en Bluetooth pour presque tout le monde. Le réglage par défaut."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Frábær hljómur um Bluetooth fyrir nánast alla. Sjálfgefið."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottimo suono via Bluetooth per quasi tutti. L'impostazione predefinita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほとんどの人にとってBluetoothで十分すばらしい音質。初期設定です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대부분의 사람에게 블루투스에서 훌륭한 소리. 기본 설정입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flott lyd over Bluetooth for nesten alle. Standardvalget."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Świetny dźwięk przez Bluetooth dla prawie każdego. Domyślna opcja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ótimo som por Bluetooth para quase todos. A opção padrão."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bra ljud över Bluetooth för nästan alla. Standardvalet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对几乎所有人来说，蓝牙上的音质都很出色。默认选项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對幾乎所有人來說，藍牙上的音質都很出色。預設選項。"
          }
        }
      }
    },
