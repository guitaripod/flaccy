    "This Mac isn't on a network, so only it can play the library. Join Wi-Fi or turn on Tailscale.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Mac er ikke på et netværk, så kun den kan afspille biblioteket. Forbind til Wi-Fi, eller tænd for Tailscale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac ist in keinem Netzwerk, daher kann nur er die Mediathek abspielen. Verbinde dich mit einem WLAN oder aktiviere Tailscale."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac isn't on a network, so only it can play the library. Join Wi-Fi or turn on Tailscale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac no está en ninguna red, así que solo él puede reproducir la biblioteca. Conéctate a una red Wi-Fi o activa Tailscale."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä Mac ei ole verkossa, joten vain se voi toistaa kirjastoa. Liity Wi-Fi-verkkoon tai kytke Tailscale päälle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac n’est sur aucun réseau : lui seul peut lire la bibliothèque. Connectez-vous au Wi-Fi ou activez Tailscale."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þessi Mac-tölva er ekki á neti, svo aðeins hún getur spilað safnið. Tengstu við Wi-Fi eða kveiktu á Tailscale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac non è collegato a una rete, quindi solo lui può riprodurre la libreria. Connettiti al Wi-Fi o attiva Tailscale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac はネットワークに接続されていないため、ライブラリを再生できるのはこの Mac だけです。Wi-Fi に接続するか、Tailscale をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac이 네트워크에 연결되어 있지 않아 이 Mac만 보관함을 재생할 수 있습니다. Wi-Fi에 연결하거나 Tailscale을 켜세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Mac-en er ikke på et nettverk, så bare den kan spille biblioteket. Koble til Wi-Fi eller slå på Tailscale."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten Mac nie jest w sieci, więc tylko on może odtwarzać bibliotekę. Połącz się z Wi-Fi albo włącz Tailscale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac não está em rede, então só ele pode tocar a biblioteca. Conecte-se ao Wi-Fi ou ative o Tailscale."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här Mac:en är inte ansluten till något nätverk, så bara den kan spela upp biblioteket. Anslut till Wi-Fi eller slå på Tailscale."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 未联网，因此只有它能播放资料库。请连接 Wi-Fi 或开启 Tailscale。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 未連網，因此只有它能播放資料庫。請連接 Wi-Fi 或開啟 Tailscale。"
          }
        }
      }
    },
    "This Mac stops syncing with %@. Your playlists and history stay here, and %@ keeps its copy.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Mac holder op med at synkronisere med %@. Dine playlister og din historik bliver her, og %@ beholder sin kopi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac synchronisiert nicht mehr mit %@. Playlists und Verlauf bleiben hier, und %@ behält seine Kopie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac stops syncing with %@. Your playlists and history stay here, and %@ keeps its copy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac deja de sincronizarse con %@. Tus playlists y tu historial se quedan aquí, y %@ conserva su copia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä Mac lopettaa synkronoinnin kohteen %@ kanssa. Soittolistasi ja historiasi pysyvät täällä, ja %@ säilyttää oman kopionsa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac arrête la synchronisation avec %@. Vos playlists et votre historique restent ici, et %@ garde sa copie."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þessi Mac hættir að samstilla við %@. Spilunarlistarnir og ferillinn haldast hér, og %@ heldur sínu afriti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac smette di sincronizzarsi con %@. Le tue playlist e la cronologia restano qui, e %@ conserva la sua copia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacは %@ との同期を停止します。プレイリストと履歴はここに残り、%@ は自分のコピーを保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac은 %@와의 동기화를 중단해요. 재생목록과 기록은 여기에 남고, %@은(는) 자신의 사본을 유지해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Macen slutter å synkronisere med %@. Spillelistene og lyttehistorikken blir her, og %@ beholder sin kopi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten Mac przestaje synchronizować się z: %@. Twoje playlisty i historia zostają tutaj, a %@ zachowuje swoją kopię."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac deixa de sincronizar com %@. Suas playlists e seu histórico ficam aqui, e %@ mantém a sua cópia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här Macen slutar synkronisera med %@. Dina spellistor, gillningar och historik finns kvar här, och %@ behåller sin kopia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 将停止与 %@ 同步。你的播放列表和记录保留在这里，%@ 保留其副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
