    "Songs copied in with Finder or the Files app (On My iPad › Flaccy) appear the next time Flaccy launches.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sange, du kopierer ind med Finder eller appen Filer (På min iPad › Flaccy), vises næste gang Flaccy starter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Titel, die du per Finder oder in der App „Dateien“ (Auf meinem iPad › Flaccy) kopierst, erscheinen beim nächsten Start von Flaccy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las canciones copiadas con el Finder o la app Archivos (En mi iPad › Flaccy) aparecen la próxima vez que se abra Flaccy."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kappaleet, jotka kopioidaan Finderilla tai Tiedostot-sovelluksella (Omalla iPadilla › Flaccy), näkyvät seuraavan kerran, kun Flaccy käynnistetään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les morceaux copiés avec le Finder ou l'app Fichiers (Sur mon iPad › Flaccy) apparaissent au prochain lancement de Flaccy."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Lög sem þú afritar inn með Finder eða Skrár-appinu (Á iPad-inum mínum › Flaccy) birtast næst þegar Flaccy er ræst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I brani copiati con il Finder o l'app File (Su iPad › Flaccy) compaiono al prossimo avvio di Flaccy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finderまたはファイルアプリ（このiPad内 › Flaccy）でコピーした曲は、次にFlaccyを起動したときに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder나 파일 앱(나의 iPad › Flaccy)으로 복사한 곡은 다음에 Flaccy를 실행할 때 나타납니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanger du kopierer inn med Finder eller Filer-appen (På min iPad › Flaccy) vises neste gang Flaccy starter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwory skopiowane przez Findera lub aplikację Pliki (Na moim iPadzie › Flaccy) pojawią się przy następnym uruchomieniu Flaccy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As músicas copiadas pelo Finder ou pelo app Arquivos (No iPad › Flaccy) aparecem na próxima vez que o Flaccy for aberto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låtar som kopieras in med Finder eller appen Filer (På min iPad › Flaccy) visas nästa gång Flaccy startas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过访达或“文件”App（我的 iPad › Flaccy）拷入的歌曲，会在下次启动 Flaccy 时出现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過 Finder 或「檔案」App（我的 iPad › Flaccy）拷入的歌曲，會在下次啟動 Flaccy 時出現。"
          }
        }
      }
    },
