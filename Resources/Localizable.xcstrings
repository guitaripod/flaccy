    "Scrambled filenames become real titles, artists and albums.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kryptiske filnavne bliver til rigtige titler, kunstnere og album."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus kryptischen Dateinamen werden echte Titel, Interpreten und Alben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nombres de archivo enrevesados se convierten en títulos, artistas y álbumes de verdad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekavista tiedostonimistä tulee oikeita kappaleiden nimiä, artisteja ja albumeja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms de fichiers illisibles deviennent de vrais titres, artistes et albums."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Brengluð skráarnöfn verða að réttum lagaheitum, listamönnum og plötum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomi di file incomprensibili diventano titoli, artisti e album veri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ぐちゃぐちゃなファイル名が、本物のタイトル・アーティスト・アルバムになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뒤죽박죽인 파일 이름이 진짜 제목, 아티스트, 앨범이 됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotete filnavn blir til ekte titler, artister og album."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poplątane nazwy plików stają się prawdziwymi tytułami, wykonawcami i albumami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomes de arquivo embaralhados viram títulos, artistas e álbuns de verdade."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kryptiska filnamn blir till riktiga titlar, artister och album."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "杂乱的文件名变成真正的标题、艺人和专辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雜亂的檔案名稱變成真正的標題、演出者和專輯。"
          }
        }
      }
    },
