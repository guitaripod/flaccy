    "Nothing in your library matches “%@”.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet i dit bibliotek matcher »%@«."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts in deiner Mediathek passt zu „%@“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada en tu biblioteca coincide con “%@”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjastossasi ei ole mitään, mikä vastaa hakua ”%@”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien dans votre bibliothèque ne correspond à « %@ »."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekkert í safninu þínu passar við „%@“."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella tua libreria non c'è nulla che corrisponda a “%@”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリに「%@」に一致するものはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함에 “%@”과(와) 일치하는 항목이 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting i biblioteket ditt samsvarer med «%@»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic w twojej bibliotece nie pasuje do „%@”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada na sua biblioteca corresponde a “%@”."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget i ditt bibliotek matchar ”%@”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资料库中没有与“%@”匹配的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料庫中沒有符合「%@」的內容。"
          }
        }
      }
    },
    "Nothing is copied or moved — Flaccy reads your files where they are.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet kopieres eller flyttes – Flaccy læser dine filer, hvor de ligger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wird kopiert oder verschoben – Flaccy liest deine Dateien dort, wo sie liegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se copia ni se mueve nada: Flaccy lee tus archivos donde están."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitään ei kopioida eikä siirretä. Flaccy lukee tiedostosi siellä, missä ne ovat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est copié ni déplacé — Flaccy lit vos fichiers là où ils sont."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Engu er afritað né fært – Flaccy les skrárnar þínar þar sem þær eru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente viene copiato o spostato: Flaccy legge i tuoi file dove sono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーも移動もしません。Flaccyはファイルをそのままの場所で読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무것도 복사하거나 옮기지 않습니다. Flaccy는 파일을 있는 자리에서 읽습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting kopieres eller flyttes – Flaccy leser filene der de ligger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie jest kopiowane ani przenoszone — Flaccy czyta twoje pliki tam, gdzie są."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é copiado nem movido — o Flaccy lê seus arquivos onde eles estão."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget kopieras eller flyttas. Flaccy läser dina filer där de ligger."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不复制也不移动任何文件——Flaccy 就在原处读取你的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不複製也不移動任何檔案——Flaccy 就在原處讀取你的檔案。"
          }
        }
      }
    },
