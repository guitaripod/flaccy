    "Pay once, own it forever.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Betal én gang, eje den for altid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal zahlen, für immer behalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paga una vez, es tuyo para siempre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksa kerran, omista ikuisesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Payez une fois, gardez-le pour toujours."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Borgaðu einu sinni og eigðu þetta til eilífðar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Paghi una volta, è tuo per sempre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度の支払いで、ずっと使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 결제하면 영원히 내 것."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Betal én gang, eie den for alltid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapłać raz, posiadaj na zawsze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pague uma vez, é seu para sempre."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Betala en gång, äg den för alltid."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次付费，永久拥有。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次付費，永久擁有。"
          }
        }
      }
    },
