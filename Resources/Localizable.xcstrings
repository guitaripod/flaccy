    "This device has no camera to scan with. Type the server’s address and key instead.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne enhed har intet kamera til at scanne med. Skriv serverens adresse og nøgle i stedet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät hat keine Kamera zum Scannen. Gib stattdessen die Adresse und den Schlüssel des Servers ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no tiene cámara para escanear. Escribe en su lugar la dirección y la clave del servidor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tässä laitteessa ei ole kameraa skannaamiseen. Kirjoita palvelimen osoite ja avain sen sijaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n’a pas de caméra pour scanner. Saisis plutôt l’adresse et la clé du serveur."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þetta tæki er ekki með myndavél til að skanna með. Sláðu inn vistfang og lykil netþjónsins í staðinn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non ha una fotocamera per la scansione. Inserisci invece l’indirizzo e la chiave del server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスにはスキャン用のカメラがありません。代わりにサーバーのアドレスとキーを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에는 스캔할 카메라가 없습니다. 대신 서버의 주소와 키를 입력하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne enheten har ikke kamera til å skanne med. Skriv inn serverens adresse og nøkkel i stedet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To urządzenie nie ma aparatu do skanowania. Wpisz zamiast tego adres i klucz serwera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não tem câmera para escanear. Digite o endereço e a chave do servidor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här enheten har ingen kamera att skanna med. Skriv in serverns adress och nyckel i stället."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备没有可用于扫描的相机。请改为输入服务器的地址和密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置沒有可用於掃描的相機。請改為輸入伺服器的位址和金鑰。"
          }
        }
      }
    },
