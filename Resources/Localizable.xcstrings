    "Home is put together on this device from your library and what you play. Sections with nothing to show stay out of the way.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Home sammensættes på denne enhed ud fra dit bibliotek og det, du spiller. Hylder uden indhold skjules."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Home wird auf diesem Gerät aus deiner Mediathek und deiner Wiedergabe zusammengestellt. Bereiche ohne Inhalt bleiben aus dem Weg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicio se crea en este dispositivo a partir de tu biblioteca y de lo que reproduces. Las secciones sin contenido no estorban."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koti kootaan tällä laitteella kirjastostasi ja siitä, mitä toistat. Osiot, joissa ei ole näytettävää, jäävät pois näkyvistä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accueil est composé sur cet appareil à partir de votre bibliothèque et de ce que vous écoutez. Les sections vides restent discrètes."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Flipinn Heim er settur saman á þessu tæki úr safninu þínu og því sem þú spilar. Hlutar sem hafa ekkert að sýna halda sig til hliðar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Home viene composta su questo dispositivo dalla tua libreria e da ciò che riproduci. Le sezioni senza contenuti restano in secondo piano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホームは、このデバイス上でライブラリと再生履歴から組み立てられます。表示する内容がないセクションは邪魔にならないよう隠れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈은 이 기기에서 보관함과 재생 기록을 바탕으로 구성됩니다. 보여줄 내용이 없는 섹션은 자동으로 숨겨집니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjem settes sammen på denne enheten av biblioteket ditt og det du spiller. Seksjoner uten noe å vise holder seg unna."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strona główna jest tworzona na tym urządzeniu z Twojej biblioteki i tego, czego słuchasz. Sekcje bez treści nie zajmują miejsca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Início é montado neste dispositivo a partir da sua biblioteca e do que você toca. Seções sem nada para mostrar ficam de fora."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hem sätts ihop på den här enheten utifrån ditt bibliotek och det du spelar. Avsnitt utan något att visa håller sig undan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主页完全在本设备上根据你的资料库和播放内容生成。没有内容可显示的分区会自动隐藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主頁完全在這台裝置上，根據你的資料庫和播放內容組成。沒有內容可顯示的區段會自動隱藏。"
          }
        }
      }
    },
    "Hover a preset to hear it": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold markøren over en forindstilling for at høre den"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fahre über eine Voreinstellung, um sie zu hören"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa el cursor sobre un preajuste para oírlo"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuuntele esiasetus viemällä osoitin sen päälle"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Survolez un préréglage pour l’écouter"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Færðu bendilinn yfir forstillingu til að heyra hana"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa il puntatore su un preset per ascoltarlo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリセットにポインタを合わせると聴けます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프리셋에 마우스를 올리면 들어볼 수 있어요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold over en forhåndsinnstilling for å høre den"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najedź na preset, aby go usłyszeć"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe o mouse sobre uma predefinição para ouvi-la"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Peka på en förinställning för att höra den"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将鼠标悬停在预设上即可试听"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將游標懸停在預設上即可試聽"
          }
        }
      }
    },
    "Hover to hear it · click to keep it": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold markøren for at høre den · klik for at beholde den"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Darüberfahren zum Hören · Klicken zum Behalten"
          }
