        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ kann nicht als dein Musikordner verwendet werden – macOS hat Flaccy keinen dauerhaften Zugriff gewährt: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede usar “%@” como carpeta de música: macOS no concedió a Flaccy acceso permanente: %@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kansiota ”%@” ei voitu käyttää musiikkikansionasi, koska macOS ei myöntänyt Flaccylle pysyvää käyttöoikeutta: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’utiliser « %@ » comme dossier de musique : macOS n’a pas accordé à Flaccy un accès durable : %@"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki var hægt að nota „%@“ sem tónlistarmöppu – macOS veitti Flaccy ekki varanlegan aðgang: %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile usare “%@” come cartella della musica: macOS non ha concesso a Flaccy un accesso duraturo: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を音楽フォルダとして使用できません。macOSがFlaccyに永続的なアクセスを許可しませんでした: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”을(를) 음악 폴더로 사용할 수 없습니다. macOS가 Flaccy에 지속적인 접근 권한을 부여하지 않았습니다: %@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke bruke «%@» som musikkmappe – macOS ga ikke Flaccy varig tilgang: %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można użyć „%@” jako folderu muzyki — macOS nie przyznał Flaccy trwałego dostępu: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível usar “%@” como sua pasta de música: o macOS não concedeu ao Flaccy acesso permanente: %@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” kan inte användas som din musikmapp – macOS gav inte Flaccy varaktig åtkomst: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将“%@”用作音乐文件夹——macOS 未授予 Flaccy 持久访问权限：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法將「%@」用作音樂資料夾——macOS 未授予 Flaccy 持續存取權限：%@"
          }
        }
      }
    },
    "Couldn’t reach your Watch. Try again in a moment": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke nå dit ur. Prøv igen om et øjeblik"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Watch ist nicht erreichbar. Versuche es gleich noch einmal"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con tu Watch. Inténtalo de nuevo en un momento"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelloasi ei tavoitettu. Yritä hetken kuluttua uudelleen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre ta Watch. Réessaie dans un instant"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki næst samband við úrið. Reyndu aftur eftir smá stund"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere il tuo Watch. Riprova tra poco"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Watchに接続できませんでした。しばらくしてから再試行してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch에 연결할 수 없습니다. 잠시 후 다시 시도하세요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke nå klokken din. Prøv igjen om litt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można połączyć się z Watchem. Spróbuj ponownie za chwilę"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível alcançar o seu Watch. Tente novamente em instantes"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte nå din klocka. Försök igen om en stund"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到 Watch，请稍后再试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線到 Watch，請稍後再試"
          }
        }
      }
    },
    "Couldn’t save the volume of “%@”. The library database refused the change, so the song keeps its previous level. Try again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke gemme lydstyrken for »%@«. Bibliotekets database afviste ændringen, så sangen beholder sit tidligere niveau. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Lautstärke von „%@“ konnte nicht gesichert werden. Die Mediathek-Datenbank hat die Änderung abgelehnt, daher behält der Song seine bisherige Lautstärke. Versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el volumen de «%@». La base de datos de la biblioteca rechazó el cambio, así que la canción conserva su nivel anterior. Inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kappaleen ”%@” äänenvoimakkuutta ei voitu tallentaa. Kirjastotietokanta hylkäsi muutoksen, joten kappale säilyttää aiemman tason. Yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer le volume de « %@ ». La base de données de la bibliothèque a refusé la modification ; le morceau garde donc son niveau précédent. Réessayez."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki tókst að vista hljóðstyrk „%@“. Gagnagrunnur safnsins hafnaði breytingunni, svo lagið heldur fyrra hljóðstyrk. Reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare il volume di “%@”. Il database della libreria ha rifiutato la modifica, quindi il brano mantiene il livello precedente. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」の音量を保存できませんでした。ライブラリのデータベースが変更を拒否したため、曲は以前の音量のままです。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”의 음량을 저장하지 못했습니다. 보관함 데이터베이스가 변경을 거부해 곡이 이전 음량을 유지합니다. 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke lagre volumet for «%@». Biblioteksdatabasen avviste endringen, så sangen beholder forrige nivå. Prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać głośności utworu „%@”. Baza danych biblioteki odrzuciła zmianę, więc utwór zachowuje poprzedni poziom. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar o volume de “%@”. O banco de dados da biblioteca recusou a alteração, então a música mantém o nível anterior. Tente novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Volymen för ”%@” kunde inte sparas. Biblioteksdatabasen avvisade ändringen, så låten behåller sin tidigare nivå. Försök igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存“%@”的音量。资料库数据库拒绝了这项更改，因此这首歌曲保持原来的音量。请再试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存「%@」的音量。資料庫拒絕了這項變更，因此這首歌曲保持原來的音量。請再試一次。"
          }
        }
      }
    },
