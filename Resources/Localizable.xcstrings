    "Play some music and your Year in Music will build itself. Or pick another year above.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afspil noget musik, så bygger Årets musik sig selv. Eller vælg et andet år ovenfor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiel etwas Musik und dein Musikjahr entsteht von selbst. Oder wähle oben ein anderes Jahr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escucha algo de música y tu Año en música se construirá solo. O elige otro año arriba."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toista musiikkia, niin Vuoden musiikki rakentuu itsestään. Tai valitse yllä toinen vuosi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écoutez de la musique et votre Année en musique se construira toute seule. Ou choisissez une autre année ci-dessus."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Spilaðu tónlist og tónlistarárið þitt byggist upp af sjálfu sér. Eða veldu annað ár hér fyrir ofan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ascolta un po' di musica e il tuo Anno in musica si costruirà da solo. Oppure scegli un altro anno qui sopra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何か音楽を再生すれば、音楽の1年はひとりでに出来上がります。上から別の年を選ぶこともできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악을 재생하면 음악 결산이 저절로 쌓입니다. 위에서 다른 해를 선택할 수도 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spill litt musikk, så bygger Årets musikk seg selv. Eller velg et annet år over."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwórz trochę muzyki, a twój Rok w muzyce zbuduje się sam. Albo wybierz inny rok powyżej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque alguma música e seu Ano em música se monta sozinho. Ou escolha outro ano acima."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spela lite musik så byggs din årssammanställning av sig själv. Eller välj ett annat år ovan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放一些音乐，年度音乐就会自动生成。也可以在上方选择其他年份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "播放一些音樂，年度音樂就會自動產生。也可以在上方選擇其他年份。"
          }
        }
      }
    },
    "Play some music, or connect Last.fm in Settings to bring in your history.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afspil noget musik, eller forbind Last.fm under Indstillinger for at hente din historik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiel etwas Musik ab oder verbinde Last.fm in den Einstellungen, um deinen Verlauf zu übernehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce música o conecta Last.fm en Ajustes para traer tu historial."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toista musiikkia tai yhdistä Last.fm Asetuksissa, niin kuunteluhistoriasi tuodaan mukaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écoutez de la musique ou connectez Last.fm dans les Réglages pour récupérer votre historique."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Spilaðu tónlist eða tengdu Last.fm í stillingunum til að flytja inn hlustunarferilinn þinn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduci della musica o collega Last.fm nelle Impostazioni per portare la tua cronologia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音楽を再生するか、設定でLast.fmを接続して履歴を取り込みましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악을 재생하거나 설정에서 Last.fm을 연결해 기록을 가져오세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spill litt musikk, eller koble til Last.fm i Innstillinger for å hente inn historikken din."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwórz muzykę lub połącz Last.fm w Ustawieniach, aby wczytać swoją historię."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque algumas músicas ou conecte o Last.fm nos Ajustes para trazer seu histórico."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spela lite musik eller anslut Last.fm i Inställningar för att hämta din historik."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放一些音乐，或在“设置”中连接 Last.fm 以导入你的历史记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "播放一些音樂，或在「設定」中連接 Last.fm 以匯入你的歷史記錄。"
          }
        }
      }
    },
    "Play the Sample Album": {
