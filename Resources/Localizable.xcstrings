            "value": "Ricerca di audio nei tuoi file"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルからオーディオを探しています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일에서 오디오 찾는 중"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanowanie plików w poszukiwaniu audio"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Procurando áudio nos seus arquivos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在扫描文件中的音频"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在掃描檔案中的音訊"
          }
        }
      }
    },
    "Scrambled filenames become real titles, artists and albums.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus kryptischen Dateinamen werden echte Titel, Interpreten und Alben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nombres de archivo enrevesados se convierten en títulos, artistas y álbumes de verdad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms de fichiers illisibles deviennent de vrais titres, artistes et albums."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomi di file incomprensibili diventano titoli, artisti e album veri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ぐちゃぐちゃなファイル名が、本物のタイトル・アーティスト・アルバムになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뒤죽박죽인 파일 이름이 진짜 제목, 아티스트, 앨범이 됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poplątane nazwy plików stają się prawdziwymi tytułami, wykonawcami i albumami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomes de arquivo embaralhados viram títulos, artistas e álbuns de verdade."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "杂乱的文件名变成真正的标题、艺人和专辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雜亂的檔案名稱變成真正的標題、演出者和專輯。"
          }
        }
      }
    },
    "Scrobbles": {
      "localizations": {
