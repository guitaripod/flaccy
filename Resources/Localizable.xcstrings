    "Hold and slide to hear them": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten und wischen, um sie zu hören"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén y desliza para oírlos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez et glissez pour les écouter"
          }
        },
