    "Less than a day left in your trial": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindre end en dag tilbage i din prøveperiode"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weniger als ein Tag in deiner Testphase übrig"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Queda menos de un día de prueba"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeilusta on jäljellä alle päivä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il reste moins d'un jour à votre essai"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Minna en einn dagur eftir af prufutímanum"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta meno di un giorno di prova"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トライアル終了まで1日を切りました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체험판 종료까지 하루도 남지 않았습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindre enn ett døgn igjen av prøveperioden"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mniej niż dzień do końca okresu próbnego"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta menos de um dia do seu teste"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindre än en dag kvar av din provperiod"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试用剩余不到一天"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "試用剩餘不到一天"
          }
        }
      }
    },
    "Less than a day left in your trial — Lifetime is one payment, no subscription.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindre end en dag tilbage i din prøveperiode – Livstid er én engangsbetaling, intet abonnement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weniger als ein Tag in deiner Testphase übrig – Lifetime ist eine Einmalzahlung, kein Abo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Queda menos de un día de prueba: de por vida es un pago único, sin suscripción."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeilusta on jäljellä alle päivä – Elinikäinen on yksi maksu, ei tilausta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il reste moins d'un jour à votre essai — à vie, c'est un paiement unique, sans abonnement."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Minna en einn dagur eftir af prufutímanum. Ævilangt er ein greiðsla, engin áskrift."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta meno di un giorno di prova: a vita è un pagamento unico, senza abbonamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トライアル終了まで1日を切りました。買い切りは一回払いで、定期購読ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체험판 종료까지 하루도 남지 않았습니다 — 평생 이용은 구독 없는 1회 결제입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindre enn ett døgn igjen av prøveperioden – Livstid er et engangskjøp, ikke et abonnement."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mniej niż dzień do końca okresu próbnego — dostęp dożywotni to jedna płatność, bez subskrypcji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta menos de um dia do seu teste — o vitalício é um pagamento único, sem assinatura."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindre än en dag kvar av din provperiod – Livstid är en engångsbetalning, ingen prenumeration."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试用剩余不到一天 — 永久版为一次性付款，无需订阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "試用剩餘不到一天 — 永久版為一次性付款，無需訂閱。"
          }
        }
      }
    },
