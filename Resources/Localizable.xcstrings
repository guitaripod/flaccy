    "Pay once, use it for life. Nothing renews.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Betal én gang, brug den resten af livet. Intet fornyes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal zahlen, ein Leben lang nutzen. Nichts verlängert sich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paga una vez, úsalo de por vida. Nada se renueva."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksa kerran, käytä elinikäisesti. Mikään ei uusiudu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Payez une fois, utilisez-le à vie. Rien ne se renouvelle."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Borgaðu einu sinni og notaðu það ævilangt. Ekkert endurnýjast."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Paga una volta, usalo per sempre. Niente si rinnova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度の支払いで一生使えます。更新は一切ありません。"
