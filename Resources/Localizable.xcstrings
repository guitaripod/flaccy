    "Hold and slide to hear them": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold og skub for at høre dem"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten und wischen, um sie zu hören"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén y desliza para oírlos"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä painettuna ja liu’uta, niin kuulet ne"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez et glissez pour les écouter"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Haltu inni og renndu til að heyra þau"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto e scorri per ascoltarli"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長押ししてスライドすると試聴できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길게 누른 채 밀어서 들어보세요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold og dra for å høre dem"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj i przesuń, aby je usłyszeć"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure e deslize para ouvi-las"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll och dra för att höra dem"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住并滑动即可试听"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住並滑動即可試聽"
          }
        }
      }
    },
