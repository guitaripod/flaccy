    "No servers yet. Add one to play its library here.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen servere endnu. Tilføj en for at afspille dens bibliotek her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Server. Füge einen hinzu, um seine Mediathek hier abzuspielen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay servidores. Añade uno para reproducir su biblioteca aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelimia ei ole vielä. Lisää palvelin, niin voit toistaa sen kirjaston täältä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun serveur pour l’instant. Ajoute-en un pour lire sa bibliothèque ici."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Engir netþjónar enn. Bættu við einum til að spila safnið hans hér."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun server per ora. Aggiungine uno per riprodurre qui la sua libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーはまだありません。追加すると、そのライブラリをここで再生できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 서버가 없습니다. 서버를 추가하면 그 보관함을 여기서 재생할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen servere ennå. Legg til en for å spille av biblioteket her."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak serwerów. Dodaj serwer, aby odtwarzać tutaj jego bibliotekę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum servidor ainda. Adicione um para tocar a biblioteca dele aqui."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga servrar än. Lägg till en för att spela upp dess bibliotek här."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有服务器。添加一个，即可在这里播放它的资料库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無伺服器。新增一個，即可在這裡播放它的資料庫。"
          }
        }
      }
    },
    "No similar artists in your library yet.": {
      "localizations": {
        "da": {
          "stringUnit": {
