    "Still connecting to your Watch. Try again in a moment": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stadig ved at oprette forbindelse til uret. Prøv igen om lidt"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung zu deiner Watch wird noch hergestellt. Versuche es gleich noch einmal"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún conectando con tu Watch. Inténtalo de nuevo en un momento"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistetään edelleen Apple Watchiin. Yritä hetken kuluttua uudelleen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion à ta Watch en cours. Réessaie dans un instant"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Enn verið að tengjast úrinu. Reyndu aftur eftir stutta stund"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connessione al tuo Watch in corso. Riprova tra poco"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだWatchに接続中です。しばらくしてから再度お試しください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 Watch에 연결하는 중입니다. 잠시 후 다시 시도하세요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kobler fortsatt til klokken din. Prøv igjen om et øyeblikk"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadal łączenie z Watchem. Spróbuj ponownie za chwilę"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda conectando ao seu Watch. Tente novamente em instantes"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ansluter fortfarande till klockan. Försök igen om en stund"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍在连接 Watch，请稍后再试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "仍在連線到 Watch，請稍後再試"
          }
        }
      }
    },
    "Still no Apple Watch paired with this iPhone.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er stadig ingen Apple Watch parret med denne iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Immer noch keine Apple Watch mit diesem iPhone gekoppelt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay ningún Apple Watch emparejado con este iPhone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tähän iPhoneen ei ole vielä yhdistetty Apple Watchia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours aucun Apple Watch associé à cet iPhone."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Engin Apple Watch er enn pöruð við þennan iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun Apple Watch associato a questo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneにはまだApple Watchがペアリングされていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone에 아직 페어링된 Apple Watch가 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsatt ingen Apple Watch er koblet til denne iPhonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadal brak Apple Watcha sparowanego z tym iPhonem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há nenhum Apple Watch pareado com este iPhone."
