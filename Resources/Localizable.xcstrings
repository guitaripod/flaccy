    "Up to date — every album has artwork and a year.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opdateret – alle album har coverbillede og årstal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles aktuell – jedes Album hat Cover und Jahr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo al día: cada álbum tiene carátula y año."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajan tasalla – jokaisella albumilla on kansikuva ja vuosi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À jour — chaque album a une pochette et une année."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppfært – allar plötur eru með umslagi og útgáfuári."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto aggiornato: ogni album ha copertina e anno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて最新です。どのアルバムにもアートワークと年があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두 최신입니다. 모든 앨범에 아트워크와 발매 연도가 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppdatert – alle album har omslag og år."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualne — każdy album ma okładkę i rok."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo em dia — todo álbum tem capa e ano."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppdaterat – varje album har omslag och år."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已是最新——每张专辑都有封面和年份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已是最新——每張專輯都有封面和年份。"
          }
        }
      }
    },
