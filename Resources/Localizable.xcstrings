    "Couldn't read that file as UTF-8 text. Equalizer APO and AutoEq profiles are plain text files.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke læse filen som UTF-8-tekst. Equalizer APO- og AutoEq-profiler er almindelige tekstfiler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei konnte nicht als UTF-8-Text gelesen werden. Equalizer APO- und AutoEq-Profile sind reine Textdateien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer ese archivo como texto UTF-8. Los perfiles de Equalizer APO y AutoEq son archivos de texto sin formato."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedostoa ei voitu lukea UTF-8-tekstinä. Equalizer APO- ja AutoEq-profiilit ovat pelkkiä tekstitiedostoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire ce fichier en texte UTF-8. Les profils Equalizer APO et AutoEq sont des fichiers texte brut."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki tókst að lesa skrána sem UTF-8-texta. Equalizer APO- og AutoEq-prófílar eru venjulegar textaskrár."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere il file come testo UTF-8. I profili Equalizer APO e AutoEq sono file di testo semplice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのファイルはUTF-8のテキストとして読めませんでした。Equalizer APOとAutoEqのプロファイルはプレーンテキストのファイルです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 파일을 UTF-8 텍스트로 읽을 수 없습니다. Equalizer APO와 AutoEq 프로파일은 일반 텍스트 파일입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke lese filen som UTF-8-tekst. Equalizer APO- og AutoEq-profiler er rene tekstfiler."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać tego pliku jako tekstu UTF-8. Profile Equalizer APO i AutoEq to zwykłe pliki tekstowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler esse arquivo como texto UTF-8. Os perfis do Equalizer APO e do AutoEq são arquivos de texto simples."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte läsa filen som UTF-8-text. Equalizer APO- och AutoEq-profiler är vanliga textfiler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将该文件作为 UTF-8 文本读取。Equalizer APO 和 AutoEq 配置文件都是纯文本文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法將該檔案讀取為 UTF-8 文字。Equalizer APO 與 AutoEq 設定檔都是純文字檔。"
          }
        }
      }
    },
    "Couldn't read the audio of “%@” (%@). You can still share an image.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke læse lyden fra »%@« (%@). Du kan stadig dele et billede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tonspur von „%@“ konnte nicht gelesen werden (%@). Du kannst trotzdem ein Bild teilen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el audio de “%@” (%@). Aún puedes compartir una imagen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedoston ”%@” ääntä ei voitu lukea (%@). Voit silti jakaa kuvan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire l’audio de « %@ » (%@). Vous pouvez tout de même partager une image."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki tókst að lesa hljóðrás „%@“ (%@). Þú getur samt deilt mynd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere l’audio di “%@” (%@). Puoi comunque condividere un’immagine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」の音声を読み込めませんでした（%@）。画像は共有できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”의 오디오를 읽을 수 없습니다(%@). 그래도 이미지는 공유할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke lese lyden i «%@» (%@). Du kan fortsatt dele et bilde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać dźwięku z „%@” (%@). Nadal możesz udostępnić obraz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o áudio de “%@” (%@). Você ainda pode compartilhar uma imagem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte läsa ljudet i ”%@” (%@). Du kan fortfarande dela en bild."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取“%@”的音频（%@）。你仍可分享图片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取「%@」的音訊（%@）。你仍可分享圖片。"
          }
        }
      }
    },
    "Couldn't read the audio of “%@” — the chosen lines lie past the end of the file. Pick earlier lines.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke læse lyden fra »%@«: de valgte linjer ligger efter filens slutning. Vælg tidligere linjer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tonspur von „%@“ konnte nicht gelesen werden – die gewählten Zeilen liegen hinter dem Dateiende. Wähle frühere Zeilen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el audio de “%@”: las líneas elegidas están después del final del archivo. Elige líneas anteriores."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedoston ”%@” ääntä ei voitu lukea, sillä valitut rivit ovat tiedoston lopun jälkeen. Valitse aiemmat rivit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire l’audio de « %@ » : les lignes choisies se trouvent après la fin du fichier. Choisissez des lignes plus anciennes."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki tókst að lesa hljóðrás „%@“ – valdar línur ná út fyrir lok skrárinnar. Veldu fyrri línur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere l’audio di “%@”: le righe scelte sono oltre la fine del file. Scegli righe precedenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」の音声を読み込めませんでした。選んだ行はファイルの終わりより後にあります。もっと前の行を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”의 오디오를 읽을 수 없습니다. 선택한 줄이 파일 끝을 넘어갑니다. 앞쪽 줄을 고르세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke lese lyden i «%@» – de valgte linjene ligger etter slutten av filen. Velg tidligere linjer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać dźwięku z „%@”. Wybrane wiersze leżą za końcem pliku. Wybierz wcześniejsze wiersze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o áudio de “%@”: as linhas escolhidas estão depois do fim do arquivo. Escolha linhas anteriores."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte läsa ljudet i ”%@” – de valda raderna ligger efter filens slut. Välj tidigare rader."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取“%@”的音频：所选歌词行超出了文件末尾。请选择更靠前的歌词行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取「%@」的音訊：所選歌詞行超出了檔案結尾。請選擇較前面的歌詞行。"
          }
        }
      }
    },
