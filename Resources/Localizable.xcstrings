    "AirDrop the files to your iPad and save them to Files. Then tap Add Music and choose them.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Send filerne til din iPad med AirDrop, og gem dem i Filer. Tryk derefter på Tilføj musik, og vælg dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sende die Dateien per AirDrop an dein iPad und sichere sie in „Dateien“. Tippe dann auf „Musik hinzufügen“ und wähle sie aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía los archivos a tu iPad con AirDrop y guárdalos en Archivos. Después toca Añadir música y selecciónalos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetä tiedostot iPadiisi AirDropilla ja tallenna ne Tiedostot-sovellukseen. Napauta sitten ”Lisää musiikkia” ja valitse ne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez les fichiers à votre iPad par AirDrop et enregistrez-les dans Fichiers. Touchez ensuite Ajouter de la musique et choisissez-les."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendu skrárnar á iPad með AirDrop og vistaðu þær í appinu Skrár. Ýttu síðan á „Bæta við tónlist“ og veldu þær."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia i file all'iPad con AirDrop e salvali in File. Poi tocca Aggiungi musica e selezionali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルをAirDropでiPadに送り、ファイルAppに保存します。そのあと「音楽を追加」をタップして選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 AirDrop으로 iPad에 보내 파일 앱에 저장하세요. 그런 다음 음악 추가를 탭하고 선택하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop filene til iPaden din og lagre dem i Filer. Trykk deretter på «Legg til musikk» og velg dem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyślij pliki przez AirDrop na iPada i zapisz je w aplikacji Pliki. Potem dotknij Dodaj muzykę i wybierz je."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie os arquivos para o iPad por AirDrop e salve-os no app Arquivos. Depois toque em Adicionar música e escolha-os."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd AirDrop för att skicka filerna till din iPad och spara dem i Filer. Tryck sedan på Lägg till musik och välj dem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 AirDrop 将文件发送到 iPad，并存储到“文件”App。然后点按“添加音乐”并选取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過 AirDrop 將檔案傳送到 iPad，並儲存到「檔案」App。然後點一下「加入音樂」並選取。"
          }
        }
      }
    },
