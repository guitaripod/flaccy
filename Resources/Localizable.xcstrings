    "Add music to Flaccy first, then pick the albums your Apple Watch should carry.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj først musik til Flaccy, og vælg derefter de album, din Apple Watch skal have med."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge zuerst Musik zu Flaccy hinzu und wähle dann die Alben aus, die deine Apple Watch haben soll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add music to Flaccy first, then pick the albums your Apple Watch should carry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero añade música a Flaccy y luego elige los álbumes que debe llevar tu Apple Watch."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää ensin musiikkia Flaccyyn ja valitse sitten albumit, jotka haluat Apple Watchiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez d’abord de la musique à Flaccy, puis choisissez les albums que votre Apple Watch doit contenir."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Bættu fyrst tónlist við Flaccy og veldu síðan plöturnar sem Apple Watch-úrið þitt á að hafa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima aggiungi musica a Flaccy, poi scegli gli album che deve avere il tuo Apple Watch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず Flaccy に音楽を追加してから、Apple Watch に入れるアルバムを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 Flaccy에 음악을 추가한 다음, Apple Watch에 담을 앨범을 고르세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til musikk i Flaccy først, og velg deretter albumene Apple Watch-en din skal ha."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw dodaj muzykę do Flaccy, a potem wybierz albumy, które ma mieć Apple Watch."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro adicione música ao Flaccy e depois escolha os álbuns que o seu Apple Watch deve ter."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg först till musik i Flaccy och välj sedan de album som ska finnas på din Apple Watch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先把音乐添加到 Flaccy，然后选择要放到 Apple Watch 上的专辑。"
