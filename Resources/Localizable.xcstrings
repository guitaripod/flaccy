        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앨범을 골라 감상을 시작하세요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg et album for å begynne å lytte"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz album, aby zacząć słuchać"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um álbum para começar a ouvir"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj ett album för att börja lyssna"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挑一张专辑开始收听"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "挑一張專輯開始聽"
          }
        }
      }
    },
    "Pinch and drag to frame the cover": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Knib og træk for at justere coverbilledet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit zwei Fingern zoomen und ziehen, um das Cover auszurichten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinch and drag to frame the cover"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pellizca y arrastra para encuadrar la portada"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nipistä ja vedä kansikuvan rajaamiseksi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pince et fais glisser pour cadrer la pochette"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Klíptu og dragðu til að staðsetja umslagið"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pizzica e trascina per inquadrare la copertina"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピンチとドラッグでカバーの範囲を調整"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "핀치하고 끌어서 커버 영역을 지정"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klyp og dra for å ramme inn omslaget"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozsuń palce i przeciągnij, aby ustawić kadr okładki"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pince e arraste para enquadrar a capa"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyp och dra för att beskära omslaget"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "捏合并拖动以调整封面取景"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "捏合並拖移以調整封面取景"
          }
        }
      }
    },
    "Pinch to zoom and drag to reposition": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Knib for at zoome, og træk for at flytte"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Zoomen zusammenziehen, zum Verschieben ziehen"
