    "Re-fetch artwork and release dates for albums Flaccy gave up on.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hent coverbilleder og udgivelsesdatoer igen for album, som Flaccy opgav."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cover und Erscheinungsdaten für Alben erneut laden, bei denen Flaccy aufgegeben hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a buscar carátulas y fechas de lanzamiento de los álbumes con los que Flaccy se rindió."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hae uudelleen kansikuvat ja julkaisupäivät albumeille, joille Flaccy ei aiemmin löytänyt tietoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relancer la recherche de pochettes et de dates de sortie pour les albums abandonnés par Flaccy."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sækja aftur umslög og útgáfudagsetningar fyrir plötur sem Flaccy gafst upp á."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca di nuovo copertine e date di uscita per gli album su cui Flaccy si è arreso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccyがあきらめたアルバムのアートワークとリリース日をもう一度取得します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy가 포기한 앨범의 아트워크와 발매일을 다시 가져옵니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hent omslag og utgivelsesdatoer på nytt for album der Flaccy ga opp."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobierz ponownie okładki i daty wydania dla albumów, z których Flaccy zrezygnował."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar de novo capas e datas de lançamento dos álbuns em que o Flaccy desistiu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hämta omslag och utgivningsdatum på nytt för album som Flaccy gav upp på."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为 Flaccy 放弃的专辑重新获取封面和发行日期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為 Flaccy 放棄的專輯重新取得封面和發行日期。"
          }
        }
      }
    },
