    "Yearly renews automatically at %@/year until cancelled. Manage or cancel in your Apple Account settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jährlich verlängert sich automatisch für %@/Jahr, bis es gekündigt wird. Verwalten oder kündigen in den Einstellungen deines Apple Accounts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anual se renueva automáticamente por %@/año hasta que lo canceles. Gestiónalo o cancélalo en los ajustes de tu Cuenta de Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuel se renouvelle automatiquement à %@/an jusqu’à résiliation. Gérez ou résiliez dans les réglages de votre compte Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuale si rinnova automaticamente a %@/anno fino alla disdetta. Gestisci o disdici nelle impostazioni del tuo Account Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "年額プランは解約するまで年額%@で自動更新されます。Appleアカウントの設定で管理・解約できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연간 플랜은 해지할 때까지 연 %@로 자동 갱신됩니다. Apple 계정 설정에서 관리하거나 해지할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Subskrypcja roczna odnawia się automatycznie za %@/rok do momentu anulowania. Zarządzaj lub anuluj w ustawieniach swojego konta Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anual renova automaticamente por %@/ano até ser cancelado. Gerencie ou cancele nos ajustes da sua Conta Apple."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "年度订阅将以每年 %@ 自动续订，直至取消。可在 Apple 账户设置中管理或取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "年度訂閱將以每年 %@ 自動續訂，直到取消為止。可在 Apple 帳戶設定中管理或取消。"
          }
        }
      }
    },
