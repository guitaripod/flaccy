    },
    "This plan isn't available in your country or region.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette abonnement er ikke tilgængeligt i dit land eller din region."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Tarif ist in deinem Land oder deiner Region nicht verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
