    "A yearly Year in Music drop is always scheduled for December 1st while notifications are on.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En årlig udgivelse af Årets musik er altid planlagt til 1. december, så længe notifikationer er slået til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange Mitteilungen aktiv sind, kommt dein Musikjahr immer am 1. Dezember."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras las notificaciones estén activadas, tu Año en música llega siempre el 1 de diciembre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuosittainen Vuosi musiikissa -julkaisu on aina ajastettu joulukuun 1. päivälle, kun ilmoitukset ovat päällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que les notifications sont activées, votre Année en musique arrive toujours le 1er décembre."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tónlistarárið þitt kemur alltaf 1. desember á meðan tilkynningar eru kveiktar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finché le notifiche sono attive, il tuo Anno in musica arriva sempre il 1° dicembre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知がオンの間、音楽の1年は毎年12月1日に届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 켜져 있는 동안 음악 결산은 매년 12월 1일에 도착합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Så lenge varsler er på, er Musikkåret alltid planlagt til 1. desember."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowa edycja Roku w muzyce pojawia się co roku 1 grudnia, dopóki powiadomienia są włączone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto as notificações estiverem ativadas, seu Ano em música chega sempre em 1º de dezembro."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En årlig Year in Music-leverans schemaläggs alltid den 1 december när notiser är på."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只要通知保持开启，年度音乐总会在 12 月 1 日送达。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只要通知保持開啟，年度音樂一律會在 12 月 1 日送達。"
          }
        }
      }
    },
