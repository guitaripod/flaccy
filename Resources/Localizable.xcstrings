    "Zoom the whole window. ⌘= and ⌘- work anywhere; ⌘0 returns to actual size.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoom hele vinduet. ⌘= og ⌘- virker overalt; ⌘0 går tilbage til den faktiske størrelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Skaliere das gesamte Fenster. ⌘= und ⌘- funktionieren überall; ⌘0 kehrt zur Originalgröße zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escala toda la ventana. ⌘= y ⌘- funcionan en cualquier lugar; ⌘0 vuelve al tamaño real."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoomaa koko ikkunaa. ⌘= ja ⌘- toimivat kaikkialla; ⌘0 palauttaa todelliseen kokoon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustez le zoom de toute la fenêtre. ⌘= et ⌘- fonctionnent partout ; ⌘0 revient à la taille réelle."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Stækkaðu eða minnkaðu allan gluggann. ⌘= og ⌘- virka alls staðar; ⌘0 fer aftur í upprunalega stærð."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scala l'intera finestra. ⌘= e ⌘- funzionano ovunque; ⌘0 torna alle dimensioni reali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウ全体を拡大縮小できます。⌘=と⌘-はどこでも使え、⌘0で実際のサイズに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우 전체를 확대/축소하세요. ⌘=와 ⌘-는 어디서나 작동하며, ⌘0으로 실제 크기로 돌아갑니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoom hele vinduet. ⌘= og ⌘- fungerer overalt; ⌘0 går tilbake til faktisk størrelse."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiększa całe okno. ⌘= i ⌘- działają wszędzie; ⌘0 przywraca rzeczywisty rozmiar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste o tamanho da janela inteira. ⌘= e ⌘- funcionam em qualquer lugar; ⌘0 retorna ao tamanho real."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Zooma hela fönstret. ⌘= och ⌘- fungerar överallt. ⌘0 återgår till faktisk storlek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缩放整个窗口。⌘= 和 ⌘- 在任何位置都能使用；⌘0 恢复到实际大小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "縮放整個視窗。⌘= 和 ⌘- 在任何位置都能使用；⌘0 恢復到實際大小。"
          }
        }
      }
    },
