    "Wi-Fi Transfer couldn't start. Close this screen and open it again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi-overførsel kunne ikke starte. Luk denne skærm, og åbn den igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die WLAN-Übertragung konnte nicht starten. Schließe diesen Bildschirm und öffne ihn erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transferencia por Wi-Fi no pudo iniciarse. Cierra esta pantalla y vuelve a abrirla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi-siirron käynnistys epäonnistui. Sulje tämä näyttö ja avaa se uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le transfert Wi-Fi n'a pas pu démarrer. Fermez cet écran et rouvrez-le."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi Transfer gat ekki hafist. Lokaðu þennan skjá og opnaðu hann aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il trasferimento Wi-Fi non è partito. Chiudi questa schermata e riaprila."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi転送を開始できませんでした。この画面を閉じて、もう一度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi 전송을 시작할 수 없습니다. 이 화면을 닫고 다시 여세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi-overføring kunne ikke starte. Lukk denne skjermen og åpne den igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się uruchomić przesyłania przez Wi-Fi. Zamknij ten ekran i otwórz go ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transferência por Wi-Fi não pôde começar. Feche esta tela e abra de novo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi-överföringen kunde inte starta. Stäng den här skärmen och öppna den igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启动 Wi-Fi 传输。请关闭此页面后重新打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法啟動 Wi-Fi 傳送。請關閉此畫面後重新開啟。"
          }
        }
      }
    },
