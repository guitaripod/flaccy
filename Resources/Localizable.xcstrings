    "This is the name %@ shows for this device.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er det navn, %@ viser for denne enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Name wird von %@ für dieses Gerät angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the name %@ shows for this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este es el nombre que muestra %@ para este dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä on nimi, jonka %@ näyttää tälle laitteelle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est le nom affiché par %@ pour cet appareil."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þetta er nafnið sem %@ sýnir fyrir þetta tæki."
          }
