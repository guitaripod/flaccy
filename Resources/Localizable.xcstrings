    "Swipe left or right with two fingers to change track": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stryg to fingre til venstre eller højre for at skifte sang"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit zwei Fingern nach links oder rechts streichen, um den Titel zu wechseln"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza con dos dedos a izquierda o derecha para cambiar de pista"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyyhkäise kahdella sormella vasemmalle tai oikealle vaihtaaksesi kappaletta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez à deux doigts vers la gauche ou la droite pour changer de morceau"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Strjúktu til vinstri eða hægri með tveimur fingrum til að skipta um lag"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri a sinistra o a destra con due dita per cambiare brano"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2本指で左右にスワイプすると曲を切り替えられます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 손가락으로 좌우로 쓸어 트랙을 바꿀 수 있습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveip med to fingre til venstre eller høyre for å bytte sang"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń dwoma palcami w lewo lub w prawo, aby zmienić utwór"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize com dois dedos para a esquerda ou a direita para trocar de faixa"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svep åt vänster eller höger med två fingrar för att byta låt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用两根手指左右轻扫可切换曲目"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用兩指左右滑動可切換曲目"
          }
        }
      }
    },
