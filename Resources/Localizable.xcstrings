    "Your %lld-day free trial starts the first time you play your own music.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine %lld-tägige kostenlose Testphase beginnt, wenn du zum ersten Mal deine eigene Musik abspielst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu prueba gratuita de %lld días empieza la primera vez que reproduces tu propia música."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre essai gratuit de %lld jours commence la première fois que vous lisez votre propre musique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua prova gratuita di %lld giorni inizia la prima volta che riproduci la tua propria musica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の音楽を初めて再生すると、%lld日間の無料トライアルが始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자신의 음악을 처음 재생하면 %lld일 무료 체험이 시작됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój %lld-dniowy bezpłatny okres próbny zaczyna się, gdy po raz pierwszy odtworzysz własną muzykę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu teste gratuito de %lld dias começa na primeira vez que você tocar sua própria música."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一次播放你自己的音乐时，%lld 天免费试用就会开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第一次播放你自己的音樂時，%lld 天免費試用就會開始。"
          }
        }
      }
    },
