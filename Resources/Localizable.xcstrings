    "Offline. %lld changes will send when %@ is reachable.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline. %1$#@arg1@ sendes, når %2$@ kan nås."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline. Ausstehende Änderungen: %lld. Sie werden gesendet, sobald %@ erreichbar ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline. %1$#@arg1@ will send when %2$@ is reachable."
          },
          "substitutions": {
            "arg1": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg change"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg changes"
                    }
                  }
                }
              }
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión. Cambios pendientes: %lld. Se enviarán cuando %@ esté disponible."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline. %1$#@arg1@ lähetetään, kun %2$@ on tavoitettavissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hors ligne. Modifications en attente : %lld. Elles seront envoyées dès que %@ sera joignable."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Án nettengingar. %1$#@arg1@ í bið þar til hægt er að ná sambandi við %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline. Modifiche in attesa: %lld. Verranno inviate quando %@ sarà raggiungibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインです。%@ に接続できるようになると、%lld 件の変更が送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인이에요. %@에 연결되면 변경 사항 %lld개가 전송돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Frakoblet. %1$#@arg1@ vil bli sendt når %2$@ er tilgjengelig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline. Oczekujące zmiany: %lld. Zostaną wysłane, gdy %@ będzie osiągalny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline. Alterações pendentes: %lld. Serão enviadas quando %@ estiver acessível."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline. %1$#@arg1@ skickas när %2$@ går att nå."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线。%@ 可连接后，将发送 %lld 项更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "離線。%@ 可連線後，將傳送 %lld 項變更。"
          }
        }
      }
    },
