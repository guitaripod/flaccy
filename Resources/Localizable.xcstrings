          }
        }
      }
    },
    "Plays this song louder or quieter on every Flaccy you sync with your Flaccy Server. A raised song is held back from clipping.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afspiller denne sang højere eller lavere på hver Flaccy, du synkroniserer med din Flaccy Server. En hævet sang holdes væk fra at klippe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielt diesen Song auf jedem Flaccy, das du mit deinem Flaccy Server synchronisierst, lauter oder leiser. Ein angehobener Song wird vor dem Übersteuern bewahrt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce esta canción más alta o más baja en cada Flaccy que sincronices con tu Flaccy Server. Una canción subida se protege para que no sature."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toistaa tämän kappaleen kovempana tai hiljaisempana jokaisessa Flaccyssa, jonka synkronoit Flaccy Serverin kanssa.Korotettua kappaletta rajoitetaan, ettei se leikkaudu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue ce morceau plus fort ou moins fort sur chaque Flaccy synchronisé avec votre Flaccy Server. Un morceau rehaussé est protégé de la saturation."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Spilar þetta lag hærra eða lægra á hverju Flaccy sem þú samstillir við Flaccy Server. Hækkað lag er takmarkað svo það klippist ekki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduce questo brano più forte o più piano su ogni Flaccy che sincronizzi con il tuo Flaccy Server. Un brano alzato viene protetto dalla saturazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy Server と同期しているすべての Flaccy で、この曲を大きく、または小さく再生します。上げた曲は音割れしないように抑えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy Server와 동기화하는 모든 Flaccy에서 이 곡을 더 크게 또는 더 작게 재생합니다. 키운 곡은 소리가 깨지지 않도록 제한됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiller av denne sangen høyere eller lavere på hver Flaccy du synkroniserer med Flaccy Server. En hevet sang holdes tilbake for å unngå klipping."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwarza ten utwór głośniej lub ciszej w każdym Flaccy synchronizowanym z Twoim Flaccy Server. Podgłośniony utwór jest chroniony przed przesterowaniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca esta música mais alta ou mais baixa em todo Flaccy que você sincroniza com seu Flaccy Server. Uma música aumentada é protegida contra distorção."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spelar den här låten högre eller lägre på varje Flaccy du synkroniserar med din Flaccy Server. En höjd låt hålls tillbaka så den inte klipper."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在与你的 Flaccy Server 同步的每个 Flaccy 上，以更大或更小的音量播放这首歌曲。调高的歌曲会被限制，避免削波失真。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在與你的 Flaccy Server 同步的每個 Flaccy 上，以更大或更小的音量播放這首歌曲。調高的歌曲會受到限制，避免削波失真。"
          }
        }
      }
    },
