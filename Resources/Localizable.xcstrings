    "Each song stays in the playlist once, at its first position. Your files are not deleted.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Song bleibt nur einmal in der Playlist, an seiner ersten Position. Deine Dateien werden nicht gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each song stays in the playlist once, at its first position. Your files are not deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada canción aparece una vez en la lista, en su primera posición. Tus archivos no se eliminan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque morceau reste une fois dans la playlist, à sa première position. Tes fichiers ne sont pas supprimés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni brano resta nella playlist una sola volta, nella sua prima posizione. I tuoi file non vengono eliminati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各曲はプレイリストに1回だけ、最初の位置に残ります。ファイルは削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 곡은 플레이리스트에 한 번만, 처음 위치에 남습니다. 파일은 삭제되지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy utwór pozostaje na playliście raz, na swojej pierwszej pozycji. Twoje pliki nie zostaną usunięte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada música fica na playlist uma vez, na primeira posição. Seus arquivos não são apagados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每首歌在播放列表中只保留一次，位于其首次出现的位置。你的文件不会被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每首歌在播放清單中只保留一次，位於其首次出現的位置。你的檔案不會被刪除。"
          }
        }
      }
    },
