            "value": "オーディオファイルはゴミ箱に移動し、ライブラリから削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오 파일은 휴지통으로 이동하고 보관함에서 제거됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lydfilene flyttes til Papirkurven og fjernes fra biblioteket ditt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki audio zostaną przeniesione do Kosza i usunięte z twojej biblioteki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
