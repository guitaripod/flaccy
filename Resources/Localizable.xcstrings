          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij węzeł · przewiń nad nim, aby zmienić Q · kliknij dwukrotnie pusty obszar, aby dodać pasmo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste um nó · role sobre ele para mudar Q · clique duas vezes em espaço vazio para adicionar uma banda"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
