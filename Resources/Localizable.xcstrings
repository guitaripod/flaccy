    "Drag a point, or type a value. The curve passes through every point.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk et punkt, eller skriv en værdi. Kurven går gennem hvert punkt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Punkt ziehen oder einen Wert eingeben. Die Kurve verläuft durch jeden Punkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra un punto o escribe un valor. La curva pasa por todos los puntos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedä pistettä tai kirjoita arvo. Käyrä kulkee jokaisen pisteen kautta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser un point ou saisissez une valeur. La courbe passe par chaque point."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Dragðu punkt eða sláðu inn gildi. Ferillinn fer í gegnum alla punkta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina un punto o digita un valore. La curva passa per ogni punto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポイントをドラッグするか、値を入力してください。カーブはすべてのポイントを通ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "점을 드래그하거나 값을 입력하세요. 곡선은 모든 점을 지납니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra et punkt, eller skriv inn en verdi. Kurven går gjennom hvert punkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij punkt lub wpisz wartość. Krzywa przechodzi przez każdy punkt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste um ponto ou digite um valor. A curva passa por todos os pontos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra en punkt eller skriv ett värde. Kurvan går genom varje punkt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动控制点或输入数值。曲线会经过每一个控制点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移控制點或輸入數值。曲線會經過每一個控制點。"
          }
        }
      }
    },
    "Drag rows to reorder · right-click to remove": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk rækker for at sortere · højreklik for at fjerne"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeilen zum Sortieren ziehen · mit rechts klicken zum Entfernen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra las filas para reordenar · clic derecho para quitar"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedä rivejä järjestääksesi uudelleen · napsauta oikealla painikkeella poistaaksesi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser les lignes pour les réordonner · clic droit pour supprimer"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Dragðu raðir til að raða · hægrismelltu til að fjarlægja"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina le righe per riordinare · clic destro per rimuovere"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行をドラッグして並べ替え · 右クリックで削除"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "행을 끌어서 순서 변경 · 우클릭으로 제거"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra rader for å endre rekkefølgen · høyreklikk for å fjerne"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij wiersze, by zmienić kolejność · kliknij prawym, by usunąć"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste as linhas para reordenar · clique com o botão direito para remover"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra rader för att ändra ordning · högerklicka för att ta bort"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动行以重新排序 · 右键点按即可移除"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移列以重新排序 · 按右鍵即可移除"
          }
        }
      }
    },
    "Drag to reorder. Turn a section off to hide it; it stays here for when you want it back.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk for at sortere. Slå et afsnit fra for at skjule det; det bliver her, indtil du vil have det tilbage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Sortieren ziehen. Schalte einen Bereich aus, um ihn auszublenden; er bleibt hier, bis du ihn wieder brauchst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para reordenar. Desactiva una sección para ocultarla; seguirá aquí por si la quieres de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedä järjestääksesi uudelleen. Kytke osio pois päältä piilottaaksesi sen; se säilyy tässä, kun haluat sen takaisin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glissez pour réorganiser. Désactivez une section pour la masquer ; elle reste ici si vous voulez la retrouver."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Dragðu til að raða. Slökktu á hluta til að fela hann; hann verður hér þegar þú vilt fá hann aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per riordinare. Disattiva una sezione per nasconderla; resterà qui se vorrai riattivarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグで並べ替えます。セクションをオフにすると非表示になりますが、ここに残るので後から戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끌어서 순서를 바꾸세요. 섹션을 끄면 숨겨지지만, 다시 필요할 때를 위해 여기에 남아 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra for å endre rekkefølgen. Slå av en seksjon for å skjule den; den blir her til du trenger den igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij, aby zmienić kolejność. Wyłącz sekcję, aby ją ukryć; pozostanie tu, gdy będzie potrzebna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para reordenar. Desative uma seção para ocultá-la; ela fica aqui para quando você quiser de volta."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra för att ändra ordning. Stäng av en sektion för att dölja den; den finns kvar här om du vill ha tillbaka den."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以重新排序。关闭某个分区即可将其隐藏；它会保留在这里，方便你随时重新开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移以重新排序。關閉某個區段即可隱藏；它會保留在這裡，方便你隨時找回。"
          }
        }
      }
    },
    "Drag to reposition, scroll to zoom, use the arrow keys to nudge": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk for at flytte, rul for at zoome, brug piletasterne til at finjustere"
