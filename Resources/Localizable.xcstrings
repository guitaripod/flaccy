    "Put your music in iCloud Drive, or connect to a server in the Files app. Then tap Add Music and pick it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege deine Musik in iCloud Drive ab oder verbinde dich in der App „Dateien“ mit einem Server. Tippe dann auf „Musik hinzufügen“ und wähle sie aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda tu música en iCloud Drive o conéctate a un servidor en la app Archivos. Después toca Añadir música y selecciónala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez votre musique dans iCloud Drive ou connectez-vous à un serveur dans l'app Fichiers. Touchez ensuite Ajouter de la musique et choisissez-la."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti la tua musica in iCloud Drive oppure collegati a un server nell'app File. Poi tocca Aggiungi musica e selezionala."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音楽をiCloud Driveに置くか、ファイルAppでサーバに接続します。そのあと「音楽を追加」をタップして選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악을 iCloud Drive에 넣거나 파일 앱에서 서버에 연결하세요. 그런 다음 음악 추가를 탭하고 선택하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Umieść muzykę w iCloud Drive albo połącz się z serwerem w aplikacji Pliki. Potem dotknij Dodaj muzykę i wybierz pliki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque suas músicas no iCloud Drive ou conecte-se a um servidor no app Arquivos. Depois toque em Adicionar música e escolha-as."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把音乐放进 iCloud Drive，或在“文件”App 中连接服务器。然后点按“添加音乐”并选取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把音樂放進 iCloud Drive，或在「檔案」App 中連接伺服器。然後點一下「加入音樂」並選取。"
          }
        }
      }
    },
