    "Your playlists, loves and history now sync with this server. Its music is in your library under Servers.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine playlister, synes godt om og din historik synkroniseres nu med denne server. Dens musik findes i dit bibliotek under Servere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Playlists, Favoriten und Verlauf werden jetzt mit diesem Server synchronisiert. Seine Musik ist in der Mediathek unter Server zu finden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your playlists, loves and history now sync with this server. Its music is in your library under Servers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus playlists, favoritas e historial ahora se sincronizan con este servidor. Su música está en tu biblioteca, en Servidores."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Soittolistasi, tykkäyksesi ja historiasi synkronoidaan nyt tämän palvelimen kanssa. Sen musiikki löytyy mediatekasi kohdasta Palvelimet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos playlists, morceaux aimés et historique se synchronisent désormais avec ce serveur. Sa musique se trouve dans votre bibliothèque, sous Serveurs."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Spilunarlistarnir þínir, líkar og ferill samstillast nú við þennan netþjón. Tónlist hans er í safninu þínu undir Netþjónum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue playlist, i preferiti e la cronologia ora si sincronizzano con questo server. La sua musica è nella tua libreria, in Server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレイリスト、お気に入り、履歴がこのサーバーと同期されるようになりました。その音楽はライブラリの「サーバー」の項目にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생목록, 좋아요, 기록이 이제 이 서버와 동기화돼요. 음악은 보관함의 서버 항목에 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spillelister, likte sanger og lyttehistorikk synkroniseres nå med denne serveren. Musikken fra serveren finnes i biblioteket ditt under Servere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje playlisty, ulubione i historia są teraz synchronizowane z tym serwerem. Jego muzyka jest w bibliotece, w sekcji Serwery."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas playlists, curtidas e histórico agora sincronizam com este servidor. A música dele está na sua biblioteca, em Servidores."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina spellistor, gillade låtar och din historik synkas nu med den här servern. Dess musik finns i ditt bibliotek under Servrar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的播放列表、喜欢和记录现在与此服务器同步。其音乐位于资料库的“服务器”下。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的播放列表、喜愛和記錄現在與此伺服器同步。其音樂位於資料庫的「伺服器」下。"
          }
        }
      }
    },
    "Your playlists, loves and history now sync with this server. Its music will be added to your library the next time you open Flaccy.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine playlister, synes godt om og din historik synkroniseres nu med denne server. Dens musik føjes til dit bibliotek, næste gang du åbner Flaccy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Playlists, Favoriten und Verlauf werden jetzt mit diesem Server synchronisiert. Seine Musik wird beim nächsten Öffnen von Flaccy zur Mediathek hinzugefügt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your playlists, loves and history now sync with this server. Its music will be added to your library the next time you open Flaccy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus playlists, favoritas e historial ahora se sincronizan con este servidor. Su música se añadirá a tu biblioteca la próxima vez que abras Flaccy."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Soittolistasi, tykkäyksesi ja historiasi synkronoidaan nyt tämän palvelimen kanssa. Sen musiikki lisätään mediatekaasi, kun avaat Flaccyn seuraavan kerran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos playlists, morceaux aimés et historique se synchronisent désormais avec ce serveur. Sa musique sera ajoutée à votre bibliothèque la prochaine fois que vous ouvrirez Flaccy."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Spilunarlistarnir þínir, líkar og ferill samstillast nú við þennan netþjón. Tónlist hans verður bætt í safnið þitt næst þegar þú opnar Flaccy."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue playlist, i preferiti e la cronologia ora si sincronizzano con questo server. La sua musica verrà aggiunta alla tua libreria la prossima volta che apri Flaccy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレイリスト、お気に入り、履歴がこのサーバーと同期されるようになりました。次回 Flaccy を開いたときに、その音楽がライブラリに追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생목록, 좋아요, 기록이 이제 이 서버와 동기화돼요. 다음에 Flaccy를 열 때 음악이 보관함에 추가될 거예요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spillelister, likte sanger og lyttehistorikk synkroniseres nå med denne serveren. Musikken fra serveren legges til i biblioteket neste gang du åpner Flaccy."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje playlisty, ulubione i historia są teraz synchronizowane z tym serwerem. Jego muzyka zostanie dodana do biblioteki przy następnym otwarciu Flaccy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas playlists, curtidas e histórico agora sincronizam com este servidor. A música dele será adicionada à sua biblioteca na próxima vez que você abrir o Flaccy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina spellistor, gillade låtar och din historik synkas nu med den här servern. Dess musik läggs till i ditt bibliotek nästa gång du öppnar Flaccy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的播放列表、喜欢和记录现在与此服务器同步。下次打开 Flaccy 时，其音乐将添加到你的资料库中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的播放列表、喜愛和記錄現在與此伺服器同步。下次開啟 Flaccy 時，其音樂將新增到你的資料庫中。"
          }
        }
      }
    },
    "Your purchase is awaiting approval. Playback unlocks automatically once it completes.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit køb venter på godkendelse. Afspilningen låses op automatisk, når det er gennemført."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kauf wartet auf Freigabe. Die Wiedergabe wird automatisch freigeschaltet, sobald er abgeschlossen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compra está pendiente de aprobación. La reproducción se desbloqueará automáticamente en cuanto se complete."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostosi odottaa hyväksyntää. Toisto avautuu automaattisesti, kun ostos on valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre achat est en attente d'approbation. La lecture se débloquera automatiquement une fois terminé."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaupið þitt bíður samþykkis. Spilun opnast sjálfkrafa þegar því lýkur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo acquisto è in attesa di approvazione. La riproduzione si sbloccherà da sola quando sarà completato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入の承認待ちです。完了すると再生は自動的にアンロックされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구입이 승인 대기 중입니다. 완료되면 재생이 자동으로 잠금 해제됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjøpet ditt venter på godkjenning. Avspillingen låses opp automatisk når det er fullført."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój zakup oczekuje na zatwierdzenie. Odtwarzanie odblokuje się automatycznie po jego zakończeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua compra está aguardando aprovação. A reprodução será liberada automaticamente assim que ela for concluída."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt köp väntar på godkännande. Uppspelningen låses upp automatiskt när det är klart."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的购买正在等待批准。完成后播放会自动解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的購買正在等待核准。完成後播放會自動解鎖。"
          }
        }
      }
    },
    "Your story is just getting started.": {
      "localizations": {
        "da": {
          "stringUnit": {
