    "Delete “%@” (%@) from your Apple Watch?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ (%2$@) von deiner Apple Watch löschen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Delete “%1$@” (%2$@) from your Apple Watch?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar “%1$@” (%2$@) de tu Apple Watch?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer « %1$@ » (%2$@) de votre Apple Watch ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare “%1$@” (%2$@) dal tuo Apple Watch?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」（%2$@）をApple Watchから削除しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”(%2$@)을(를) Apple Watch에서 삭제할까요?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć „%1$@” (%2$@) z Apple Watch?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar “%1$@” (%2$@) do seu Apple Watch?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要从 Apple Watch 中删除“%1$@”（%2$@）吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要從 Apple Watch 刪除「%1$@」（%2$@）嗎？"
          }
        }
      }
    },
