    "A code works once and lasts 10 minutes. Make a new one on %@ and try again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En kode virker én gang og gælder i 10 minutter. Opret en ny på %@, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Code funktioniert nur einmal und gilt 10 Minuten. Erstelle auf %@ einen neuen und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A code works once and lasts 10 minutes. Make a new one on %@ and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un código funciona una sola vez y dura 10 minutos. Genera uno nuevo en %@ y vuelve a intentarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koodi toimii kerran ja vanhenee 10 minuutin kuluttua. Luo uusi koodi %@:llä ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un code ne fonctionne qu’une fois et reste valable 10 minutes. Crée-en un nouveau sur %@ et réessaie."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Kóði virkar einu sinni og gildir í 10 mínútur. Búðu til nýjan á %@ og reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un codice funziona una sola volta e dura 10 minuti. Creane uno nuovo su %@ e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードは1回だけ使え、有効期限は10分です。%@ で新しいコードを作成して、もう一度試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드는 한 번만 사용할 수 있으며 10분 동안 유효합니다. %@에서 새 코드를 만든 뒤 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En kode fungerer én gang og varer i 10 minutter. Lag en ny på %@ og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod działa tylko raz i jest ważny przez 10 minut. Wygeneruj nowy na %@ i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um código funciona uma única vez e vale por 10 minutos. Gere um novo em %@ e tente de novo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En kod fungerar bara en gång och gäller i 10 minuter. Skapa en ny på %@ och försök igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代码只能使用一次，有效期为 10 分钟。请在 %@ 上生成新代码，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代碼只能使用一次，有效期為 10 分鐘。請在 %@ 上產生新代碼，然後重試。"
          }
        }
      }
    },
    "A device needs a name. Type one and try again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En enhed skal have et navn. Skriv et og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Gerät braucht einen Namen. Namen eingeben und erneut versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A device needs a name. Type one and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositivo necesita un nombre. Escribe uno y vuelve a intentarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laitteelle on annettava nimi. Kirjoita nimi ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un appareil doit avoir un nom. Saisissez-en un et réessayez."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tæki þarf nafn. Sláðu inn nafn og reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dispositivo deve avere un nome. Inserisci un nome e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスには名前が必要です。名前を入力して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 이름이 필요해요. 이름을 입력하고 다시 시도해 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En enhet trenger et navn. Skriv inn et og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Urządzenie musi mieć nazwę. Wpisz ją i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dispositivo precisa de um nome. Digite um e tente de novo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En enhet behöver ett namn. Skriv ett och försök igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备需要一个名称。请输入名称后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置需要一個名稱。請輸入名稱後再試一次。"
          }
        }
      }
    },
