    "Scan this code with the camera in Flaccy on your iPhone or iPad. On another Mac or a Linux computer, paste the link into Add Flaccy Server.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan denne kode med kameraet i Flaccy på din iPhone eller iPad. På en anden Mac eller en Linux-computer indsætter du linket i »Tilføj Flaccy Server«."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne diesen Code mit der Kamera in Flaccy auf deinem iPhone oder iPad. Auf einem anderen Mac oder einem Linux-Computer fügst du den Link in „Flaccy Server hinzufügen“ ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan this code with the camera in Flaccy on your iPhone or iPad. On another Mac or a Linux computer, paste the link into Add Flaccy Server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea este código con la cámara de Flaccy en tu iPhone o iPad. En otro Mac o en un ordenador Linux, pega el enlace en «Añadir Flaccy Server»."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Skannaa tämä koodi iPhonessasi tai iPadissasi olevalla Flaccyn kameralla. Toisella Macilla tai Linux-tietokoneella liitä linkki kohtaan ”Lisää Flaccy-palvelin”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez ce code avec l’appareil photo de Flaccy sur votre iPhone ou iPad. Sur un autre Mac ou un ordinateur Linux, collez le lien dans « Ajouter Flaccy Server »."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skannaðu þennan kóða með myndavélinni í Flaccy á iPhone eða iPad. Á annarri Mac-tölvu eða Linux-tölvu skaltu líma hlekkinn í „Bæta við Flaccy-netþjóni“."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona questo codice con la fotocamera di Flaccy sul tuo iPhone o iPad. Su un altro Mac o un computer Linux, incolla il link in «Aggiungi Flaccy Server»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone または iPad の Flaccy のカメラでこのコードをスキャンしてください。別の Mac や Linux コンピュータでは、リンクを「Flaccy Server を追加」に貼り付けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone이나 iPad의 Flaccy 카메라로 이 코드를 스캔하세요. 다른 Mac이나 Linux 컴퓨터에서는 링크를 “Flaccy Server 추가”에 붙여넣으세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skann denne koden med kameraet i Flaccy på iPhonen eller iPaden din. På en annen Mac eller en Linux-datamaskin limer du lenken inn i «Legg til Flaccy-server»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeskanuj ten kod aparatem w Flaccy na iPhonie lub iPadzie. Na innym Macu lub komputerze z Linuksem wklej link w polu „Dodaj Flaccy Server”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie este código com a câmera do Flaccy no seu iPhone ou iPad. Em outro Mac ou em um computador Linux, cole o link em “Adicionar Flaccy Server”."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanna den här koden med kameran i Flaccy på din iPhone eller iPad. På en annan Mac eller en Linux-dator klistrar du in länken i ”Lägg till Flaccy-server”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请用 iPhone 或 iPad 上的 Flaccy 相机扫描此二维码。在其他 Mac 或 Linux 电脑上，请将链接粘贴到“添加 Flaccy Server”中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請用 iPhone 或 iPad 上的 Flaccy 相機掃描此 QR Code。在其他 Mac 或 Linux 電腦上，請將連結貼到「新增 Flaccy Server」中。"
          }
        }
      }
    },
    "Scanning your files for audio": {
      "localizations": {
        "da": {
