    "%@ refused the API key. Create a new key in the server’s settings and try again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ afviste API-nøglen. Opret en ny nøgle i serverens indstillinger, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat den API-Schlüssel abgelehnt. Erstelle in den Servereinstellungen einen neuen Schlüssel und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ rechazó la clave de API. Crea una clave nueva en los ajustes del servidor y vuelve a intentarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hylkäsi API-avaimen. Luo palvelimen asetuksista uusi avain ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a refusé la clé d’API. Crée une nouvelle clé dans les réglages du serveur, puis réessaie."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hafnaði API-lyklinum. Búðu til nýjan lykil í stillingum netþjónsins og reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha rifiutato la chiave API. Crea una nuova chiave nelle impostazioni del server e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が API キーを受け付けませんでした。サーバーの設定で新しいキーを作成して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 API 키를 거부했습니다. 서버 설정에서 새 키를 만든 뒤 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ avviste API-nøkkelen. Opprett en ny nøkkel i serverens innstillinger og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ odrzucił klucz API. Utwórz nowy klucz w ustawieniach serwera i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ recusou a chave de API. Crie uma nova chave nas configurações do servidor e tente novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ avvisade API-nyckeln. Skapa en ny nyckel i serverns inställningar och försök igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 拒绝了 API 密钥。请在服务器设置中创建新密钥，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 拒絕了 API 金鑰。請在伺服器設定中建立新金鑰，然後再試一次。"
          }
        }
      }
    },
    "%@ refused the username or password. Check both and try again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ afviste brugernavnet eller adgangskoden. Kontrollér begge, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat den Benutzernamen oder das Passwort abgelehnt. Prüfe beides und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ rechazó el nombre de usuario o la contraseña. Revisa ambos y vuelve a intentarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hylkäsi käyttäjätunnuksen tai salasanan. Tarkista molemmat ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a refusé le nom d’utilisateur ou le mot de passe. Vérifie les deux, puis réessaie."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hafnaði notandanafninu eða lykilorðinu. Athugaðu bæði og reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha rifiutato il nome utente o la password. Controlla entrambi e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ がユーザー名またはパスワードを受け付けませんでした。両方を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 사용자 이름 또는 비밀번호를 거부했습니다. 둘 다 확인한 뒤 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ avviste brukernavnet eller passordet. Kontroller begge og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ odrzucił nazwę użytkownika lub hasło. Sprawdź oba i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ recusou o nome de usuário ou a senha. Confira os dois e tente novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ avvisade användarnamnet eller lösenordet. Kontrollera båda och försök igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 拒绝了用户名或密码。请检查两者后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 拒絕了使用者名稱或密碼。請檢查兩者後再試一次。"
          }
        }
      }
    },
