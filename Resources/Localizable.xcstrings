    "Tap the zip in the Files app to unzip it, then choose the folder it makes.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på zip-filen i appen Filer for at pakke den ud, og vælg derefter den mappe, der oprettes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe die ZIP-Datei in der Dateien-App an, um sie zu entpacken, und wähle dann den Ordner, der dabei entsteht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el ZIP en la app Archivos para descomprimirlo y luego elige la carpeta que se crea."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta zip-tiedostoa Tiedostot-sovelluksessa purkaaksesi sen ja valitse sen luoma kansio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez l’archive ZIP dans l’app Fichiers pour la décompresser, puis choisissez le dossier créé."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikkaðu á zip-skrána í Skrár-appinu til að afþjappa hana og veldu svo möppuna sem myndast."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca lo ZIP nell'app File per decomprimerlo, poi scegli la cartella che crea."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ファイル」アプリでZIPをタップして展開し、できたフォルダを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 앱에서 ZIP을 탭해 압축을 푼 뒤, 만들어진 폴더를 선택하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på zip-filen i Filer-appen for å pakke den ut, og velg deretter mappen som blir laget."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij ZIP w aplikacji Pliki, aby go rozpakować, a następnie wybierz powstały folder."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no ZIP no app Arquivos para descompactá-lo e depois escolha a pasta criada."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på zip-filen i appen Filer för att packa upp den och välj sedan mappen som skapas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“文件”App 中轻点 ZIP 将其解压，然后选择生成的文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「檔案」App 中輕點 ZIP 將其解壓縮，然後選擇產生的資料夾。"
          }
        }
      }
    },
