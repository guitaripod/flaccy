    "Add songs or whole folders from iCloud Drive, a USB drive, or a network share you've connected in the Files app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Titel oder ganze Ordner aus iCloud Drive, einem USB-Laufwerk oder einer Netzwerkfreigabe hinzu, die du in der App „Dateien“ verbunden hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade canciones o carpetas completas desde iCloud Drive, una unidad USB o un recurso compartido de red que has conectado en la app “Archivos”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des morceaux ou des dossiers entiers depuis iCloud Drive, un disque USB ou un partage réseau que vous avez connecté dans l'app « Fichiers »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi brani o intere cartelle da iCloud Drive, un'unità USB o una condivisione di rete che hai collegato nell'app “File”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive、USBドライブ、またはファイルAppで接続したネットワーク共有から、曲やフォルダごと追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive, USB 드라이브 또는 파일 앱에서 연결한 네트워크 공유 폴더에서 곡이나 폴더 전체를 추가하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodawaj utwory lub całe foldery z iCloud Drive, dysku USB albo udziału sieciowego połączonego w aplikacji Pliki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione músicas ou pastas inteiras do iCloud Drive, de uma unidade USB ou de um compartilhamento de rede conectado no app “Arquivos”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以从 iCloud Drive、U 盘，或你在“文件”App 中连接的网络共享，添加歌曲或整个文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以從 iCloud Drive、USB 隨身碟，或你在「檔案」App 中連接的網路共享，新增歌曲或整個資料夾。"
          }
        }
      }
    },
