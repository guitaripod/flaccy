    "Hide duplicate songs": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppelte Songs ausblenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide duplicate songs"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar canciones duplicadas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer les morceaux en double"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi brani duplicati"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重複した曲を非表示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중복 곡 숨기기"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukryj zduplikowane utwory"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar músicas duplicadas"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏重复歌曲"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏重複歌曲"
          }
        }
      }
    },
    "Hide duplicate songs lists a song once when it sits on several albums, such as a single and the album it came from. Press and hold a song to see every copy.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppelte Songs ausblenden zeigt einen Song nur einmal, wenn er auf mehreren Alben steht, zum Beispiel auf einer Single und dem Album, von dem sie stammt. Halte einen Song gedrückt, um alle Kopien zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide duplicate songs lists a song once when it sits on several albums, such as a single and the album it came from. Press and hold a song to see every copy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar canciones duplicadas muestra una canción una sola vez cuando aparece en varios álbumes, como un single y el álbum del que procede. Mantén pulsada una canción para ver todas sus copias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer les morceaux en double n'affiche un morceau qu'une fois lorsqu'il figure sur plusieurs albums, comme un single et l'album d'origine. Maintiens un morceau appuyé pour voir chaque copie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi brani duplicati mostra un brano una sola volta quando è presente in più album, ad esempio un singolo e l'album da cui proviene. Tieni premuto un brano per vedere tutte le copie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重複した曲を非表示にすると、シングルと元のアルバムのように複数のアルバムに入っている曲は1回だけ表示されます。曲を長押しするとすべてのコピーを確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중복 곡 숨기기를 켜면 싱글과 원본 앨범처럼 여러 앨범에 들어 있는 곡을 한 번만 표시합니다. 곡을 길게 눌러 모든 복사본을 확인하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukryj zduplikowane utwory wyświetla utwór tylko raz, gdy znajduje się na kilku albumach, na przykład na singlu i albumie, z którego pochodzi. Przytrzymaj utwór, aby zobaczyć wszystkie kopie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar músicas duplicadas lista uma música uma vez quando ela aparece em vários álbuns, como um single e o álbum de onde saiu. Mantenha uma música pressionada para ver todas as cópias."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“隐藏重复歌曲”会在一首歌同时出现在多张专辑中（例如单曲及其所属专辑）时只列出一次。长按歌曲可查看所有副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「隱藏重複歌曲」會在一首歌同時出現在多張專輯中（例如單曲及其所屬專輯）時只列出一次。長按歌曲可查看所有副本。"
          }
        }
      }
    },
