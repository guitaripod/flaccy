    "Group album editions (Deluxe, Remaster…) as one album": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Album-Editionen (Deluxe, Remaster…) als ein Album"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupar ediciones (Deluxe, Remaster…) como un álbum"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regrouper les éditions (Deluxe, Remaster…) en un album"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raggruppa le edizioni (Deluxe, Remaster…) come un unico album"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エディション（Deluxe、Remasterなど）を1つのアルバムにまとめます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에디션(디럭스, 리마스터 등)을 하나의 앨범으로 묶기"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grupuj edycje albumu (Deluxe, Remaster…) w jeden album"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupar edições (Deluxe, Remaster…) como um só álbum"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把各版本（豪华版、重制版…）合并为一张专辑"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把各種專輯版本（豪華版、重製版…）合併為一張專輯"
          }
        }
      }
    },
    "Group editions folds Deluxe, Remaster, and Explicit variants into one album and keeps a single best copy of each song.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Editionen gruppieren“ fasst Deluxe-, Remaster- und Explicit-Varianten zu einem Album zusammen und behält von jedem Titel die beste Kopie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupar ediciones funde las variantes Deluxe, Remaster y Explicit en un solo álbum y conserva la mejor copia de cada canción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le regroupement des éditions fond les variantes Deluxe, Remaster et Explicit en un seul album et ne garde que la meilleure copie de chaque morceau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il raggruppamento delle edizioni fonde le varianti Deluxe, Remaster ed Explicit in un solo album e tiene la copia migliore di ogni brano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エディションをまとめると、Deluxe版・Remaster版・Explicit版が1つのアルバムになり、各曲は最良のコピーだけが残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에디션 묶기는 디럭스, 리마스터, 익스플리싯 버전을 하나의 앨범으로 합치고 각 곡의 최상급 사본만 남깁니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grupowanie edycji łączy warianty Deluxe, Remaster i Explicit w jeden album i zachowuje jedną, najlepszą kopię każdego utworu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupar edições funde as versões Deluxe, Remaster e Explicit em um só álbum e mantém a melhor cópia de cada música."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合并版本会把豪华版、重制版和显式版合成一张专辑，每首歌只保留最佳的一份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "合併版本會把豪華版、重製版與 Explicit 版合成一張專輯，每首歌只保留最好的一份。"
          }
        }
      }
    },
