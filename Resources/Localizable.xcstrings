    "Time-synced lyrics that follow along as you listen.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidssynkroniserede sangtekster, der følger med, mens du lytter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitsynchrone Songtexte, die beim Hören mitlaufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Letras sincronizadas que avanzan mientras escuchas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoitetut sanoitukset, jotka seuraavat mukana kuunnellessasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des paroles synchronisées qui défilent au fil de l'écoute."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tímasamstilltir textar sem fylgja með meðan þú hlustar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Testi sincronizzati che scorrono mentre ascolti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "聴きながら追いかけられる、時間同期の歌詞。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "들으면서 함께 흐르는 시간 동기화 가사."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidssynkronisert sangtekst som følger med mens du lytter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst zsynchronizowany w czasie, podążający za tobą podczas słuchania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Letras sincronizadas que acompanham você enquanto ouve."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidssynkroniserade låttexter som följer med när du lyssnar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与音乐同步滚动的歌词，边听边跟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨著音樂同步捲動的歌詞，邊聽邊跟。"
          }
        }
      }
    },
