        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld曲は繰り返し失敗したため停止しました。再試行して再送できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld곡이 여러 번 시도 후 중단되었습니다. 다시 시도해서 보내세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld utworów zatrzymano po kilku próbach. Ponów, aby wysłać je ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld músicas pararam após tentativas repetidas. Tente novamente para reenviá-las."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
