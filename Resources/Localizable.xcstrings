        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pince para ampliar e arraste para reposicionar"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyp för att zooma och dra för att flytta"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "捏合缩放，拖动调整位置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "捏合縮放，拖移調整位置"
