    "No songs yet. Right-click any song and choose Add to Playlist.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen sange endnu. Højreklik på en sang, og vælg Tilføj til playliste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Titel. Klicke mit rechts auf einen Titel und wähle „Zur Playlist hinzufügen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay canciones. Haz clic derecho en cualquier canción y elige “Añadir a una playlist”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kappaleita ei ole vielä. Napsauta kappaletta hiiren kakkospainikkeella ja valitse Lisää soittolistaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun morceau pour l’instant. Faites un clic droit sur un morceau et choisissez « Ajouter à une playlist »."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Engin lög enn. Hægrismelltu á lag og veldu „Bæta við spilunarlista“."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun brano per ora. Fai clic destro su un brano e scegli “Aggiungi a playlist”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ曲がありません。曲を右クリックして「プレイリストに追加」を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 곡이 없습니다. 곡을 마우스 오른쪽 버튼으로 클릭하고 “재생목록에 추가”를 선택하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen sanger ennå. Høyreklikk på en sang og velg «Legg til i spilleliste»."
          }
