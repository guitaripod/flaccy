    "Add Tailscale to listen away from home.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj Tailscale, så du kan lytte, når du er væk hjemmefra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Tailscale hinzu, um auch unterwegs zu hören."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Tailscale to listen away from home."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade Tailscale para escuchar fuera de casa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää Tailscale, jotta voit kuunnella kotoa poissa ollessasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez Tailscale pour écouter loin de chez vous."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Bættu Tailscale við til að hlusta á ferðinni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi Tailscale per ascoltare fuori casa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外出先で聴くには Tailscale を追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외부에서 들으려면 Tailscale을 추가하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til Tailscale for å lytte utenfor hjemmet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj Tailscale, aby słuchać poza domem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione o Tailscale para ouvir fora de casa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till Tailscale för att lyssna när du inte är hemma."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 Tailscale 即可在外出时收听。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增 Tailscale 即可在外出時聆聽。"
          }
        }
      }
    },
