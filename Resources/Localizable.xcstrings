            "state": "translated",
            "value": "O Flaccy não consegue reproduzir arquivos %@, então este não foi adicionado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy kan inte spela %@-filer, så den här lades inte till."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 无法播放 %@ 文件，因此这一个未添加。"
