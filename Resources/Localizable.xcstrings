    "You do your best listening after dark.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du lytter bedst, når det er mørkt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hörst am besten, wenn es dunkel wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escuchas mejor cuando cae la noche."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Parhaiten kuuntelet pimeän tultua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous écoutez le mieux une fois la nuit tombée."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þú hlustar best þegar dimmir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai il meglio quando cala il buio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日が暮れてからが本領発揮です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해가 진 뒤에 가장 잘 듣습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du lytter best når det har blitt mørkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najlepiej słucha ci się po zmroku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ouve melhor depois que escurece."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du lyssnar bäst när det blir mörkt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "夜幕降临后，你才真正开始听歌。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "天黑之後，你才真正開始聽歌。"
          }
        }
      }
    },
