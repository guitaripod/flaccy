    "Seven days of listening, wrapped up and ready.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Syv dages lytning, samlet og klar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieben Tage Musik – zusammengefasst und bereit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siete días de música, resumidos y listos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seitsemän päivän kuuntelu, koottuna ja valmiina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sept jours d'écoute, résumés et prêts à partager."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjö dagar af hlustun, teknir saman og tilbúnir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sette giorni di ascolti, riassunti e pronti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "7日分の音楽を、まるごとまとめました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "7일 치 음악을 한눈에 정리했습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Syv dager med lytting, oppsummert og klare."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Siedem dni słuchania, podsumowane i gotowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sete dias de música, resumidos e prontos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sju dagars lyssnande, sammanfattat och redo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "七天的收听，已经打包好了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "七天的聆聽，已經打包好了。"
          }
        }
      }
    },
    "Shapes the sound with a response curve and presets": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Former lyden med en frekvenskurve og forindstillinger"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Formt den Klang mit einer Frequenzkurve und Voreinstellungen"
          }
