          "stringUnit": {
            "state": "translated",
            "value": "Nimeä soittolista näille %lld kappaleelle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nommez la playlist pour ces %lld morceaux."
