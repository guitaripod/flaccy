          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac용 Flaccy가 이제 Flaccy에 통합되었습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy for Mac er nå en del av Flaccy"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy na Maca jest teraz częścią Flaccy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Flaccy para Mac agora faz parte do Flaccy"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy för Mac ingår nu i Flaccy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 版 Flaccy 现已并入 Flaccy"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 版 Flaccy 現已併入 Flaccy"
          }
        }
      }
    },
    "Flaccy gave up on %@ albums — no source has them.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy har opgivet %@ album – ingen kilde har dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy hat bei %@ Alben aufgegeben – keine Quelle hat sie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy se ha rendido con %@ álbumes: ninguna fuente los tiene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy luopui albumeista: %@ – mikään lähde ei sisällä niitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy a renoncé pour %@ albums — aucune source ne les a."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy gafst upp á plötum %@ – engin heimild hefur þær."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy si è arreso con %@ album: nessuna fonte li ha."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 枚のアルバムはあきらめました。どのソースにもありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@개 앨범은 포기했습니다. 어떤 출처에도 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy ga opp %@-album – ingen kilde har dem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy zrezygnował z %@ albumów — żadne źródło ich nie ma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Flaccy desistiu de %@ álbuns — nenhuma fonte os tem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy gav upp %@ album – ingen källa har dem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 放弃了 %@ 张专辑——没有任何来源收录它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 放棄了 %@ 張專輯——沒有任何來源收錄它們。"
          }
        }
      }
    },
    "Flaccy indexes the folder in place — nothing is copied or moved. Files added to the folder appear automatically.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy indekserer mappen på stedet – intet kopieres eller flyttes. Nye filer i mappen vises automatisk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy indexiert den Ordner an Ort und Stelle – nichts wird kopiert oder verschoben. Neue Dateien im Ordner erscheinen automatisch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy indexa la carpeta donde está: no se copia ni se mueve nada. Los archivos que añadas a la carpeta aparecen automáticamente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy indeksoi kansion paikallaan – mitään ei kopioida tai siirretä. Kansioon lisätyt tiedostot ilmestyvät automaattisesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy indexe le dossier sur place — rien n'est copié ni déplacé. Les fichiers ajoutés au dossier apparaissent automatiquement."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy skráir möppuna á sínum stað – ekkert er afritað eða fært. Skrár sem bætast við möppuna birtast sjálfkrafa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy indicizza la cartella dov'è: nulla viene copiato o spostato. I file aggiunti alla cartella compaiono automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccyはフォルダをその場でインデックスします — 何もコピーも移動もしません。フォルダに追加したファイルは自動的に現れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy는 폴더를 제자리에서 색인합니다 — 아무것도 복사하거나 옮기지 않습니다. 폴더에 추가한 파일은 자동으로 나타납니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy indekserer mappen der den ligger – ingenting kopieres eller flyttes. Nye filer i mappen vises automatisk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy indeksuje folder w miejscu — nic nie jest kopiowane ani przenoszone. Pliki dodane do folderu pojawiają się automatycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Flaccy indexa a pasta onde ela está — nada é copiado ou movido. Arquivos adicionados à pasta aparecem automaticamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy indexerar mappen på plats – inget kopieras eller flyttas. Filer som läggs till i mappen visas automatiskt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 会就地为文件夹建立索引——不会拷贝或移动任何东西。往文件夹里添加的文件会自动出现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 會就地為資料夾建立索引——不會拷貝或移動任何東西。之後放進資料夾的檔案會自動出現。"
          }
        }
      }
    },
    "Flaccy indexes the folder in place, nothing copied or moved. Music from the Music app is in Music › Music › Media.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy indekserer mappen på stedet, intet kopieres eller flyttes. Musik fra Musik-appen ligger under Musik › Musik › Medier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy indiziert den Ordner an seinem Platz; nichts wird kopiert oder verschoben. Musik aus der Music-App liegt unter Music › Music › Media."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy indexes the folder in place, nothing copied or moved. Music from the Music app is in Music › Music › Media."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy indexa la carpeta en su sitio, sin copiar ni mover nada. La música de la app Music está en Music › Music › Media."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy indeksoi kansion paikallaan, mitään ei kopioida eikä siirretä. Musiikki Music-sovelluksesta löytyy kohdasta Music › Music › Media."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy indexe le dossier sur place, rien n’est copié ni déplacé. La musique de l’app Music se trouve dans Music › Music › Media."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy skráir möppuna þar sem hún er, ekkert er afritað eða fært. Tónlist úr Tónlist-appinu er í Music › Music › Media."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy indicizza la cartella sul posto, senza copiare né spostare nulla. La musica dell’app Music si trova in Music › Music › Media."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy はフォルダをそのまま索引化します。コピーや移動は行いません。Music アプリの音楽は Music › Music › Media にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy는 폴더를 제자리에서 색인하며, 아무것도 복사하거나 옮기지 않습니다. Music 앱의 음악은 Music › Music › Media에 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy indekserer mappen på stedet, ingenting kopieres eller flyttes. Musikk fra Musikk-appen ligger under Musikk › Musikk › Media."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy indeksuje folder w miejscu, niczego nie kopiując ani nie przenosząc. Muzyka z aplikacji Music znajduje się w Music › Music › Media."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Flaccy indexa a pasta no lugar, sem copiar nem mover nada. A música do app Music está em Music › Music › Media."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy indexerar mappen på plats – inget kopieras eller flyttas. Musik från appen Musik finns i Music › Music › Media."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 原地索引该文件夹，不复制也不移动任何内容。Music App 中的音乐位于 Music › Music › Media。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 就地索引該資料夾，不複製也不移動任何內容。Music App 中的音樂位於 Music › Music › Media。"
          }
        }
      }
    },
    "Flaccy indexes your music folder in place, so removing from the library moves the original file to the Trash.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy indekserer din musikmappe på stedet, så når du fjerner noget fra biblioteket, flyttes originalfilen til papirkurven."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy indexiert deinen Musikordner an Ort und Stelle: Beim Entfernen aus der Mediathek wandert die Originaldatei in den Papierkorb."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy indexa tu carpeta de música donde está, así que eliminarla de la biblioteca envía el archivo original a la papelera."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy indeksoi musiikkikansiosi paikallaan, joten kirjastosta poistaminen siirtää alkuperäisen tiedoston roskakoriin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy indexe votre dossier de musique sur place : retirer un morceau de la bibliothèque place le fichier d'origine dans la corbeille."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy skráir tónlistarmöppuna þína á sínum stað, þannig að þegar þú fjarlægir úr safninu fer upprunalega skráin í ruslakörfuna."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy indicizza la tua cartella di musica dov'è, quindi rimuovere un brano dalla libreria sposta il file originale nel Cestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccyは音楽フォルダをその場でインデックスするため、ライブラリから削除すると元のファイルがゴミ箱に移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy는 음악 폴더를 제자리에서 색인하므로, 보관함에서 제거하면 원본 파일이 휴지통으로 이동합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy indekserer musikkmappen din der den ligger, så når du fjerner noe fra biblioteket, flyttes originalfilen til papirkurven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy indeksuje twój folder z muzyką w miejscu, więc usunięcie z biblioteki przenosi oryginalny plik do Kosza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Flaccy indexa sua pasta de música onde ela está, então remover da biblioteca move o arquivo original para o Lixo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy indexerar din musikmapp på plats, så när du tar bort något från biblioteket flyttas originalfilen till Papperskorgen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 会就地为音乐文件夹建立索引，因此从资料库中移除时，原始文件会被移到废纸篓。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 會就地為音樂資料夾建立索引，因此從資料庫移除時，原始檔案會被移到垃圾桶。"
          }
        }
      }
    },
    "Flaccy indexes your music folder in place, so removing from the library moves the original files to the Trash.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy indekserer din musikmappe på stedet, så når du fjerner noget fra biblioteket, flyttes originalfilerne til papirkurven."
