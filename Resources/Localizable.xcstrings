    "This can take a moment. You can keep browsing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das kann einen Moment dauern. Du kannst weiter stöbern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto puede tardar un momento. Puedes seguir navegando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela peut prendre un moment. Vous pouvez continuer à naviguer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Può volerci un momento. Puoi continuare a navigare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少し時間がかかります。そのまま操作を続けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠시 걸릴 수 있습니다. 계속 둘러보셔도 됩니다."
