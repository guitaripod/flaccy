    "%@ %lld songs are queued and will send on their own.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ In der Warteschlange: %2$lld Titel. Sie werden automatisch gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ En cola: %2$lld canciones. Se enviarán por sí solas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ En file d’attente : %2$lld morceaux. Ils s’envoient tout seuls."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ In coda: %2$lld brani. Verranno inviati da soli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ キュー内: %2$lld曲。自動で送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 대기 중인 곡: %2$lld곡. 자동으로 전송됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ W kolejce: %2$lld utworów. Wyślą się same."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Na fila: %2$lld músicas. Elas serão enviadas sozinhas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 排队中：%2$lld 首歌曲，将自动发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
