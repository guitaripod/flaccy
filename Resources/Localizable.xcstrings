    "%@ %lld songs are queued and will send on their own.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %lld sange er i kø og sendes automatisk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ In der Warteschlange: %2$lld Titel. Sie werden automatisch gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ En cola: %2$lld canciones. Se enviarán por sí solas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %lld kappaletta on jonossa ja ne lähetetään automaattisesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ En file d’attente : %2$lld morceaux. Ils s’envoient tout seuls."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %lld lög eru í biðröð og verða send sjálfkrafa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ In coda: %2$lld brani. Verranno inviati da soli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ キュー内: %2$lld曲。自動で送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 대기 중인 곡: %2$lld곡. 자동으로 전송됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$lld sanger står i kø og sendes automatisk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ W kolejce: %2$lld utworów. Wyślą się same."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Na fila: %2$lld músicas. Elas serão enviadas sozinhas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %lld låtar står i kö och skickas av sig själva."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 排队中：%2$lld 首歌曲，将自动发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 排隊中：%2$lld 首歌曲，將自動傳送。"
          }
        }
      }
    },
