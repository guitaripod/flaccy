    "The connection works, but the lyrics server didn't answer within 10 seconds. Try again in a moment.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbindelsen virker, men sangtekst-serveren svarede ikke inden for 10 sekunder. Prøv igen om lidt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung funktioniert, aber der Songtext-Server hat nicht innerhalb von 10 Sekunden geantwortet. Versuche es gleich noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión funciona, pero el servidor de letras no respondió en 10 segundos. Inténtalo de nuevo en un momento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhteys toimii, mutta sanoituspalvelin ei vastannut 10 sekunnin kuluessa. Yritä hetken päästä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion fonctionne, mais le serveur de paroles n’a pas répondu dans les 10 secondes. Réessayez dans un instant."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tengingin virkar, en textanetþjónninn svaraði ekki innan 10 sekúndna. Reyndu aftur eftir smástund."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione funziona, ma il server dei testi non ha risposto entro 10 secondi. Riprova tra poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続は有効ですが、歌詞サーバが10秒以内に応答しませんでした。少し待ってから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결은 되었지만 가사 서버가 10초 안에 응답하지 않았습니다. 잠시 후 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilkoblingen fungerer, men tjenesten for sangtekster svarte ikke innen 10 sekunder. Prøv igjen om litt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenie działa, ale serwer tekstów nie odpowiedział w ciągu 10 sekund. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão funciona, mas o servidor de letras não respondeu em 10 segundos. Tente novamente em instantes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslutningen fungerar, men låttextservern svarade inte inom 10 sekunder. Försök igen om en stund."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络连接正常，但歌词服务器未在 10 秒内响应。请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網路連線正常，但歌詞伺服器未在 10 秒內回應。請稍後再試一次。"
          }
        }
      }
    },
