    ", in your library, double tap to play": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": ", in deiner Mediathek, Doppeltippen zum Abspielen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": ", en tu biblioteca, toca dos veces para reproducir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ", dans votre bibliothèque, toucher deux fois pour lire"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ", nella tua libreria, tocca due volte per riprodurre"
          }
        },
