    "Headroom is set for you, so boosts never clip. Drag to take over.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Headroom wird für dich eingestellt, damit Anhebungen nie übersteuern. Ziehen, um selbst zu übernehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El margen se ajusta automáticamente para que los aumentos nunca saturen. Arrastra para tomar el control."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La marge est réglée pour vous, afin que les boosts ne saturent jamais. Faites glisser pour reprendre la main."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il margine è impostato automaticamente, così i boost non saturano mai. Trascina per prendere il controllo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘッドルームは自動設定されるので、ブーストで音が歪むことはありません。ドラッグして手動で設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "헤드룸은 자동으로 설정되어 부스트해도 클리핑되지 않습니다. 드래그하면 직접 설정할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapas (headroom) ustawiany jest za ciebie, więc wzmocnienia nie przesterowują. Przeciągnij, aby przejąć kontrolę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A folga (headroom) é ajustada para você, então os reforços nunca cortam. Arraste para assumir o controle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "余量已为你自动设置，因此提升不会削波。拖动即可手动接管。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "餘量已為你自動設定，因此提升不會爆音。拖移即可手動接管。"
          }
        }
      }
    },
