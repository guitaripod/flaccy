    "%@ has a new security key. Remove it and add it again to keep syncing.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har en ny sikkerhedsnøgle. Fjern den, og tilføj den igen for at fortsætte synkroniseringen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat einen neuen Sicherheitsschlüssel. Entferne es und füge es erneut hinzu, damit die Synchronisierung weiterläuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has a new security key. Remove it and add it again to keep syncing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tiene una clave de seguridad nueva. Elimínalo y añádelo de nuevo para seguir sincronizando."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:llä on uusi suojausavain. Poista se ja lisää uudelleen, jotta synkronointi jatkuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a une nouvelle clé de sécurité. Supprime-le et ajoute-le de nouveau pour continuer la synchronisation."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er með nýjan öryggislykil. Fjarlægðu netþjóninn og bættu honum aftur við til að halda samstillingu áfram."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha una nuova chiave di sicurezza. Rimuovilo e aggiungilo di nuovo per continuare la sincronizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のセキュリティキーが変わりました。同期を続けるには、削除してから追加し直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 보안 키가 바뀌었습니다. 동기화를 계속하려면 삭제한 뒤 다시 추가하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har en ny sikkerhetsnøkkel. Fjern den og legg den til igjen for å fortsette å synkronisere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ma nowy klucz bezpieczeństwa. Usuń go i dodaj ponownie, aby synchronizacja działała dalej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tem uma nova chave de segurança. Remova-o e adicione-o de novo para continuar sincronizando."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har en ny säkerhetsnyckel. Ta bort den och lägg till den igen för att synkroniseringen ska fortsätta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的安全密钥已更改。请将其移除并重新添加，以继续同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的安全金鑰已更改。請將其移除並重新新增，以繼續同步。"
          }
        }
      }
    },
    "%@ has been on repeat — %@ plays and counting. See your recap.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ har kørt på gentagelse – %2$@ afspilninger og tæller stadig op. Se dit tilbageblik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ läuft in Dauerschleife – %2$@ Wiedergaben und es werden mehr. Sieh dir deinen Rückblick an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ has been on repeat — %2$@ plays and counting. See your recap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no para de sonar: %2$@ reproducciones y subiendo. Mira tu resumen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ on soinut toistuvasti – %2$@ toistoa, ja luku kasvaa. Katso katsauksesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tourne en boucle — %2$@ écoutes et ça continue. Voir votre récap."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hefur verið spilað aftur og aftur: %2$@ spilanir og fjölgar enn. Skoðaðu yfirlitið þitt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ è sempre in loop: %2$@ ascolti e non è finita. Guarda il tuo riepilogo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@がヘビロテ中 — %2$@回再生、まだ止まりません。リキャップを見る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@을(를) 계속 반복 중 — %2$@회 재생, 아직 진행 중. 리캡을 확인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ har gått på repeat: %2$@ avspillinger og det blir flere. Se tilbakeblikket ditt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ gra w kółko — %2$@ odtworzeń i wciąż rośnie. Zobacz swoje podsumowanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ não sai do repeat — %2$@ reproduções e contando. Veja sua retrospectiva."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ har varit på repeat – %2$@ uppspelningar och det blir fler. Se din återblick."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 一直在循环——已播放 %2$@ 次，还在继续。看看你的回顾。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 一直在重複播放——已播放 %2$@ 次，還在持續。看看你的回顧。"
          }
        }
      }
    },
