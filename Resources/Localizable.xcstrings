    "Copies files into Flaccy's library folder, preserving folder structure.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopierer filer ind i Flaccys biblioteksmappe og bevarer mappestrukturen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiert Dateien in Flaccys Mediathekordner und behält die Ordnerstruktur bei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia los archivos a la carpeta de biblioteca de Flaccy conservando la estructura de carpetas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopioi tiedostot Flaccyn kirjastokansioon säilyttäen kansiorakenteen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie les fichiers dans le dossier de bibliothèque de Flaccy en conservant la structure des dossiers."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Afritar skrár í safnmöppu Flaccy og varðveitir mappauppbygginguna."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia i file nella cartella della libreria di Flaccy mantenendo la struttura delle cartelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダ構成を保ったまま、ファイルをFlaccyのライブラリフォルダにコピーします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더 구조를 유지한 채 파일을 Flaccy 보관함 폴더로 복사합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopierer filer til Flaccys bibliotekmappe og beholder mappestrukturen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiuje pliki do folderu biblioteki Flaccy, zachowując strukturę folderów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia os arquivos para a pasta de biblioteca do Flaccy, preservando a estrutura de pastas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopierar filer till Flaccys biblioteksmapp och behåller mappstrukturen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把文件拷贝到 Flaccy 的资料库文件夹，并保留文件夹结构。"
          }
        },
        "zh-Hant": {
