          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fant ingen duplikatsanger eller albumutgaver å slå sammen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono zduplikowanych utworów ani edycji albumów do scalenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma faixa duplicada nem edição de álbum para mesclar foi encontrada."
          }
        },
        "sv": {
