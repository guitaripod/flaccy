    "All %lld items are already in your library.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle %lld elementer findes allerede i dit bibliotek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle %lld Titel sind bereits in deiner Bibliothek."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los %lld elementos ya están en tu biblioteca."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki %lld kohdetta ovat jo kirjastossasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les %lld éléments sont déjà dans votre bibliothèque."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Öll %lld atriði eru þegar í safninu þínu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i %lld elementi sono già nella tua libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld件はすべてライブラリにあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개 항목이 모두 이미 보관함에 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle %lld sanger er allerede i biblioteket ditt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$#@arg1@"
          },
          "substitutions": {
            "arg1": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "few": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Wszystkie %arg elementy są już w twojej bibliotece."
                    }
                  },
                  "many": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Wszystkie %arg elementów jest już w twojej bibliotece."
                    }
                  },
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg element jest już w twojej bibliotece."
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg elementu jest już w twojej bibliotece."
                    }
                  }
                }
              }
            }
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os %lld itens já estão na sua biblioteca."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla %lld objekt finns redan i ditt bibliotek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这 %lld 项均已在你的资料库中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這 %lld 項均已在你的資料庫中。"
          }
        }
      }
    },
    "All %lld tracks will be removed from this device.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle %lld sange fjernes fra denne enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle %lld Titel werden von diesem Gerät entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las %lld pistas se eliminarán de este dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki %lld kappaletta poistetaan tältä laitteelta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les %lld morceaux seront supprimés de cet appareil."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Öll %lld lög verða fjarlægð af þessu tæki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i %lld brani verranno rimossi da questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld曲すべてがこのデバイスから削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld곡 전체가 이 기기에서 제거됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle %lld sanger fjernes fra denne enheten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$#@arg1@"
          },
          "substitutions": {
            "arg1": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "few": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Wszystkie %arg utwory zostaną usunięte z tego urządzenia."
                    }
                  },
                  "many": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Wszystkie %arg utworów zostanie usunięte z tego urządzenia."
                    }
                  },
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg utwór zostanie usunięty z tego urządzenia."
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg utworu zostanie usunięty z tego urządzenia."
                    }
                  }
                }
              }
            }
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As %lld faixas serão removidas deste dispositivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla %lld låtar tas bort från den här enheten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部 %lld 首曲目将从此设备上移除。"
          }
        },
