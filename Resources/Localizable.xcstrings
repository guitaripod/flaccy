    "Play a library from your own music server, such as Navidrome or Flaccy Server. Its songs join your library next to the ones on this device.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afspil et bibliotek fra din egen musikserver, f.eks. Navidrome eller Flaccy Server. Dets sange føjes til dit bibliotek ved siden af dem på denne enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiele eine Mediathek von deinem eigenen Musikserver ab, etwa von Navidrome oder Flaccy Server. Ihre Songs erscheinen in deiner Mediathek neben denen auf diesem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce una biblioteca de tu propio servidor de música, como Navidrome o Flaccy Server. Sus canciones se suman a tu biblioteca junto a las de este dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toista kirjasto omalta musiikkipalvelimeltasi, kuten Navidromelta tai Flaccy Serveriltä. Sen kappaleet näkyvät kirjastossasi tällä laitteella olevien kappaleiden rinnalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lis une bibliothèque depuis ton propre serveur musical, comme Navidrome ou Flaccy Server. Ses morceaux rejoignent ta bibliothèque à côté de ceux de cet appareil."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Spilaðu safn af þínum eigin tónlistarnetþjóni, til dæmis Navidrome eða Flaccy Server. Lögin þaðan bætast við safnið þitt ásamt lögunum í þessu tæki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduci una libreria dal tuo server musicale, come Navidrome o Flaccy Server. I suoi brani si aggiungono alla tua libreria, accanto a quelli di questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の音楽サーバー（Navidrome や Flaccy Server など）のライブラリを再生できます。サーバーの曲は、このデバイスの曲と一緒にライブラリに追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Navidrome이나 Flaccy Server 같은 내 음악 서버의 보관함을 재생할 수 있습니다. 서버의 곡은 이 기기의 곡과 함께 내 보관함에 추가됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spill et bibliotek fra din egen musikkserver, som Navidrome eller Flaccy Server. Sangene fra den blir med i biblioteket ditt ved siden av dem på denne enheten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwarzaj bibliotekę z własnego serwera muzyki, na przykład Navidrome lub Flaccy Server. Jego utwory dołączą do Twojej biblioteki obok tych z tego urządzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque uma biblioteca do seu próprio servidor de música, como o Navidrome ou o Flaccy Server. As músicas dele entram na sua biblioteca junto com as deste dispositivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spela ett bibliotek från din egen musikserver, till exempel Navidrome eller Flaccy Server. Dess låtar läggs till i ditt bibliotek bredvid dem på den här enheten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放你自己的音乐服务器（如 Navidrome 或 Flaccy Server）上的资料库。其中的歌曲会与此设备上的歌曲一起加入你的资料库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "播放你自己的音樂伺服器（如 Navidrome 或 Flaccy Server）上的資料庫。其中的歌曲會與此裝置上的歌曲一起加入你的資料庫。"
          }
        }
      }
    },
    "Play a song and its lyrics show up here.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afspil en sang, så vises dens sangtekst her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiele einen Titel ab, dann erscheint hier sein Songtext."
