    "Can't reach the App Store. Check your connection and try again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ikke nå App Store. Kontrollér din forbindelse, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store ist nicht erreichbar. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede conectar con App Store. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store ei ole tavoitettavissa. Tarkista yhteys ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'accéder à l'App Store. Vérifiez votre connexion et réessayez."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki næst samband við App Store. Athugaðu tenginguna þína og reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere l'App Store. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeに接続できません。接続を確認して再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store에 연결할 수 없습니다. 연결을 확인하고 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Får ikke kontakt med App Store. Kontroller tilkoblingen og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można połączyć się z App Store. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível acessar a App Store. Verifique sua conexão e tente novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan inte nå App Store. Kontrollera anslutningen och försök igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到 App Store。请检查网络连接后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線至 App Store。請檢查網路連線後再試一次。"
          }
        }
      }
    },
    "Can't reach the music folder. Reconnect its drive or choose a folder in Library settings, then turn sharing off and on.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ikke nå musikmappen. Tilslut dens drev igen, eller vælg en mappe under Biblioteksindstillinger, og slå deling fra og til igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Musikordner ist nicht erreichbar. Laufwerk erneut verbinden oder in den Mediathek-Einstellungen einen Ordner wählen, dann die Freigabe aus- und wieder einschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach the music folder. Reconnect its drive or choose a folder in Library settings, then turn sharing off and on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede acceder a la carpeta de música. Vuelve a conectar su unidad o elige una carpeta en los ajustes de Biblioteca, y después desactiva y activa de nuevo el uso compartido."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Musiikkikansio ei ole tavoitettavissa. Yhdistä sen asema uudelleen tai valitse kansio kohdasta Kirjaston asetukset, ja kytke sitten jakaminen pois ja takaisin päälle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’accéder au dossier de musique. Reconnectez son disque ou choisissez un dossier dans les réglages de la Bibliothèque, puis désactivez et réactivez le partage."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki næst samband við tónlistarmöppuna. Tengdu drifið aftur eða veldu möppu í stillingum safnsins, slökktu síðan á deilingu og kveiktu aftur á henni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere la cartella della musica. Ricollegare il disco o scegliere una cartella nelle impostazioni della Libreria, poi disattivare e riattivare la condivisione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音楽フォルダにアクセスできません。ドライブを再接続するか、ライブラリの設定でフォルダを選び、共有をオフにしてからオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악 폴더에 연결할 수 없어요. 드라이브를 다시 연결하거나 보관함 설정에서 폴더를 고른 뒤, 공유를 껐다가 켜 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Får ikke kontakt med musikkmappen. Koble til disken på nytt eller velg en mappe i Bibliotek-innstillingene, og slå deretter deling av og på igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można otworzyć folderu z muzyką. Podłącz ponownie dysk albo wybierz folder w ustawieniach biblioteki, a potem wyłącz i włącz udostępnianie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar a pasta de música. Reconecte o disco ou escolha uma pasta nos Ajustes da Biblioteca e, em seguida, desative e reative o compartilhamento."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan inte nå musikmappen. Anslut dess enhet igen eller välj en mapp i bibliotekets inställningar, stäng sedan av och på delningen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问音乐文件夹。请重新连接其所在的磁盘，或在资料库设置中选择文件夹，然后关闭再开启共享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線到音樂資料夾。請重新連接其所在的磁碟，或在資料庫設定中選擇資料夾，然後關閉再開啟共享。"
          }
        }
      }
    },
    "Can't reach the online catalogs. Check your connection.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ikke nå onlinekatalogerne. Kontrollér din forbindelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Online-Kataloge nicht erreichbar. Prüfe deine Verbindung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach the online catalogs. Check your connection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede acceder a los catálogos en línea. Revisa tu conexión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Online-katalogit eivät ole tavoitettavissa. Tarkista yhteys."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre les catalogues en ligne. Vérifiez votre connexion."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki næst samband við netkatalogana. Athugaðu nettenginguna þína."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere i cataloghi online. Controlla la connessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンラインカタログに接続できません。接続を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온라인 카탈로그에 연결할 수 없습니다. 연결을 확인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Får ikke kontakt med de nettbaserte katalogene. Kontroller tilkoblingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można połączyć się z katalogami online. Sprawdź połączenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
