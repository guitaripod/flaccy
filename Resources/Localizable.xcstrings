            "value": "Indsæt en Equalizer APO- eller AutoEq-profil her, eller brug knapperne nedenfor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge hier ein Equalizer-APO- oder AutoEq-Profil ein oder nutze die Schaltflächen unten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega aquí un perfil de Equalizer APO o AutoEq, o usa los botones de abajo."
          }
