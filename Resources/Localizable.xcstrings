    },
    "Couldn't explain this because Flaccy's AI couldn't be reached. Check your connection and try again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ikke forklare dette, fordi Flaccys AI ikke kunne nås. Kontrollér forbindelsen, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erklärung nicht möglich, weil Flaccys KI nicht erreichbar war. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
