        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 無法播放 %@ 檔案，因此這一個未加入。"
          }
        }
      }
    },
    "Flaccy can’t reach %@. The server didn’t answer. Check that it is running and that this device is on the same network or Tailscale, then try again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy kan ikke nå %@. Serveren svarede ikke. Kontrollér, at den kører, og at denne enhed er på samme netværk eller i Tailscale, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy kann %@ nicht erreichen. Der Server antwortet nicht. Prüfe, ob er läuft und ob dieses Gerät im selben Netzwerk oder in Tailscale ist, und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy no puede conectar con %@. El servidor no respondió. Comprueba que esté en marcha y que este dispositivo esté en la misma red o en Tailscale, y vuelve a intentarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy ei tavoita kohdetta %@. Palvelin ei vastannut. Tarkista, että se on käynnissä ja että tämä laite on samassa verkossa tai Tailscalessa, ja yritä sitten uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy ne parvient pas à joindre %@. Le serveur n’a pas répondu. Vérifie qu’il est démarré et que cet appareil est sur le même réseau ou sur Tailscale, puis réessaie."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy nær ekki sambandi við %@. Netþjónninn svaraði ekki. Athugaðu hvort hann er í gangi og hvort þetta tæki sé á sama neti eða í Tailscale, reyndu svo aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy non riesce a raggiungere %@. Il server non ha risposto. Controlla che sia in esecuzione e che questo dispositivo sia sulla stessa rete o su Tailscale, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy は %@ に接続できません。サーバーが応答しませんでした。サーバーが起動していること、このデバイスが同じネットワークまたは Tailscale 上にあることを確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy가 %@에 연결할 수 없습니다. 서버가 응답하지 않았습니다. 서버가 실행 중이고 이 기기가 같은 네트워크 또는 Tailscale에 있는지 확인한 뒤 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy kan ikke nå %@. Serveren svarte ikke. Sjekk at den kjører, og at denne enheten er på samme nettverk eller i Tailscale, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy nie może połączyć się z %@. Serwer nie odpowiedział. Sprawdź, czy działa i czy to urządzenie jest w tej samej sieci lub w Tailscale, a potem spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Flaccy não consegue acessar %@. O servidor não respondeu. Verifique se ele está em execução e se este dispositivo está na mesma rede ou no Tailscale e tente novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy kan inte nå %@. Servern svarade inte. Kontrollera att den körs och att den här enheten är på samma nätverk eller Tailscale, och försök sedan igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 无法连接到 %@。服务器没有响应。请确认服务器正在运行，并且此设备与它处于同一网络或 Tailscale 中，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 無法連線到 %@。伺服器沒有回應。請確認伺服器正在執行，且此裝置與它位於同一網路或 Tailscale 中，然後再試一次。"
          }
        }
      }
    },
    "Flaccy can’t use the camera. Allow it in Settings, or type the server’s address and key instead.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy kan ikke bruge kameraet. Tillad det under Indstillinger, eller skriv serverens adresse og nøgle i stedet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy kann die Kamera nicht verwenden. Erlaube den Zugriff in den Einstellungen oder gib stattdessen die Adresse und den Schlüssel des Servers ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy no puede usar la cámara. Permítelo en Ajustes o escribe en su lugar la dirección y la clave del servidor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy ei voi käyttää kameraa. Salli käyttö Asetuksissa tai kirjoita palvelimen osoite ja avain sen sijaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy ne peut pas utiliser l’appareil photo. Autorise-le dans Réglages, ou saisis plutôt l’adresse et la clé du serveur."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy getur ekki notað myndavélina. Leyfðu aðgang í Stillingum eða sláðu inn vistfang og lykil netþjónsins í staðinn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy non può usare la fotocamera. Consentine l’uso nelle Impostazioni oppure inserisci l’indirizzo e la chiave del server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy はカメラを使用できません。「設定」で許可するか、代わりにサーバーのアドレスとキーを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy가 카메라를 사용할 수 없습니다. 설정에서 허용하거나 서버의 주소와 키를 직접 입력하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy kan ikke bruke kameraet. Tillat det i Innstillinger, eller skriv inn serverens adresse og nøkkel i stedet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy nie może używać aparatu. Zezwól na to w Ustawieniach albo wpisz adres i klucz serwera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Flaccy não pode usar a câmera. Permita o acesso nos Ajustes ou digite o endereço e a chave do servidor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy kan inte använda kameran. Tillåt det i Inställningar, eller skriv in serverns adress och nyckel i stället."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 无法使用相机。请在“设置”中允许，或改为输入服务器的地址和密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 無法使用相機。請在“設定”中允許，或改為輸入伺服器的位址和金鑰。"
          }
        }
      }
    },
    "Flaccy can’t use the camera. Allow it in Settings, or type the server’s details instead.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy kan ikke bruge kameraet. Tillad det under Indstillinger, eller skriv serverens oplysninger i stedet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy hat keinen Kamerazugriff. Zugriff in den Einstellungen erlauben oder die Daten des Servers stattdessen eingeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy can’t use the camera. Allow it in Settings, or type the server’s details instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy no puede usar la cámara. Permítelo en Ajustes o escribe los datos del servidor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy ei voi käyttää kameraa. Salli käyttö Asetuksissa tai kirjoita palvelimen tiedot sen sijaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy ne peut pas utiliser l’appareil photo. Autorisez-le dans Réglages, ou saisissez plutôt les informations du serveur."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy getur ekki notað myndavélina. Leyfðu aðgang í Stillingum, eða sláðu inn upplýsingar netþjónsins í staðinn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy non può usare la fotocamera. Consentine l’uso nelle Impostazioni, oppure inserisci i dati del server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy はカメラを使用できません。設定で許可するか、代わりにサーバーの情報を入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy가 카메라를 사용할 수 없어요. 설정에서 허용하거나, 대신 서버 정보를 직접 입력해 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy kan ikke bruke kameraet. Tillat det i Innstillinger, eller skriv inn serverens opplysninger i stedet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy nie może użyć aparatu. Zezwól na dostęp w Ustawieniach albo wpisz dane serwera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Flaccy não pode usar a câmera. Permita o acesso nos Ajustes ou digite os dados do servidor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy kan inte använda kameran. Tillåt det i Inställningar, eller skriv in serverns uppgifter i stället."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 无法使用相机。请在“设置”中允许，或改为手动输入服务器信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 無法使用相機。請在「設定」中允許，或改為手動輸入伺服器資訊。"
          }
        }
      }
    },
    "Flaccy checked the file's own tags, looked for a .lrc or .elrc file next to the song, and asked lrclib.net. None of them have words for it. lrclib is written by its community, so Flaccy asks again in 30 days. A .lrc file saved next to the song shows up straight away.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy tjekkede filens egne tags, ledte efter en .lrc- eller .elrc-fil ved siden af sangen og spurgte lrclib.net. Ingen af dem har sangteksten. lrclib vedligeholdes af fællesskabet, så Flaccy spørger igen om 30 dage. En .lrc-fil, der gemmes ved siden af sangen, vises med det samme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy hat die Tags der Datei geprüft, nach einer .lrc- oder .elrc-Datei neben dem Titel gesucht und lrclib.net gefragt. Keine davon hat dafür einen Text. lrclib wird von der Community gepflegt, deshalb fragt Flaccy in 30 Tagen erneut. Eine .lrc-Datei, die neben dem Titel gespeichert wird, erscheint sofort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy revisó las etiquetas del archivo, buscó un archivo .lrc o .elrc junto a la canción y consultó a lrclib.net. Ninguna tiene la letra. lrclib lo mantiene su comunidad, así que Flaccy volverá a consultar dentro de 30 días. Un archivo .lrc guardado junto a la canción aparece al instante."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy tarkisti tiedoston omat tunnisteet, etsi kappaleen vierestä .lrc- tai .elrc-tiedoston ja kysyi lrclib.net-palvelusta. Mistään niistä ei löytynyt sanoituksia. lrclib on yhteisön ylläpitämä, joten Flaccy kysyy uudelleen 30 päivän kuluttua. Kappaleen viereen tallennettu .lrc-tiedosto näkyy heti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy a examiné les balises du fichier, cherché un fichier .lrc ou .elrc à côté du morceau et interrogé lrclib.net. Aucune source n’en contient les paroles. lrclib est alimenté par sa communauté, donc Flaccy réessaiera dans 30 jours. Un fichier .lrc enregistré à côté du morceau apparaît aussitôt."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy skoðaði eigin merki skráarinnar, leitaði að .lrc- eða .elrc-skrá við hlið lagsins og spurði lrclib.net. Engin þeirra hefur texta fyrir það. lrclib er haldið við af samfélaginu, þannig að Flaccy spyr aftur eftir 30 daga. .lrc-skrá sem vistuð er við hlið lagsins birtist strax."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy ha controllato i tag del file, cercato un file .lrc o .elrc accanto al brano e interrogato lrclib.net. Nessuno ha il testo. lrclib è curato dalla sua comunità, quindi Flaccy riprova tra 30 giorni. Un file .lrc salvato accanto al brano compare subito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccyはファイル自身のタグを確認し、曲のそばの.lrcまたは.elrcファイルを探し、lrclib.netに問い合わせました。どれにも歌詞はありませんでした。lrclibはコミュニティが管理しているため、Flaccyは30日後に再度確認します。曲のそばに保存された.lrcファイルはすぐに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy는 파일 자체의 태그를 확인하고, 곡 옆의 .lrc 또는 .elrc 파일을 찾고, lrclib.net에 물어봤습니다. 어디에도 가사가 없었습니다. lrclib은 커뮤니티가 관리하므로 Flaccy는 30일 후에 다시 확인합니다. 곡 옆에 저장한 .lrc 파일은 바로 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy sjekket filens egne tagger, lette etter en .lrc- eller .elrc-fil ved siden av sangen og spurte lrclib.net. Ingen av dem har sangteksten. lrclib vedlikeholdes av fellesskapet, så Flaccy spør igjen om 30 dager. En .lrc-fil som lagres ved siden av sangen, vises med en gang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy sprawdziło tagi pliku, poszukało pliku .lrc lub .elrc obok utworu i zapytało lrclib.net. Żadne z nich nie ma do niego tekstu. lrclib prowadzi społeczność, więc Flaccy zapyta ponownie za 30 dni. Plik .lrc zapisany obok utworu pojawi się od razu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Flaccy verificou as tags do próprio arquivo, procurou um arquivo .lrc ou .elrc ao lado da música e consultou o lrclib.net. Nenhum deles tem a letra. O lrclib é mantido pela comunidade, então o Flaccy consulta de novo em 30 dias. Um arquivo .lrc salvo ao lado da música aparece imediatamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy kontrollerade filens egna taggar, letade efter en .lrc- eller .elrc-fil bredvid låten och frågade lrclib.net. Ingen av dem har någon text för låten. lrclib underhålls av sin gemenskap, så Flaccy frågar igen om 30 dagar. En .lrc-fil som sparas bredvid låten visas direkt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 检查了文件自身的标签，查找了歌曲旁边的 .lrc 或 .elrc 文件，并询问了 lrclib.net。这些来源都没有这首歌的歌词。lrclib 由社区维护，因此 Flaccy 将在 30 天后再次查询。保存在歌曲旁边的 .lrc 文件会立即显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 檢查了檔案本身的標籤、尋找歌曲旁的 .lrc 或 .elrc 檔案，並詢問了 lrclib.net。這些來源都沒有這首歌的歌詞。lrclib 由社群維護，因此 Flaccy 會在 30 天後再次查詢。儲存在歌曲旁的 .lrc 檔案會立即顯示。"
          }
        }
      }
    },
    "Flaccy couldn't open a connection. Check that you're online; lyrics load as soon as you are.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy kunne ikke oprette forbindelse. Kontrollér, at du er online; sangteksterne indlæses, så snart du er det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy konnte keine Verbindung herstellen. Prüfe, ob du online bist; der Songtext lädt, sobald du es bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy no pudo abrir una conexión. Comprueba que tienes conexión; la letra se carga en cuanto la tengas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy ei saanut yhteyttä. Tarkista, että olet verkossa. Sanoitukset latautuvat heti, kun olet taas verkossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy n’a pas pu ouvrir de connexion. Vérifiez que vous êtes en ligne ; les paroles se chargent dès que c’est le cas."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy gat ekki komið á tengingu. Athugaðu hvort þú sért á netinu; textar hlaðast um leið og þú ert það."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy non è riuscito ad aprire una connessione. Controlla di essere online; il testo si carica appena lo sei."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccyは接続を開けませんでした。オンラインか確認してください。オンラインになれば歌詞はすぐに読み込まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy가 연결을 열 수 없었습니다. 온라인 상태인지 확인하세요. 온라인이 되면 가사를 바로 불러옵니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy kunne ikke åpne en tilkobling. Sjekk at du er på nett; sangteksten lastes så snart du er det."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy nie mogło otworzyć połączenia. Sprawdź, czy masz dostęp do internetu; teksty wczytają się, gdy tylko go będziesz mieć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Flaccy não conseguiu abrir uma conexão. Verifique se você está online; a letra carrega assim que estiver."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy kunde inte öppna en anslutning. Kontrollera att du är online, så laddas låttexterna så snart du är det."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 无法建立连接。请检查是否已联网；一旦联网，歌词就会加载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 無法建立連線。請確認已連上網路；一連上就會載入歌詞。"
          }
        }
      }
    },
    "Flaccy couldn’t make a secure connection to %@. Its certificate isn’t trusted. Use the server’s http:// address on your own network, or give it a valid certificate, then try again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy kunne ikke oprette en sikker forbindelse til %@. Certifikatet er ikke betroet. Brug serverens http://-Adresse på dit eget netværk, eller giv den et gyldigt certifikat, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy konnte keine sichere Verbindung zu %@ herstellen. Das Zertifikat wird nicht als vertrauenswürdig eingestuft. Verwende in deinem eigenen Netzwerk die http://-Adresse des Servers oder gib ihm ein gültiges Zertifikat und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy no pudo establecer una conexión segura con %@. Su certificado no es de confianza. Usa la dirección http:// del servidor en tu propia red, o dale un certificado válido, y vuelve a intentarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy ei voinut muodostaa suojattua yhteyttä kohteeseen %@. Sen varmenne ei ole luotettu. Käytä palvelimen osoitetta, joka alkaa http://, omassa verkossasi tai anna sille kelvollinen varmenne, ja yritä sitten uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy n’a pas pu établir de connexion sécurisée avec %@. Son certificat n’est pas approuvé. Utilise l’adresse http:// du serveur sur ton propre réseau, ou donne-lui un certificat valide, puis réessaie."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy gat ekki komið á öruggri tengingu við %@. Vottorð þess er ekki treyst. Notaðu vistfang netþjónsins með http:// á þínu eigin neti, eða gefðu honum gilt vottorð, og reyndu svo aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy non è riuscito a stabilire una connessione sicura con %@. Il suo certificato non è attendibile. Usa l’indirizzo http:// del server sulla tua rete, oppure dagli un certificato valido, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy は %@ とのセキュアな接続を確立できませんでした。証明書が信頼されていません。自分のネットワーク内ではサーバーの http:// アドレスを使うか、有効な証明書を設定して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy가 %@와(과) 보안 연결을 만들 수 없습니다. 인증서를 신뢰할 수 없습니다. 내 네트워크에서는 서버의 http:// 주소를 사용하거나 유효한 인증서를 설정한 뒤 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy kunne ikke opprette en sikker tilkobling til %@. Sertifikatet er ikke betrodd. Bruk serverens http://-Adresse på ditt eget nettverk, eller gi den et gyldig sertifikat, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy nie mogło nawiązać bezpiecznego połączenia z %@. Jego certyfikat nie jest zaufany. We własnej sieci użyj adresu serwera zaczynającego się od http:// albo ustaw prawidłowy certyfikat i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Flaccy não conseguiu fazer uma conexão segura com %@. O certificado dele não é confiável. Use o endereço http:// do servidor na sua própria rede, ou dê a ele um certificado válido, e tente novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy kunde inte skapa en säker anslutning till %@. Certifikatet är inte betrott. Använd serverns http://-adress på ditt eget nätverk, eller ge servern ett giltigt certifikat, och försök sedan igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 无法与 %@ 建立安全连接。其证书不受信任。请在自己的网络中使用服务器的 http:// 地址，或为它配置有效证书，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 無法與 %@ 建立安全連線。其憑證不受信任。請在自己的網路中使用伺服器的 http:// 位址，或為它設定有效憑證，然後再試一次。"
          }
        }
      }
    },
    "Flaccy couldn’t save the song on this device. Free some space and try again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy kunne ikke gemme sangen på denne enhed. Frigør lidt lagerplads, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy konnte den Song nicht auf diesem Gerät speichern. Gib etwas Speicherplatz frei und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy no pudo guardar la canción en este dispositivo. Libera algo de espacio y vuelve a intentarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy ei voinut tallentaa kappaletta tälle laitteelle. Vapauta tilaa ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy n’a pas pu enregistrer le morceau sur cet appareil. Libère de l’espace, puis réessaie."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy gat ekki vistað lagið á þessu tæki. Losaðu um pláss og reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy non è riuscito a salvare il brano su questo dispositivo. Libera dello spazio e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy はこのデバイスに曲を保存できませんでした。空き容量を確保して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy가 이 기기에 곡을 저장하지 못했습니다. 저장 공간을 확보한 뒤 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy kunne ikke lagre sangen på denne enheten. Frigjør litt lagringsplass, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy nie mogło zapisać utworu na tym urządzeniu. Zwolnij trochę miejsca i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Flaccy não conseguiu salvar a música neste dispositivo. Libere espaço e tente novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy kunde inte spara låten på den här enheten. Frigör lite utrymme och försök igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 无法将歌曲保存到此设备。请释放一些存储空间，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 無法將歌曲儲存到此裝置。請釋出一些儲存空間，然後再試一次。"
          }
        }
      }
    },
    "Flaccy couldn’t store the sign-in in this device’s Keychain. Unlock the device and try again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy kunne ikke gemme loginoplysningerne i nøglering på denne enhed. Lås enheden op, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy konnte die Anmeldedaten nicht im Schlüsselbund dieses Geräts speichern. Entsperre das Gerät und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy no pudo guardar el inicio de sesión en el llavero de este dispositivo. Desbloquea el dispositivo y vuelve a intentarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy ei voinut tallentaa kirjautumistietoja tämän laitteen avainnippuun. Avaa laitteen lukitus ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy n’a pas pu enregistrer l’identifiant dans le trousseau de cet appareil. Déverrouille l’appareil, puis réessaie."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy gat ekki vistað innskráninguna í Lyklakippu þessa tækis. Opnaðu tækið og reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy non è riuscito a salvare l’accesso nel portachiavi di questo dispositivo. Sblocca il dispositivo e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy はサインイン情報をこのデバイスのキーチェーンに保存できませんでした。デバイスのロックを解除して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy가 로그인 정보를 이 기기의 키체인에 저장하지 못했습니다. 기기 잠금을 해제한 뒤 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy kunne ikke lagre innloggingen i nøkkelringen på denne enheten. Lås opp enheten, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy nie mogło zapisać danych logowania w pęku kluczy tego urządzenia. Odblokuj urządzenie i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Flaccy não conseguiu guardar o login no Chaveiro deste dispositivo. Desbloqueie o dispositivo e tente novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy kunde inte spara inloggningen i Nyckelknippan på den här enheten. Lås upp enheten och försök igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 无法将登录信息存入此设备的钥匙串。请解锁设备，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 無法將登入資訊儲存到此裝置的鑰匙圈。請解鎖裝置，然後再試一次。"
          }
        }
      }
    },
    "Flaccy for Mac is now part of Flaccy": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy til Mac er nu en del af Flaccy"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy für Mac ist jetzt Teil von Flaccy"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy para Mac ahora forma parte de Flaccy"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy for Mac on nyt osa Flaccya"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy pour Mac fait désormais partie de Flaccy"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy fyrir Mac er nú hluti af Flaccy"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy per Mac ora fa parte di Flaccy"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
