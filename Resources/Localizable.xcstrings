            "value": "Nommez la playlist pour ces %lld morceaux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai un nome alla playlist con questi %lld brani."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この%lld曲のプレイリストに名前を付けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 %lld곡을 담을 재생목록의 이름을 입력하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwij playlistę %1$#@arg1@."
          },
          "substitutions": {
            "arg1": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "few": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "dla tych %arg utworów"
                    }
                  },
                  "many": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "dla tych %arg utworów"
                    }
                  },
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "dla tego %arg utworu"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "dla tych %arg utworu"
                    }
                  }
                }
              }
            }
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê um nome à playlist com estas %lld faixas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为这 %lld 首曲目命名播放列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為這 %lld 首曲目的播放列表命名。"
          }
        }
      }
    },
