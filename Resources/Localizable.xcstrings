        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma jeszcze utworów. Kliknij dowolny utwór prawym przyciskiem i wybierz Dodaj do playlisty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma música ainda. Clique com o botão direito em qualquer música e escolha “Adicionar à playlist”."
          }
        },
        "sv": {
          "stringUnit": {
