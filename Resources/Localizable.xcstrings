    "Wikipedia couldn't answer (HTTP %lld). Try again in a few minutes.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Wikipedia kunne ikke svare (HTTP %lld). Prøv igen om et par minutter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wikipedia konnte nicht antworten (HTTP %lld). Versuche es in ein paar Minuten erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wikipedia no pudo responder (HTTP %lld). Inténtalo de nuevo en unos minutos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Wikipedia ei voinut vastata (HTTP %lld). Yritä uudelleen muutaman minuutin kuluttua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wikipédia n’a pas pu répondre (HTTP %lld). Réessayez dans quelques minutes."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Wikipedia gat ekki svarað (HTTP %lld). Reyndu aftur eftir nokkrar mínútur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Wikipedia non ha potuto rispondere (HTTP %lld). Riprova tra qualche minuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wikipediaが応答できませんでした（HTTP %lld）。数分後にもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위키백과가 응답하지 못했습니다(HTTP %lld). 몇 분 후 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Wikipedia kunne ikke svare (HTTP %lld). Prøv igjen om noen minutter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wikipedia nie mogła odpowiedzieć (HTTP %lld). Spróbuj ponownie za kilka minut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Wikipédia não conseguiu responder (HTTP %lld). Tente novamente em alguns minutos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Wikipedia kunde inte svara (HTTP %lld). Försök igen om några minuter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "维基百科无法响应（HTTP %lld）。请几分钟后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "維基百科無法回應（HTTP %lld）。請幾分鐘後再試一次。"
          }
        }
      }
    },
    "Wikipedia took too long to answer. Try again in a moment.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Wikipedia svarede ikke i tide. Prøv igen om lidt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wikipedia hat zu lange nicht geantwortet. Versuche es gleich noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wikipedia tardó demasiado en responder. Inténtalo de nuevo en un momento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Wikipedia vastasi liian hitaasti. Yritä uudelleen hetken päästä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wikipédia a mis trop de temps à répondre. Réessayez dans un instant."
          }
