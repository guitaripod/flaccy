    "From any computer on the same Wi-Fi, in its web browser. Nothing to install.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra enhver computer på samme Wi-Fi, via webbrowseren. Der skal ikke installeres noget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von jedem Computer im selben WLAN, direkt im Webbrowser. Keine Installation nötig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde cualquier ordenador en la misma Wi-Fi, en su navegador web. Sin instalar nada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mistä tahansa tietokoneesta samassa Wi-Fi-verkossa selaimella. Ei asennettavaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depuis n'importe quel ordinateur sur le même Wi-Fi, dans son navigateur web. Rien à installer."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Frá hvaða tölvu sem er á sama Wi-Fi neti, í vefvafra. Ekkert þarf að setja upp."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da qualsiasi computer sulla stessa rete Wi-Fi, nel suo browser web. Niente da installare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じWi-Fi上のコンピュータのWebブラウザから。インストール不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 Wi-Fi에 연결된 컴퓨터의 웹 브라우저에서. 설치할 것이 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra en hvilken som helst datamaskin på samme Wi-Fi, i nettleseren. Ingenting å installere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z dowolnego komputera w tej samej sieci Wi-Fi, w jego przeglądarce. Bez instalowania czegokolwiek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De qualquer computador na mesma rede Wi-Fi, no navegador. Nada para instalar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Från valfri dator på samma Wi-Fi, i webbläsaren. Inget behöver installeras."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在同一 Wi-Fi 下的任意电脑上，用网页浏览器即可，无需安装任何软件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在同一個 Wi-Fi 下的任何電腦上，用網頁瀏覽器即可，不必安裝任何軟體。"
          }
        }
      }
    },
