    "Keep this iPad on the same Wi-Fi. When your computer shows a code, scan it and Flaccy connects.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold denne iPad på samme Wi-Fi. Når din computer viser en kode, skal du scanne den, så forbinder Flaccy sig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte dieses iPad im selben WLAN. Wenn dein Computer einen Code anzeigt, scanne ihn, und Flaccy verbindet sich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep this iPad on the same Wi-Fi. When your computer shows a code, scan it and Flaccy connects."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén este iPad en el mismo Wi-Fi. Cuando tu ordenador muestre un código, escanéalo y Flaccy se conectará."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä tämä iPad samassa Wi-Fi-verkossa. Kun tietokone näyttää koodin, skannaa se, niin Flaccy muodostaa yhteyden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez cet iPad sur le même Wi-Fi. Quand votre ordinateur affiche un code, scannez-le et Flaccy se connecte."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Haltu þessum iPad á sama Wi-Fi. Þegar tölvan þín sýnir kóða skaltu skanna hann og Flaccy tengist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni questo iPad sulla stessa rete Wi-Fi. Quando il computer mostra un codice, scansionalo e Flaccy si connette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPad を同じ Wi-Fi に接続したままにしてください。コンピュータにコードが表示されたら、スキャンすると Flaccy が接続します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPad를 같은 Wi-Fi에 연결해 두세요. 컴퓨터에 코드가 표시되면 스캔하세요. Flaccy가 연결됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold denne iPaden på samme Wi-Fi. Når datamaskinen din viser en kode, skann den, så kobler Flaccy seg til."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trzymaj ten iPad w tej samej sieci Wi-Fi. Gdy komputer pokaże kod, zeskanuj go, a Flaccy się połączy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha este iPad na mesma rede Wi-Fi. Quando seu computador mostrar um código, escaneie-o e o Flaccy se conecta."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll den här iPaden på samma Wi-Fi. När datorn visar en kod skannar du den, så ansluter Flaccy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请让这台 iPad 保持在同一 Wi-Fi 下。电脑显示代码时，扫描它，Flaccy 就会连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請讓這台 iPad 保持在同一 Wi-Fi 下。電腦顯示代碼時，掃描它，Flaccy 就會連線。"
          }
        }
      }
    },
