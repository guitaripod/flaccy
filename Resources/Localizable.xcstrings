    "“%@” isn’t downloaded and %@ can’t be reached. Connect to the internet or Tailscale and try again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "»%@« er ikke hentet, og %@ kan ikke nås. Forbind til internettet eller Tailscale, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist nicht heruntergeladen und %@ ist nicht erreichbar. Verbinde dich mit dem Internet oder Tailscale und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” no está descargada y %@ no se puede alcanzar. Conéctate a internet o a Tailscale y vuelve a intentarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” ei ole ladattuna, eikä %@ ole tavoitettavissa. Yhdistä internetiin tai Tailscaleen ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” n’est pas téléchargé et %@ est injoignable. Connecte-toi à Internet ou à Tailscale, puis réessaie."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ er ekki sótt og ekki næst samband við %@. Tengstu við internetið eða Tailscale og reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” non è scaricato e %@ non è raggiungibile. Connettiti a internet o a Tailscale e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” はダウンロードされておらず、%@ に接続できません。インターネットまたは Tailscale に接続して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”은(는) 다운로드되지 않았고 %@에 연결할 수 없습니다. 인터넷 또는 Tailscale에 연결한 뒤 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» er ikke lastet ned, og %@ kan ikke nås. Koble til internett eller Tailscale og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” nie jest pobrany, a %@ jest nieosiągalny. Połącz się z internetem lub Tailscale i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” não está baixada e %@ não pode ser acessado. Conecte-se à internet ou ao Tailscale e tente novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” har inte hämtats och %@ går inte att nå. Anslut till internet eller Tailscale och försök igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 未下载，且无法连接 %@。请连接互联网或 Tailscale，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 尚未下載，且無法連線到 %@。請連線到網際網路或 Tailscale，然後再試一次。"
          }
        }
      }
    },
    "“%@” needs %@, but your Apple Watch has %@ free. Remove some music first.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "»%1$@« kræver %2$@, men dit Apple Watch har kun %3$@ ledig plads. Fjern noget musik først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ braucht %2$@, aber deine Apple Watch hat nur %3$@ frei. Entferne zuerst etwas Musik."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "“%1$@” needs %2$@, but your Apple Watch has %3$@ free. Remove some music first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” necesita %2$@, pero tu Apple Watch solo tiene %3$@ libres. Quita algo de música antes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%1$@” vaatii %2$@, mutta Apple Watchissasi on %3$@ vapaata tilaa. Poista ensin musiikkia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » nécessite %2$@, mais votre Apple Watch ne dispose que de %3$@ libres. Retirez d'abord de la musique."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ þarf %2$@, en Apple Watch-úrið þitt hefur aðeins %3$@ laust. Fjarlægðu einhverja tónlist fyrst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” richiede %2$@, ma il tuo Apple Watch ha solo %3$@ liberi. Rimuovi prima un po' di musica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」には%2$@が必要ですが、Apple Watchの空きは%3$@です。先に音楽を減らしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”에는 %2$@이(가) 필요하지만 Apple Watch의 여유 공간은 %3$@입니다. 먼저 음악을 정리하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» krever %2$@, men Apple Watch har bare %3$@ ledig. Fjern litt musikk først."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” wymaga %2$@, ale twój Apple Watch ma %3$@ wolnego miejsca. Najpierw usuń trochę muzyki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” precisa de %2$@, mas seu Apple Watch tem %3$@ livres. Remova alguma música antes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%1$@” kräver %2$@, men din Apple Watch har %3$@ ledigt. Ta bort lite musik först."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”需要 %2$@，但你的 Apple Watch 仅剩 %3$@ 可用。请先移除一些音乐。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」需要 %2$@，但你的 Apple Watch 只剩 %3$@ 可用。請先移除一些音樂。"
          }
        }
      }
    },
    "…and %lld more album merges": {
      "localizations": {
