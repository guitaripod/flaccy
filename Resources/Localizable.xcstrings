    "A fuller low end": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein volleres Bassfundament"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graves más llenos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Graves plus pleins"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bassi più pieni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低音がより豊かに"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 풍성한 저음"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pełniejszy dół pasma"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Graves mais encorpados"
          }
        },
        "zh-Hans": {
          "stringUnit": {
