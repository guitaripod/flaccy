    "Peak guard is catching overs. Lower the preamp or return to Auto.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Peak-beskyttelsen griber ind, fordi lyden klipper. Sænk forforstærkningen, eller skift tilbage til Auto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Peak-Schutz greift ein. Vorverstärkung senken oder zu Auto zurückkehren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La protección de picos está actuando. Baja el preamplificador o vuelve a Automático."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Huippusuojaus rajoittaa ylitykset. Laske esivahvistusta tai palaa Autoon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La protection de crête intervient. Baissez le préampli ou revenez sur Auto."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hámarksvörnin grípur yfirkeyrslur. Lækkaðu forsterkinn eða farðu aftur í Sjálfvirkt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La protezione dai picchi interviene. Abbassa il preamplificatore o torna ad Automatico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピーク保護が作動しています。プリアンプを下げるか、自動に戻してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피크 보호가 작동 중입니다. 프리앰프를 낮추거나 자동으로 되돌리세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Toppvakten hindrer klipping. Senk forforsterkningen eller gå tilbake til Auto."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ochrona szczytów właśnie przycina sygnał. Obniż przedwzmacniacz albo wróć do trybu auto."
          }
        },
