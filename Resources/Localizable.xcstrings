    "Songs copied in with Finder or the Files app (On My iPhone › Flaccy) appear the next time Flaccy launches.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Titel, die du per Finder oder in der App „Dateien“ (Auf meinem iPhone › Flaccy) kopierst, erscheinen beim nächsten Start von Flaccy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las canciones copiadas con el Finder o la app Archivos (En mi iPhone › Flaccy) aparecen la próxima vez que se abra Flaccy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les morceaux copiés avec le Finder ou l'app Fichiers (Sur mon iPhone › Flaccy) apparaissent au prochain lancement de Flaccy."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I brani copiati con il Finder o l'app File (Su iPhone › Flaccy) compaiono al prossimo avvio di Flaccy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finderまたはファイルアプリ（このiPhone内 › Flaccy）でコピーした曲は、次にFlaccyを起動したときに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder나 파일 앱(나의 iPhone › Flaccy)으로 복사한 곡은 다음에 Flaccy를 실행할 때 나타납니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwory skopiowane przez Findera lub aplikację Pliki (Na moim iPhonie › Flaccy) pojawią się przy następnym uruchomieniu Flaccy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As músicas copiadas pelo Finder ou pelo app Arquivos (No iPhone › Flaccy) aparecem na próxima vez que o Flaccy for aberto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过访达或“文件”App（我的 iPhone › Flaccy）拷入的歌曲，会在下次启动 Flaccy 时出现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過 Finder 或「檔案」App（我的 iPhone › Flaccy）拷入的歌曲，會在下次啟動 Flaccy 時出現。"
          }
        }
      }
    },
