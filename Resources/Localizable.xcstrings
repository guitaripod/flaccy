    },
    "Couldn't restore the previous mix of “%@” — %@. Nothing was changed; try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der vorherige Mix von „%@“ konnte nicht wiederhergestellt werden – %@. Es wurde nichts geändert; versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo restaurar la mezcla anterior de “%@”: %@. No se cambió nada; inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de restaurer le mix précédent de « %@ » : %@. Rien n’a été modifié ; réessayez."
          }
        },
        "it": {
          "stringUnit": {
