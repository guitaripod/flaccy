    "The purchase didn't go through. Try again in a moment.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Købet blev ikke gennemført. Prøv igen om lidt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf ist nicht zustande gekommen. Versuche es gleich noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compra no se ha completado. Inténtalo de nuevo en unos instantes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osto ei onnistunut. Yritä hetken päästä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'achat n'a pas abouti. Réessayez dans un instant."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaupin gengu ekki í gegn. Reyndu aftur eftir smástund."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'acquisto non è andato a buon fine. Riprova tra qualche istante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入を完了できませんでした。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구입이 완료되지 않았습니다. 잠시 후 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjøpet gikk ikke gjennom. Prøv igjen om litt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakup nie powiódł się. Spróbuj za chwilę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A compra não foi concluída. Tente novamente em instantes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Köpet gick inte igenom. Försök igen om en stund."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买未完成。请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "購買未完成。請稍後再試。"
          }
        }
      }
    },
    "The sample album download was interrupted. Try again to pick up where it stopped.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hentningen af eksempelalbummet blev afbrudt. Prøv igen for at fortsætte, hvor den stoppede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download des Beispielalbums wurde unterbrochen. Versuche es erneut, um dort weiterzumachen, wo er stehen blieb."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La descarga del álbum de muestra se interrumpió. Inténtalo de nuevo para continuar donde se detuvo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Esimerkkialbumin lataus keskeytyi. Yritä uudelleen, niin jatkuu siitä, mihin jäätiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement de l’album d’exemple a été interrompu. Réessayez pour reprendre là où il s’était arrêté."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Niðurhal sýnishornsplötunnar var rofið. Reyndu aftur til að halda áfram þar sem það hætti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il download dell’album di esempio è stato interrotto. Riprova per riprendere da dove si era fermato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンプルアルバムのダウンロードが中断されました。もう一度試すと、中断した場所から再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샘플 앨범 다운로드가 중단되었습니다. 다시 시도하면 중단된 곳부터 이어받습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedlastingen av eksempelalbumet ble avbrutt. Prøv igjen for å fortsette der den stoppet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobieranie albumu przykładowego zostało przerwane. Spróbuj ponownie, aby wznowić od miejsca przerwania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O download do álbum de exemplo foi interrompido. Tente novamente para continuar de onde parou."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hämtningen av exempelalbumet avbröts. Försök igen för att fortsätta där den stannade."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "示例专辑的下载已中断。请重试以从中断处继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "範例專輯的下載已中斷。請再試一次，從中斷處繼續。"
          }
        }
      }
    },
    "The sample album is about 130 MB and this connection may be metered. Wi-Fi is the better way to get it.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksempelalbummet fylder ca. 130 MB, og denne forbindelse er måske datamålt. Det er bedst at hente det over Wi-Fi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Beispielalbum ist etwa 130 MB groß und diese Verbindung könnte volumenbegrenzt sein. Am besten lädst du es über WLAN."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
