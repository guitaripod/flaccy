    "Tag cleanup is powered by Flaccy AI — included in Flaccy Lifetime.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprydning af tags er drevet af Flaccy AI og er inkluderet i Flaccy Lifetime."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tag-Bereinigung läuft mit Flaccy AI – in Flaccy Lifetime enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La limpieza de etiquetas funciona con la IA de Flaccy: incluida en Flaccy de por vida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunnisteiden siivouksen tekee Flaccy AI, ja se sisältyy Flaccy Lifetimeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nettoyage des tags est assuré par Flaccy AI — inclus dans Flaccy à vie."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hreinsun merkja er knúin af Flaccy AI og er innifalin í Flaccy Ævilangt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pulizia dei tag è alimentata da Flaccy AI: inclusa in Flaccy a vita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグの整理はFlaccy AIによるものです。Flaccy 買い切りに含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "태그 정리는 Flaccy AI가 담당합니다 — Flaccy 평생 이용에 포함됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagg-opprydding er drevet av Flaccy AI – inkludert i Flaccy Lifetime."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czyszczenie tagów działa dzięki AI Flaccy — w cenie Flaccy Lifetime."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A limpeza de tags é feita pela IA do Flaccy — incluída no Flaccy Vitalício."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Taggrensning drivs av Flaccy AI och ingår i Flaccy Livstid."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签整理由 Flaccy AI 提供——已包含在 Flaccy 永久版中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤整理由 Flaccy AI 提供——已包含在 Flaccy 永久版中。"
          }
        }
      }
    },
    "Tag cleanup skipped — your trial has ended": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprydning af tags blev sprunget over, da din prøveperiode er udløbet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag-Bereinigung übersprungen – deine Testphase ist beendet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpieza de etiquetas omitida: tu prueba ha terminado"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunnisteiden siivous ohitettiin, koska kokeilusi on päättynyt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettoyage des tags ignoré — votre essai est terminé"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hreinsun merkja sleppt: prufutími þinn er lokið"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulizia dei tag saltata: la tua prova è finita"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグの整理をスキップしました。トライアルが終了しています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "태그 정리를 건너뜀 — 체험이 종료되었습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagg-opprydding hoppet over – prøveperioden din er utløpt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czyszczenie tagów pominięte — twój okres próbny się skończył"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpeza de tags ignorada — seu período de teste acabou"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Taggrensning hoppades över – din provperiod har avslutats"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已跳过标签整理——你的试用已结束"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已跳過標籤整理——你的試用已結束"
          }
        }
      }
    },
    "Tailscale is off and this Wi-Fi isn't shared, so only this Mac can play it. Turn on either one.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale er slukket, og dette Wi-Fi deles ikke, så kun denne Mac kan afspille musikken. Tænd for en af dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale ist aus und dieses WLAN wird nicht geteilt, daher kann nur dieser Mac es abspielen. Schalte eins von beiden ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale is off and this Wi-Fi isn't shared, so only this Mac can play it. Turn on either one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale está desactivado y este Wi-Fi no está compartido, así que solo este Mac puede reproducirla. Activa una de las dos opciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale on pois päältä, eikä tätä Wi-Fi-verkkoa jaeta, joten vain tämä Mac voi toistaa musiikkia. Kytke jompikumpi päälle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale est désactivé et ce Wi-Fi n’est pas partagé : seul ce Mac peut la lire. Activez l’une des deux options."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale er slökkt og þetta Wi-Fi er ekki deilt, svo aðeins þessi Mac-tölva getur spilað tónlistina. Kveiktu á öðru hvoru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale è disattivato e questa rete Wi-Fi non è condivisa, quindi solo questo Mac può riprodurla. Attiva una delle due."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale がオフで、この Wi-Fi は共有されていないため、このMacでしか再生できません。どちらかをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale이 꺼져 있고 이 Wi-Fi는 공유되지 않아서 이 Mac에서만 재생할 수 있습니다. 둘 중 하나를 켜세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale er av, og dette Wi-Fi-et deles ikke, så bare denne Mac-en kan spille den av. Slå på en av dem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale jest wyłączony, a ta sieć Wi-Fi nie jest udostępniona, więc tylko ten Mac może ją odtwarzać. Włącz jedno z nich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tailscale está desativado e este Wi-Fi não está compartilhado, então só este Mac pode tocá-la. Ative um dos dois."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale är av och det här Wi-Fi-nätverket delas inte, så bara den här Mac:en kan spela upp musiken. Slå på något av dem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale 已关闭，且此 Wi-Fi 未共享，因此只有这台 Mac 能播放。请开启其中一项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale 已關閉，且此 Wi-Fi 未共享，因此只有這台 Mac 能播放。請開啟其中一項。"
          }
        }
      }
    },
