    "Last.fm didn't confirm the sign-in, so you're not signed in. Try again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm bekræftede ikke login, så du er ikke logget ind. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm hat die Anmeldung nicht bestätigt, du bist also nicht angemeldet. Versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm no confirmó el inicio de sesión, así que no has iniciado sesión. Inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm ei vahvistanut kirjautumista, joten et ole kirjautunut sisään. Yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm n’a pas confirmé la connexion, vous n’êtes donc pas connecté. Réessayez."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm staðfesti ekki innskráninguna, svo innskráningin tókst ekki. Reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm non ha confermato l’accesso, quindi non hai effettuato l’accesso. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fmがサインインを確認しなかったため、サインインされていません。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm이 로그인을 확인하지 않아 로그인되지 않았습니다. 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm bekreftet ikke innloggingen, så du er ikke logget på. Prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm nie potwierdziło logowania, więc nie jesteś zalogowany. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Last.fm não confirmou o login, então você não está conectado. Tente novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm bekräftade inte inloggningen, så du är inte inloggad. Försök igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm 未确认登录，因此你尚未登录。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm 未確認登入，因此你尚未登入。請再試一次。"
          }
        }
      }
    },
    "Last.fm or Flaccy's signing service sent a reply Flaccy couldn't read. Try again later.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm eller Flaccys signeringstjeneste sendte et svar, som Flaccy ikke kunne læse. Prøv igen senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm oder der Signaturdienst von Flaccy hat eine Antwort gesendet, die Flaccy nicht lesen konnte. Versuche es später erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm o el servicio de firma de Flaccy envió una respuesta que Flaccy no pudo leer. Inténtalo más tarde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm tai Flaccyn allekirjoituspalvelu lähetti vastauksen, jota Flaccy ei pystynyt lukemaan. Yritä myöhemmin uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm ou le service de signature de Flaccy a envoyé une réponse que Flaccy n’a pas pu lire. Réessayez plus tard."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm eða undirritunarþjónusta Flaccy sendi svar sem Flaccy gat ekki lesið. Reyndu aftur síðar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm o il servizio di firma di Flaccy ha inviato una risposta che Flaccy non è riuscito a leggere. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fmまたはFlaccyの署名サービスが、Flaccyで読み取れない応答を返しました。後でもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm 또는 Flaccy의 서명 서비스가 Flaccy가 읽을 수 없는 응답을 보냈습니다. 나중에 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm eller signeringstjenesten til Flaccy sendte et svar Flaccy ikke kunne lese. Prøv igjen senere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm lub usługa podpisywania Flaccy wysłała odpowiedź, której Flaccy nie mogło odczytać. Spróbuj ponownie później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Last.fm ou o serviço de assinatura do Flaccy enviou uma resposta que o Flaccy não conseguiu ler. Tente novamente mais tarde."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm eller Flaccys signeringstjänst skickade ett svar som Flaccy inte kunde läsa. Försök igen senare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm 或 Flaccy 的签名服务返回了 Flaccy 无法读取的响应。请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm 或 Flaccy 的簽章服務回傳了 Flaccy 無法讀取的回應。請稍後再試一次。"
          }
        }
      }
    },
    "Last.fm returned to Flaccy without a sign-in token, so you're not signed in. Try again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm sendte Flaccy tilbage uden et login-token, så du er ikke logget ind. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm hat Flaccy ohne Anmeldetoken zurückgegeben, du bist also nicht angemeldet. Versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm devolvió a Flaccy sin un token de inicio de sesión, así que no has iniciado sesión. Inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm palautti Flaccyyn ilman kirjautumistunnusta, joten et ole kirjautunut sisään. Yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm a renvoyé Flaccy sans jeton de connexion ; vous n’êtes donc pas connecté. Réessayez."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm skilaði Flaccy án innskráningartóka, svo innskráningin tókst ekki. Reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm ha riportato a Flaccy senza un token di accesso, quindi non hai effettuato l’accesso. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fmからサインイン用トークンなしで戻ってきたため、サインインされていません。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm이 로그인 토큰 없이 Flaccy로 돌아와서 로그인되지 않았습니다. 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm svarte Flaccy uten innloggingstoken, så du er ikke logget på. Prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm wróciło do Flaccy bez tokenu logowania, więc nie jesteś zalogowany. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Last.fm voltou ao Flaccy sem um token de login, então você não está conectado. Tente novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm skickade tillbaka till Flaccy utan någon inloggningstoken, så du är inte inloggad. Försök igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm 返回 Flaccy 时没有登录令牌，因此你尚未登录。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm 回到 Flaccy 時沒有登入權杖，因此你尚未登入。請再試一次。"
          }
        }
      }
    },
