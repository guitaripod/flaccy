    "Everything you set up is still here.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt, du har konfigureret, er stadig her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was du eingerichtet hast, ist noch da."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que configuraste sigue aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki asettamasi on yhä tallella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que vous avez configuré est toujours là."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt sem þú hefur sett upp er ennþá hér."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che hai configurato è ancora qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定した内容はすべてそのまま残っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정한 모든 것은 그대로 남아 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt du har satt opp, er fortsatt her."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko, co skonfigurowano, wciąż tu jest."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que você configurou continua aqui."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt du har ställt in finns kvar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你设置的一切都还在。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你設定的一切都還在。"
          }
        }
      }
    },
