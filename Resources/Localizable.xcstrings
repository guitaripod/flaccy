          "stringUnit": {
            "state": "translated",
            "value": "Poistaa välimuistissa olevat kappaleet ja säilyttää lataukset"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime les morceaux en cache et conserve tes téléchargements"
