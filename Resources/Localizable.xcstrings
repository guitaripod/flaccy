          "stringUnit": {
            "state": "translated",
            "value": "Envía las canciones que se volvieron a detener"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähettää uudelleen ne kappaleet, jotka pysähtyivät"
