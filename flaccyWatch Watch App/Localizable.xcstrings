    "%@ albums are still missing artwork.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei %@ Alben fehlt noch das Cover."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A %@ álbumes todavía les falta la carátula."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il manque encore la pochette de %@ albums."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A %@ album manca ancora la copertina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 枚のアルバムにまだアートワークがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@개 앨범에 아직 아트워크가 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ álbuns ainda estão sem capa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还有 %@ 张专辑没有封面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還有 %@ 張專輯沒有封面。"
          }
        }
      }
    },
