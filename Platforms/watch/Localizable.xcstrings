    "%@ albums are still missing artwork.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ album mangler stadig coverbillede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei %@ Alben fehlt noch das Cover."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A %@ álbumes todavía les falta la carátula."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ albumia on vielä ilman kansikuvaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il manque encore la pochette de %@ albums."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Það vantar enn umslag á %@ plötur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A %@ album manca ancora la copertina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 枚のアルバムにまだアートワークがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@개 앨범에 아직 아트워크가 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ album mangler fortsatt omslag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ albumom wciąż brakuje okładki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ álbuns ainda estão sem capa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Omslag saknas fortfarande för %@ album."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还有 %@ 张专辑没有封面。"
          }
        },
