    "Flaccy gave up on %@ albums — no source has them.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy har opgivet %@ album – ingen kilde har dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy hat bei %@ Alben aufgegeben – keine Quelle hat sie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy se ha rendido con %@ álbumes: ninguna fuente los tiene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy luopui etsimästä %@ albumia, koska mikään lähde ei tunne niitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy a renoncé pour %@ albums — aucune source ne les a."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy gafst upp á %@ plötum – engin uppspretta er með þær."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy si è arreso con %@ album: nessuna fonte li ha."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 枚のアルバムはあきらめました。どのソースにもありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@개 앨범은 포기했습니다. 어떤 출처에도 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy ga opp %@ album – ingen kilde har dem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy zrezygnował z %@ albumów — żadne źródło ich nie ma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Flaccy desistiu de %@ álbuns — nenhuma fonte os tem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy slutade leta efter %@ album. Ingen källa har dem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 放弃了 %@ 张专辑——没有任何来源收录它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 放棄了 %@ 張專輯——沒有任何來源收錄它們。"
          }
        }
      }
    },
    "Flaccy's AI turns scrambled filenames into real titles, artists and albums.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccys AI gør kryptiske filnavne til rigtige titler, kunstnere og album."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccys KI macht aus kryptischen Dateinamen echte Titel, Interpreten und Alben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA de Flaccy convierte nombres de archivo enrevesados en títulos, artistas y álbumes de verdad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy AI muuttaa sekavat tiedostonimet oikeiksi kappaleiden nimiksi, artisteiksi ja albumeiksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’IA de Flaccy transforme des noms de fichiers illisibles en vrais titres, artistes et albums."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Gervigreind Flaccy breytir brengluðum skráarheitum í raunveruleg heiti laga, listamanna og platna."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’IA di Flaccy trasforma nomi di file incomprensibili in titoli, artisti e album veri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FlaccyのAIが、ぐちゃぐちゃなファイル名を本物のタイトル・アーティスト・アルバムに変えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy의 AI가 뒤죽박죽인 파일 이름을 진짜 제목, 아티스트, 앨범으로 바꿉니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccys AI gjør kryptiske filnavn om til ekte titler, artister og album."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Flaccy zamienia poplątane nazwy plików w prawdziwe tytuły, wykonawców i albumy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A IA do Flaccy transforma nomes de arquivo embaralhados em títulos, artistas e álbuns de verdade."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccys AI gör om kryptiska filnamn till riktiga titlar, artister och album."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 的 AI 把杂乱的文件名变成真正的标题、艺人和专辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaccy 的 AI 把雜亂的檔案名稱變成真正的標題、演出者和專輯。"
          }
        }
      }
    },
