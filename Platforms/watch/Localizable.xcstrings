          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tytuły, wykonawcy oraz dokładna głębia bitowa i częstotliwość próbkowania każdego utworu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Título, artista e a profundidade de bits e taxa de amostragem exatas de cada faixa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每首曲目的标题、艺人，以及精确的位深度和采样率。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每首曲目的標題、演出者，以及精確的位元深度與取樣率。"
          }
        }
      }
    },
