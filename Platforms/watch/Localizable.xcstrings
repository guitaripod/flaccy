    },
    "Titles, artists, and the exact bit depth and sample rate of every track.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Titel, Interpreten und die genaue Bittiefe und Abtastrate jedes Titels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Título, artista y la profundidad de bits y frecuencia de muestreo exactas de cada pista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le titre, l’artiste et la profondeur de bits et la fréquence d’échantillonnage exactes de chaque morceau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Titolo, artista e gli esatti bit depth e frequenza di campionamento di ogni brano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトル、アーティスト、そして各トラックの正確なビット深度とサンプルレート。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
