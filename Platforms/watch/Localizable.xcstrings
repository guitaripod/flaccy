    "The setup summary belongs to this library. Reinstalling or resetting builds a new one.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsætningsoversigten hører til dette bibliotek. Ved geninstallation eller nulstilling oprettes en ny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einrichtungsübersicht gehört zu dieser Mediathek. Nach einer Neuinstallation oder einem Zurücksetzen wird eine neue erstellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resumen de configuración pertenece a esta biblioteca. Reinstalar o restablecer crea una nueva."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asennusyhteenveto kuuluu tähän kirjastoon. Uudelleenasennus tai nollaus luo uuden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce récapitulatif appartient à cette bibliothèque. Une réinstallation ou une réinitialisation en crée une nouvelle."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Yfirlitið yfir uppsetninguna tilheyrir þessu safni. Með enduruppsetningu eða endurstillingu er búið til nýtt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riepilogo della configurazione appartiene a questa libreria. Reinstallare o reimpostare ne crea una nuova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセットアップの記録はこのライブラリのものです。再インストールやリセットをすると新しいライブラリになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설정 요약은 이 보관함의 기록입니다. 재설치하거나 초기화하면 새 보관함이 만들어집니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppsettsoversikten hører til dette biblioteket. Ved ny installasjon eller tilbakestilling lages et nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podsumowanie konfiguracji należy do tej biblioteki. Ponowna instalacja lub reset tworzy nowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O resumo da configuração pertence a esta biblioteca. Reinstalar ou redefinir cria uma nova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Installationsöversikten hör till det här biblioteket. Om du installerar om eller återställer skapas en ny."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这份建立摘要属于当前资料库。重新安装或重置会建立新的资料库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份建立摘要屬於目前的資料庫。重新安裝或重設會建立新的資料庫。"
          }
        }
      }
    },
    "Titles, artists, and the exact bit depth and sample rate of every track.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Titler, kunstnere og den præcise bitdybde og samplingfrekvens for hver sang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Titel, Interpreten und die genaue Bittiefe und Abtastrate jedes Titels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Título, artista y la profundidad de bits y frecuencia de muestreo exactas de cada pista."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimet, artistit sekä jokaisen kappaleen tarkka bittisyvyys ja näytteenottotaajuus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le titre, l’artiste et la profondeur de bits et la fréquence d’échantillonnage exactes de chaque morceau."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Titlar, listamenn og nákvæm bitadýpt og sýnatíðni hvers lags."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Titolo, artista e gli esatti bit depth e frequenza di campionamento di ogni brano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトル、アーティスト、そして各トラックの正確なビット深度とサンプルレート。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 트랙의 제목, 아티스트, 그리고 정확한 비트 심도와 샘플레이트."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Titler, artister og den nøyaktige bitdybden og samplingsfrekvensen for hver sang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tytuły, wykonawcy oraz dokładna głębia bitowa i częstotliwość próbkowania każdego utworu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Título, artista e a profundidade de bits e taxa de amostragem exatas de cada faixa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Titlar, artister och det exakta bitdjupet och samplingsfrekvensen för varje låt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每首曲目的标题、艺人，以及精确的位深度和采样率。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每首曲目的標題、演出者，以及精確的位元深度與取樣率。"
          }
        }
      }
    },
    "Touch and hold a song or album to add it.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold fingeren på en sang eller et album for at tilføje det."
