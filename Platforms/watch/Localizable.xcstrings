    "Nothing is copied or moved — Flaccy reads your files where they are.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet bliver kopieret eller flyttet – Flaccy læser dine filer, hvor de ligger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wird kopiert oder verschoben – Flaccy liest deine Dateien dort, wo sie liegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se copia ni se mueve nada: Flaccy lee tus archivos donde están."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitään ei kopioida eikä siirretä, Flaccy lukee tiedostosi siellä, missä ne ovat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est copié ni déplacé — Flaccy lit vos fichiers là où ils sont."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekkert er afritað eða fært – Flaccy les skrárnar þínar þar sem þær eru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente viene copiato o spostato: Flaccy legge i tuoi file dove sono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーも移動もしません。Flaccyはファイルをそのままの場所で読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무것도 복사하거나 옮기지 않습니다. Flaccy는 파일을 있는 자리에서 읽습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting kopieres eller flyttes – Flaccy leser filene dine der de ligger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie jest kopiowane ani przenoszone — Flaccy czyta twoje pliki tam, gdzie są."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é copiado nem movido — o Flaccy lê seus arquivos onde eles estão."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget kopieras eller flyttas – Flaccy läser dina filer där de ligger."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不复制也不移动任何文件——Flaccy 就在原处读取你的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
