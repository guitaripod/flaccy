    "Frees %@. It stays on your iPhone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gibt %@ frei. Sie bleibt auf deinem iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera %@. Sigue en tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Libère %@. Elle reste sur ton iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera %@. Resta sul tuo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を空けます。iPhoneには残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 확보. iPhone에는 그대로 남습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwalnia %@. Pozostaje na twoim iPhonie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera %@. Continua no seu iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "释放 %@。它仍保留在你的 iPhone 上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "釋放 %@。它仍保留在你的 iPhone 上。"
          }
        }
      }
    },
